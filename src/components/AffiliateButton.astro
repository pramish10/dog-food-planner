---
/**
 * AffiliateButton — renders an inline Amazon link with visible underline.
 *
 * Props:
 *   url      — affiliate link (required)
 *   label    — override text (default: "View on Amazon")
 *   size     — 'sm' | 'md' (default: 'sm')
 *   class    — extra Tailwind classes passed from parent
 */
interface Props {
  url: string;
  label?: string;
  size?: 'sm' | 'md';
  class?: string;
}

const {
  url,
  label = 'View on Amazon',
  class: extraClass = '',
} = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer sponsored"
  class={`amazon-inline-link inline font-semibold text-[#b46218] dark:text-[#f0a85d] underline decoration-[#c47a2b] decoration-1.5 underline-offset-2 hover:decoration-[#8b4513] transition-colors ${extraClass}`}
  aria-label={label}
>
  <span>{label}</span>
  <span class="text-[10px] text-[#c47a2b] no-print ml-0.5">🛒</span>
</a>
