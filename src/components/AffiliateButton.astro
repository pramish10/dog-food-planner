---
/**
 * AffiliateButton — renders an inline Amazon link with visible underline.
 *
 * Props:
 *   url      — affiliate link (required)
 *   label    — override text (default: "View on Amazon")
 *   size     — 'sm' | 'md' (default: 'sm')
 *   class    — extra Tailwind classes passed from parent
 */
interface Props {
  url: string;
  label?: string;
  size?: 'sm' | 'md';
  class?: string;
}

const {
  url,
  label = 'View on Amazon',
  class: extraClass = '',
} = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer sponsored"
  class={`amazon-inline-link inline font-semibold text-black dark:text-[#fde8c8] underline decoration-black dark:decoration-zinc-300 decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer ${extraClass}`}
  aria-label={label}
>
  <span>{label}</span>
</a>
