---
/**
 * AmazonLink — Component for sponsored Amazon affiliate links.
 * Complies with FTC & Amazon Associates disclosure guidelines:
 * target="_blank", rel="sponsored nofollow noopener"
 */
interface Props {
  url: string;
  label?: string;
  class?: string;
}

const {
  url,
  label = 'Buy Now',
  class: extraClass = '',
} = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="sponsored nofollow noopener"
  class={`amazon-inline-link inline font-semibold text-[#b46218] dark:text-[#f0a85d] underline decoration-black dark:decoration-zinc-300 decoration-1.5 underline-offset-2 transition-colors ${extraClass}`}
  aria-label={`${label} on Amazon`}
>
  <span><slot>{label}</slot></span>
</a>
