---
import type { Lang } from '../i18n/ui';
import { BLOG_UI_STRINGS } from '../i18n/blog';

interface Props {
  lang?: Lang;
  class?: string;
}

const { lang = 'en', class: className = '' } = Astro.props;
const uiStrings = BLOG_UI_STRINGS[lang] || BLOG_UI_STRINGS.en;
---

<section class:list={["max-w-xl mx-auto px-4 sm:px-6 pt-10 sm:pt-12", className]} aria-label={uiStrings.newsletterTitle}>
  <div 
    class="blog-newsletter-card rounded-2xl px-4 py-5 sm:p-6 text-center bg-white/90 dark:bg-[#1a1106]/90 backdrop-blur-sm border border-[#f0d5a8] dark:border-[#3a2510] shadow-xs"
  >
    <div class="text-2xl mb-2">📬</div>
    <h3 class="text-base sm:text-lg font-bold text-[#1c0f00] dark:text-[#fde8c8] tracking-tight mb-1.5">
      {uiStrings.newsletterTitle}
    </h3>
    <p class="text-xs text-[#6b4226] dark:text-[#c4956a] max-w-md mx-auto mb-4 leading-relaxed">
      {uiStrings.newsletterDesc}
    </p>

    <!-- EmailOctopus Form Embed -->
    <div 
      class="emailoctopus-wrapper" 
      data-placeholder={uiStrings.newsletterPlaceholder} 
      data-btn={uiStrings.newsletterBtn}
      data-msg-already-subscribed={uiStrings.newsletterAlreadySubscribed}
      data-msg-temp-error={uiStrings.newsletterTempEmailError}
    >
      <script is:inline async src="https://eomail5.com/form/3a32e580-c79f-11f1-ba68-8f65c387aa2a.js" data-form="3a32e580-c79f-11f1-ba68-8f65c387aa2a"></script>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    const DISPOSABLE_DOMAINS = new Set([
      '10minutemail.com', '10minutemail.net', '20minutemail.com', 'tempmail.com', 'temp-mail.org',
      'mailinator.com', 'guerrillamail.com', 'sharklasers.com', 'guerillamail.biz', 'guerillamail.com',
      'guerillamail.de', 'guerillamail.net', 'guerillamail.org', 'grr.la', 'guerrillamailblock.com',
      'yopmail.com', 'trashmail.com', 'trashmail.net', 'trashmail.me', 'throwawaymail.com',
      'getnada.com', 'dispostable.com', 'fakeinbox.com', 'mohmal.com', 'crazymailing.com',
      'mytemp.email', 'generator.email', 'emailondeck.com', 'inboxkitten.com', 'dropmail.me',
      'fakemailgenerator.com', 'tempr.email', 'tempail.com', 'burnermail.io', 'mailcatch.com',
      'maildrop.cc', 'harakirimail.com', 'jetable.org', 'mailnesia.com', 'zillamail.com',
      'nada.ltd', 'tempmailaddress.com', 'disposablemail.com', 'tempinbox.com', 'byom.de',
      'yopmail.fr', 'yopmail.net', 'cool.fr.nf', 'courriel.fr.nf', 'moncourrier.fr.nf',
      'monemail.fr.nf', 'monmail.fr.nf', 'mytempemail.com', 'spambox.us', 'binkmail.com',
      'bobmail.info', 'chammy.info', 'devnullmail.com', 'letthemeatspam.com', 'mailinater.com',
      'mailhazard.com', 'mailslurp.com', 'minutemail.com', 'trashymail.com', 'tmail.ws',
      'tmpmail.org', 'disbox.org', 'inboxclean.com', 'trashmail.org', 'deadaddress.com',
      'trashmail.net', 'wegwerfmail.de', 'wegwerfmail.net', 'wegwerfmail.org', 'fakemail.net',
      'tempmail.net', 'throwawayemailaddress.com', 'temp-mail.io', 'mailpoof.com'
    ]);

    const DISPOSABLE_KEYWORDS = [
      'tempmail', 'temp-mail', '10minute', '20minute', 'throwaway',
      'trashmail', 'fakemail', 'guerrillamail', 'mailinator', 'dispostable',
      'disposable', 'burnermail', 'yopmail', 'crazymailing', 'sharklasers',
      'mohmal', 'dropmail', 'emailondeck', 'inboxkitten', 'getnada', 'tempail',
      'fakemailgenerator', 'wegwerfmail', 'trashmail', 'minutemail'
    ];

    function isDisposableEmail(email) {
      if (!email || !email.includes('@')) return false;
      const domain = email.split('@')[1]?.toLowerCase();
      if (!domain) return false;
      if (DISPOSABLE_DOMAINS.has(domain)) return true;
      return DISPOSABLE_KEYWORDS.some(function(kw) { return domain.includes(kw); });
    }

    function isAlreadySubscribed(email) {
      try {
        const stored = JSON.parse(localStorage.getItem('dfp_subscribed_emails') || '[]');
        return Array.isArray(stored) && stored.includes(email.toLowerCase());
      } catch (e) {
        return false;
      }
    }

    function markSubscribed(email) {
      try {
        const stored = JSON.parse(localStorage.getItem('dfp_subscribed_emails') || '[]');
        const list = Array.isArray(stored) ? stored : [];
        if (!list.includes(email.toLowerCase())) {
          list.push(email.toLowerCase());
          localStorage.setItem('dfp_subscribed_emails', JSON.stringify(list));
        }
      } catch (e) {}
    }

    function setupEmailOctopusEnhancements() {
      const wrappers = document.querySelectorAll('.emailoctopus-wrapper');
      wrappers.forEach(function(wrapper) {
        if (wrapper.dataset.eoEnhanced) return;
        wrapper.dataset.eoEnhanced = 'true';

        const placeholder = wrapper.getAttribute('data-placeholder');
        const btnText = wrapper.getAttribute('data-btn');
        const msgAlreadySubscribed = wrapper.getAttribute('data-msg-already-subscribed') || "You're already subscribed with this email!";
        const msgTempError = wrapper.getAttribute('data-msg-temp-error') || "Please use a permanent personal or work email (temporary emails are not accepted).";

        let attachedForm = null;
        let lastEmailAttempt = '';

        function checkAndAttachForm() {
          const form = wrapper.querySelector('form.emailoctopus-form');
          const emailInput = wrapper.querySelector('input[type="email"]');
          const submitBtn = wrapper.querySelector('input[type="submit"], button[type="submit"]');

          // Localize input placeholder & submit button
          if (emailInput && placeholder && emailInput.placeholder !== placeholder) {
            emailInput.placeholder = placeholder;
          }
          if (submitBtn && btnText) {
            if ('value' in submitBtn && submitBtn.value !== btnText) {
              submitBtn.value = btnText;
            }
            if (submitBtn.tagName.toLowerCase() === 'button' && submitBtn.textContent !== btnText) {
              submitBtn.textContent = btnText;
            }
          }

          // Attach pre-flight validation in capture phase before EmailOctopus recaptcha runs
          if (form && form !== attachedForm) {
            attachedForm = form;
            
            // Clear custom error on typing
            emailInput?.addEventListener('input', function() {
              const errEl = wrapper.querySelector('.emailoctopus-error-message');
              if (errEl) errEl.textContent = '';
            });

            function validateAndIntercept(e) {
              const emailVal = (emailInput?.value || '').trim();
              lastEmailAttempt = emailVal;
              const errEl = wrapper.querySelector('.emailoctopus-error-message');

              // Check format
              const emailRegex = /^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/;
              if (!emailRegex.test(emailVal)) {
                return; // Let standard validation handle empty or invalid syntax
              }

              // 1. Check for temporary / disposable email
              if (isDisposableEmail(emailVal)) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                if (errEl) errEl.textContent = msgTempError;
                return false;
              }

              // 2. Check for duplicate subscription on this device
              if (isAlreadySubscribed(emailVal)) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                if (errEl) errEl.textContent = msgAlreadySubscribed;
                return false;
              }
            }

            submitBtn?.addEventListener('click', validateAndIntercept, true);
            form.addEventListener('submit', validateAndIntercept, true);
          }
        }

        checkAndAttachForm();
        const observer = new MutationObserver(checkAndAttachForm);
        observer.observe(wrapper, { childList: true, subtree: true });

        // Save email on successful subscription
        const successObserver = new MutationObserver(function() {
          const successEl = wrapper.querySelector('.emailoctopus-success-message');
          if (successEl && successEl.textContent && successEl.textContent.trim()) {
            if (lastEmailAttempt) {
              markSubscribed(lastEmailAttempt);
            }
          }
        });
        successObserver.observe(wrapper, { childList: true, subtree: true });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupEmailOctopusEnhancements);
    } else {
      setupEmailOctopusEnhancements();
    }
  })();
</script>

<style is:global>
  /* Seamless DogFoodPlanner styling for EmailOctopus embedded form */
  .emailoctopus-wrapper {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
  }
  .emailoctopus-wrapper .inline-container {
    max-width: 100% !important;
    width: 100% !important;
    background: transparent !important;
    padding: 0 !important;
    margin: 0 auto !important;
  }
  .emailoctopus-wrapper .form-container {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
  }
  .emailoctopus-wrapper .emailoctopus-form-wrapper {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    background: transparent !important;
    padding: 0 !important;
    width: 100% !important;
  }
  .emailoctopus-wrapper .emailoctopus-form {
    width: 100% !important;
    margin: 0 auto !important;
  }

  /* Responsive layout: clean inline bar on mobile & PC like desktop view */
  .emailoctopus-wrapper .main-form {
    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    justify-content: center !important;
    gap: 0.5rem !important;
    width: 100% !important;
    max-width: 26rem !important;
    margin: 0 auto !important;
  }
  .emailoctopus-wrapper [eo-form-fields-container] {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    width: auto !important;
    display: flex !important;
    align-items: stretch !important;
    justify-content: stretch !important;
    flex-wrap: nowrap !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .emailoctopus-wrapper .emailoctopus-form-row {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Input styling: comfortable height, warm border, proper typography */
  .emailoctopus-wrapper .form-control {
    width: 100% !important;
    min-width: 0 !important;
    font-size: 0.8125rem !important; /* 13px */
    line-height: 1.25rem !important;
    padding: 0.5rem 0.875rem !important;
    border-radius: 0.75rem !important; /* rounded-xl */
    background-color: #fff8f0 !important;
    border: 1px solid #f0d5a8 !important;
    color: #1c0f00 !important;
    box-sizing: border-box !important;
    transition: border-color 0.15s ease, box-shadow 0.15s ease !important;
    height: 2.375rem !important;
    margin: 0 !important;
  }
  html.dark .emailoctopus-wrapper .form-control {
    background-color: #150d04 !important;
    border-color: #3a2510 !important;
    color: #fde8c8 !important;
  }
  .emailoctopus-wrapper .form-control::placeholder {
    color: #9a7b56 !important;
    opacity: 1 !important;
  }
  html.dark .emailoctopus-wrapper .form-control::placeholder {
    color: #785b3b !important;
  }
  .emailoctopus-wrapper .form-control:focus {
    outline: none !important;
    border-color: #c47a2b !important;
    box-shadow: 0 0 0 2px rgba(196, 122, 43, 0.25) !important;
  }

  /* Submit button styling: matched height, no drop-down, no rightward push */
  .emailoctopus-wrapper .btn,
  .emailoctopus-wrapper .btn-primary,
  .emailoctopus-wrapper input[type="submit"],
  .emailoctopus-wrapper button[type="submit"] {
    flex: 0 0 auto !important;
    width: auto !important;
    font-size: 0.8125rem !important;
    font-weight: 700 !important;
    padding: 0.5rem 1.125rem !important;
    border-radius: 0.75rem !important;
    background-color: #c47a2b !important;
    border: 1px solid #c47a2b !important;
    color: #ffffff !important;
    cursor: pointer !important;
    transition: background-color 0.15s ease, transform 0.1s ease !important;
    white-space: nowrap !important;
    margin: 0 !important;
    height: 2.375rem !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .emailoctopus-wrapper .btn:hover,
  .emailoctopus-wrapper .btn-primary:hover,
  .emailoctopus-wrapper input[type="submit"]:hover,
  .emailoctopus-wrapper button[type="submit"]:hover {
    background-color: #a86520 !important;
    border-color: #a86520 !important;
  }
  .emailoctopus-wrapper .btn:active,
  .emailoctopus-wrapper .btn-primary:active,
  .emailoctopus-wrapper input[type="submit"]:active,
  .emailoctopus-wrapper button[type="submit"]:active {
    transform: scale(0.98) !important;
  }

  /* Ultra narrow devices (< 330px): graceful stacked layout that is 100% centered and full-width */
  @media (max-width: 330px) {
    .emailoctopus-wrapper .main-form {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 0.5rem !important;
    }
    .emailoctopus-wrapper [eo-form-fields-container],
    .emailoctopus-wrapper .emailoctopus-form-row {
      width: 100% !important;
      flex: 1 1 100% !important;
    }
    .emailoctopus-wrapper .btn,
    .emailoctopus-wrapper .btn-primary,
    .emailoctopus-wrapper input[type="submit"],
    .emailoctopus-wrapper button[type="submit"] {
      width: 100% !important;
      flex: 1 1 100% !important;
    }
  }

  .emailoctopus-wrapper .emailoctopus-success-message {
    font-size: 0.75rem !important;
    font-weight: 600 !important;
    color: #059669 !important; /* emerald-600 */
    margin: 0.75rem auto 0 !important;
    text-align: center !important;
  }
  html.dark .emailoctopus-wrapper .emailoctopus-success-message {
    color: #34d399 !important; /* emerald-400 */
  }
  .emailoctopus-wrapper .emailoctopus-error-message {
    font-size: 0.75rem !important;
    font-weight: 500 !important;
    color: #dc2626 !important; /* red-600 */
    margin: 0.75rem auto 0 !important;
    text-align: center !important;
  }
  html.dark .emailoctopus-wrapper .emailoctopus-error-message {
    color: #f87171 !important; /* red-400 */
  }
  .emailoctopus-wrapper .mastfoot {
    font-size: 0.65rem !important;
    color: #9a7b56 !important;
    margin-top: 0.5rem !important;
    opacity: 0.8 !important;
  }
  html.dark .emailoctopus-wrapper .mastfoot {
    color: #785b3b !important;
  }
  .emailoctopus-wrapper .mastfoot a {
    color: #c47a2b !important;
    text-decoration: underline !important;
  }
</style>
