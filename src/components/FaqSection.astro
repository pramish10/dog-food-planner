---
import { generateFaqJsonLd } from '../data/faqs';
import { getLocalizedFaqs, FAQ_CATEGORY_TRANSLATIONS } from '../i18n/faqs';
import { getPageTranslations } from '../i18n/pages';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';

interface Props {
  title?: string;
  subtitle?: string;
  limit?: number;
  category?: string;
  showCategories?: boolean;
  showSearch?: boolean;
  viewAllLink?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const pageStrings = getPageTranslations(lang).faqPage;
const categoryStrings = FAQ_CATEGORY_TRANSLATIONS[lang];

const {
  title = pageStrings.badge,
  subtitle = pageStrings.exploreHubsSubtitle,
  limit,
  category,
  showCategories = true,
  showSearch = true,
  viewAllLink = false,
} = Astro.props;

let faqs = getLocalizedFaqs(lang);
if (category && category !== 'All Questions') {
  faqs = faqs.filter(f => f.categoryKey === category);
}
if (limit) {
  faqs = faqs.slice(0, limit);
}

const faqJsonLd = generateFaqJsonLd(faqs);
---

<section id="faq-section" class="py-12 sm:py-20 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
        <span class="text-[#0070f3]">FAQ</span> // {pageStrings.badge}
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-3">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Live Search & Category Filter Toolbar -->
    {(showSearch || showCategories) && (
      <div class="mb-8 space-y-4">
        {showSearch && (
          <div class="relative max-w-xl mx-auto">
            <input 
              type="search"
              id="faq-search-input"
              placeholder={pageStrings.badge}
              class="w-full pl-10 pr-4 py-2.5 bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] focus:border-[#171717] dark:focus:border-[#ededed] focus:bg-white dark:focus:bg-[#141414] rounded-xl text-xs sm:text-sm text-[#171717] dark:text-[#ededed] outline-none transition-all placeholder:text-[#8f8f8f] dark:placeholder:text-[#737373] shadow-2xs"
            />
            <svg class="w-4 h-4 text-[#8f8f8f] dark:text-[#737373] absolute left-3.5 top-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
            </svg>
          </div>
        )}

        {showCategories && (
          <div class="flex items-center justify-center gap-1.5 flex-wrap pt-1">
            {Object.keys(categoryStrings).map(cat => (
              <button
                type="button"
                data-faq-cat-filter={cat}
                aria-pressed="false"
                class="faq-cat-btn px-3 py-1 text-xs font-mono rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] transition-all cursor-pointer"
              >
                {categoryStrings[cat] || cat}
              </button>
            ))}
          </div>
        )}
      </div>
    )}

    <!-- FAQ Accordion List -->
    <div id="faq-accordion-list" class="space-y-3">
      {faqs.map((faq, index) => (
        <div 
          class="faq-item hairline-card bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] rounded-xl overflow-hidden transition-all duration-200"
          data-category={faq.categoryKey}
          data-question={faq.question.toLowerCase()}
          data-keywords={faq.tags.join(' ').toLowerCase()}
        >
          <button 
            type="button"
            class="faq-toggle-btn w-full px-4 sm:px-5 py-3.5 sm:py-4 text-left flex items-center justify-between gap-3 sm:gap-4 cursor-pointer select-none group"
            aria-expanded="false"
            aria-controls={`faq-answer-${faq.id}`}
          >
            <span class="font-medium text-xs sm:text-sm text-[#171717] dark:text-[#ededed] group-hover:text-[#0070f3] dark:group-hover:text-[#3291ff] transition-colors leading-snug">
              {faq.question}
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 rounded-full bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] flex items-center justify-center text-[#171717] dark:text-[#ededed] font-mono text-xs transition-transform duration-200">
              +
            </span>
          </button>

          <div 
            id={`faq-answer-${faq.id}`}
            class="faq-content hidden px-4 sm:px-5 pb-5 pt-1 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed border-t border-[#f0f0f0] dark:border-[#262626] bg-white/70 dark:bg-[#121212]/90"
          >
            <p class="font-medium text-[#171717] dark:text-[#ededed] mb-2 text-xs bg-[#f8fafc] dark:bg-[#1a1a1a] p-3 rounded-lg border border-blue-100/50 dark:border-blue-900/30">
              💡 <strong>{getPageTranslations(lang).faqSingle.directQuickAnswer}:</strong> {faq.shortAnswer}
            </p>
            <div class="prose prose-neutral dark:prose-invert max-w-none text-xs text-[#4d4d4d] dark:text-[#a1a1a1] space-y-2" set:html={faq.fullAnswerHtml} />
            
            <div class="mt-4 pt-3 border-t border-[#ebebeb] dark:border-[#262626] flex flex-wrap items-center justify-between gap-2 text-[11px]">
              <span class="font-mono text-[#8f8f8f] dark:text-[#737373]">{faq.category}</span>
              <a href={translatePath(`/faq/${faq.slug}`)} class="font-mono font-semibold text-[#0070f3] dark:text-[#3291ff] hover:underline flex items-center gap-1">
                {getPageTranslations(lang).faqSingle.readAnswer}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- No Search Results Fallback -->
    <div id="faq-no-results" class="hidden text-center py-12 text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] bg-[#fafafa] dark:bg-[#141414] rounded-xl border border-dashed border-[#ebebeb] dark:border-[#2e2e2e]">
      <p class="font-medium text-[#171717] dark:text-[#ededed] mb-1">{pageStrings.exploreHubsTitle}</p>
      <p>{pageStrings.exploreHubsSubtitle}</p>
    </div>

    {viewAllLink && (
      <div class="mt-10 text-center">
        <a 
          href={translatePath('/faq')} 
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#171717] dark:bg-white text-white dark:text-[#171717] hover:bg-[#333333] dark:hover:bg-[#e5e5e5] text-xs font-semibold rounded-full transition-all shadow-sm"
        >
          <span>{pageStrings.badge}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      </div>
    )}

  </div>
</section>

<style>
  .faq-cat-btn:hover {
    color: #171717;
    border-color: #171717;
  }

  :global(.dark) .faq-cat-btn:hover {
    color: #ededed;
    border-color: #ededed;
  }

  .faq-cat-btn.is-active,
  .faq-cat-btn.is-active:hover {
    background-color: #171717 !important;
    border-color: #171717 !important;
    color: #fff !important;
  }

  :global(.dark) .faq-cat-btn.is-active,
  :global(.dark) .faq-cat-btn.is-active:hover {
    background-color: #fff !important;
    border-color: #fff !important;
    color: #171717 !important;
  }
</style>

<!-- Embedded SEO JSON-LD FAQPage Schema -->
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<script>
  // Interactive FAQ Accordion Logic
  const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');
  const catButtons = document.querySelectorAll<HTMLElement>('.faq-cat-btn');
  const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
  const noResults = document.getElementById('faq-no-results');

  let activeCategory = 'All Questions';
  let searchTerm = '';

  function setActiveCategory(category: string) {
    activeCategory = Array.from(catButtons).some(
      button => button.getAttribute('data-faq-cat-filter') === category,
    ) ? category : 'All Questions';

    catButtons.forEach(button => {
      const isActive = button.getAttribute('data-faq-cat-filter') === activeCategory;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });
  }

  // Accordion Expand/Collapse
  faqItems.forEach(item => {
    const btn = item.querySelector('.faq-toggle-btn');
    const content = item.querySelector('.faq-content');
    const icon = item.querySelector('.faq-icon');

    btn?.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      
      // Toggle current
      if (isExpanded) {
        btn.setAttribute('aria-expanded', 'false');
        content?.classList.add('hidden');
        if (icon) icon.textContent = '+';
      } else {
        btn.setAttribute('aria-expanded', 'true');
        content?.classList.remove('hidden');
        if (icon) icon.textContent = '−';
      }
    });
  });

  // Filter & Search Dispatcher
  function applyFilters() {
    let visibleCount = 0;

    faqItems.forEach(item => {
      const itemCat = item.getAttribute('data-category') || '';
      const itemQ = item.getAttribute('data-question') || '';
      const itemKeywords = item.getAttribute('data-keywords') || '';

      const matchCategory = activeCategory === 'All Questions' || itemCat === activeCategory;
      const matchSearch = searchTerm === '' || 
        itemQ.includes(searchTerm) || 
        itemKeywords.includes(searchTerm);

      if (matchCategory && matchSearch) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (visibleCount === 0 && noResults) {
      noResults.classList.remove('hidden');
    } else if (noResults) {
      noResults.classList.add('hidden');
    }
  }

  // Category Buttons Click
  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      setActiveCategory(btn.getAttribute('data-faq-cat-filter') || 'All Questions');
      applyFilters();

      const url = new URL(window.location.href);
      if (activeCategory === 'All Questions') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', activeCategory);
      }
      window.history.replaceState(null, '', url);
    });
  });

  // Search Input Event
  searchInput?.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilters();
  });

  // Topic badges link here with a category query parameter. Apply it after the
  // page renders so the selected tab and the visible answers stay in sync.
  const requestedCategory = new URLSearchParams(window.location.search).get('category');
  setActiveCategory(requestedCategory || 'All Questions');
  applyFilters();
</script>
