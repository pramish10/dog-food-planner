---
import { generateFaqJsonLd } from '../data/faqs';
import { getLocalizedFaqs } from '../i18n/faqs';
import { getPageTranslations } from '../i18n/pages';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';

interface Props {
  title?: string;
  subtitle?: string;
  limit?: number;
  category?: string;
  showSearch?: boolean;
  viewAllLink?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const pageStrings = getPageTranslations(lang).faqPage;

const {
  title = pageStrings.badge,
  subtitle = pageStrings.exploreHubsSubtitle,
  limit,
  category,
  showSearch = true,
  viewAllLink = false,
} = Astro.props;

let faqs = getLocalizedFaqs(lang);
if (category && category !== 'All Questions') {
  faqs = faqs.filter(f => f.categoryKey === category);
}
const displayLimit = limit || 0;

const faqJsonLd = generateFaqJsonLd(faqs);
---

<section id="faq-section" class="relative py-12 sm:py-20 border-b border-[#f0d5a8] dark:border-[#3a2510] overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#1c0f00] dark:text-[#fde8c8] tracking-tight mb-3">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-[#6b4226] dark:text-[#c4956a] leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Live Search Toolbar + Category Filters -->
    {showSearch && (
      <div class="mb-8 space-y-4">
        <!-- Search Input -->
        <div class="relative max-w-xl mx-auto">
          <input 
            type="search"
            id="faq-search-input"
            placeholder="Search questions, topics, ingredients…"
            class="w-full pl-10 pr-4 py-2.5 bg-white/85 dark:bg-[#1c1208]/85 border border-[#f0d5a8] dark:border-[#3a2510] focus:border-[#c47a2b] dark:focus:border-[#f59e0b] focus:bg-white dark:focus:bg-[#25180c] rounded-xl text-xs sm:text-sm text-[#1c0f00] dark:text-[#fde8c8] outline-none transition-all placeholder:text-[#8f5e35]/60 dark:placeholder:text-[#c4956a]/60 shadow-2xs"
          />
          <svg class="w-4 h-4 text-[#8f5e35] dark:text-[#c4956a] absolute left-3.5 top-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
          </svg>
        </div>

        <!-- Category Filter Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-2" id="faq-category-filters" role="group" aria-label="Filter by category">
          <button
            type="button"
            data-cat="all"
            class="faq-cat-btn active px-3 py-1.5 text-[11px] sm:text-xs font-mono font-semibold rounded-lg border transition-all cursor-pointer
              bg-[#92400e] dark:bg-[#f59e0b] text-white dark:text-[#1c0f00] border-[#92400e] dark:border-[#f59e0b] shadow-xs"
          >
            All Questions
          </button>
          <button
            type="button"
            data-cat="Diet & Nutrition"
            class="faq-cat-btn px-3 py-1.5 text-[11px] sm:text-xs font-mono font-semibold rounded-lg border transition-all cursor-pointer
              bg-white/85 dark:bg-[#1c1208]/85 text-[#6b4226] dark:text-[#c4956a] border-[#f0d5a8] dark:border-[#3a2510]
              hover:bg-[#fff0e6] dark:hover:bg-[#2a1a08] hover:text-[#1c0f00] dark:hover:text-[#fde8c8]"
          >
            🥩 Diet & Nutrition
          </button>
          <button
            type="button"
            data-cat="Health & Allergies"
            class="faq-cat-btn px-3 py-1.5 text-[11px] sm:text-xs font-mono font-semibold rounded-lg border transition-all cursor-pointer
              bg-white/85 dark:bg-[#1c1208]/85 text-[#6b4226] dark:text-[#c4956a] border-[#f0d5a8] dark:border-[#3a2510]
              hover:bg-[#fff0e6] dark:hover:bg-[#2a1a08] hover:text-[#1c0f00] dark:hover:text-[#fde8c8]"
          >
            🩺 Health & Allergies
          </button>
          <button
            type="button"
            data-cat="Feeding Math & Portions"
            class="faq-cat-btn px-3 py-1.5 text-[11px] sm:text-xs font-mono font-semibold rounded-lg border transition-all cursor-pointer
              bg-white/85 dark:bg-[#1c1208]/85 text-[#6b4226] dark:text-[#c4956a] border-[#f0d5a8] dark:border-[#3a2510]
              hover:bg-[#fff0e6] dark:hover:bg-[#2a1a08] hover:text-[#1c0f00] dark:hover:text-[#fde8c8]"
          >
            ⚖️ Feeding Math
          </button>
          <button
            type="button"
            data-cat="Ingredients & Safety"
            class="faq-cat-btn px-3 py-1.5 text-[11px] sm:text-xs font-mono font-semibold rounded-lg border transition-all cursor-pointer
              bg-white/85 dark:bg-[#1c1208]/85 text-[#6b4226] dark:text-[#c4956a] border-[#f0d5a8] dark:border-[#3a2510]
              hover:bg-[#fff0e6] dark:hover:bg-[#2a1a08] hover:text-[#1c0f00] dark:hover:text-[#fde8c8]"
          >
            🔬 Ingredients & Safety
          </button>
          <button
            type="button"
            data-cat="Brand Reviews & Safety"
            class="faq-cat-btn px-3 py-1.5 text-[11px] sm:text-xs font-mono font-semibold rounded-lg border transition-all cursor-pointer
              bg-white/85 dark:bg-[#1c1208]/85 text-[#6b4226] dark:text-[#c4956a] border-[#f0d5a8] dark:border-[#3a2510]
              hover:bg-[#fff0e6] dark:hover:bg-[#2a1a08] hover:text-[#1c0f00] dark:hover:text-[#fde8c8]"
          >
            ⭐ Brand Reviews
          </button>
          <button
            type="button"
            data-cat="Glossary & Terms"
            class="faq-cat-btn px-3 py-1.5 text-[11px] sm:text-xs font-mono font-semibold rounded-lg border transition-all cursor-pointer
              bg-white/85 dark:bg-[#1c1208]/85 text-[#6b4226] dark:text-[#c4956a] border-[#f0d5a8] dark:border-[#3a2510]
              hover:bg-[#fff0e6] dark:hover:bg-[#2a1a08] hover:text-[#1c0f00] dark:hover:text-[#fde8c8]"
          >
            📖 Glossary
          </button>
        </div>

        <!-- Active filter indicator -->
        <div id="faq-filter-status" class="hidden text-center">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-[#8f5e35] dark:text-[#c4956a]">
            Showing: <span id="faq-filter-label" class="text-[#1c0f00] dark:text-[#fde8c8] font-semibold"></span>
            <button id="faq-clear-filter" type="button" class="text-[#92400e] dark:text-[#f59e0b] hover:underline ml-1 font-bold">× Clear</button>
          </span>
        </div>
      </div>
    )}

    <noscript>
      <div class="mb-6 rounded-xl border border-amber-200/70 dark:border-amber-900/50 bg-amber-50/70 dark:bg-amber-950/20 p-4 text-sm text-amber-900 dark:text-amber-100">
        Search, category filters, and accordion toggles need JavaScript. The full FAQ answers remain visible below for easier browsing.
      </div>
    </noscript>

    <!-- FAQ Accordion List -->
    <div id="faq-accordion-list" class="space-y-3" data-faq-limit={displayLimit}>
      {faqs.map((faq, index) => (
        <div 
          class="faq-item hairline-card bg-white/85 dark:bg-[#1c1208]/85 backdrop-blur-sm border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl overflow-hidden hover:border-[#c47a2b] dark:hover:border-[#f59e0b] transition-all duration-200 shadow-2xs"
          data-category={faq.categoryKey}
          data-question={faq.question.toLowerCase()}
          data-keywords={faq.tags.join(' ').toLowerCase()}
        >
          <button 
            type="button"
            class="faq-toggle-btn w-full px-4 sm:px-5 py-3.5 sm:py-4 text-left flex items-center justify-between gap-3 sm:gap-4 cursor-pointer select-none group"
            aria-expanded="false"
            aria-controls={`faq-answer-${faq.id}`}
          >
            <span class="font-medium text-xs sm:text-sm text-[#1c0f00] dark:text-[#fde8c8] group-hover:text-[#92400e] dark:group-hover:text-[#f59e0b] transition-colors leading-snug">
              {faq.question}
            </span>
            <span class="faq-icon shrink-0 w-6 h-6 rounded-full bg-[#fffbf6] dark:bg-[#25180c] border border-[#f0d5a8] dark:border-[#3a2510] flex items-center justify-center text-[#8f5e35] dark:text-[#c4956a] font-mono text-xs transition-transform duration-200">
              +
            </span>
          </button>

          <div 
            id={`faq-answer-${faq.id}`}
            class="faq-content hidden px-4 sm:px-5 pb-5 pt-1 text-xs sm:text-sm text-[#6b4226] dark:text-[#c4956a] leading-relaxed border-t border-[#f0d5a8]/60 dark:border-[#3a2510] bg-[#fffbf6]/70 dark:bg-[#150d04]/80"
          >
            <p class="font-medium text-[#1c0f00] dark:text-[#fde8c8] mb-2 text-xs bg-[#fef7ee] dark:bg-[#231507] p-3 rounded-lg border border-[#f0d5a8] dark:border-[#4a2e12]">
              💡 <strong class="text-[#92400e] dark:text-[#f59e0b]">{getPageTranslations(lang).faqSingle.directQuickAnswer}:</strong> {faq.shortAnswer}
            </p>

            <div class="mt-4 pt-3 border-t border-[#f0d5a8]/60 dark:border-[#3a2510] flex flex-wrap items-center justify-between gap-2 text-[11px]">
              <span class="font-mono text-[#8f5e35] dark:text-[#c4956a]">{faq.category}</span>
              <a href={translatePath(`/faq/${faq.slug}`)} class="font-mono font-semibold text-[#92400e] dark:text-[#f59e0b] hover:underline flex items-center gap-1">
                Read More →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- No Search Results Fallback -->
    <div id="faq-no-results" class="hidden text-center py-12 text-xs sm:text-sm text-[#8f5e35] dark:text-[#c4956a] bg-white/85 dark:bg-[#1c1208]/85 rounded-xl border border-dashed border-[#f0d5a8] dark:border-[#3a2510]">
      <p class="font-medium text-[#1c0f00] dark:text-[#fde8c8] mb-1">{pageStrings.exploreHubsTitle}</p>
      <p>{pageStrings.exploreHubsSubtitle}</p>
    </div>

    {viewAllLink && (
      <div class="mt-10 text-center">
        <a 
          href={translatePath('/faq')} 
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#92400e] dark:bg-[#f59e0b] text-white dark:text-[#1c0f00] hover:bg-[#78350f] dark:hover:bg-[#fbbf24] text-xs font-semibold rounded-full transition-all shadow-sm"
        >
          <span>{pageStrings.badge}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      </div>
    )}

  </div>
</section>

<!-- Embedded SEO JSON-LD FAQPage Schema -->
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<script>
  // Interactive FAQ Accordion + Search + Category Filter Logic
  const accordionList = document.getElementById('faq-accordion-list');
  const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');
  const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
  const noResults = document.getElementById('faq-no-results');
  const faqLimit = parseInt(accordionList?.getAttribute('data-faq-limit') || '0', 10);
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.faq-cat-btn');
  const filterStatus = document.getElementById('faq-filter-status');
  const filterLabel = document.getElementById('faq-filter-label');
  const clearFilterBtn = document.getElementById('faq-clear-filter');

  let searchTerm = '';
  let activeCategory = 'all';

  // ── Accordion Expand/Collapse ──────────────────────────────────────────────
  faqItems.forEach(item => {
    const btn = item.querySelector('.faq-toggle-btn');
    const content = item.querySelector('.faq-content');
    const icon = item.querySelector('.faq-icon');

    btn?.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        btn.setAttribute('aria-expanded', 'false');
        content?.classList.add('hidden');
        if (icon) icon.textContent = '+';
      } else {
        btn.setAttribute('aria-expanded', 'true');
        content?.classList.remove('hidden');
        if (icon) icon.textContent = '−';
      }
    });
  });

  // ── Category Button Active State ───────────────────────────────────────────
  function setActiveCatBtn(cat: string) {
    catBtns.forEach(btn => {
      const isActive = btn.dataset.cat === cat;
      // Active styles
      btn.classList.toggle('bg-[#92400e]', isActive);
      btn.classList.toggle('dark:bg-[#f59e0b]', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('dark:text-[#1c0f00]', isActive);
      btn.classList.toggle('border-[#92400e]', isActive);
      btn.classList.toggle('dark:border-[#f59e0b]', isActive);
      btn.classList.toggle('shadow-xs', isActive);
      // Inactive styles
      btn.classList.toggle('bg-white/85', !isActive);
      btn.classList.toggle('dark:bg-[#1c1208]/85', !isActive);
      btn.classList.toggle('text-[#6b4226]', !isActive);
      btn.classList.toggle('dark:text-[#c4956a]', !isActive);
      btn.classList.toggle('border-[#f0d5a8]', !isActive);
      btn.classList.toggle('dark:border-[#3a2510]', !isActive);
    });

    // Show/hide filter status indicator
    if (filterStatus && filterLabel) {
      if (cat !== 'all') {
        filterStatus.classList.remove('hidden');
        filterLabel.textContent = cat;
      } else {
        filterStatus.classList.add('hidden');
      }
    }
  }

  // ── Category Filter Click ──────────────────────────────────────────────────
  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.cat || 'all';
      // Clear search when switching category
      if (searchInput) {
        searchInput.value = '';
        searchTerm = '';
      }
      setActiveCatBtn(activeCategory);
      applyFilters();
    });
  });

  // ── Clear Filter Button ────────────────────────────────────────────────────
  clearFilterBtn?.addEventListener('click', () => {
    activeCategory = 'all';
    if (searchInput) {
      searchInput.value = '';
      searchTerm = '';
    }
    setActiveCatBtn('all');
    applyFilters();
  });

  // ── Apply Search + Category Filters ───────────────────────────────────────
  function applyFilters() {
    let visibleCount = 0;
    const isFiltered = searchTerm !== '' || activeCategory !== 'all';
    const shouldApplyLimit = faqLimit > 0 && !isFiltered;

    faqItems.forEach(item => {
      const itemQ = item.getAttribute('data-question') || '';
      const itemKeywords = item.getAttribute('data-keywords') || '';
      const itemCat = item.getAttribute('data-category') || '';

      const matchSearch = searchTerm === '' ||
        itemQ.includes(searchTerm) ||
        itemKeywords.includes(searchTerm);

      const matchCat = activeCategory === 'all' || itemCat === activeCategory;

      if (matchSearch && matchCat) {
        visibleCount++;
        if (shouldApplyLimit && visibleCount > faqLimit) {
          item.classList.add('hidden');
        } else {
          item.classList.remove('hidden');
        }
      } else {
        item.classList.add('hidden');
      }
    });

    const actualVisible = shouldApplyLimit ? Math.min(visibleCount, faqLimit) : visibleCount;

    if (actualVisible === 0 && noResults) {
      noResults.classList.remove('hidden');
    } else if (noResults) {
      noResults.classList.add('hidden');
    }
  }

  // ── Search Input Event ─────────────────────────────────────────────────────
  searchInput?.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
    // Reset category filter when searching
    if (searchTerm !== '') {
      activeCategory = 'all';
      setActiveCatBtn('all');
    }
    applyFilters();
  });

  // ── Handle URL ?category= param (from hero badges on /faq page) ───────────
  const urlParams = new URLSearchParams(window.location.search);
  const urlCat = urlParams.get('category');
  if (urlCat) {
    activeCategory = urlCat;
    setActiveCatBtn(urlCat);
  }

  applyFilters();
</script>
