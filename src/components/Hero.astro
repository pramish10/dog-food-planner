---
---

<section class="relative pt-16 pb-20 sm:pt-24 sm:pb-28 mesh-gradient-bg border-b border-[#ebebeb]">
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center">
    
    <!-- Technical Eyebrow (Geist Mono from DESIGN.md) -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-[#ebebeb] shadow-xs mb-8">
      <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
      <span class="font-mono text-xs font-semibold text-[#171717] uppercase tracking-wider">
        VETERINARY RER/MER NUTRITION ENGINE
      </span>
      <span class="text-[#ebebeb]">|</span>
      <span class="font-mono text-xs text-[#8f8f8f]">AAFCO & NRC STANDARDS</span>
    </div>

    <!-- Hero Display Title (Geist Sans 600 with tight tracking -2.4px) -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-semibold text-[#171717] tracking-tight leading-[1.08] max-w-4xl mx-auto mb-6">
      Precision nutrition formulated for your dog's <span class="bg-gradient-to-r from-[#0070f3] via-[#7928ca] to-[#ff0080] bg-clip-text text-transparent">exact biology.</span>
    </h1>

    <!-- Subtitle / Body -->
    <p class="text-base sm:text-xl text-[#4d4d4d] max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
      Move beyond generic dry kibble. Calculate exact metabolic calories, balanced macro ratios, and tailored 
      <strong class="text-[#171717] font-medium">Fresh-Cooked</strong>, <strong class="text-[#171717] font-medium">Raw BARF</strong>, or <strong class="text-[#171717] font-medium">Superfood Topper</strong> recipes tailored to your dog's breed, age, and lifestyle.
    </p>

    <!-- Marketing CTA Button Pill (rounded.pill 100px from DESIGN.md) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-14">
      <a 
        href="#planner-section" 
        class="w-full sm:w-auto inline-flex items-center justify-center text-base font-medium text-white bg-[#171717] hover:bg-[#2b2b2b] active:scale-[0.98] transition-all px-8 py-3.5 rounded-full shadow-md hover:shadow-lg"
      >
        <span>Build Your Dog's Custom Plan</span>
        <svg class="w-4 h-4 ml-2 text-[#50e3c2]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      </a>
      
      <a 
        href="#science-section" 
        class="w-full sm:w-auto inline-flex items-center justify-center text-base font-medium text-[#171717] bg-white hover:bg-[#f2f2f2] border border-[#ebebeb] active:scale-[0.98] transition-all px-6 py-3.5 rounded-full shadow-xs"
      >
        <span>Explore The Science</span>
      </a>
    </div>

    <!-- Key Scientific Value Metrics Strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 max-w-4xl mx-auto pt-6 border-t border-[#ebebeb]/80">
      <div class="p-4 bg-white/70 backdrop-blur-xs rounded-xl border border-[#ebebeb] text-left">
        <div class="font-mono text-2xl font-bold text-[#171717]">70 × kg<sup class="text-xs">0.75</sup></div>
        <div class="text-xs text-[#8f8f8f] mt-1 font-sans">Resting Metabolic Math</div>
      </div>
      <div class="p-4 bg-white/70 backdrop-blur-xs rounded-xl border border-[#ebebeb] text-left">
        <div class="font-mono text-2xl font-bold text-[#0070f3]">3 Diets</div>
        <div class="text-xs text-[#8f8f8f] mt-1 font-sans">Cooked, Raw BARF, Topper</div>
      </div>
      <div class="p-4 bg-white/70 backdrop-blur-xs rounded-xl border border-[#ebebeb] text-left">
        <div class="font-mono text-2xl font-bold text-[#10b981]">&lt; 3%</div>
        <div class="text-xs text-[#8f8f8f] mt-1 font-sans">Low-Carb Starch Cap</div>
      </div>
      <div class="p-4 bg-white/70 backdrop-blur-xs rounded-xl border border-[#ebebeb] text-left">
        <div class="font-mono text-2xl font-bold text-[#7928ca]">100%</div>
        <div class="text-xs text-[#8f8f8f] mt-1 font-sans">Transparent Ingredients</div>
      </div>
    </div>

  </div>
</section>
