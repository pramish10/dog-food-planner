---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="relative pt-10 pb-12 sm:pt-20 sm:pb-24 border-b border-[#ebebeb] dark:border-[#262626] overflow-hidden mesh-gradient-bg bg-[#fafafa] dark:bg-[#0d0d0d]">

  <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 text-center min-w-0">

    <!-- Mono eyebrow badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_1px_rgba(0,0,0,0.04)] mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-[#22c55e] shrink-0 animate-pulse"></span>
      <span class="font-mono text-[11px] font-medium text-[#8f8f8f] dark:text-[#737373] uppercase tracking-wider">{t('hero.badge')}</span>
    </div>

    <!-- display-xl headline: 48px / 600 / -2.4px -->
    <h1 class="text-[2rem] xs:text-[2.4rem] sm:text-[3rem] font-semibold text-[#171717] dark:text-[#ededed] leading-[1] tracking-[-0.05em] sm:tracking-[-0.05em] max-w-2xl mx-auto mb-5 text-balance px-0.5">
      {t('hero.title1')} <span class="text-[#171717] dark:text-[#ededed]">{t('hero.titleHighlight')}</span><br class="hidden sm:block" /> {t('hero.title2')}
    </h1>

    <!-- body-lg subtitle -->
    <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-xl mx-auto mb-8 sm:mb-10 leading-relaxed font-normal text-pretty px-0.5">
      {t('hero.subtitle')}
    </p>

    <!-- CTAs: black pill primary + ghost pill secondary -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 mb-10 sm:mb-14 w-full sm:w-auto">
      <a
        href="#planner-section"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 min-h-[44px] text-base font-medium text-white dark:text-[#171717] bg-[#171717] dark:bg-white hover:bg-[#333] dark:hover:bg-[#e5e5e5] rounded-full px-7 py-0 transition-all active:scale-[0.97]"
      >
        <span>{t('hero.ctaCalculate')}</span>
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      </a>

      <a
        href={translatePath('/dog-food-brands')}
        class="w-full sm:w-auto inline-flex items-center justify-center min-h-[44px] text-base font-medium text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#141414] hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] active:scale-[0.97] transition-all px-7 py-0 rounded-full"
      >
        {t('hero.ctaCompare')}
      </a>
    </div>

    <!-- Trust metrics strip — hairline cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-3 max-w-2xl mx-auto pt-5 sm:pt-6 border-t border-[#ebebeb] dark:border-[#262626]">
      <div class="p-3 sm:p-4 bg-white dark:bg-[#141414] rounded-xl border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_1px_rgba(0,0,0,0.04)] text-center">
        <div class="text-xl sm:text-2xl font-semibold text-[#171717] dark:text-[#ededed]">{t('hero.metric1Value')}</div>
        <div class="font-mono text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] mt-1 leading-snug">{t('hero.metric1Label')}</div>
      </div>
      <div class="p-3 sm:p-4 bg-white dark:bg-[#141414] rounded-xl border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_1px_rgba(0,0,0,0.04)] text-center">
        <div class="text-xl sm:text-2xl font-semibold text-[#171717] dark:text-[#ededed]">{t('hero.metric2Value')}</div>
        <div class="font-mono text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] mt-1 leading-snug">{t('hero.metric2Label')}</div>
      </div>
      <div class="p-3 sm:p-4 bg-white dark:bg-[#141414] rounded-xl border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_1px_rgba(0,0,0,0.04)] text-center">
        <div class="text-xl sm:text-2xl font-semibold text-[#171717] dark:text-[#ededed]">{t('hero.metric3Value')}</div>
        <div class="font-mono text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] mt-1 leading-snug">{t('hero.metric3Label')}</div>
      </div>
      <div class="p-3 sm:p-4 bg-white dark:bg-[#141414] rounded-xl border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_1px_rgba(0,0,0,0.04)] text-center">
        <div class="text-xl sm:text-2xl font-semibold text-[#171717] dark:text-[#ededed]">{t('hero.metric4Value')}</div>
        <div class="font-mono text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] mt-1 leading-snug">{t('hero.metric4Label')}</div>
      </div>
    </div>

  </div>
</section>
