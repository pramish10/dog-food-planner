---
import { languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, getLocalizedPath, cleanPathname, useTranslations } from '../i18n/utils';

function buildLocalizedHref(path: string, langCode: Lang) {
  return getLocalizedPath(path, langCode);
}

interface Props {
  variant?: 'navbar' | 'footer' | 'compact';
  class?: string;
}

const { variant = 'navbar', class: className = '' } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const currentPath = Astro.url.pathname;
const currentHash = Astro.url.hash;
const cleanPath = cleanPathname(currentPath);
const preservedPath = `${cleanPath}${currentHash}`;

const languageList = Object.entries(languages) as [Lang, string][];
---

{variant === 'compact' || variant === 'footer' ? (
  <div class:list={["flex flex-wrap items-center gap-1.5 text-xs", className]}>
    <span class="text-[#8f8f8f] dark:text-[#737373] text-[11px] font-mono mr-1">Language:</span>
    {languageList.map(([langCode, langName]) => {
      const isCurrent = langCode === currentLang;
      const href = buildLocalizedHref(preservedPath, langCode);
      return (
        <a
          href={href}
          data-lang-switch
          class:list={[
            "px-2.5 py-2 min-h-9 rounded text-[11px] transition-all font-medium",
            isCurrent
              ? "bg-[#171717] text-white dark:bg-white dark:text-[#171717] font-semibold"
              : "text-[#666666] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#f2f2f2] dark:hover:bg-[#1f1f1f]"
          ]}
          aria-current={isCurrent ? 'page' : undefined}
          title={langName}
        >
          {langName}
        </a>
      );
    })}
  </div>
) : (
  <div class:list={["relative inline-flex items-end text-left language-picker-dropdown", className]}>
    <!-- Dropdown Trigger Button -->
    <button
      type="button"
      id="lang-picker-btn"
      aria-expanded="false"
      aria-haspopup="true"
      aria-label="Select website language"
      class="inline-flex items-center justify-center gap-1 h-7 sm:h-8 px-2 sm:px-2.5 text-[11px] sm:text-xs font-semibold text-[#6b4226] dark:text-[#fde8c8] hover:text-[#92400e] dark:hover:text-[#f59e0b] bg-[#fff8f0] dark:bg-[#1c1208] hover:bg-[#fdf3e7] dark:hover:bg-[#2a1a08] rounded-full border border-[#f0d5a8] dark:border-[#3a2510] shadow-xs hover:shadow-sm transition-all cursor-pointer whitespace-nowrap shrink-0"
    >
      <!-- Globe Icon -->
      <svg class="w-3.5 h-3.5 text-[#a16207] dark:text-[#c4956a] shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" />
        <line x1="2" y1="12" x2="22" y2="12" />
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
      </svg>
      <span class="text-[11px] sm:text-xs font-mono font-semibold uppercase leading-none">{currentLang}</span>
      <!-- Chevron Down -->
      <svg class="w-3 h-3 text-[#a16207] dark:text-[#c4956a] transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <!-- Dropdown Panel -->
    <div
      id="lang-picker-menu"
      class="hidden absolute right-0 top-full mt-1.5 w-44 rounded-2xl bg-white dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] shadow-xl py-1.5 z-50 transition-all focus:outline-none backdrop-blur-md"
      role="menu"
      aria-orientation="vertical"
      aria-labelledby="lang-picker-btn"
    >
      <div class="px-3 py-1.5 border-b border-[#f0d5a8]/60 dark:border-[#3a2510] text-[10px] font-mono text-[#a16207] dark:text-[#c4956a] uppercase tracking-wider">
        {t('lang.select')}
      </div>
      <div class="max-h-64 overflow-y-auto py-1">
        {languageList.map(([langCode, langName]) => {
          const isCurrent = langCode === currentLang;
          const href = buildLocalizedHref(preservedPath, langCode);
          return (
            <a
              href={href}
              data-lang-switch
              role="menuitem"
              class:list={[
                "flex items-center justify-between px-3 py-2 text-xs font-medium transition-colors",
                isCurrent
                  ? "bg-[#f0d5a8]/50 dark:bg-[#3a2510]/60 text-[#1c0f00] dark:text-[#fde8c8] font-semibold"
                  : "text-[#6b4226] dark:text-[#c4956a] hover:bg-[#fdf3e7] dark:hover:bg-[#2a1a08] hover:text-[#92400e] dark:hover:text-[#fde8c8]"
              ]}
              aria-current={isCurrent ? 'page' : undefined}
            >
              <span>{langName}</span>
              {isCurrent && (
                <svg class="w-3.5 h-3.5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </div>
)}

<script is:inline>
  const SCROLL_STATE_KEY = 'dfp-language-switch-scroll';

  function saveLanguageSwitchState() {
    const activeStep = document.querySelector('.quiz-step:not(.hidden)')?.getAttribute('data-step');
    const plannerSection = document.getElementById('planner-section');
    const resultsSection = document.getElementById('results-section');
    const plannerTop = plannerSection ? Math.round(plannerSection.getBoundingClientRect().top + window.scrollY) : null;
    const resultsVisible = resultsSection ? !resultsSection.classList.contains('hidden') : false;

    sessionStorage.setItem(
      SCROLL_STATE_KEY,
      JSON.stringify({
        scrollY: window.scrollY,
        hash: window.location.hash,
        activeStep,
        plannerTop,
        resultsVisible,
      })
    );
  }

  function restoreLanguageSwitchState() {
    const raw = sessionStorage.getItem(SCROLL_STATE_KEY);
    if (!raw) return;

    sessionStorage.removeItem(SCROLL_STATE_KEY);

    try {
      const state = JSON.parse(raw);

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (typeof state.scrollY === 'number') {
            window.scrollTo(0, state.scrollY);
          }
        });
      });
    } catch {
      sessionStorage.removeItem(SCROLL_STATE_KEY);
    }
  }

  function setupLanguagePicker() {
    const btn = document.getElementById('lang-picker-btn');
    const menu = document.getElementById('lang-picker-menu');

    document.querySelectorAll('[data-lang-switch]').forEach((link) => {
      if (link.dataset.langSwitchBound === 'true') return;
      link.dataset.langSwitchBound = 'true';
      link.addEventListener('click', saveLanguageSwitchState);
    });

    if (!btn || !menu) return;

    function toggleMenu(e) {
      e?.stopPropagation();
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    }

    function closeMenu(e) {
      if (!btn.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    }

    btn.addEventListener('click', toggleMenu);
    document.addEventListener('click', closeMenu);
  }

  restoreLanguageSwitchState();
  setupLanguagePicker();
  document.addEventListener('astro:page-load', () => {
    restoreLanguageSwitchState();
    setupLanguagePicker();
  });
</script>
