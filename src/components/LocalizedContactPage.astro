---
import Layout from '../layouts/Layout.astro'; import Navbar from './Navbar.astro'; import Breadcrumbs from './Breadcrumbs.astro'; import Footer from './Footer.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils'; import { ui, type Lang } from '../i18n/ui'; import { getPageTranslations } from '../i18n/pages';
const { lang } = Astro.props as { lang: Lang }; const strings = ui[lang] || ui.en; const t = useTranslations(lang); const path = useTranslatedPath(lang); const p = getPageTranslations(lang).contact;
---
<Layout lang={lang} title={strings['contact.title']} description={strings['contact.desc']}><Navbar /><main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]"><Breadcrumbs items={[{ name: t('nav.brand'), url: path('/') }, { name: t('footer.linkContact') }]} /><section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]"><div class="max-w-4xl mx-auto px-4 sm:px-6 text-center"><div class="inline-flex font-mono text-xs uppercase font-medium px-3 py-1 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] mb-3">{p.eyebrow}</div><h1 class="text-[1.65rem] sm:text-4xl font-semibold text-[#171717] dark:text-[#ededed] text-balance leading-tight">{strings['contact.title']}</h1><p class="mt-4 text-[#4d4d4d] dark:text-[#a1a1a1]">{strings['contact.desc']}</p></div></section><div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 grid md:grid-cols-3 gap-6">{p.cards.map((card) => <article class="hairline-card p-5 bg-white dark:bg-[#141414]"><div class="text-xl">{card.icon}</div><h2 class="font-bold text-[#171717] dark:text-[#ededed] mt-2">{card.title}</h2><p>{card.desc}</p><a href={`mailto:${card.email}`} class="text-[#0070f3] font-mono text-xs">{card.email}</a></article>)}</div><section class="max-w-2xl mx-auto px-4 sm:px-6 pb-12"><div class="hairline-card p-6 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.formTitle}</h2><p class="mt-2">{p.formDesc}</p><form class="mt-5 space-y-3" action="mailto:hello@dogfoodplanner.com"><label class="block">{p.nameLabel}<input required name="name" placeholder={p.namePlaceholder} class="mt-1 w-full p-3 border rounded" /></label><label class="block">{p.emailLabel}<input required type="email" name="email" placeholder={p.emailPlaceholder} class="mt-1 w-full p-3 border rounded" /></label><label class="block">{p.subjectLabel}<select name="subject" class="mt-1 w-full p-3 border rounded">{p.subjectOptions.map((option) => <option>{option}</option>)}</select></label><label class="block">{p.messageLabel}<textarea required name="message" placeholder={p.messagePlaceholder} class="mt-1 w-full p-3 border rounded" rows="5"></textarea></label><button class="px-5 py-3 rounded-full bg-[#171717] text-white">{p.submitBtn}</button></form><p class="mt-5 text-amber-700">{p.notice}</p></div></section></main><Footer /></Layout>
