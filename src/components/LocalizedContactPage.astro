---
import Layout from '../layouts/Layout.astro'; import Navbar from './Navbar.astro'; import Breadcrumbs from './Breadcrumbs.astro'; import Footer from './Footer.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils'; import { ui, type Lang } from '../i18n/ui'; import { getPageTranslations } from '../i18n/pages';
const { lang } = Astro.props as { lang: Lang }; const strings = ui[lang] || ui.en; const t = useTranslations(lang); const path = useTranslatedPath(lang); const p = getPageTranslations(lang).contact;
---
<Layout lang={lang} title={strings['contact.title']} description={strings['contact.desc']}>
  <Navbar />
  <main class="min-h-screen contact-warm-bg">
    <Breadcrumbs items={[{ name: t('nav.brand'), url: path('/') }, { name: t('footer.linkContact') }]} />
    <section class="relative py-12 sm:py-16 border-b border-[#f0d5a8] dark:border-[#3a2510] overflow-hidden">
      <div class="absolute inset-0 pointer-events-none z-0">
        <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-[500px] h-48 rounded-full opacity-50" style="background: radial-gradient(ellipse at 50% 0%, rgba(196,122,43,0.15) 0%, transparent 70%); filter: blur(35px);"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex font-mono text-xs uppercase font-bold px-3 py-1 rounded-full border border-[#f0d5a8] dark:border-[#3a2510] mb-4 bg-[#fdf3e7] dark:bg-[#2a1a08] text-[#92400e] dark:text-[#d97706]">{p.eyebrow}</div>
        <h1 class="text-[1.65rem] sm:text-4xl font-extrabold text-[#1c0f00] dark:text-[#fde8c8] text-balance leading-tight">{p.formTitle}</h1>
        <p class="mt-4 text-sm text-[#6b4226] dark:text-[#c4956a] max-w-2xl mx-auto leading-relaxed">{p.formDesc}</p>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-12">
      <div class="grid md:grid-cols-3 gap-4 md:gap-5 mb-8">
        {p.cards.map((card) => (
          <article class="warm-card p-5 space-y-2">
            <div class="text-2xl">{card.icon}</div>
            <h2 class="font-bold text-sm text-[#1c0f00] dark:text-[#fde8c8] mt-1">{card.title}</h2>
            <p class="text-xs text-[#6b4226] dark:text-[#c4956a]">{card.desc}</p>
            <a href={`mailto:${card.email}`} class="font-mono text-xs text-[#c47a2b] dark:text-[#f59e0b] hover:underline block">{card.email}</a>
          </article>
        ))}
      </div>

      <section class="max-w-3xl mx-auto">
        <div class="warm-card p-6 sm:p-8">
          <h2 class="text-xl font-bold text-[#1c0f00] dark:text-[#fde8c8]">{p.formTitle}</h2>
          <p class="mt-2 text-xs text-[#6b4226] dark:text-[#c4956a] mb-6">{p.formDesc}</p>

          <form id="locale-contact-form" method="POST" action="mailto:hello@dogfoodplanner.com" enctype="text/plain" class="mt-5 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label class="block">
                <span class="block text-xs font-mono uppercase font-bold text-[#92400e] dark:text-[#d97706] mb-1.5">{p.nameLabel}</span>
                <input required type="text" name="Name" placeholder={p.namePlaceholder} class="mt-1 w-full px-3.5 py-2.5 text-xs sm:text-sm bg-[#fff8f0] dark:bg-[#2a1a08] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] placeholder-[#a16207]/50 dark:placeholder-[#c4956a]/50 focus:outline-none focus:border-[#c47a2b] dark:focus:border-[#f59e0b] transition-all" />
              </label>
              <label class="block">
                <span class="block text-xs font-mono uppercase font-bold text-[#92400e] dark:text-[#d97706] mb-1.5">{p.emailLabel}</span>
                <input required type="email" name="From" placeholder={p.emailPlaceholder} class="mt-1 w-full px-3.5 py-2.5 text-xs sm:text-sm bg-[#fff8f0] dark:bg-[#2a1a08] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] placeholder-[#a16207]/50 dark:placeholder-[#c4956a]/50 focus:outline-none focus:border-[#c47a2b] dark:focus:border-[#f59e0b] transition-all" />
              </label>
            </div>
            <label class="block">
              <span class="block text-xs font-mono uppercase font-bold text-[#92400e] dark:text-[#d97706] mb-1.5">{p.subjectLabel}</span>
              <select name="Subject" class="mt-1 w-full px-3.5 py-2.5 text-xs sm:text-sm bg-[#fff8f0] dark:bg-[#2a1a08] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] dark:focus:border-[#f59e0b] transition-all">
                {p.subjectOptions.map((option) => <option>{option}</option>)}
              </select>
            </label>
            <label class="block">
              <span class="block text-xs font-mono uppercase font-bold text-[#92400e] dark:text-[#d97706] mb-1.5">{p.messageLabel}</span>
              <textarea required rows="5" name="Message" placeholder={p.messagePlaceholder} class="mt-1 w-full px-3.5 py-2.5 text-xs sm:text-sm bg-[#fff8f0] dark:bg-[#2a1a08] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] placeholder-[#a16207]/50 dark:placeholder-[#c4956a]/50 focus:outline-none focus:border-[#c47a2b] dark:focus:border-[#f59e0b] transition-all resize-none"></textarea>
            </label>

            <div id="locale-contact-success" class="hidden p-3.5 bg-[#22c55e]/10 border border-[#22c55e]/30 rounded-xl text-[11px] leading-relaxed">
              <div class="font-semibold text-[#16a34a] mb-1">{p.successTitle}</div>
              <div class="text-[#6b4226] dark:text-[#c4956a]">
                {p.successDesc} <a href="mailto:hello@dogfoodplanner.com?subject=DogFoodPlanner%20Contact%20Inquiry" class="underline text-[#c47a2b] dark:text-[#f59e0b] font-mono">hello@dogfoodplanner.com</a>
              </div>
            </div>

            <button type="submit" class="px-6 py-2.5 rounded-full text-white text-xs font-bold transition-all cursor-pointer shadow-md w-full sm:w-auto active:scale-[0.97]" style="background: linear-gradient(135deg, #c47a2b 0%, #e8a44a 100%); box-shadow: 0 4px 14px rgba(196,122,43,0.35);">
              {p.submitBtn}
            </button>
            <p class="mt-4 text-[#92400e] dark:text-[#d97706] text-[11px] leading-relaxed">{p.notice}</p>
          </form>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById('locale-contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('locale-contact-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const RECIPIENT = 'hello@dogfoodplanner.com';
    const getVal = (n: string) => (form.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement)?.value?.trim() || '';
    const name = getVal('Name');
    const email = getVal('From');
    const subject = getVal('Subject') || 'Contact Inquiry';
    const message = getVal('Message');

    const mailSubject = encodeURIComponent(`[DogFoodPlanner Contact] ${subject} — ${name}`);
    const mailBody = encodeURIComponent(
      `From: ${name} <${email}>\n` +
      `Date: ${new Date().toLocaleString()}\n` +
      `Topic: ${subject}\n\n` +
      `${message}\n\n` +
      `---\n` +
      `Sent from DogFoodPlanner.com Contact Form\n` +
      `Please reply to: ${email}`
    );
    const mailtoUrl = `mailto:${RECIPIENT}?replyto=${encodeURIComponent(email)}&subject=${mailSubject}&body=${mailBody}`;

    if (successMsg) successMsg.classList.remove('hidden');
    window.location.href = mailtoUrl;
  });
</script>
