---
import Layout from '../layouts/Layout.astro'; import Navbar from './Navbar.astro'; import Breadcrumbs from './Breadcrumbs.astro'; import Footer from './Footer.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils'; import { ui, type Lang } from '../i18n/ui'; import { getPageTranslations } from '../i18n/pages';
const { lang } = Astro.props as { lang: Lang }; const strings = ui[lang] || ui.en; const t = useTranslations(lang); const path = useTranslatedPath(lang); const p = getPageTranslations(lang).contact;
---
<Layout lang={lang} title={strings['contact.title']} description={strings['contact.desc']}>
  <Navbar />
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs items={[{ name: t('nav.brand'), url: path('/') }, { name: t('footer.linkContact') }]} />
    <section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex font-mono text-xs uppercase font-medium px-3 py-1 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] mb-3 bg-[#fafafa] dark:bg-[#141414] shadow-2xs">{p.eyebrow}</div>
        <h1 class="text-[1.65rem] sm:text-4xl font-semibold text-[#171717] dark:text-[#ededed] text-balance leading-tight">{strings['contact.title']}</h1>
        <p class="mt-4 text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">{strings['contact.desc']}</p>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <div class="grid md:grid-cols-3 gap-4 md:gap-6 mb-10">
        {p.cards.map((card) => (
          <article class="hairline-card p-5 bg-white dark:bg-[#141414] space-y-2">
            <div class="text-xl">{card.icon}</div>
            <h2 class="font-bold text-sm text-[#171717] dark:text-[#ededed] mt-1">{card.title}</h2>
            <p class="text-xs text-[#8f8f8f] dark:text-[#737373]">{card.desc}</p>
            <a href={`mailto:${card.email}`} class="font-mono text-xs text-[#0070f3] dark:text-[#3291ff] hover:underline block">{card.email}</a>
          </article>
        ))}
      </div>

      <section class="max-w-3xl mx-auto">
        <div class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]">
          <h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.formTitle}</h2>
          <p class="mt-2 text-xs text-[#8f8f8f] dark:text-[#737373] mb-6">{p.formDesc}</p>

          <form id="locale-contact-form" method="POST" action="mailto:hello@dogfoodplanner.com" enctype="text/plain" class="mt-5 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label class="block">
                <span class="block text-xs font-mono uppercase font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">{p.nameLabel}</span>
                <input required type="text" name="Name" placeholder={p.namePlaceholder} class="mt-1 w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] transition-all" />
              </label>
              <label class="block">
                <span class="block text-xs font-mono uppercase font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">{p.emailLabel}</span>
                <input required type="email" name="From" placeholder={p.emailPlaceholder} class="mt-1 w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] transition-all" />
              </label>
            </div>
            <label class="block">
              <span class="block text-xs font-mono uppercase font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">{p.subjectLabel}</span>
              <select name="Subject" class="mt-1 w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] transition-all">
                {p.subjectOptions.map((option) => <option>{option}</option>)}
              </select>
            </label>
            <label class="block">
              <span class="block text-xs font-mono uppercase font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">{p.messageLabel}</span>
              <textarea required rows="5" name="Message" placeholder={p.messagePlaceholder} class="mt-1 w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] transition-all resize-none"></textarea>
            </label>

            <div id="locale-contact-success" class="hidden p-3.5 bg-[#10b981]/10 border border-[#10b981]/30 rounded-lg text-[11px] leading-relaxed">
              <div class="font-semibold text-[#10b981] mb-1">✓ Message prepared — sending to hello@dogfoodplanner.com</div>
              <div class="text-[#4d4d4d] dark:text-[#a1a1a1]">
                Your email client should open with a pre-drafted message addressed to <a href="mailto:hello@dogfoodplanner.com?subject=DogFoodPlanner%20Contact%20Inquiry" class="underline text-[#0070f3] dark:text-[#3291ff] font-mono">hello@dogfoodplanner.com</a>. Just hit <strong>Send</strong> in your email app and it will arrive in our inbox.
              </div>
            </div>

            <button type="submit" class="px-6 py-2.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] hover:bg-[#333333] dark:hover:bg-[#e5e5e5] text-xs font-semibold transition-all cursor-pointer shadow-sm w-full sm:w-auto">
              {p.submitBtn}
            </button>
            <p class="mt-5 text-amber-700 dark:text-amber-400 text-[11px] leading-relaxed">{p.notice}</p>
          </form>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById('locale-contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('locale-contact-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const RECIPIENT = 'hello@dogfoodplanner.com';
    const getVal = (n: string) => (form.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement)?.value?.trim() || '';
    const name = getVal('Name');
    const email = getVal('From');
    const subject = getVal('Subject') || 'Contact Inquiry';
    const message = getVal('Message');

    const mailSubject = encodeURIComponent(`[DogFoodPlanner Contact] ${subject} — ${name}`);
    const mailBody = encodeURIComponent(
      `From: ${name} <${email}>\n` +
      `Date: ${new Date().toLocaleString()}\n` +
      `Topic: ${subject}\n\n` +
      `${message}\n\n` +
      `---\n` +
      `Sent from DogFoodPlanner.com Contact Form\n` +
      `Please reply to: ${email}`
    );
    const mailtoUrl = `mailto:${RECIPIENT}?replyto=${encodeURIComponent(email)}&subject=${mailSubject}&body=${mailBody}`;

    if (successMsg) successMsg.classList.remove('hidden');
    window.location.href = mailtoUrl;
  });
</script>
