---
import ComparisonTable from './ComparisonTable.astro';
import AffiliateButton from './AffiliateButton.astro';
import { getPageTranslations } from '../i18n/pages';
import { getLangFromUrl } from '../i18n/utils';
import { getPrimaryBrandProduct } from '../data/affiliates';

const { kind } = Astro.props as { kind: 'bestFood' | 'recipes' | 'toxic' | 'brands' | 'allergies' };
const p = getPageTranslations(getLangFromUrl(Astro.url))[kind] as any;
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-8 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
  {kind === 'bestFood' && <>
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">{p.rankingsTitle}</h2>
      <p>{p.rankingsIntro}</p>
      <div class="space-y-3">{p.rankings.map((item: any) => { const rankProd = getPrimaryBrandProduct(item.title); return <article class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626]"><div class="flex justify-between gap-3"><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.rank}. {item.title}</h3><span class="font-mono text-[#0070f3]">{item.score}</span></div><p class="mt-2">{item.pros}</p><p class="mt-1 text-[#8f8f8f]">{item.cons}</p>{rankProd && <div class="mt-3 pt-2 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between gap-3"><p class="text-[11px] text-[#8f8f8f] dark:text-[#737373] flex-1 min-w-0 truncate">{rankProd.name}</p><AffiliateButton url={rankProd.url} label="Buy Now" size="sm" class="shrink-0" /></div>}</article>; })}</div>
    </section>
    <ComparisonTable />
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-3"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.buyerGuideTitle}</h2>{p.buyerRules.map((item: any) => <div><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.title}</h3><p>{item.desc}</p></div>)}</section>
  </>}

  {kind === 'recipes' && <>
    <aside class="p-6 bg-[#fffbeb] dark:bg-[#291f05] border border-[#fef08a] dark:border-[#854d0e] rounded-2xl"><h2 class="font-bold text-amber-800 dark:text-amber-300">⚠️ {p.calciumWarningTitle}</h2><p class="mt-2 text-amber-900 dark:text-amber-200">{p.calciumWarningDesc}</p></aside>

    {/* Calcium supplement — the #1 missing nutrient in any homemade boneless recipe */}
    <div class="hairline-card p-5 bg-white dark:bg-[#141414] flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <p class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373] mb-1">🛒 Essential for every homemade recipe</p>
        <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">U.S.A. Eggshell Powder, 8oz — Calcium Supplement</p>
        <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">Add ½ tsp per pound of boneless meat to balance the Ca:P ratio — the most critical step in any homemade dog food recipe.</p>
      </div>
      <AffiliateButton url="https://amzn.to/4haNVWy" label="Buy Now" size="sm" class="shrink-0 mt-1" />
    </div>

    {p.recipesList.map((recipe: any, idx: number) => {
      // Per-recipe affiliate products matched to the recipe's key ingredient
      const recipeAffiliates: Record<number, { name: string; note: string; url: string }> = {
        0: { name: 'Zesty Paws Wild Alaskan Salmon Oil for Dogs & Cats, 16oz', note: 'The omega-3 supplement for this recipe — add after cooling to preserve EPA/DHA fatty acids.', url: 'https://amzn.to/46HCJdW' },
        1: { name: 'Brutus Broth Chicken Bone Broth — Hip & Joint Meal Topper, 16.9 fl oz', note: 'Add warm bone broth to this recipe for extra collagen, hydration, and palatability.', url: 'https://amzn.to/4zSd7Zb' },
        2: { name: "Stella & Chewy's Freeze-Dried Raw Beef Meal Mixers — 95% Grass-Fed Beef, Organs & Bone, 1oz", note: 'Convenient freeze-dried organ meat topper — the beef liver & heart this recipe calls for, ready to crumble in.', url: 'https://amzn.to/4gyO85G' },
      };
      const prod = recipeAffiliates[idx];
      return <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
        <span class="font-mono text-xs text-[#7928ca]">{recipe.tag}</span>
        <h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{recipe.title}</h2>
        <p>{recipe.desc}</p>
        <ul class="space-y-1">{recipe.ingredients.map((ingredient: any) => {
          const hasLink = typeof ingredient === 'object' && ingredient.affiliateUrl;
          const label = typeof ingredient === 'string' ? ingredient : ingredient.name || ingredient;
          return <li class="flex items-center justify-between gap-3 py-1 border-b border-[#ebebeb] dark:border-[#262626] last:border-0">
            <span class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">{label}</span>
            {hasLink && <AffiliateButton url={ingredient.affiliateUrl} label="Buy →" size="sm" class="shrink-0 text-[10px] py-0.5 px-2" />}
          </li>;
        })}</ul>
        <p>{recipe.prep}</p>
        {prod && (
          <div class="mt-4 pt-4 border-t border-[#ebebeb] dark:border-[#262626] flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <p class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373] mb-1">🛒 Recommended for this recipe</p>
              <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">{prod.name}</p>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">{prod.note}</p>
            </div>
            <AffiliateButton url={prod.url} label="Buy Now" size="sm" class="shrink-0 mt-1" />
          </div>
        )}
      </section>
    })}
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-3"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.calciumGuideTitle}</h2>{p.calciumGuideItems.map((item: any) => <div><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.title} — {item.ratio}</h3><p>{item.desc}</p></div>)}</section>

    {/* Calcium guide bottom CTA */}
    <div class="hairline-card p-5 bg-white dark:bg-[#141414] flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <p class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373] mb-1">🛒 Seaweed calcium alternative</p>
        <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">Animal Essentials Sea-Cal — Pure Seaweed Calcium Powder, 12oz</p>
        <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">Vegan Icelandic seaweed calcium with magnesium — the plant-based alternative to eggshell powder for bone & joint health.</p>
      </div>
      <AffiliateButton url="https://amzn.to/4gRALwj" label="Buy Now" size="sm" class="shrink-0 mt-1" />
    </div>
  </>}

  {kind === 'toxic' && <>
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4"><h2 class="text-xl font-bold text-[#e11d48] dark:text-[#f43f5e]">☠️ {p.dangerTitle}</h2><p>{p.dangerIntro}</p><div class="grid sm:grid-cols-2 gap-3">{p.dangerList.map((item: any) => <article class="p-4 bg-red-50/50 dark:bg-red-950/30 rounded-xl"><h3 class="font-bold text-red-900 dark:text-red-200">{item.name}</h3><p>{item.toxin}</p><p>{item.symptoms}</p><strong>{item.risk}</strong></article>)}</div></section>
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.emergencyTitle}</h2><ol class="list-decimal pl-5 mt-3 space-y-2">{p.emergencySteps.map((item: string) => <li>{item}</li>)}</ol></section>
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]">
      <h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.safeTitle}</h2>
      <p class="mt-2">{p.safeIntro}</p>
      <div class="grid sm:grid-cols-2 gap-3 mt-4">{p.safeFoods.map((item: any) => <div><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.name}</h3><p>{item.benefit}</p></div>)}</div>

      {/* Safe-food affiliate products — whole food ingredients that are safe & beneficial */}
      <div class="mt-6 pt-5 border-t border-[#ebebeb] dark:border-[#262626] space-y-4">
        <p class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373]">🛒 Safe & beneficial ingredients — available on Amazon</p>

        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">Libby's 100% Pure Canned Pumpkin, 15oz (Pack of 5)</p>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">Pure pumpkin — one of the safest, most beneficial foods for dogs. Soluble fiber for digestion, beta-carotene for immunity.</p>
          </div>
          <AffiliateButton url="https://amzn.to/4xINd8W" label="Buy Now" size="sm" class="shrink-0 mt-1" />
        </div>

        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">Wild Planet Wild Sardines in Water, No Salt Added, 4.4oz (Pack of 12)</p>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">Safe whole-food omega-3 source — wild sardines in water (no salt) are one of the healthiest additions to any dog's bowl.</p>
          </div>
          <AffiliateButton url="https://amzn.to/4xg3W2h" label="Buy Now" size="sm" class="shrink-0 mt-1" />
        </div>

        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">Zesty Paws Wild Alaskan Salmon Oil for Dogs & Cats, 16oz</p>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">Safe omega-3 supplement — EPA/DHA for skin, coat, joints, and anti-inflammatory support. A safe daily addition to any meal.</p>
          </div>
          <AffiliateButton url="https://amzn.to/46HCJdW" label="Buy Now" size="sm" class="shrink-0 mt-1" />
        </div>
      </div>
    </section>
  </>}

  {kind === 'brands' && <><section class="space-y-4">{p.brandsList.map((brand: any) => { const brandProd = getPrimaryBrandProduct(brand.name); return <article class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><div class="flex justify-between gap-3"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{brand.name}</h2><span class="font-mono text-[#0070f3]">{brand.grade}</span></div><p class="mt-3">{brand.pros}</p><p class="mt-2">{brand.cons}</p><p class="mt-2 font-medium">{brand.verdict}</p>{brandProd && <div class="mt-3 pt-3 border-t border-[#ebebeb] dark:border-[#262626] flex items-start justify-between gap-3"><div class="flex-1 min-w-0"><p class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373]">Available on Amazon</p><p class="text-xs font-semibold text-[#171717] dark:text-[#ededed] leading-snug mt-0.5 line-clamp-2">{brandProd.name}</p></div><AffiliateButton url={brandProd.url} label="Buy Now" size="sm" class="shrink-0 mt-1" /></div>}</article>; })}</section><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.recallsTitle}</h2><p class="mt-2">{p.recallsDesc}</p></section><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.methodTitle}</h2>{p.methodPillars.map((item: any) => <div class="mt-3"><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.title}</h3><p>{item.desc}</p></div>)}</section></>}

  {kind === 'allergies' && <><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.allergensTitle}</h2><p class="mt-2">{p.allergensIntro}</p>{p.allergensList.map((item: any) => <div class="mt-3"><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.name}</h3><p>{item.desc}</p></div>)}</section><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.eliminationTitle}</h2>{p.eliminationSteps.map((item: any) => <div class="mt-4"><span class="font-mono text-[#0070f3]">{item.step}</span><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.title}</h3><p>{item.desc}</p></div>)}</section><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.novelTitle}</h2>{p.novelProteins.map((item: any) => <div class="mt-3"><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.name}</h3><p>{item.desc}</p></div>)}<div class="mt-6 pt-5 border-t border-[#ebebeb] dark:border-[#262626] flex items-start justify-between gap-4"><div class="flex-1 min-w-0"><p class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373] mb-1">Recommended for elimination diets</p><p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">Royal Canin Veterinary Diet Hydrolyzed Protein Adult, 25.3lb</p><p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">Vet-grade hydrolyzed protein — the gold standard for food allergy elimination trials.</p></div><AffiliateButton url="https://amzn.to/4ykV9Nk" label="Buy Now" size="sm" class="shrink-0 mt-1" /></div></section></>}
</div>
