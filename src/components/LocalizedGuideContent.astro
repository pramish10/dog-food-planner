---
import AffiliateButton from './AffiliateButton.astro';
import { getPageTranslations } from '../i18n/pages';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { getPrimaryBrandProduct } from '../data/affiliates';
import { BEST_FOOD_RANKING_SLUGS } from '../data/bestFoodRankings';
import { getFeedingStyles, FEEDING_STYLES_SECTION_I18N } from '../data/feedingStyles';
import { GOLDEN_RULE_SLUGS } from '../data/goldenRules';
import { getSensitiveStomachPillars, SENSITIVE_STOMACH_SECTION_I18N } from '../data/sensitiveStomach';
import { getPuppyNutritionRequirements, PUPPY_NUTRITION_SECTION_I18N } from '../data/puppyNutrition';
import { getRecipeBlueprints, RECIPE_BLUEPRINT_SECTION_I18N } from '../data/recipeBlueprint';
import {
  HOMEMADE_RECIPE_SLUGS,
  HOMEMADE_RECIPES,
  HOMEMADE_RECIPES_PAGE_I18N,
} from '../data/homemadeRecipes';

const { kind } = Astro.props as { kind: 'bestFood' | 'recipes' | 'toxic' | 'brands' | 'allergies' };
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const p = getPageTranslations(lang)[kind] as any;
const feedingStyles = getFeedingStyles(lang);
const fsI18n = FEEDING_STYLES_SECTION_I18N[lang] || FEEDING_STYLES_SECTION_I18N.en;
const sensitivePillars = getSensitiveStomachPillars(lang);
const ssI18n = SENSITIVE_STOMACH_SECTION_I18N[lang] || SENSITIVE_STOMACH_SECTION_I18N.en;
const puppyRequirements = getPuppyNutritionRequirements(lang);
const pnI18n = PUPPY_NUTRITION_SECTION_I18N[lang] || PUPPY_NUTRITION_SECTION_I18N.en;
const recipeBlueprints = getRecipeBlueprints(lang);
const rbI18n = RECIPE_BLUEPRINT_SECTION_I18N[lang] || RECIPE_BLUEPRINT_SECTION_I18N.en;
const flagshipBlueprint = recipeBlueprints[0];
const hrI18n = HOMEMADE_RECIPES_PAGE_I18N[lang] || HOMEMADE_RECIPES_PAGE_I18N.en;
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-8 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
  {kind === 'bestFood' && <>

    {/* ── 1. Top 5 Rankings ── */}
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">{p.rankingsTitle}</h2>
      <p>{p.rankingsIntro}</p>
      <div class="space-y-3">
        {p.rankings.map((item: any, idx: number) => {
          const rankProd = getPrimaryBrandProduct(item.title);
          const detailSlug = BEST_FOOD_RANKING_SLUGS[idx];
          return (
            <article class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626]">
              <div class="flex justify-between gap-3">
                <h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.rank}. {item.title}</h3>
                <span class="font-mono text-[#0070f3] shrink-0">{item.score}</span>
              </div>
              <p class="mt-2">{item.pros}</p>
              <p class="mt-1 text-[#8f8f8f]">{item.cons}</p>
              {item.readMore && detailSlug && (
                <a
                  href={translatePath(`/best-dog-food/${detailSlug}`)}
                  class="mt-3 inline-flex items-center gap-1 text-[11px] font-semibold text-[#0070f3] hover:text-[#005ac2]"
                >
                  {p.readMoreLabel || 'Read more →'}
                </a>
              )}
              {rankProd && (
                <div class="mt-3 pt-2 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between gap-3">
                  <p class="text-[11px] text-[#8f8f8f] dark:text-[#737373] flex-1 min-w-0 truncate">{rankProd.name}</p>
                  <AffiliateButton url={rankProd.url} label="Buy Now" size="sm" class="shrink-0" />
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>

    {/* ── 2. Fresh vs Raw vs Kibble ── */}
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
        {fsI18n.title}
      </h2>
      <p>{fsI18n.intro}</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-2">
        {feedingStyles.map((style) => (
          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex flex-col">
            <div class="font-mono text-xs font-bold uppercase mb-1" style={`color: ${style.accent}`}>{style.optionLabel}</div>
            <h3 class="font-semibold text-sm text-[#171717] dark:text-[#ededed] mb-2">{style.title}</h3>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed flex-1">{style.summary}</p>
            <a
              href={translatePath(`/best-dog-food/feeding-style/${style.slug}`)}
              class="mt-3 inline-flex items-center gap-1 text-[11px] font-semibold text-[#0070f3] hover:text-[#005ac2]"
            >
              {fsI18n.readMoreBtn}
            </a>
          </div>
        ))}
      </div>
      <p class="text-xs text-[#8f8f8f] dark:text-[#737373]">{fsI18n.footerText} <a href={translatePath('/dog-food-recipes')} class="text-[#0070f3] dark:text-[#3291ff] font-semibold underline">{fsI18n.footerLink}</a>.</p>
    </section>

    {/* ── 3. Buyer Guide ── */}
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
      <h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.buyerGuideTitle}</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {p.buyerRules.map((item: any, idx: number) => {
          const ruleSlug = GOLDEN_RULE_SLUGS[idx];
          return (
            <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex flex-col justify-between">
              <div>
                <h3 class="font-bold text-[#171717] dark:text-[#ededed] mb-1">{item.title}</h3>
                <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">{item.desc}</p>
              </div>
              {ruleSlug && (
                <a
                  href={translatePath(`/best-dog-food/golden-rules/${ruleSlug}`)}
                  class="mt-3 inline-flex items-center gap-1 text-[11px] font-semibold text-[#0070f3] hover:text-[#005ac2] dark:text-[#3291ff] dark:hover:text-[#60a5fa]"
                >
                  {p.readMoreLabel || 'Read more →'}
                </a>
              )}
            </div>
          );
        })}
      </div>
    </section>

    {/* ── 4. Sensitive Stomach & Allergies ── */}
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-3">
      <h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{ssI18n.title}</h2>
      <p>{ssI18n.intro}</p>
      <div class="grid sm:grid-cols-3 gap-3 mt-2">
        {sensitivePillars.map((pillar) => (
          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex flex-col justify-between">
            <div>
              <h3 class="font-bold text-sm text-[#171717] dark:text-[#ededed] mb-1">{pillar.title}</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">{pillar.desc}</p>
            </div>
            <a
              href={translatePath(`/best-dog-food/sensitive-stomach/${pillar.slug}`)}
              class="mt-3 inline-flex items-center gap-1 text-[11px] font-semibold text-[#0070f3] hover:text-[#005ac2] dark:text-[#3291ff] dark:hover:text-[#60a5fa]"
            >
              {ssI18n.readMoreBtn}
            </a>
          </div>
        ))}
      </div>
      <p class="text-xs text-[#8f8f8f] dark:text-[#737373]">{ssI18n.footerText} <a href={translatePath('/dog-food-allergies')} class="text-[#0070f3] dark:text-[#3291ff] font-semibold underline">{ssI18n.footerLink}</a>.</p>
    </section>

    {/* ── 5. Puppy Nutrition ── */}
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">{pnI18n.title}</h2>
        <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">{pnI18n.intro}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
        {puppyRequirements.map((req) => (
          <article class="p-5 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex flex-col justify-between">
            <div>
              <h3 class="font-bold text-sm sm:text-base text-[#171717] dark:text-[#ededed] mb-2 leading-snug">
                {req.title}
              </h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
                {req.desc}
              </p>
            </div>
            <a
              href={translatePath(`/best-dog-food/puppy-nutrition/${req.slug}`)}
              class="mt-4 inline-flex items-center gap-1 text-[11px] font-semibold text-[#0070f3] hover:text-[#005ac2] dark:text-[#3291ff] dark:hover:text-[#60a5fa] group"
            >
              <span>{pnI18n.readMoreBtn}</span>
            </a>
          </article>
        ))}
      </div>

      <p class="text-xs text-[#8f8f8f] dark:text-[#737373] pt-2">
        {pnI18n.footerText} <a href={translatePath('/#planner-section')} class="text-[#0070f3] dark:text-[#3291ff] font-semibold underline">{pnI18n.footerLink}</a>.
      </p>
    </section>

    {/* ── 6. DIY Recipe Blueprint ── */}
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">{rbI18n.title}</h2>
        <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">{rbI18n.intro}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
        {recipeBlueprints.map((blueprint) => (
          <article class="p-5 sm:p-6 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center gap-1.5 font-mono text-[11px] text-[#0070f3] dark:text-[#3291ff] bg-blue-50 dark:bg-blue-950/60 border border-blue-100 dark:border-blue-900/60 px-2.5 py-0.5 rounded-full mb-3">
                <span>{blueprint.badge}</span>
              </div>
              <h3 class="font-bold text-base sm:text-lg text-[#171717] dark:text-[#ededed] mb-2 leading-snug">
                {blueprint.name}
              </h3>
              <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
                {blueprint.shortDesc}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-[#ebebeb] dark:border-[#262626] flex flex-wrap items-center justify-between gap-3">
              <a
                href={translatePath(`/best-dog-food/recipe-blueprint/${blueprint.slug}`)}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0070f3] hover:text-[#005ac2] dark:text-[#3291ff] dark:hover:text-[#60a5fa] group"
              >
                <span>{rbI18n.readMoreBtn}</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <p class="text-xs text-[#8f8f8f] dark:text-[#737373] pt-2">
        {rbI18n.footerText} <a href={translatePath('/#planner-section')} class="text-[#0070f3] dark:text-[#3291ff] font-semibold underline">{rbI18n.footerLink}</a>.
      </p>
    </section>


  </>}

  {kind === 'recipes' && <>
    <aside class="p-6 bg-[#fffbeb] dark:bg-[#291f05] border border-[#fef08a] dark:border-[#854d0e] rounded-2xl">
      <h2 class="font-bold text-amber-800 dark:text-amber-300">⚠️ {p.calciumWarningTitle}</h2>
      <p class="mt-2 text-amber-900 dark:text-amber-200">{p.calciumWarningDesc}</p>
    </aside>

    {p.recipesList.map((recipe: any, idx: number) => {
      const slug = HOMEMADE_RECIPE_SLUGS[idx] || 'gently-cooked-turkey-pumpkin';
      const richRecipe = HOMEMADE_RECIPES[slug];
      return (
        <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span
              class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold tracking-wide"
              style={richRecipe ? `background-color: ${richRecipe.colorTheme.tagBg}; color: ${richRecipe.colorTheme.tagText};` : 'background-color: #f3e8ff; color: #7e22ce;'}
            >
              {recipe.tag}
            </span>
            {richRecipe && (
              <span class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373]">
                {richRecipe.prepTime} • {richRecipe.lifeStage.split('(')[0].trim()}
              </span>
            )}
          </div>

          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed] leading-snug">
              {recipe.title}
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              {recipe.desc}
            </p>
          </div>

          {/* Streamlined Key Ingredients Preview */}
          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] space-y-2">
            <p class="text-[11px] font-mono uppercase tracking-wider font-semibold text-[#8f8f8f] dark:text-[#737373]">
              Key Ingredients Preview:
            </p>
            <ul class="grid sm:grid-cols-2 gap-1.5 text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">
              {recipe.ingredients.slice(0, 4).map((ingredient: any) => {
                const label = typeof ingredient === 'string' ? ingredient : ingredient.name || ingredient;
                return (
                  <li class="flex items-center gap-1.5 truncate">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3] shrink-0"></span>
                    <span class="truncate">{label}</span>
                  </li>
                );
              })}
            </ul>
            {recipe.ingredients.length > 4 && (
              <p class="text-[11px] text-[#8f8f8f] dark:text-[#737373] italic pt-1">
                + {recipe.ingredients.length - 4} more balanced whole-food essentials & micro-nutrients
              </p>
            )}
          </div>

          <div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-[#ebebeb] dark:border-[#262626]">
            <a
              href={translatePath(`/dog-food-recipes/${slug}`)}
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#0070f3] dark:text-[#3291ff] hover:text-[#005ac2] dark:hover:text-[#60a5fa] group transition-colors"
            >
              <span>{hrI18n.readMoreBtn}</span>
              <span class="transform group-hover:translate-x-1 transition-transform">→</span>
            </a>
            {richRecipe && (
              <span class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373]">
                {richRecipe.macroProfile.caPhosphorusRatio.split('(')[0].trim()}
              </span>
            )}
          </div>
        </section>
      );
    })}
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-3"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.calciumGuideTitle}</h2>{p.calciumGuideItems.map((item: any) => <div><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.title} — {item.ratio}</h3><p>{item.desc}</p></div>)}</section>
  </>}

  {kind === 'toxic' && <>
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4"><h2 class="text-xl font-bold text-[#e11d48] dark:text-[#f43f5e]">☠️ {p.dangerTitle}</h2><p>{p.dangerIntro}</p><div class="grid sm:grid-cols-2 gap-3">{p.dangerList.map((item: any) => <article class="p-4 bg-red-50/50 dark:bg-red-950/30 rounded-xl"><h3 class="font-bold text-red-900 dark:text-red-200">{item.name}</h3><p>{item.toxin}</p><p>{item.symptoms}</p><strong>{item.risk}</strong></article>)}</div></section>
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.emergencyTitle}</h2><ol class="list-decimal pl-5 mt-3 space-y-2">{p.emergencySteps.map((item: string) => <li>{item}</li>)}</ol></section>
    <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]">
      <h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.safeTitle}</h2>
      <p class="mt-2">{p.safeIntro}</p>
      <div class="grid sm:grid-cols-2 gap-3 mt-4">{p.safeFoods.map((item: any) => <div><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.name}</h3><p>{item.benefit}</p></div>)}</div>

      {/* Safe-food affiliate products — whole food ingredients that are safe & beneficial */}
      <div class="mt-6 pt-5 border-t border-[#ebebeb] dark:border-[#262626] space-y-4">
        <p class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373]">🛒 Safe & beneficial ingredients — available on Amazon</p>

        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">Libby's 100% Pure Canned Pumpkin, 15oz (Pack of 5)</p>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">Pure pumpkin — one of the safest, most beneficial foods for dogs. Soluble fiber for digestion, beta-carotene for immunity.</p>
          </div>
          <AffiliateButton url="https://amzn.to/4xINd8W" label="Buy Now" size="sm" class="shrink-0 mt-1" />
        </div>

        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">Wild Planet Wild Sardines in Water, No Salt Added, 4.4oz (Pack of 12)</p>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">Safe whole-food omega-3 source — wild sardines in water (no salt) are one of the healthiest additions to any dog's bowl.</p>
          </div>
          <AffiliateButton url="https://amzn.to/4xg3W2h" label="Buy Now" size="sm" class="shrink-0 mt-1" />
        </div>

        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">Zesty Paws Wild Alaskan Salmon Oil for Dogs & Cats, 16oz</p>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">Safe omega-3 supplement — EPA/DHA for skin, coat, joints, and anti-inflammatory support. A safe daily addition to any meal.</p>
          </div>
          <AffiliateButton url="https://amzn.to/46HCJdW" label="Buy Now" size="sm" class="shrink-0 mt-1" />
        </div>
      </div>
    </section>
  </>}

  {kind === 'brands' && <><section class="space-y-4">{p.brandsList.map((brand: any) => { const brandProd = getPrimaryBrandProduct(brand.name); return <article class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><div class="flex justify-between gap-3"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{brand.name}</h2><span class="font-mono text-[#0070f3]">{brand.grade}</span></div><p class="mt-3">{brand.pros}</p><p class="mt-2">{brand.cons}</p><p class="mt-2 font-medium">{brand.verdict}</p>{brandProd && <div class="mt-3 pt-3 border-t border-[#ebebeb] dark:border-[#262626] flex items-start justify-between gap-3"><div class="flex-1 min-w-0"><p class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373]">Available on Amazon</p><p class="text-xs font-semibold text-[#171717] dark:text-[#ededed] leading-snug mt-0.5 line-clamp-2">{brandProd.name}</p></div><AffiliateButton url={brandProd.url} label="Buy Now" size="sm" class="shrink-0 mt-1" /></div>}</article>; })}</section><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.recallsTitle}</h2><p class="mt-2">{p.recallsDesc}</p></section><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.methodTitle}</h2>{p.methodPillars.map((item: any) => <div class="mt-3"><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.title}</h3><p>{item.desc}</p></div>)}</section></>}

  {kind === 'allergies' && <><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.allergensTitle}</h2><p class="mt-2">{p.allergensIntro}</p>{p.allergensList.map((item: any) => <div class="mt-3"><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.name}</h3><p>{item.desc}</p></div>)}</section><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.eliminationTitle}</h2>{p.eliminationSteps.map((item: any) => <div class="mt-4"><span class="font-mono text-[#0070f3]">{item.step}</span><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.title}</h3><p>{item.desc}</p></div>)}</section><section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]"><h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">{p.novelTitle}</h2>{p.novelProteins.map((item: any) => <div class="mt-3"><h3 class="font-bold text-[#171717] dark:text-[#ededed]">{item.name}</h3><p>{item.desc}</p></div>)}<div class="mt-6 pt-5 border-t border-[#ebebeb] dark:border-[#262626] flex items-start justify-between gap-4"><div class="flex-1 min-w-0"><p class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373] mb-1">Recommended for elimination diets</p><p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">Royal Canin Veterinary Diet Hydrolyzed Protein Adult, 25.3lb</p><p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">Vet-grade hydrolyzed protein — the gold standard for food allergy elimination trials.</p></div><AffiliateButton url="https://amzn.to/4ykV9Nk" label="Buy Now" size="sm" class="shrink-0 mt-1" /></div></section></>}
