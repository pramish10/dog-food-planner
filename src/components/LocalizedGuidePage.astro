---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Footer from './Footer.astro';
import LocalizedGuideContent from './LocalizedGuideContent.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import { ui, type Lang } from '../i18n/ui';
import { getPageTranslations } from '../i18n/pages';
const { lang, kind, titleKey, navKey } = Astro.props as { lang: Lang; kind: 'bestFood' | 'recipes' | 'toxic' | 'brands' | 'allergies'; titleKey: keyof typeof ui.en; navKey: keyof typeof ui.en };
const strings = ui[lang] || ui.en;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const page = getPageTranslations(lang)[kind] as any;
const descriptionKey = titleKey.replace('.title', '.desc') as keyof typeof ui.en;
---
<Layout lang={lang} title={strings[titleKey]} description={strings[descriptionKey]}>
  <Navbar />
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs items={[{ name: t('nav.brand'), url: translatePath('/') }, { name: t(navKey) }]} />
    <section class="py-10 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]"><div class="max-w-4xl mx-auto px-4 sm:px-6 text-center min-w-0"><div class="inline-flex items-center gap-1.5 font-mono text-[10px] sm:text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs max-w-full">{page.eyebrow}</div><h1 class="text-[1.65rem] sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4 text-balance leading-tight">{page.heroTitle || strings[titleKey]}</h1><p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed text-pretty">{page.heroSubtitle || strings[descriptionKey]}</p></div></section>
    <LocalizedGuideContent kind={kind} />
  </main>
  <Footer />
</Layout>
