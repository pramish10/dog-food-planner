---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Footer from './Footer.astro';
import LocalizedGuideContent from './LocalizedGuideContent.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import { ui, type Lang } from '../i18n/ui';
import { getPageTranslations } from '../i18n/pages';
const { lang, kind, titleKey, navKey } = Astro.props as { lang: Lang; kind: 'bestFood' | 'recipes' | 'toxic' | 'brands' | 'allergies'; titleKey: keyof typeof ui.en; navKey: keyof typeof ui.en };
const strings = ui[lang] || ui.en;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const page = getPageTranslations(lang)[kind] as any;
const descriptionKey = titleKey.replace('.title', '.desc') as keyof typeof ui.en;
---
<Layout lang={lang} title={strings[titleKey]} description={strings[descriptionKey]}>
  <Navbar />
  <main class="min-h-screen page-warm-bg">
    <Breadcrumbs items={[{ name: t('nav.brand'), url: translatePath('/') }, { name: t(navKey) }]} />
    <section class="relative py-10 sm:py-16 border-b border-[#f0d5a8] dark:border-[#3a2510] overflow-hidden">
      <!-- Warm glow -->
      <div class="absolute inset-0 pointer-events-none z-0">
        <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-[500px] h-48 rounded-full opacity-50" style="background: radial-gradient(ellipse at 50% 0%, rgba(196,122,43,0.15) 0%, transparent 70%); filter: blur(35px);"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center min-w-0">
        <div class="inline-flex items-center gap-1.5 font-mono text-[10px] sm:text-xs uppercase font-bold text-[#92400e] dark:text-[#d97706] bg-[#fdf3e7] dark:bg-[#2a1a08] border border-[#f0d5a8] dark:border-[#3a2510] px-3 py-1 rounded-full mb-4 max-w-full">
          {page.eyebrow}
        </div>
        <h1 class="text-[1.65rem] sm:text-4xl lg:text-5xl font-extrabold text-[#1c0f00] dark:text-[#fde8c8] tracking-tight mb-4 text-balance leading-tight">
          {t(navKey)}
        </h1>
        <p class="text-sm sm:text-base text-[#6b4226] dark:text-[#c4956a] max-w-2xl mx-auto leading-relaxed text-pretty">
          {page.heroSubtitle || strings[descriptionKey]}
        </p>
      </div>
    </section>
    <LocalizedGuideContent kind={kind} />
  </main>
  <Footer />
</Layout>

<style>
  .page-warm-bg {
    background: linear-gradient(160deg, #fff8f0 0%, #fef3e2 60%, #fff0e6 100%);
  }
  html.dark .page-warm-bg {
    background: linear-gradient(160deg, #150d04 0%, #1c1005 60%, #1a0e04 100%);
  }
</style>
