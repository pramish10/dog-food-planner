---
import { getPageTranslations } from '../i18n/pages';
import { getLangFromUrl } from '../i18n/utils';
const { kind } = Astro.props as { kind: 'privacy' | 'terms' };
const p = getPageTranslations(getLangFromUrl(Astro.url))[kind];
---
<div class="relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute top-24 -right-20 w-[500px] h-[500px] rounded-full opacity-35"
      style="background: radial-gradient(circle, rgba(234,179,8,0.12) 0%, rgba(196,122,43,0.06) 40%, transparent 70%); filter: blur(50px);"></div>
    <div class="absolute top-1/2 -left-20 w-[500px] h-[500px] rounded-full opacity-35"
      style="background: radial-gradient(circle, rgba(196,122,43,0.12) 0%, rgba(255,200,100,0.06) 40%, transparent 70%); filter: blur(50px);"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-12 space-y-6 text-xs sm:text-sm text-[#6b4226] dark:text-[#c4956a] leading-relaxed">
    <div class="flex flex-wrap items-center justify-between gap-2 p-3.5 bg-white/85 dark:bg-[#1c1208]/85 backdrop-blur-sm rounded-xl border border-[#f0d5a8] dark:border-[#3a2510] text-[#8f5e35] dark:text-[#c4956a] font-mono text-xs shadow-2xs">
      <span>📅 {p.lastUpdated}</span>
      <span>🔒 DogFoodPlanner Official Legal Notice</span>
    </div>

    {p.intro && (
      <div class="p-5 sm:p-6 bg-white/85 dark:bg-[#1c1208]/85 backdrop-blur-sm rounded-2xl border border-[#f0d5a8] dark:border-[#3a2510] text-sm text-[#1c0f00] dark:text-[#fde8c8] font-medium leading-relaxed shadow-xs">
        {p.intro}
      </div>
    )}

    {p.sections.map((section) => (
      <section class="hairline-card p-6 sm:p-8 bg-white/85 dark:bg-[#1c1208]/85 backdrop-blur-sm border border-[#f0d5a8] dark:border-[#3a2510] rounded-2xl space-y-3 shadow-xs">
        <h2 class="text-lg sm:text-xl font-bold text-[#1c0f00] dark:text-[#fde8c8] border-b border-[#f0d5a8]/60 dark:border-[#3a2510] pb-2.5">
          {section.title}
        </h2>
        <p class="text-xs sm:text-sm text-[#6b4226] dark:text-[#c4956a] leading-relaxed whitespace-pre-line">
          {section.content}
        </p>
      </section>
    ))}
  </div>
</div>
