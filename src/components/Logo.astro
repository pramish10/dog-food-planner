---
interface Props {
  class?: string;
}

const { class: className = 'w-8 h-8' } = Astro.props;
---

<div
  class:list={[
    'aspect-square overflow-hidden flex justify-center items-center bg-black dark:bg-[#ededed] text-white dark:text-[#171717] shrink-0',
    className,
  ]}
  style="border-radius: 10.17%;"
>
  <!-- Lucide paw-print: white outline on black rounded square -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.21"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="w-[75.3%] h-[75.3%]"
    aria-hidden="true"
  >
    <circle cx="11" cy="4" r="2"></circle>
    <circle cx="18" cy="8" r="2"></circle>
    <circle cx="20" cy="16" r="2"></circle>
    <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path>
  </svg>
</div>
