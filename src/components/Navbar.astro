---
import LanguagePicker from './LanguagePicker.astro';
import Logo from './Logo.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, cleanPathname } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentPath = Astro.url.pathname;
const cleanPath = cleanPathname(currentPath);

const isBestFoodActive = cleanPath.startsWith('/best-dog-food');
const isRecipesActive = cleanPath.startsWith('/dog-food-recipes');
const isToxicFoodsActive = cleanPath.startsWith('/toxic-foods');
const isBrandsActive = cleanPath.startsWith('/dog-food-brands');
const isFaqActive = cleanPath.startsWith('/faq');
const isAllergiesActive = cleanPath.startsWith('/dog-food-allergies');
const isCalculatorActive = cleanPath.startsWith('/feeding-calculator');
const isHomeActive = cleanPath === '/';
---

<header class="bg-[#fff8f0]/95 dark:bg-[#150d04]/95 backdrop-blur-md border-b border-[#f0d5a8] dark:border-[#3a2510] transition-colors pt-[env(safe-area-inset-top)] sticky top-0 z-50">

  <!-- ── Main row ─────────────────────────────────────────────────── -->
  <div class="max-w-6xl mx-auto w-full min-w-0 pl-[max(0.75rem,env(safe-area-inset-left))] pr-[max(0.75rem,env(safe-area-inset-right))] sm:px-6 h-12 sm:h-14 lg:h-16 flex items-center gap-2 sm:gap-3">

    <!-- Brand Logo -->
    <a href={translatePath('/')} class="flex items-end gap-1.5 sm:gap-2 group shrink-0 h-8 sm:h-9">
      <Logo class="size-7 sm:size-7.5 lg:size-8 shadow-sm group-hover:scale-105 transition-transform" />
      <div class="flex flex-col min-w-0 justify-center leading-none">
        <div class="flex items-center min-w-0">
          <!-- On mobile: show a compact "DFP" abbreviation; sm+ show full brand name -->
          <span class="font-bold text-[11px] xs:text-[12px] sm:text-[13px] lg:text-base text-[#1c0f00] dark:text-[#fde8c8] tracking-tight whitespace-nowrap">
            <span class="inline sm:hidden">DFP</span>
            <span class="hidden sm:inline">{t('nav.brand')}</span>
          </span>
        </div>
        <span class="text-[10px] text-[#a16207] dark:text-[#92400e] font-mono mt-0.5 hidden md:block truncate">{t('nav.subbrand')}</span>
      </div>
    </a>

    <!-- Desktop Nav Links (lg+) -->
    <nav class="hidden lg:flex items-center gap-0.5 ml-2">
      <a
        href={translatePath('/best-dog-food')}
        class:list={[
          "text-xs px-3 py-1.5 rounded-full transition-all duration-150 font-medium",
          isBestFoodActive
            ? "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#1c0f00] dark:text-[#fde8c8] font-semibold"
            : "text-[#6b4226] dark:text-[#c4956a] hover:text-[#92400e] dark:hover:text-[#f59e0b] hover:bg-[#fdf3e7] dark:hover:bg-[#2a1a08]"
        ]}
        aria-current={isBestFoodActive ? 'page' : undefined}
      >{t('nav.bestDogFood')}</a>

      <a
        href={translatePath('/dog-food-recipes')}
        class:list={[
          "text-xs px-3 py-1.5 rounded-full transition-all duration-150 font-medium",
          isRecipesActive
            ? "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#1c0f00] dark:text-[#fde8c8] font-semibold"
            : "text-[#6b4226] dark:text-[#c4956a] hover:text-[#92400e] dark:hover:text-[#f59e0b] hover:bg-[#fdf3e7] dark:hover:bg-[#2a1a08]"
        ]}
        aria-current={isRecipesActive ? 'page' : undefined}
      >{t('nav.recipes')}</a>

      <a
        href={translatePath('/toxic-foods')}
        class:list={[
          "text-xs px-3 py-1.5 rounded-full transition-all duration-150 font-medium",
          isToxicFoodsActive
            ? "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#1c0f00] dark:text-[#fde8c8] font-semibold"
            : "text-[#6b4226] dark:text-[#c4956a] hover:text-[#92400e] dark:hover:text-[#f59e0b] hover:bg-[#fdf3e7] dark:hover:bg-[#2a1a08]"
        ]}
        aria-current={isToxicFoodsActive ? 'page' : undefined}
      >{t('nav.toxicFoods')}</a>

      <a
        href={translatePath('/dog-food-brands')}
        class:list={[
          "text-xs px-3 py-1.5 rounded-full transition-all duration-150 font-medium",
          isBrandsActive
            ? "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#1c0f00] dark:text-[#fde8c8] font-semibold"
            : "text-[#6b4226] dark:text-[#c4956a] hover:text-[#92400e] dark:hover:text-[#f59e0b] hover:bg-[#fdf3e7] dark:hover:bg-[#2a1a08]"
        ]}
        aria-current={isBrandsActive ? 'page' : undefined}
      >{t('nav.brands')}</a>

      <a
        href={translatePath('/faq')}
        class:list={[
          "text-xs px-3 py-1.5 rounded-full transition-all duration-150 font-medium",
          isFaqActive
            ? "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#1c0f00] dark:text-[#fde8c8] font-semibold"
            : "text-[#6b4226] dark:text-[#c4956a] hover:text-[#92400e] dark:hover:text-[#f59e0b] hover:bg-[#fdf3e7] dark:hover:bg-[#2a1a08]"
        ]}
        aria-current={isFaqActive ? 'page' : undefined}
      >{t('nav.faqs')}</a>
    </nav>

    <!-- Right-side actions -->
    <div class="flex items-end gap-2 sm:gap-2.5 lg:gap-3 shrink-0 ml-auto">

      <!-- Language Switcher (decreased height h-7 sm:h-8) -->
      <LanguagePicker variant="navbar" />

      <!-- Theme Toggle (decreased height h-7 sm:h-8, aligned to bottom) -->
      <button
        type="button"
        id="theme-toggle-btn"
        aria-label="Toggle light and dark mode"
        class="theme-toggle inline-flex items-center justify-center h-7 sm:h-8 px-2 sm:px-2.5 text-[#6b4226] dark:text-[#fde8c8] hover:text-[#92400e] dark:hover:text-[#f59e0b] bg-[#fff8f0] dark:bg-[#1c1208] hover:bg-[#fdf3e7] dark:hover:bg-[#2a1a08] rounded-full border border-[#f0d5a8] dark:border-[#3a2510] shadow-xs hover:shadow-sm transition-all cursor-pointer shrink-0"
      >
        <svg class="theme-sun-icon w-3.5 h-3.5 sm:w-4 sm:h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg class="theme-moon-icon w-3.5 h-3.5 sm:w-4 sm:h-4 block dark:hidden text-[#6b4226]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/>
        </svg>
      </button>

      <!-- Plan Bowl CTA (h-8 sm:h-9, bottom-aligned with theme and language) -->
      <a
        href={translatePath('/#planner-section')}
        class="inline-flex items-center justify-center h-8 sm:h-9 text-[11px] sm:text-xs font-bold text-white active:scale-[0.98] transition-all px-3 sm:px-4 rounded-full shadow-md whitespace-nowrap shrink-0"
        style="background: linear-gradient(135deg, #c47a2b 0%, #e8a44a 100%); box-shadow: 0 3px 12px rgba(196,122,43,0.35);"
      >
        <span>{t('nav.planBowl')}</span>
        <svg class="w-3 h-3 ml-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      </a>

    </div>
  </div>

  <!-- ── Mobile quick-nav strip (visible on < lg) ── -->
  <div id="mobile-quicknav" class="lg:hidden border-t border-[#f0d5a8] dark:border-[#3a2510] bg-[#fff8f0]/95 dark:bg-[#150d04]/95">
    <div class="flex overflow-x-auto scrollbar-hide gap-1 pl-[max(0.75rem,env(safe-area-inset-left))] pr-[max(0.75rem,env(safe-area-inset-right))] py-1.5" style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;">
      <a
        href={translatePath('/#planner-section')}
        class:list={[
          "quicknav-link flex-none text-[11px] font-semibold px-2.5 py-1 rounded-full whitespace-nowrap transition-all duration-150 scroll-snap-align-start",
          isHomeActive || isCalculatorActive
            ? "text-white"
            : "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#6b4226] dark:text-[#c4956a]"
        ]}
        style={isHomeActive || isCalculatorActive ? "background: linear-gradient(135deg, #c47a2b 0%, #e8a44a 100%);" : ""}
      >🐕 {t('nav.calculator')}</a>

      <a
        href={translatePath('/best-dog-food')}
        class:list={[
          "quicknav-link flex-none text-[11px] font-medium px-2.5 py-1 rounded-full whitespace-nowrap transition-all duration-150",
          isBestFoodActive
            ? "text-white font-semibold"
            : "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#6b4226] dark:text-[#c4956a]"
        ]}
        style={isBestFoodActive ? "background: linear-gradient(135deg, #c47a2b 0%, #e8a44a 100%);" : ""}
        aria-current={isBestFoodActive ? 'page' : undefined}
      >🏆 {t('nav.bestDogFood')}</a>

      <a
        href={translatePath('/dog-food-recipes')}
        class:list={[
          "quicknav-link flex-none text-[11px] font-medium px-2.5 py-1 rounded-full whitespace-nowrap transition-all duration-150",
          isRecipesActive
            ? "text-white font-semibold"
            : "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#6b4226] dark:text-[#c4956a]"
        ]}
        style={isRecipesActive ? "background: linear-gradient(135deg, #c47a2b 0%, #e8a44a 100%);" : ""}
        aria-current={isRecipesActive ? 'page' : undefined}
      >🍲 {t('nav.recipes')}</a>

      <a
        href={translatePath('/dog-food-allergies')}
        class:list={[
          "quicknav-link flex-none text-[11px] font-medium px-2.5 py-1 rounded-full whitespace-nowrap transition-all duration-150",
          isAllergiesActive
            ? "text-white font-semibold"
            : "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#6b4226] dark:text-[#c4956a]"
        ]}
        style={isAllergiesActive ? "background: linear-gradient(135deg, #c47a2b 0%, #e8a44a 100%);" : ""}
        aria-current={isAllergiesActive ? 'page' : undefined}
      >🛡️ {t('nav.allergies')}</a>

      <a
        href={translatePath('/toxic-foods')}
        class:list={[
          "quicknav-link flex-none text-[11px] font-medium px-2.5 py-1 rounded-full whitespace-nowrap transition-all duration-150",
          isToxicFoodsActive
            ? "text-white font-semibold"
            : "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#6b4226] dark:text-[#c4956a]"
        ]}
        style={isToxicFoodsActive ? "background: linear-gradient(135deg, #c47a2b 0%, #e8a44a 100%);" : ""}
        aria-current={isToxicFoodsActive ? 'page' : undefined}
      >☠ {t('nav.toxicFoods')}</a>

      <a
        href={translatePath('/dog-food-brands')}
        class:list={[
          "quicknav-link flex-none text-[11px] font-medium px-2.5 py-1 rounded-full whitespace-nowrap transition-all duration-150",
          isBrandsActive
            ? "text-white font-semibold"
            : "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#6b4226] dark:text-[#c4956a]"
        ]}
        style={isBrandsActive ? "background: linear-gradient(135deg, #c47a2b 0%, #e8a44a 100%);" : ""}
        aria-current={isBrandsActive ? 'page' : undefined}
      >⭐ {t('nav.brands')}</a>

      <a
        href={translatePath('/faq')}
        class:list={[
          "quicknav-link flex-none text-[11px] font-medium px-2.5 py-1 rounded-full whitespace-nowrap transition-all duration-150",
          isFaqActive
            ? "text-white font-semibold"
            : "bg-[#f0d5a8]/60 dark:bg-[#3a2510]/60 text-[#6b4226] dark:text-[#c4956a]"
        ]}
        style={isFaqActive ? "background: linear-gradient(135deg, #c47a2b 0%, #e8a44a 100%);" : ""}
        aria-current={isFaqActive ? 'page' : undefined}
      >❓ {t('nav.faqs')}</a>
    </div>
  </div>

</header>

<script is:inline>
  function setupNavbar() {
    // Scroll active quicknav pill into view on page load
    const activeQuickLink = document.querySelector('.quicknav-link[aria-current="page"]');
    activeQuickLink?.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' });

    // Theme toggle
    document.querySelectorAll('.theme-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>

<style>
  /* Hide scrollbar on quick-nav strip while keeping scroll functionality */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
