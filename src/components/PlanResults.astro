    // Render custom dynamic items for AM (no emojis)
    const amItemsHtml = amCustomItems.map((item, index) => `
      <li class="flex items-center gap-1.5 text-xs sm:text-sm text-[#1c0f00] dark:text-[#fde8c8] group py-1.5 ${index === 0 ? 'mt-3.5 pt-3 border-t border-[#f0d5a8]/70 dark:border-[#3a2510]/70 print:mt-4 print:pt-3.5 print:border-black/40' : 'mt-1.5 print:mt-2.5'}">
        <span class="text-[#c47a2b] font-bold shrink-0">•</span>
        <div class="inline-flex items-center flex-wrap gap-x-1.5 gap-y-1 min-w-0 leading-relaxed">
          <strong class="text-[#1c0f00] dark:text-[#fde8c8] font-mono shrink-0">${item.dose}</strong>
          <a href="${item.url}" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-[#1c0f00] dark:text-[#fde8c8] underline decoration-black dark:decoration-zinc-300 decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
            <span>${item.name}</span>
          </a>
          <button type="button" data-remove-bowl="am" data-item-index="${index}" class="remove-ingredient-btn inline-flex items-center justify-center w-4 h-4 rounded text-[#92400e]/50 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer shrink-0 ml-1 no-print" title="Remove ingredient" aria-label="Remove ${item.name}">
            <svg class="w-3 h-3 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </li>
    `).join('');

    // Render custom dynamic items for PM (no emojis)
    const pmItemsHtml = pmCustomItems.map((item, index) => `
      <li class="flex items-center gap-1.5 text-xs sm:text-sm text-[#1c0f00] dark:text-[#fde8c8] group py-1.5 ${index === 0 ? 'mt-3.5 pt-3 border-t border-[#f0d5a8]/70 dark:border-[#3a2510]/70 print:mt-4 print:pt-3.5 print:border-black/40' : 'mt-1.5 print:mt-2.5'}">
        <span class="text-[#c47a2b] font-bold shrink-0">•</span>
        <div class="inline-flex items-center flex-wrap gap-x-1.5 gap-y-1 min-w-0 leading-relaxed">
          <strong class="text-[#1c0f00] dark:text-[#fde8c8] font-mono shrink-0">${item.dose}</strong>
          <a href="${item.url}" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-[#1c0f00] dark:text-[#fde8c8] underline decoration-black dark:decoration-zinc-300 decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
            <span>${item.name}</span>
          </a>
          <button type="button" data-remove-bowl="pm" data-item-index="${index}" class="remove-ingredient-btn inline-flex items-center justify-center w-4 h-4 rounded text-[#92400e]/50 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer shrink-0 ml-1 no-print" title="Remove ingredient" aria-label="Remove ${item.name}">
            <svg class="w-3 h-3 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </li>
    `).join('');

    const medsHtml = profile.hasMeds
      ? `
        <li class="flex items-start gap-2 text-xs text-[#16a34a] font-semibold">
          <span>•</span>
          <span>[ ] Daily Medication (Administer in morning bowl)</span>
        </li>
      `
      : '';

    if (amList) {
      amList.innerHTML = baseItemHtml + amItemsHtml + medsHtml;
    }
    if (pmList) {
      pmList.innerHTML = baseItemHtml + pmItemsHtml;
    }

    // Attach remove handlers
    document.querySelectorAll('.remove-ingredient-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const bowl = (btn as HTMLElement).dataset.removeBowl;
        const index = parseInt((btn as HTMLElement).dataset.itemIndex || '-1', 10);
        if (index >= 0) {
          if (bowl === 'am') amCustomItems.splice(index, 1);
          if (bowl === 'pm') pmCustomItems.splice(index, 1);
          renderBowlsOnly(profile, lang);
          saveCurrentState();
        }
      });
    });

    // Render the single '+' Add extra ingredient buttons for AM & PM
    renderAddButton('am', profile);
    renderAddButton('pm', profile);
  }

  // Renders the single initial '+' button or inline search box
  function renderAddButton(bowl: 'am' | 'pm', profile: any) {
    const container = document.getElementById(`${bowl}-add-container`);
    if (!container) return;

    container.innerHTML = `
      <div class="add-wrapper relative">
        <button type="button" class="open-search-btn text-xs font-semibold text-[#c47a2b] hover:text-[#92400e] dark:hover:text-[#fde8c8] flex items-center gap-1.5 py-0.5 px-1 rounded-md hover:bg-amber-50 dark:hover:bg-amber-950/30 transition-all cursor-pointer">
          <span class="w-3.5 h-3.5 rounded-full border border-[#c47a2b] flex items-center justify-center font-bold text-[11px] leading-none">+</span>
          <span>Add extra ingredient</span>
        </button>
      </div>
    `;

    const btn = container.querySelector('.open-search-btn');
    btn?.addEventListener('click', () => {
      openSearchInterface(bowl, profile);
    });
  }

  function openSearchInterface(bowl: 'am' | 'pm', profile: any) {
    const container = document.getElementById(`${bowl}-add-container`);
    if (!container) return;

    container.innerHTML = `
      <div class="relative w-full">
        <div class="flex items-center gap-1.5">
          <div class="relative flex-1 flex items-center">
            <input type="text" class="ingredient-search-input w-full pl-2.5 pr-8 py-1 text-xs bg-white dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-lg text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b]" placeholder="Type ingredient" autocomplete="off" />
            <button type="button" class="cancel-search-btn absolute right-1.5 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center text-[#92400e] dark:text-[#c4956a] hover:text-[#c47a2b] dark:hover:text-[#fde8c8] rounded hover:bg-amber-100/50 dark:hover:bg-amber-950/40 transition-colors cursor-pointer" title="Cancel">
              <svg class="w-3.5 h-3.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>
        <!-- Suggestions dropdown (starts hidden, only shows as user types) -->
        <div class="ingredient-suggestions hidden absolute z-30 left-0 right-0 top-full mt-1 bg-white dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl shadow-lg max-h-48 overflow-y-auto p-1 divide-y divide-[#f0d5a8]/30 dark:divide-[#3a2510]/30">
        </div>
      </div>
    `;

    const input = container.querySelector('.ingredient-search-input') as HTMLInputElement | null;
    const cancelBtn = container.querySelector('.cancel-search-btn');
    const suggestions = container.querySelector('.ingredient-suggestions') as HTMLElement | null;

    if (input) {
      input.focus();

      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        if (!query || !suggestions) {
          suggestions?.classList.add('hidden');
          return;
        }

        const matches = INGREDIENTS_CATALOG.filter(item =>
          item.name.toLowerCase().includes(query)
        );

        if (matches.length === 0) {
          suggestions.innerHTML = `
            <div class="px-3 py-2 text-xs text-[#92400e] dark:text-[#c4956a]">
              No matching dog-safe food found. Try pumpkin, egg, blueberries, kefir...
            </div>
          `;
          suggestions.classList.remove('hidden');
          return;
        }

        const weightLbs = profile.weightLbs || 45;
        const stage = profile.ageStage || 'adult';
        const goal = profile.targetGoal || 'maintain';

        suggestions.innerHTML = matches.map(item => {
          const dose = item.calculateDose(weightLbs, stage, goal);
          return `
            <button type="button" data-pick-id="${item.id}" class="pick-item-btn w-full text-left px-2.5 py-1.5 text-xs rounded-lg hover:bg-amber-50 dark:hover:bg-amber-950/40 flex items-center justify-between transition-colors cursor-pointer">
              <span class="font-semibold text-[#1c0f00] dark:text-[#fde8c8]">${item.name}</span>
              <span class="font-mono text-[10px] text-[#c47a2b] font-bold">${dose}</span>
            </button>
          `;
        }).join('');

        suggestions.classList.remove('hidden');

        // Click on suggestion
        suggestions.querySelectorAll('.pick-item-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const pickId = (btn as HTMLElement).dataset.pickId;
            const pickedItem = INGREDIENTS_CATALOG.find(i => i.id === pickId);
            if (!pickedItem) return;

            const dose = pickedItem.calculateDose(weightLbs, stage, goal);
            const newItem: BowlCustomItem = {
              id: pickedItem.id,
              name: pickedItem.name,
              icon: '',
              dose,
              url: pickedItem.affiliateUrl,
            };

            if (bowl === 'am') amCustomItems.push(newItem);
            if (bowl === 'pm') pmCustomItems.push(newItem);

            renderBowlsOnly(profile, getCurrentLang());
            saveCurrentState();
          });
        });
      });
    }

    cancelBtn?.addEventListener('click', () => {
      renderAddButton(bowl, profile);
    });
  }

  function saveCurrentState() {
    if (!currentProfile) return;
    const note1 = (document.getElementById('sitter-note-input') as HTMLInputElement)?.value;
    const note2 = (document.getElementById('sitter-note-input-2') as HTMLInputElement)?.value;
    const note3 = (document.getElementById('sitter-note-input-3') as HTMLInputElement)?.value;
    const vetPhone = (document.getElementById('vet-phone-input') as HTMLInputElement)?.value;
    const amTime = (document.getElementById('am-time-input') as HTMLInputElement)?.value;
    const pmTime = (document.getElementById('pm-time-input') as HTMLInputElement)?.value;
    sessionStorage.setItem(
      RESULTS_STATE_KEY,
      JSON.stringify({
        profile: currentProfile,
        diet: currentProfile.currentDiet || 'fresh',
        amCustomItems,
        pmCustomItems,
        sitterNote1: note1,
        sitterNote2: note2,
        sitterNote3: note3,
        vetPhone,
        amTime,
        pmTime,
      })
    );
  }

  function renderResults(profile: any, dietOverride?: string, shouldScroll: boolean = true) {
    const lang = getCurrentLang();
    const result = calculateCanineNutrition(profile);
    const diet = dietOverride || profile.dietPreference || 'fresh';

    const section = document.getElementById('results-section') as HTMLElement;
    section.classList.remove('hidden');
    if (shouldScroll) {
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    const plannerSection = document.getElementById('planner-section') as HTMLElement;
    if (plannerSection) plannerSection.classList.add('hidden');

    const dogName = result.dogName || 'Lucy';
    const breed = profile.breed || 'Dog';
    const weightDisplay = profile.weightLbs ? `${Math.round(profile.weightLbs)} lbs` : `${result.weightKg} kg`;

    document.querySelectorAll('#card-dog-name').forEach(el => el.textContent = dogName);

    // Card Header
    const cardBreed = document.getElementById('card-dog-breed');
    if (cardBreed) cardBreed.textContent = breed;
    const cardWeight = document.getElementById('card-dog-weight');
    if (cardWeight) cardWeight.textContent = weightDisplay;
    const cardStage = document.getElementById('card-dog-stage');
    if (cardStage) {
      const stage = profile.ageStage || 'adult';
      cardStage.textContent = stage.includes('puppy') ? 'Puppy' : (stage === 'senior' ? 'Senior' : 'Adult');
    }
    const cardDiet = document.getElementById('card-dog-diet');
    if (cardDiet) cardDiet.textContent = getDietDisplayName(profile.currentDiet || profile.dietPreference, lang);
    const cardKcal = document.getElementById('card-dog-kcal');
    if (cardKcal) cardKcal.textContent = `${result.merKcal.toLocaleString(lang)} kcal/day`;

    // Allergies banner
    const allergyBanner = document.getElementById('card-allergy-banner');
    const noAllergyBanner = document.getElementById('card-no-allergy-banner');
    const allergiesList = document.getElementById('card-allergies-list');
    const cleanAllergies = (profile.allergies || []).filter((a: string) => a !== 'none / no allergies');

    if (cleanAllergies.length > 0) {
      allergyBanner?.classList.remove('hidden');
      noAllergyBanner?.classList.add('hidden');
      if (allergiesList) allergiesList.textContent = `Strictly Avoid: ${cleanAllergies.join(', ')}`;
    } else {
      allergyBanner?.classList.add('hidden');
      noAllergyBanner?.classList.remove('hidden');
    }

    // Treat Limit & breakdown (Daily treat cap text removed, Training Bites with exact link)
    const treatLimitEl = document.getElementById('card-treat-limit');
    if (treatLimitEl) treatLimitEl.textContent = String(result.treatKcal);
    const treatBreakdown = document.getElementById('card-treat-breakdown');
    const treatPiecesEl = document.getElementById('card-treat-pieces');
    const trainingBitesCount = Math.max(2, Math.round(result.treatKcal / 10));
    const smallBiscuitsCount = Math.max(1, Math.round(result.treatKcal / 35));

    if (treatBreakdown) {
      treatBreakdown.innerHTML = `<a href="https://link.amazon/B0h2wswVk" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-[#1c0f00] dark:text-[#fde8c8] underline decoration-black dark:decoration-zinc-300 decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">Training Bites</a>`;
    }
    if (treatPiecesEl) {
      treatPiecesEl.textContent = `~${trainingBitesCount} training bites OR ${smallBiscuitsCount} small biscuits`;
    }

    // Weekly checklist table
    const table = document.getElementById('weekly-checklist-table');
    if (table) {
      table.innerHTML = renderWeeklyChecklist(Boolean(profile.hasMeds), lang);
    }


    // Initialize custom bowl items if not restored from session
    if (!sessionStorage.getItem(RESULTS_STATE_KEY)) {
      const weightLbs = profile.weightLbs || 45;
      const stage = profile.ageStage || 'adult';
      const goal = profile.targetGoal || 'maintain';

      // AM default: Salmon Oil
      const salmonItem = INGREDIENTS_CATALOG.find(i => i.id === 'salmon-oil');
      amCustomItems = salmonItem ? [{
        id: salmonItem.id,
        name: salmonItem.name,
        icon: '',
        dose: salmonItem.calculateDose(weightLbs, stage, goal),
        url: salmonItem.affiliateUrl,
      }] : [];

      // PM default: Pumpkin Puree (or Joint Chew for senior)
      const pmTargetId = stage === 'senior' ? 'joint-chew' : 'pumpkin';
      const pmItem = INGREDIENTS_CATALOG.find(i => i.id === pmTargetId);
      pmCustomItems = pmItem ? [{
        id: pmItem.id,
        name: pmItem.name,
        icon: '',
        dose: pmItem.calculateDose(weightLbs, stage, goal),
        url: pmItem.affiliateUrl,
      }] : [];
    }

    // Render bowls & initial '+' buttons
    renderBowlsOnly(profile, lang);

    currentProfile = profile;
    saveCurrentState();
    ensureCardLinksOpenNewTab();
  }

  function ensureCardLinksOpenNewTab() {
    document.querySelectorAll('#fridge-planner-card a').forEach((link) => {
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener noreferrer sponsored');
    });
  }

  function restoreResultsState() {
    const raw = sessionStorage.getItem(RESULTS_STATE_KEY);
    if (!raw) return;
    try {
      const state = JSON.parse(raw);
      if (!state?.profile) return;
      currentProfile = state.profile;
      if (Array.isArray(state.amCustomItems)) amCustomItems = state.amCustomItems;
      if (Array.isArray(state.pmCustomItems)) pmCustomItems = state.pmCustomItems;
      renderResults(currentProfile, state.diet || 'fresh', false);
      if (state.sitterNote1 !== undefined) {
        const el = document.getElementById('sitter-note-input') as HTMLInputElement | null;
        if (el) el.value = state.sitterNote1;
      }
      if (state.sitterNote2 !== undefined) {
        const el = document.getElementById('sitter-note-input-2') as HTMLInputElement | null;
        if (el) el.value = state.sitterNote2;
      }
      if (state.sitterNote3 !== undefined) {
        const el = document.getElementById('sitter-note-input-3') as HTMLInputElement | null;
        if (el) el.value = state.sitterNote3;
      }
      if (state.vetPhone !== undefined) {
        const el = document.getElementById('vet-phone-input') as HTMLInputElement | null;
        if (el) el.value = state.vetPhone;
      }
      if (state.amTime !== undefined) {
        const el = document.getElementById('am-time-input') as HTMLInputElement | null;
        if (el) el.value = state.amTime;
      }
      if (state.pmTime !== undefined) {
        const el = document.getElementById('pm-time-input') as HTMLInputElement | null;
        if (el) el.value = state.pmTime;
      }
      ensureCardLinksOpenNewTab();
    } catch {
      sessionStorage.removeItem(RESULTS_STATE_KEY);
    }
  }

  function startOver() {
    sessionStorage.removeItem(RESULTS_STATE_KEY);
    currentProfile = null;
    amCustomItems = [];
    pmCustomItems = [];
    const note1 = document.getElementById('sitter-note-input') as HTMLInputElement | null;
    if (note1) { note1.value = 'Fresh water changed 2x daily. Rest 30m before walks.'; note1.setAttribute('value', note1.value); }
    const note2 = document.getElementById('sitter-note-input-2') as HTMLInputElement | null;
    if (note2) { note2.value = ''; note2.setAttribute('value', ''); }
    const note3 = document.getElementById('sitter-note-input-3') as HTMLInputElement | null;
    if (note3) { note3.value = ''; note3.setAttribute('value', ''); }
    document.getElementById('results-section')?.classList.add('hidden');
    const plannerSection = document.getElementById('planner-section');
    if (plannerSection) {
      plannerSection.classList.remove('hidden');
      document.dispatchEvent(new CustomEvent('dogPlannerReset'));
      plannerSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function syncPrintInputs() {
    ['sitter-note-input', 'sitter-note-input-2', 'sitter-note-input-3', 'vet-phone-input', 'am-time-input', 'pm-time-input'].forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.setAttribute('value', el.value);
    });
  }

  function printPlan() {
    ensureCardLinksOpenNewTab();
    syncPrintInputs();
    document.body.classList.add('printing-plan');
    window.print();
  }

  window.addEventListener('beforeprint', () => {
    const results = document.getElementById('results-section');
    if (results && !results.classList.contains('hidden')) {
      syncPrintInputs();
      document.body.classList.add('printing-plan');
    }
  });

  window.addEventListener('afterprint', () => {
    document.body.classList.remove('printing-plan');
  });

  document.addEventListener('dogPlannerSubmit', (e: Event) => {
    const profile = (e as CustomEvent).detail;
    currentProfile = profile;
    amCustomItems = [];
    pmCustomItems = [];
    sessionStorage.removeItem(RESULTS_STATE_KEY);
    const note2 = document.getElementById('sitter-note-input-2') as HTMLInputElement | null;
    if (note2) { note2.value = ''; note2.setAttribute('value', ''); }
    const note3 = document.getElementById('sitter-note-input-3') as HTMLInputElement | null;
    if (note3) { note3.value = ''; note3.setAttribute('value', ''); }
    renderResults(profile);
  });

  document.querySelectorAll('.edit-plan-btn').forEach(btn => {
    btn.addEventListener('click', startOver);
  });
  document.querySelectorAll('.print-card-btn').forEach(btn => {
    btn.addEventListener('click', printPlan);
  });

  ['sitter-note-input', 'sitter-note-input-2', 'sitter-note-input-3', 'vet-phone-input', 'am-time-input', 'pm-time-input'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', () => {
      saveCurrentState();
    });
  });

  // Restore on page load if present
  restoreResultsState();
</script>
