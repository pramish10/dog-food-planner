        <span class="text-[#c47a2b] font-bold">•</span>
        <div class="leading-relaxed">
          <strong class="font-bold text-[#1c0f00] dark:text-[#fde8c8]">${perMealCups} ${tx.cupsUnit}</strong> (${perMealGrams}${tx.gramsUnit})
          <a href="${recipeUrl}" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-[#1c0f00] dark:text-[#fde8c8] underline decoration-black dark:decoration-zinc-300 decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
            <span>${recipe.title}</span>
