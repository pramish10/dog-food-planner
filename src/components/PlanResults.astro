  function renderPlan(profile: any) {
    const result = calculateCanineNutrition(profile);

    // Update Headings
    const dogNameEl = document.getElementById('res-dog-name');
    const subtitleEl = document.getElementById('res-dog-subtitle');
    const inlines = document.querySelectorAll('.res-dog-name-inline');
    
    if (dogNameEl) dogNameEl.textContent = result.dogName;
    inlines.forEach((el) => { el.textContent = result.dogName; });

    if (subtitleEl) {
      subtitleEl.textContent = `${profile.breed} · ${Math.round(profile.weightLbs)} lbs (${result.weightKg} kg) · Goal: ${profile.targetGoal.toUpperCase()}`;
    }

    // Update Top Metric Cards
    const merEl = document.getElementById('res-mer-calories');
    const rerEl = document.getElementById('res-rer-base');
    const dailyGramsEl = document.getElementById('res-daily-grams');
    const dailyCupsEl = document.getElementById('res-daily-cups');
    const perMealEl = document.getElementById('res-per-meal-grams');
    const mealsCountEl = document.getElementById('res-meals-count');
    const treatPctEl = document.getElementById('res-treat-pct');
    const treatKcalEl = document.getElementById('res-treat-kcal');

    if (merEl) merEl.innerHTML = `${result.merKcal} <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f]">kcal</span>`;
    if (rerEl) rerEl.textContent = `${result.rerKcal}`;
    if (dailyGramsEl) dailyGramsEl.innerHTML = `${result.activeDailyGrams} <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f]">grams</span>`;
    if (dailyCupsEl) dailyCupsEl.textContent = `${result.dailyCupsEst}`;
    if (perMealEl) perMealEl.innerHTML = `${result.perMealGrams} <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f]">g/bowl</span>`;
    if (mealsCountEl) mealsCountEl.textContent = `${result.mealsPerDay}x Daily`;
    if (treatPctEl) treatPctEl.textContent = `${profile.treatBudgetPct ?? 10}%`;
    if (treatKcalEl) treatKcalEl.innerHTML = `${result.treatKcal} <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f]">kcal/day</span>`;

    // Find Matching Recipe
    const recipe = selectRecipe(profile);
    if (!recipe) {
      const selectionSummary = document.getElementById('recipe-selection-summary');
      if (selectionSummary) selectionSummary.textContent = 'No recipe in this feeding style safely matches every selected sensitivity. Please choose another feeding style or ask your veterinarian for a formulated diet.';
      return;
    }

    const dietTagEl = document.getElementById('recipe-diet-tag');
    const recipeTitleEl = document.getElementById('recipe-title');
    const recipeDescEl = document.getElementById('recipe-description');
    const rowsContainer = document.getElementById('ingredient-rows-container');
    const prepContainer = document.getElementById('prep-steps-container');

    if (dietTagEl) dietTagEl.textContent = `TODAY'S RECIPE: ${recipe.dietType.replace('-', ' ')}`;
    if (recipeTitleEl) recipeTitleEl.textContent = recipe.name;
    if (recipeDescEl) recipeDescEl.textContent = recipe.description;

    const heroImg = document.getElementById('recipe-hero-img') as HTMLImageElement | null;
    if (heroImg && recipe) {
      heroImg.src = RECIPE_HERO_IMAGES[recipe.id] || 'https://images.unsplash.com/photo-1574672280600-4accfa5b6f98?auto=format&fit=crop&w=800&h=400&q=80';
      heroImg.alt = recipe.name;
    }

    const matchNote = document.getElementById('recipe-match-note');
    const avoidedAllergies = (profile.allergies || []).filter((allergy: string) => allergy !== 'none / no allergies');
    const selectionSummary = document.getElementById('recipe-selection-summary');
    const methodSummary = document.getElementById('recipe-method-summary');
    const dietName = recipe.dietType === 'fresh-cooked'
      ? 'fresh-cooked meals'
      : recipe.dietType === 'raw-barf'
        ? 'raw BARF meals'
        : 'a superfood topper';
    const proteinSelected = profile.proteinChoice && !profile.proteinChoice.includes('No Pref');
    const proteinReason = proteinSelected
      ? `You selected ${profile.proteinChoice}, and ${recipe.name} uses ${recipe.primaryProtein.toLowerCase()} as its main protein.`
      : `You selected a balanced protein choice, so we chose this lean ${recipe.primaryProtein.toLowerCase()} recipe as an everyday option.`;
    const healthReason = recipe.healthFocusMatches.includes(profile.healthFocus)
      ? `It supports your ${profile.healthFocus} focus.`
      : `It is the closest available match for your ${profile.healthFocus || 'General Health'} focus.`;
    const safetyReason = avoidedAllergies.length
      ? ` It also avoids your selected sensitivity: ${avoidedAllergies.join(', ')}.`
      : ' No ingredient sensitivities were selected.';
    const ageStageLabel = ({ 'puppy-early': 'early puppy growth stage', 'puppy-late': 'late puppy growth stage', adult: 'adult life stage', senior: 'senior life stage' } as Record<string, string>)[profile.ageStage] || profile.ageStage;
    const sensitivityReason = avoidedAllergies.length
      ? `The recipe excludes your reported sensitivities: ${avoidedAllergies.join(', ')}.`
      : 'No ingredient sensitivities were reported, so no ingredients needed to be excluded.';
    const energyReason = `Your daily starting amount is ${result.merKcal} kcal, calculated from a ${result.weightKg} kg dog in the ${ageStageLabel} with ${profile.activityLevel} activity and a ${profile.targetGoal} weight goal.`;
    const summary = `This ${dietName} recommendation was selected because you chose ${proteinSelected ? profile.proteinChoice : 'a balanced protein rotation'} and ${profile.healthFocus} as the health focus. ${proteinReason} ${healthReason} ${sensitivityReason} ${energyReason} Monitor body condition and adjust with your veterinarian as needed.`;
    if (matchNote) matchNote.textContent = `${recipe.primaryProtein} recipe selected for your answers.`;
    if (selectionSummary) selectionSummary.textContent = summary;
    if (methodSummary) methodSummary.textContent = 'Recipe matching uses feeding style first, removes selected sensitivities, then ranks the remaining recipes by protein preference, health focus, and energy density. Energy is a starting estimate; use a complete and balanced recipe formulated for your dog’s life stage and review it with your veterinarian for long-term feeding.';

    // Every bowl is derived from this exact recipe, not from a separate generic schedule.
    const timedContainer = document.getElementById('timed-schedule-container');
    if (timedContainer) {
      const mealLabels = result.mealsPerDay === 3
        ? [{ time: '07:30 AM', name: 'Breakfast bowl' }, { time: '01:00 PM', name: 'Midday bowl' }, { time: '06:30 PM', name: 'Dinner bowl' }]
        : [{ time: '07:30 AM', name: 'Morning bowl' }, { time: '06:30 PM', name: 'Evening bowl' }];
      const mealPortion = Math.round(result.activeDailyGrams / result.mealsPerDay);
      const ingredientRows = recipe.ingredients.map((ingredient) => {
        const amount = (result.activeDailyGrams * ingredient.percentage) / 100 / result.mealsPerDay;
        const formattedAmount = Number.isInteger(amount) ? amount.toString() : amount.toFixed(1);
        return `<li class="flex items-center justify-between gap-3 py-1.5 border-b border-[#ebebeb]/60 dark:border-[#2e2e2e] last:border-0"><span class="text-[#171717] dark:text-[#ededed] font-medium">${ingredient.name}</span><span class="shrink-0 font-mono text-[11px] font-bold text-[#0070f3] dark:text-[#3291ff]">${formattedAmount}g</span></li>`;
      }).join('');
      timedContainer.innerHTML = mealLabels.map((meal) => `
        <article class="p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#1a1a1a]">
          <div class="flex items-center justify-between gap-3 mb-2"><span class="font-mono text-xs font-bold text-[#171717] dark:text-[#ededed] bg-[#f2f2f2] dark:bg-[#262626] px-2 py-0.5 rounded">${meal.time}</span><span class="text-[10px] font-mono text-[#8f8f8f] dark:text-[#737373]">${mealPortion}g total</span></div>
          <h4 class="font-semibold text-sm text-[#171717] dark:text-[#ededed] mb-2">${meal.name}</h4>
          <ul class="text-xs">${ingredientRows}</ul>
        </article>
      `).join('');
    }

    // Render Ingredients with exact grams
    if (rowsContainer) {
      rowsContainer.innerHTML = '';
      recipe.ingredients.forEach((ing) => {
        const ingGrams = Math.round((result.activeDailyGrams * ing.percentage) / 100);
        const buyLinks = ingredientShoppingLinks(ing.name);
        const row = document.createElement('div');
        row.className = 'p-3 sm:p-3.5 bg-white dark:bg-[#141414] hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] flex flex-col sm:flex-row sm:items-center gap-3 text-xs transition-colors';
        row.innerHTML = `
          <img src="${INGREDIENT_IMAGES[ing.category]}" alt="${ing.name}" loading="lazy" class="w-12 h-12 rounded-md object-cover shrink-0 border border-[#ebebeb] dark:border-[#2e2e2e]" />
          <div class="flex items-center gap-2.5 min-w-0 flex-1">
            <span class="font-mono text-[10px] sm:text-[11px] font-bold text-[#171717] dark:text-[#ededed] bg-[#f2f2f2] dark:bg-[#262626] px-2 py-0.5 rounded shrink-0">${ingGrams}g</span>
            <div>
              <div class="font-medium text-[#171717] dark:text-[#ededed]">${ing.name}</div>
              <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373]">${ing.purpose}</div>
            </div>
          </div>
          <div class="flex items-center gap-2 sm:justify-end shrink-0">
            <span class="font-mono text-[9px] sm:text-[10px] uppercase text-[#8f8f8f] dark:text-[#737373] bg-[#fafafa] dark:bg-[#1f1f1f] border border-[#ebebeb] dark:border-[#2e2e2e] px-2 py-0.5 rounded hidden xs:inline-block">${ing.category}</span>
            <a href="${buyLinks.amazon}" target="_blank" rel="noopener noreferrer${buyLinks.isAffiliate ? ' nofollow' : ''}" class="no-print inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#0070f3] hover:bg-[#005ac2] text-white text-[11px] font-semibold transition-all shadow-xs active:scale-95 touch-manipulation">
              <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
              <span>Buy Now</span>
            </a>
          </div>
        `;
        rowsContainer.appendChild(row);
      });
    }

    // Render Preparation Notes
    if (prepContainer) {
      prepContainer.innerHTML = '';
      recipe.preparationNotes.forEach((step, idx) => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2';
        li.innerHTML = `
          <span class="font-mono font-bold text-[#171717] dark:text-[#ededed] bg-[#f2f2f2] dark:bg-[#262626] w-4 h-4 sm:w-5 sm:h-5 rounded-full flex items-center justify-center shrink-0 text-[9px] sm:text-[10px] mt-0.5">${idx + 1}</span>
          <span class="leading-relaxed text-[#4d4d4d] dark:text-[#a1a1a1]">${step}</span>
        `;
        prepContainer.appendChild(li);
      });
    }

    // Update Macros
    const protPctEl = document.getElementById('macro-protein-pct');
    const protBar = document.getElementById('macro-protein-bar');
    const fatPctEl = document.getElementById('macro-fat-pct');
    const fatBar = document.getElementById('macro-fat-bar');
    const fiberPctEl = document.getElementById('macro-fiber-pct');
    const fiberBar = document.getElementById('macro-fiber-bar');
    const moistPctEl = document.getElementById('macro-moisture-pct');
    const moistBar = document.getElementById('macro-moisture-bar');
    const caPhosEl = document.getElementById('ca-phos-ratio');

    if (protPctEl) protPctEl.textContent = `${recipe.macroProfile.proteinPct}%`;
    if (protBar) protBar.style.width = `${recipe.macroProfile.proteinPct}%`;

    if (fatPctEl) fatPctEl.textContent = `${recipe.macroProfile.fatPct}%`;
    if (fatBar) fatBar.style.width = `${recipe.macroProfile.fatPct}%`;

    if (fiberPctEl) fiberPctEl.textContent = `${recipe.macroProfile.carbsPct}%`;
    if (fiberBar) fiberBar.style.width = `${recipe.macroProfile.carbsPct * 4}%`;

    if (moistPctEl) moistPctEl.textContent = `${recipe.macroProfile.moisturePct}%`;
    if (moistBar) moistBar.style.width = `${recipe.macroProfile.moisturePct}%`;

    if (caPhosEl) caPhosEl.textContent = recipe.macroProfile.caPhosphorusRatio;

    renderPersonalizedAdvice(profile, result, recipe);
    renderBreedInsights(profile);
    renderHealthFocusTips(profile);
  }

  // Listen to plan generation events
  window.addEventListener('generate-plan', (e: any) => {
    currentProfile = e.detail;
    renderPlan(currentProfile);
  });

  // Diet tab switcher
  document.querySelectorAll('.diet-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!currentProfile) return;
      document.querySelectorAll('.diet-tab-btn').forEach((b) => {
        b.classList.remove('active', 'bg-white', 'dark:bg-[#262626]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
        b.classList.add('text-[#8f8f8f]', 'dark:text-[#737373]');
      });
      btn.classList.add('active', 'bg-white', 'dark:bg-[#262626]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
      btn.classList.remove('text-[#8f8f8f]', 'dark:text-[#737373]');

      const diet = btn.getAttribute('data-diet') || 'fresh-cooked';
      currentProfile.dietPreference = diet as any;
      renderPlan(currentProfile);
    });
  });

  // Download PDF button — triggers browser Save as PDF dialog
  document.getElementById('download-pdf-btn')?.addEventListener('click', () => {
    document.body.classList.add('printing-plan');
    window.print();
  });

  window.addEventListener('afterprint', () => document.body.classList.remove('printing-plan'));
</script>
