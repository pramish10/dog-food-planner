---
import { RECIPES } from '../data/recipes';
import { getLangFromUrl } from '../i18n/utils';
import { plannerTranslations } from '../i18n/planner';

const lang = getLangFromUrl(Astro.url);
const p = plannerTranslations[lang] || plannerTranslations.en;
---

<section id="results-section" class="py-10 sm:py-20 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626] transition-all hidden" data-lang={lang}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Results Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8 sm:mb-10 pb-6 border-b border-[#ebebeb] dark:border-[#262626]">
      <div>
        <div class="inline-flex items-center gap-1.5 font-mono text-[10px] sm:text-xs uppercase font-medium text-[#10b981] bg-[#10b981]/10 px-3 py-1 rounded-full mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
          {p.readyBadge}
        </div>
        <h2 class="text-2xl sm:text-4xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">
          {p.mealPlanFor} <span id="res-dog-name" class="text-[#0070f3] dark:text-[#3291ff]">Lucy</span>
        </h2>
        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-1" id="res-dog-subtitle">
          {p.planSubtitle}
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2 w-full sm:w-auto">
        <button 
          id="download-pdf-btn"
          class="no-print w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-semibold text-white bg-[#0070f3] hover:bg-[#005ac2] border border-[#0070f3] hover:border-[#005ac2] rounded-full transition-all shadow-2xs cursor-pointer touch-manipulation active:scale-[0.98]"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
          </svg>
          Download PDF
        </button>
      </div>
    </div>

    <p class="mb-8 text-[11px] text-[#8f8f8f] dark:text-[#737373] leading-relaxed">
      {p.resultsDisclaimerText}
    </p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3.5 mb-8 sm:mb-10">
      
      <!-- Card 1: Daily food energy -->
      <div class="p-3.5 sm:p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414]">
        <div class="flex items-center justify-between text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono mb-1 sm:mb-2 uppercase">
          <span>{p.cardEnergyTitle}</span>
          <span class="text-[#0070f3] dark:text-[#3291ff]">{p.cardEnergyGuide}</span>
        </div>
        <div class="text-xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed] font-mono tracking-tight" id="res-mer-calories">
          984 <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f] dark:text-[#737373]">kcal</span>
        </div>
        <div class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] mt-0.5 sm:mt-1 font-mono">
          {p.cardEnergyBase} <span id="res-rer-base">615</span> kcal
        </div>
      </div>

      <!-- Card 2: Total Daily Weight -->
      <div class="p-3.5 sm:p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414]">
        <div class="flex items-center justify-between text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono mb-1 sm:mb-2 uppercase">
          <span>{p.cardPortionTitle}</span>
          <span class="text-[#10b981]">{p.cardPortionTotal}</span>
        </div>
        <div class="text-xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed] font-mono tracking-tight" id="res-daily-grams">
          728 <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f] dark:text-[#737373]">{p.cardPortionGrams}</span>
        </div>
        <div class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] mt-0.5 sm:mt-1 font-mono">
          ≈ <span id="res-daily-cups">3.2</span> {p.cardPortionCups}
        </div>
      </div>

      <!-- Card 3: Per Meal Split -->
      <div class="p-3.5 sm:p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414]">
        <div class="flex items-center justify-between text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono mb-1 sm:mb-2 uppercase">
          <span>{p.cardPerMealTitle}</span>
          <span class="text-[#7928ca] dark:text-[#a35cf0]" id="res-meals-count">{p.cardPerMealTimes}</span>
        </div>
        <div class="text-xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed] font-mono tracking-tight" id="res-per-meal-grams">
          364 <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f] dark:text-[#737373]">{p.cardPerMealBowl}</span>
        </div>
        <div class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] mt-0.5 sm:mt-1 font-mono">
          {p.cardPerMealSched}
        </div>
      </div>

      <!-- Card 4: Treat & Snack Allowance -->
      <div class="p-3.5 sm:p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414]">
        <div class="flex items-center justify-between text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono mb-1 sm:mb-2 uppercase">
          <span>{p.cardTreatTitle}</span>
          <span class="text-[#f5a623] font-semibold" id="res-treat-pct">10%</span>
        </div>
        <div class="text-xl sm:text-3xl font-bold text-[#f5a623] font-mono tracking-tight" id="res-treat-kcal">
          98 <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f] dark:text-[#737373]">{p.cardTreatKcalDay}</span>
        </div>
        <div class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] mt-0.5 sm:mt-1 font-mono">
          {p.cardTreatAllowance}
        </div>
      </div>

    </div>

    <!-- Personalized Advice Panel -->
    <div id="personalized-advice-panel" class="mb-8 sm:mb-10 p-5 sm:p-6 rounded-2xl border border-[#0070f3]/20 bg-gradient-to-br from-[#f0f7ff] to-[#fafafa] dark:from-[#0070f3]/10 dark:to-[#141414] dark:border-[#0070f3]/20">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-lg">🎯</span>
        <h3 class="text-sm sm:text-base font-bold text-[#171717] dark:text-[#ededed]">Personalized Advice for <span class="res-dog-name-inline text-[#0070f3] dark:text-[#3291ff]">Lucy</span></h3>
      </div>
      <div id="advice-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <!-- Dynamically populated via JS -->
      </div>
    </div>

    <!-- Breed Insights Panel -->
    <div id="breed-insights-panel" class="mb-8 sm:mb-10 p-5 sm:p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414]">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-lg">🐾</span>
        <h3 class="text-sm sm:text-base font-bold text-[#171717] dark:text-[#ededed]">Breed-Specific Nutrition Insights</h3>
      </div>
      <div id="breed-insights-content" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Dynamically populated via JS -->
      </div>
    </div>

    <!-- Diet Switcher Pills -->
    <div class="no-print overflow-x-auto pb-2 sm:pb-0 mb-6 sm:mb-8 no-scrollbar">
      <div class="flex items-center gap-1.5 sm:gap-2 p-1 bg-[#f2f2f2] dark:bg-[#1a1a1a] rounded-lg border border-[#ebebeb] dark:border-[#2e2e2e] min-w-max">
        <button 
          type="button" 
          data-diet="fresh-cooked" 
          class="diet-tab-btn active px-3 sm:px-4 py-2 text-[11px] sm:text-xs font-semibold rounded-md bg-white dark:bg-[#262626] text-[#171717] dark:text-white shadow-xs transition-all touch-manipulation cursor-pointer"
        >
          🍲 {p.dietFresh}
        </button>
        <button 
          type="button" 
          data-diet="raw-barf" 
          class="diet-tab-btn px-3 sm:px-4 py-2 text-[11px] sm:text-xs font-semibold rounded-md text-[#8f8f8f] dark:text-[#737373] hover:text-[#171717] dark:hover:text-white transition-all touch-manipulation cursor-pointer"
        >
          🥩 {p.dietRaw}
        </button>
        <button 
          type="button" 
          data-diet="superfood-topper" 
          class="diet-tab-btn px-3 sm:px-4 py-2 text-[11px] sm:text-xs font-semibold rounded-md text-[#8f8f8f] dark:text-[#737373] hover:text-[#171717] dark:hover:text-white transition-all touch-manipulation cursor-pointer"
        >
          🥣 {p.dietTopper}
        </button>
      </div>
    </div>

    <!-- SECTION A: Recipe-specific daily meal schedule -->
    <div class="hairline-card p-4 sm:p-8 mb-8 sm:mb-10 bg-white dark:bg-[#141414]">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#ebebeb] dark:border-[#262626]">
        <div>
          <span class="font-mono text-[10px] sm:text-xs font-bold text-[#0070f3] dark:text-[#3291ff] uppercase tracking-wider">
            {p.todayRecipePrefix}
          </span>
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mt-0.5">
            {p.bowlSectionTitle} <span class="res-dog-name-inline">Lucy</span>
          </h3>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="timed-schedule-container">
        <!-- Dynamically rendered via JS -->
      </div>
    </div>

      <!-- SECTION B: Your recipe and a simple meal overview -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 mb-10 sm:mb-12">
      
      <!-- Left 2 Cols: Ingredient Blueprint -->
      <div class="lg:col-span-2 space-y-5 sm:space-y-6">
        
        <div class="hairline-card p-4 sm:p-8 bg-white dark:bg-[#141414]">
          <div class="flex items-center justify-between mb-2.5 sm:mb-3">
            <span class="font-mono text-[10px] sm:text-xs text-[#0070f3] dark:text-[#3291ff] font-semibold uppercase tracking-wider" id="recipe-diet-tag">
              {p.todayRecipePrefix}
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-semibold text-[#171717] dark:text-[#ededed] mb-2" id="recipe-title">
            Gently Cooked Lean Turkey & Pumpkin Feast
          </h3>
          <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed mb-5 sm:mb-6" id="recipe-description">
            Slow-simmered lean ground turkey paired with antioxidant-rich pumpkin puree, steamed greens, and wild Alaskan salmon oil.
          </p>
          <p class="text-[11px] text-[#8f8f8f] dark:text-[#737373] -mt-3 mb-5" id="recipe-match-note" aria-live="polite"></p>

          <!-- Ingredients Grams Table -->
          <div class="mb-5 sm:mb-6">
            <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono mb-2.5 sm:mb-3">
              {p.ingredientsHeader}
            </h4>
            <div class="divide-y divide-[#ebebeb] dark:divide-[#262626] border border-[#ebebeb] dark:border-[#262626] rounded-lg overflow-hidden" id="ingredient-rows-container">
              <!-- Dynamically populated via JS -->
            </div>
          </div>

          <!-- Step-by-Step Preparation Guide -->
          <div>
            <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono mb-2.5 sm:mb-3">
              {p.prepStepsHeader}
            </h4>
            <ol class="space-y-2 text-xs text-[#4d4d4d] dark:text-[#a1a1a1]" id="prep-steps-container">
              <!-- Populated via JS -->
            </ol>
          </div>

        </div>

      </div>

      <!-- Right Col: Simple meal overview -->
      <div class="space-y-5 sm:space-y-6">
        
        <!-- Macro Breakdown Card -->
        <div class="hairline-card p-4 sm:p-6 bg-white dark:bg-[#141414]">
          <div class="flex items-center justify-between mb-3 sm:mb-4">
            <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
              Macronutrient Target
            </h4>
          </div>

          <div class="space-y-3 sm:space-y-4 mb-5 sm:mb-6">
            <div>
              <div class="flex justify-between text-xs font-medium mb-1">
                <span class="text-[#171717] dark:text-[#ededed]">Protein</span>
                <span class="font-mono text-[#0070f3] dark:text-[#3291ff]" id="macro-protein-pct">48%</span>
              </div>
              <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-2 rounded-full overflow-hidden">
                <div class="bg-[#0070f3] dark:bg-[#3291ff] h-full rounded-full" id="macro-protein-bar" style="width: 48%;"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-medium mb-1">
                <span class="text-[#171717] dark:text-[#ededed]">Healthy Fats & Omegas</span>
                <span class="font-mono text-[#7928ca] dark:text-[#a35cf0]" id="macro-fat-pct">32%</span>
              </div>
              <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-2 rounded-full overflow-hidden">
                <div class="bg-[#7928ca] dark:bg-[#a35cf0] h-full rounded-full" id="macro-fat-bar" style="width: 32%;"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-medium mb-1">
                <span class="text-[#171717] dark:text-[#ededed]">Vegetables & fibre</span>
                <span class="font-mono text-[#10b981]" id="macro-fiber-pct">4%</span>
              </div>
              <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-2 rounded-full overflow-hidden">
                <div class="bg-[#10b981] h-full rounded-full" id="macro-fiber-bar" style="width: 4%;"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-medium mb-1">
                <span class="text-[#171717] dark:text-[#ededed]">Hydration / Moisture</span>
                <span class="font-mono text-[#50e3c2]" id="macro-moisture-pct">74%</span>
              </div>
              <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-2 rounded-full overflow-hidden">
                <div class="bg-[#50e3c2] h-full rounded-full" id="macro-moisture-bar" style="width: 74%;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 7-Day Transition Card -->
        <div class="hairline-card p-4 sm:p-6 bg-white dark:bg-[#141414] space-y-3">
          <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
            {p.transitionHeader}
          </h4>
          <ul class="space-y-1.5 text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">
            <li class="flex items-center gap-2"><span>🟢</span> {p.transitionP1}</li>
            <li class="flex items-center gap-2"><span>🟡</span> {p.transitionP2}</li>
            <li class="flex items-center gap-2"><span>🟠</span> {p.transitionP3}</li>
            <li class="flex items-center gap-2"><span>⭐</span> {p.transitionP4}</li>
          </ul>
        </div>

        <!-- Recipe selection summary -->
        <div class="hairline-card p-4 sm:p-6 bg-gradient-to-b from-white to-[#fafafa] dark:from-[#141414] dark:to-[#171717]">
          <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono mb-3">Why this recipe</h4>
          <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed" id="recipe-selection-summary">This recipe is selected from your feeding style, protein preference, health focus, and stated sensitivities.</p>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] leading-relaxed" id="recipe-method-summary">Recipe matching uses feeding style first, removes selected sensitivities, then ranks the remaining recipes by protein preference, health focus, and energy density. Energy is a starting estimate; use a complete and balanced recipe formulated for your dog's life stage and review it with your veterinarian for long-term feeding.</p>
        </div>

      </div>

    </div>

    <!-- Health Focus Deep Dive -->
    <div id="health-focus-tips" class="mt-8 sm:mt-10 p-5 sm:p-6 rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414]">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-lg" id="health-focus-icon">⭐</span>
        <h3 class="text-sm sm:text-base font-bold text-[#171717] dark:text-[#ededed]">Your <span id="health-focus-label">General Health</span> Nutrition Guide</h3>
      </div>
      <div id="health-focus-content" class="space-y-3">
        <!-- Dynamically populated via JS -->
      </div>
    </div>

  </div>
</section>

<script>
  import { calculateCanineNutrition } from '../utils/nutritionEngine';
  import { RECIPES } from '../data/recipes';
  import { INGREDIENT_AFFILIATE_MAP } from '../data/affiliates';

  let currentProfile: any = null;

  const ALLERGY_ALIASES: Record<string, string[]> = {
    'chicken / poultry': ['chicken', 'poultry', 'turkey'],
    beef: ['beef'],
    dairy: ['dairy'],
    eggs: ['egg'],
    'grains / wheat': ['grain', 'wheat'],
    soy: ['soy'],
    corn: ['corn']
  };

  function selectRecipe(profile: any) {
    const dietRecipes = RECIPES.filter((recipe) => recipe.dietType === profile.dietPreference);
    const avoidedAllergies = (profile.allergies || []).filter((allergy: string) => allergy !== 'none / no allergies');
    const allergySafeRecipes = dietRecipes.filter((recipe) => !recipe.ingredients.some((ingredient) =>
      (ingredient.allergens || []).some((allergen) => avoidedAllergies.some((allergy: string) =>
        (ALLERGY_ALIASES[allergy] || [allergy]).some((alias) => allergen.toLowerCase().includes(alias))
      ))
    ));
    const availableRecipes = allergySafeRecipes;
    const preferredProtein = profile.proteinChoice?.toLowerCase();
    const needsLowerEnergy = profile.targetGoal === 'lose' || profile.bcs >= 7 || profile.activityLevel === 'sedentary';
    const needsMoreEnergy = profile.targetGoal === 'gain' || profile.bcs <= 3 || ['active', 'working'].includes(profile.activityLevel);
    const scoredRecipes = availableRecipes.map((recipe) => {
      let score = 0;
      if (preferredProtein && !preferredProtein.includes('no pref') && recipe.primaryProtein.toLowerCase() === preferredProtein) score += 100;
      if (recipe.healthFocusMatches.includes(profile.healthFocus)) score += 30;
      if (needsLowerEnergy) score -= recipe.macroProfile.kcalPerGram * 10;
      if (needsMoreEnergy) score += recipe.macroProfile.kcalPerGram * 10;
      return { recipe, score };
    }).sort((a, b) => b.score - a.score);

    // Sensitivities are hard exclusions. A no-match result is handled in the caller.
    return scoredRecipes[0]?.recipe || null;
  }

  // Hero image per recipe — shown at the top of the recipe card
  const RECIPE_HERO_IMAGES: Record<string, string> = {
    'fresh-chicken-everyday': 'https://images.unsplash.com/photo-1598103442097-8b74394b95c3?auto=format&fit=crop&w=800&h=400&q=80', // cooked chicken bowl
    'fresh-turkey-vitality': 'https://images.unsplash.com/photo-1574672280600-4accfa5b6f98?auto=format&fit=crop&w=800&h=400&q=80', // turkey meal
    'fresh-beef-power': 'https://images.unsplash.com/photo-1529692236671-f1f6cf9683ba?auto=format&fit=crop&w=800&h=400&q=80', // ground beef
    'fresh-salmon-dermacare': 'https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?auto=format&fit=crop&w=800&h=400&q=80', // salmon fillet
    'raw-barf-complete-beef': 'https://images.unsplash.com/photo-1607623814075-e51df1bdc82f?auto=format&fit=crop&w=800&h=400&q=80', // raw beef
    'raw-barf-lamb-hypoallergenic': 'https://images.unsplash.com/photo-1603048588665-791ca8aea617?auto=format&fit=crop&w=800&h=400&q=80', // lamb
    'topper-gut-joint-shield': 'https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=800&h=400&q=80', // bone broth / soup
  };

  // Per-ingredient-category images (used for ingredient row thumbnails)
  const INGREDIENT_IMAGES: Record<string, string> = {
    'Muscle Meat': 'https://images.unsplash.com/photo-1607623814075-e51df1bdc82f?auto=format&fit=crop&w=160&h=160&q=80', // raw meat
    'Organ': 'https://images.unsplash.com/photo-1603360946369-dc9bb6258143?auto=format&fit=crop&w=160&h=160&q=80', // organ meat
    'Raw Bone': 'https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&w=160&h=160&q=80', // bone
    'Vegetables & Greens': 'https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=160&h=160&q=80', // vegetables
    'Healthy Fats & Oils': 'https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?auto=format&fit=crop&w=160&h=160&q=80', // oil
    'Natural Supplements': 'https://images.unsplash.com/photo-1550572017-edd951b55104?auto=format&fit=crop&w=160&h=160&q=80', // supplements
  };

  function ingredientShoppingLinks(name: string) {
    const affiliateUrl = INGREDIENT_AFFILIATE_MAP[name];
    const query = encodeURIComponent(name);
    return {
      amazon: affiliateUrl && affiliateUrl.length > 0
        ? affiliateUrl
        : `https://www.amazon.com/s?k=${query}`,
      isAffiliate: !!(affiliateUrl && affiliateUrl.length > 0),
    };
  }

  function renderPersonalizedAdvice(profile: any, result: any, recipe: any) {
    const grid = document.getElementById('advice-cards-grid');
    if (!grid) return;

    const cards: Array<{ icon: string; title: string; body: string; color: string }> = [];

    // Age-stage advice
    const ageAdvice: Record<string, { icon: string; title: string; body: string }> = {
      'puppy-early': {
        icon: '🐣',
        title: 'Early Puppy (2–4 months)',
        body: `${result.dogName} needs 3 meals/day with 28–32% protein and DHA for brain development. Calcium:Phosphorus ratio must be 1.2:1 to 1.4:1 — avoid over-supplementing calcium which causes skeletal deformities in large breeds.`
      },
      'puppy-late': {
        icon: '🐕',
        title: 'Growing Puppy (4–12 months)',
        body: `${result.dogName} is in peak growth. Protein should be 26–30% of diet. Transition to 2 meals/day around 6 months. Avoid high-fat diets that accelerate bone growth too fast in large breeds.`
      },
      'adult': {
        icon: '🦮',
        title: 'Adult Maintenance',
        body: `${result.dogName} needs consistent daily calories to maintain lean muscle. Spayed/neutered dogs need 20–30% fewer calories than intact dogs. Monitor body condition score monthly — ribs should be easily felt but not visible.`
      },
      'senior': {
        icon: '🦴',
        title: 'Senior Nutrition',
        body: `${result.dogName} needs higher-quality protein (not less) to prevent muscle wasting (sarcopenia). Reduce fat by 10–15%, increase moisture content, and add glucosamine/chondroitin. Kidney function monitoring is critical — avoid excess phosphorus.`
      }
    };
    const ageCard = ageAdvice[profile.ageStage];
    if (ageCard) cards.push({ ...ageCard, color: '#0070f3' });

    // BCS advice
    if (profile.bcs <= 3) {
      cards.push({
        icon: '⚠️',
        title: 'Underweight Alert',
        body: `BCS ${profile.bcs}/9 indicates ${result.dogName} is underweight. Increase daily calories by 20% using energy-dense proteins like beef and salmon. Add healthy fats (salmon oil, flaxseed oil). Rule out parasites, dental pain, or illness with your vet.`,
        color: '#f59e0b'
      });
    } else if (profile.bcs >= 7) {
      cards.push({
        icon: '⚖️',
        title: 'Weight Management Priority',
        body: `BCS ${profile.bcs}/9 means ${result.dogName} is overweight. We've reduced calories by 20%. Feed measured portions only — no free feeding. Replace high-calorie treats with raw carrots, cucumber, or blueberries. Increase daily walks by 15 minutes.`,
        color: '#e11d48'
      });
    }

    // Activity advice
    const activityAdvice: Record<string, { icon: string; title: string; body: string }> = {
      sedentary: {
        icon: '🛋️',
        title: 'Low Activity — Calorie Watch',
        body: `Sedentary dogs burn 15% fewer calories. Avoid high-fat recipes and limit treats strictly to 5% of daily intake. Prioritize lean proteins (turkey, chicken breast) and high-fiber vegetables to maintain satiety without excess calories.`
      },
      working: {
        icon: '🏔️',
        title: 'Working Dog — High Energy Needs',
        body: `Working dogs need 55% more calories than resting. Prioritize fat-dense proteins (beef, salmon) for sustained energy. Feed 3x daily if possible. Add electrolytes via bone broth on heavy work days. Monitor hydration closely.`
      },
      active: {
        icon: '⚡',
        title: 'Active Dog — Performance Nutrition',
        body: `Active dogs need 25% more calories with emphasis on quality protein for muscle repair. Feed the larger meal 2 hours after exercise, not before. Add wild salmon oil for joint lubrication and anti-inflammatory recovery.`
      }
    };
    const actCard = activityAdvice[profile.activityLevel];
    if (actCard) cards.push({ ...actCard, color: '#7928ca' });

    // Allergy advice
    const avoidedAllergies = (profile.allergies || []).filter((a: string) => a !== 'none / no allergies');
    if (avoidedAllergies.length > 0) {
      const allergyTips: Record<string, string> = {
        'chicken / poultry': 'Replace with novel proteins: lamb, venison, rabbit, or wild-caught fish. Avoid all poultry by-products and "meat meal" on labels.',
        beef: 'Use lamb, turkey, or salmon as alternatives. Check for hidden beef in "meat broth" or "natural flavors" on commercial labels.',
        dairy: 'Avoid cheese, yogurt, and whey. Goat milk is often tolerated better than cow dairy due to smaller fat globules.',
        'grains / wheat': 'Use grain-free recipes with sweet potato, pumpkin, or zucchini as carb sources. Oats are often tolerated even in grain-sensitive dogs.',
        soy: 'Avoid soy lecithin and soy protein isolate in commercial foods. Soy is a common hidden ingredient in budget kibbles.',
        eggs: 'Eggs are a common allergen — avoid all egg-containing treats and baked dog foods. Duck eggs are sometimes tolerated.',
        corn: 'Corn is a common filler with low bioavailability. Replace with sweet potato or pumpkin for digestible carbohydrates.'
      };
      const tipLines = avoidedAllergies.map((a: string) => allergyTips[a] || `Avoid ${a} in all forms.`).join(' ');
      cards.push({
        icon: '🚫',
        title: `Sensitivity Management: ${avoidedAllergies.join(', ')}`,
        body: tipLines,
        color: '#e11d48'
      });
    }

    // Diet type advice
    const dietAdvice: Record<string, { icon: string; title: string; body: string }> = {
      'fresh-cooked': {
        icon: '🍲',
        title: 'Fresh Cooked — Key Rules',
        body: 'Cook proteins to 160°F internal temperature. Never add onions, garlic, or xylitol. Always add a complete vitamin/mineral supplement (like Just Food for Dogs Nutrient Blend) — homemade food alone is nutritionally incomplete without it.'
      },
      'raw-barf': {
        icon: '🥩',
        title: 'Raw BARF — Safety Protocol',
        body: 'Freeze raw meat at -4°F for 3+ weeks before feeding to eliminate parasites. Follow 80/10/10 ratio: 80% muscle meat, 10% raw edible bone, 10% organs. Wash all bowls and surfaces with hot soapy water after every meal.'
      },
      'superfood-topper': {
        icon: '🥣',
        title: 'Topper Strategy',
        body: 'Reduce kibble portion by 25–30% when adding toppers to avoid overfeeding. Warm bone broth toppers to 100°F to release aroma and improve palatability. Rotate toppers weekly to prevent food boredom and broaden nutrient spectrum.'
      }
    };
    const dietCard = dietAdvice[profile.dietPreference];
    if (dietCard) cards.push({ ...dietCard, color: '#10b981' });

    grid.innerHTML = cards.map(card => `
      <div class="p-4 rounded-xl border border-[${card.color}]/20 bg-white dark:bg-[#1a1a1a]" style="border-left: 3px solid ${card.color}">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-base">${card.icon}</span>
          <span class="text-xs font-bold text-[#171717] dark:text-[#ededed]">${card.title}</span>
        </div>
        <p class="text-[11px] sm:text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">${card.body}</p>
      </div>
    `).join('');
  }

  function renderBreedInsights(profile: any) {
    const container = document.getElementById('breed-insights-content');
    if (!container) return;

    const breedName = profile.breed || '';
    const isLarge = breedName.toLowerCase().includes('large') || breedName.toLowerCase().includes('giant') ||
      ['german shepherd', 'labrador', 'golden retriever', 'rottweiler', 'great dane', 'saint bernard', 'mastiff', 'husky', 'malamute', 'bernese'].some(b => breedName.toLowerCase().includes(b));
    const isToy = breedName.toLowerCase().includes('toy') || breedName.toLowerCase().includes('chihuahua') ||
      ['chihuahua', 'pomeranian', 'yorkshire', 'maltese', 'shih tzu', 'pekingese'].some(b => breedName.toLowerCase().includes(b));
    const isBrachy = ['bulldog', 'pug', 'boston terrier', 'french bulldog', 'boxer', 'shih tzu', 'pekingese', 'cavalier'].some(b => breedName.toLowerCase().includes(b));
    const isHighEnergy = ['border collie', 'husky', 'malamute', 'jack russell', 'dalmatian', 'vizsla', 'weimaraner', 'pointer', 'setter', 'springer'].some(b => breedName.toLowerCase().includes(b));
    const isHerding = ['border collie', 'australian shepherd', 'german shepherd', 'corgi', 'sheltie', 'collie'].some(b => breedName.toLowerCase().includes(b));

    const insights: Array<{ icon: string; label: string; value: string; note: string }> = [];

    if (isToy) {
      insights.push({ icon: '⚡', label: 'Metabolism', value: 'Very Fast', note: 'Toy breeds burn calories 25% faster per kg. Feed 3x daily to prevent hypoglycemia. Use calorie-dense small bites.' });
    } else if (isLarge) {
      insights.push({ icon: '🦴', label: 'Joint Health', value: 'Priority', note: 'Large breeds are prone to hip dysplasia and elbow dysplasia. Add glucosamine (500mg/day) and chondroitin. Avoid rapid weight gain in puppies.' });
    } else {
      insights.push({ icon: '⚖️', label: 'Metabolism', value: 'Moderate', note: 'Medium breeds have balanced metabolic needs. 2 meals/day is ideal. Monitor weight monthly with rib-check test.' });
    }

    if (isBrachy) {
      insights.push({ icon: '😮‍💨', label: 'Brachycephalic', value: 'Special Needs', note: 'Flat-faced breeds have smaller airways — avoid obesity strictly as extra weight worsens breathing. Feed from elevated bowls to reduce air swallowing and bloat risk.' });
    } else if (isHighEnergy) {
      insights.push({ icon: '🏃', label: 'Energy Level', value: 'High Performance', note: 'This breed needs 25–40% more calories on active days. Prioritize complex carbs (sweet potato, oats) for sustained energy. Replenish electrolytes with bone broth after intense exercise.' });
    } else if (isHerding) {
      insights.push({ icon: '🧠', label: 'Herding Breed', value: 'Brain + Body', note: 'Herding breeds need mental stimulation alongside nutrition. DHA-rich foods (salmon, sardines) support cognitive function. High protein (28%+) maintains lean muscle for agility.' });
    } else {
      insights.push({ icon: '🐾', label: 'Breed Type', value: 'Standard', note: 'Follow standard NRC guidelines for this breed size. Rotate proteins every 4–6 weeks to prevent food sensitivities from developing.' });
    }

    // Always add a dental insight
    insights.push({ icon: '🦷', label: 'Dental Health', value: 'Daily Care', note: 'Raw meaty bones (under supervision) and freeze-dried treats help reduce plaque. Avoid sticky soft treats. Brush teeth 3x/week with dog-safe toothpaste. Dental disease affects 80% of dogs by age 3.' });

    container.innerHTML = insights.map(ins => `
      <div class="p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#1a1a1a]">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="text-base">${ins.icon}</span>
          <div>
            <div class="text-[10px] font-mono uppercase text-[#8f8f8f] dark:text-[#737373]">${ins.label}</div>
            <div class="text-xs font-bold text-[#171717] dark:text-[#ededed]">${ins.value}</div>
          </div>
        </div>
        <p class="text-[11px] text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">${ins.note}</p>
      </div>
    `).join('');
  }

