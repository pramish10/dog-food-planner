---
import { RECIPES } from '../data/recipes';
import { getLangFromUrl } from '../i18n/utils';
import { plannerTranslations } from '../i18n/planner';

const lang = getLangFromUrl(Astro.url);
const p = plannerTranslations[lang] || plannerTranslations.en;
---

<section id="results-section" class="hidden py-8 sm:py-12 bg-[#fdf8f3] dark:bg-[#150d04] border-b border-[#f0e0cc] dark:border-[#2a1f14]" data-lang={lang}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Results Header -->
    <div class="mb-5 sm:mb-6">
      <div class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase font-semibold text-[#16a34a] bg-[#22c55e]/10 px-3 py-1 rounded-full mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#22c55e] animate-pulse"></span>
        {p.readyBadge}
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#1c0f00] dark:text-[#fde8c8] tracking-tight">
        {p.mealPlanFor} <span id="res-dog-name" class="text-[#c47a2b] dark:text-[#e8a44a]">Lucy</span>
      </h2>
      <p id="res-summary" class="text-sm text-[#6b4226] dark:text-[#c4956a] mt-1.5 leading-relaxed"></p>
    </div>

    <!-- Horizontal layout on lg+: LEFT = stats/schedule/insight, RIGHT = recipe -->
    <div class="lg:flex lg:gap-6 lg:items-start">

      <!-- LEFT COLUMN: Stats + Schedule + Insight -->
      <div class="lg:w-[42%] xl:w-[38%] shrink-0 space-y-4 mb-5 lg:mb-0">

        <!-- 3 Key Stat Cards -->
        <div class="grid grid-cols-3 gap-2 sm:gap-2.5">
          <div class="p-3 sm:p-3.5 rounded-2xl border border-[#f0d5a8] dark:border-[#3a2510] bg-white dark:bg-[#1c1208] text-center">
            <div class="text-[10px] font-mono font-semibold text-[#92400e] dark:text-[#c4956a] uppercase mb-1">{p.cardEnergyTitle}</div>
            <div class="text-lg sm:text-xl font-bold text-[#1c0f00] dark:text-[#fde8c8] font-mono" id="res-mer-calories">—</div>
            <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] font-mono">kcal/day</div>
          </div>
          <div class="p-3 sm:p-3.5 rounded-2xl border border-[#f0d5a8] dark:border-[#3a2510] bg-white dark:bg-[#1c1208] text-center">
            <div class="text-[10px] font-mono font-semibold text-[#92400e] dark:text-[#c4956a] uppercase mb-1">{p.cardPortionTitle}</div>
            <div class="text-lg sm:text-xl font-bold text-[#1c0f00] dark:text-[#fde8c8] font-mono" id="res-daily-grams">—</div>
            <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] font-mono">g/day</div>
          </div>
          <div class="p-3 sm:p-3.5 rounded-2xl border border-[#f0d5a8] dark:border-[#3a2510] bg-white dark:bg-[#1c1208] text-center">
            <div class="text-[10px] font-mono font-semibold text-[#92400e] dark:text-[#c4956a] uppercase mb-1">{p.cardPerMealTitle}</div>
            <div class="text-lg sm:text-xl font-bold text-[#1c0f00] dark:text-[#fde8c8] font-mono" id="res-per-meal-grams">—</div>
            <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] font-mono" id="res-meals-label">—x/day</div>
          </div>
        </div>

        <!-- Feeding Schedule -->
        <div class="bg-white dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-2xl p-4 sm:p-5">
          <h3 class="text-xs font-bold text-[#1c0f00] dark:text-[#fde8c8] mb-3 uppercase tracking-wider font-mono">{p.bowlSectionTitle} <span class="res-dog-name-inline text-[#c47a2b] dark:text-[#e8a44a]">Lucy</span></h3>
          <div id="feeding-schedule-container" class="space-y-2">
            <!-- Populated by JS -->
          </div>
          <div class="mt-3 pt-3 border-t border-[#f0d5a8] dark:border-[#3a2510] flex items-center justify-between text-xs text-[#92400e] dark:text-[#c4956a]">
            <span>{p.cardTreatTitle}:</span>
            <span class="font-mono font-semibold text-[#c47a2b]"><span id="res-treat-kcal">—</span> kcal/day</span>
          </div>
        </div>

        <!-- Profile-specific insight card -->
        <div id="insight-card" class="p-4 rounded-2xl border border-[#c47a2b]/30 bg-[#c47a2b]/5 dark:bg-[#c47a2b]/10">
          <p id="insight-text" class="text-sm text-[#6b4226] dark:text-[#c4956a] leading-relaxed"></p>
        </div>

        <!-- Disclaimer + Start Over (desktop: in left col) -->
        <div class="hidden lg:block text-center pt-1">
          <p class="text-[11px] text-[#92400e]/70 dark:text-[#c4956a]/70 mb-3">{p.resultsDisclaimerText}</p>
          <button id="start-over-btn" type="button"
            class="px-6 py-2.5 text-sm font-semibold text-[#92400e] dark:text-[#c4956a] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl hover:text-[#c47a2b] hover:border-[#c47a2b] transition-all cursor-pointer touch-manipulation min-h-[44px]">
            {p.prevBtn}
          </button>
        </div>

      </div><!-- end LEFT COLUMN -->

      <!-- RIGHT COLUMN: Diet tabs + Recipe -->
      <div class="flex-1 min-w-0">

        <!-- Diet Tabs -->
        <div class="flex gap-1.5 mb-3 p-1 bg-[#fdf3e7] dark:bg-[#1c1208] rounded-xl border border-[#f0d5a8] dark:border-[#3a2510]">
          <button type="button" data-diet="fresh-cooked" class="diet-tab-btn flex-1 py-2.5 text-xs font-semibold rounded-lg bg-white dark:bg-[#2a1a08] text-[#1c0f00] dark:text-[#fde8c8] shadow-sm transition-all cursor-pointer touch-manipulation min-h-[40px]">🍲 {p.dietFresh}</button>
          <button type="button" data-diet="raw-barf" class="diet-tab-btn flex-1 py-2.5 text-xs font-semibold rounded-lg text-[#92400e] dark:text-[#c4956a] hover:text-[#c47a2b] hover:border-[#c47a2b] transition-all cursor-pointer touch-manipulation min-h-[40px]">🥩 {p.dietRaw}</button>
          <button type="button" data-diet="superfood-topper" class="diet-tab-btn flex-1 py-2.5 text-xs font-semibold rounded-lg text-[#92400e] dark:text-[#c4956a] hover:text-[#c47a2b] hover:border-[#c47a2b] transition-all cursor-pointer touch-manipulation min-h-[40px]">🥣 {p.dietTopper}</button>
        </div>

        <!-- Recipe Card -->
        <div class="bg-white dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-2xl p-4 sm:p-5">
          <div class="text-[10px] font-mono font-semibold text-[#c47a2b] dark:text-[#e8a44a] uppercase tracking-wider mb-1" id="recipe-diet-tag">{p.todayRecipePrefix}</div>
          <h3 class="text-base font-bold text-[#1c0f00] dark:text-[#fde8c8] mb-1" id="recipe-title">—</h3>
          <p class="text-sm text-[#6b4226] dark:text-[#c4956a] mb-4 leading-relaxed" id="recipe-description">—</p>

          <div id="no-recipe-warning" class="hidden mb-4 p-3 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 text-sm text-amber-800 dark:text-amber-200">
            {p.noRecipeMatch}
          </div>

          <!-- Ingredients -->
          <div class="mb-4">
            <div class="text-[10px] font-mono font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-2">{p.ingredientsHeader}</div>
            <div id="ingredient-rows-container" class="divide-y divide-[#f0d5a8] dark:divide-[#3a2510] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl overflow-hidden">
              <!-- Populated by JS -->
            </div>
          </div>

          <!-- Prep Steps -->
          <div>
            <div class="text-[10px] font-mono font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-2">{p.prepStepsHeader}</div>
            <ol id="prep-steps-container" class="space-y-2 text-sm text-[#6b4226] dark:text-[#c4956a]">
              <!-- Populated by JS -->
            </ol>
          </div>

        </div>

        <!-- Disclaimer + Start Over (mobile: below recipe) -->
        <div class="lg:hidden text-center mt-5">
          <p class="text-[11px] text-[#92400e]/70 dark:text-[#c4956a]/70 mb-4">{p.resultsDisclaimerText}</p>
          <button id="start-over-btn-mobile" type="button"
            class="px-6 py-3 text-sm font-semibold text-[#92400e] dark:text-[#c4956a] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl hover:text-[#c47a2b] hover:border-[#c47a2b] transition-all cursor-pointer touch-manipulation min-h-[44px]">
            {p.prevBtn}
          </button>
        </div>

      </div><!-- end RIGHT COLUMN -->

    </div><!-- end horizontal layout -->

  </div>
</section>

<script>
  import { calculateCanineNutrition } from '../utils/nutritionEngine';
  import { RECIPES } from '../data/recipes';

  const ALLERGY_ALIASES: Record<string, string[]> = {
    'chicken / poultry': ['chicken', 'poultry', 'turkey'],
    beef: ['beef'],
    dairy: ['dairy'],
    eggs: ['egg'],
    'grains / wheat': ['grain', 'wheat'],
    soy: ['soy'],
    corn: ['corn'],
  };

  const HEALTH_ICONS: Record<string, string> = {
    'General Longevity & Health': '⭐',
    'Joints & Mobility Support': '🦴',
    'Skin & Shiny Coat Vitality': '✨',
    'Sensitive Digestion & Gut Health': '🌿',
    'Metabolic Weight Management': '⚖️',
  };

  const RESULTS_STATE_KEY = 'dfp-results-state';
  let currentProfile: any = null;
  let currentDiet = 'fresh-cooked';

  function selectRecipe(profile: any, dietOverride?: string) {
    const diet = dietOverride || profile.dietPreference;
    const dietRecipes = RECIPES.filter((r) => r.dietType === diet);
    const avoidedAllergies = (profile.allergies || []).filter((a: string) => a !== 'none / no allergies');
    const safes = dietRecipes.filter((r) =>
      !r.ingredients.some((ing) =>
        (ing.allergens || []).some((al) =>
          avoidedAllergies.some((av: string) =>
            (ALLERGY_ALIASES[av] || [av]).some((alias) => al.toLowerCase().includes(alias))
          )
        )
      )
    );
    const pool = safes.length ? safes : dietRecipes;
    const preferred = profile.proteinChoice?.toLowerCase();
    const scored = pool.map((r) => {
      let score = 0;
      if (preferred && preferred !== 'auto' && r.primaryProtein.toLowerCase() === preferred) score += 100;
      if (r.healthFocusMatches.some((h: string) => h.toLowerCase().includes(profile.healthFocus?.toLowerCase()?.split(' ')[0] || ''))) score += 30;
      return { r, score };
    }).sort((a, b) => b.score - a.score);
    return { recipe: scored[0]?.r || null, hadNoSafeMatch: safes.length === 0 };
  }

  function saveResultsState(profile: any, diet: string) {
    sessionStorage.setItem(
      RESULTS_STATE_KEY,
      JSON.stringify({
        profile,
        diet,
      })
    );
  }

  function clearResultsState() {
    sessionStorage.removeItem(RESULTS_STATE_KEY);
  }

  function restoreResultsState() {
    const raw = sessionStorage.getItem(RESULTS_STATE_KEY);
    if (!raw) return;

    try {
      const state = JSON.parse(raw);
      if (!state?.profile) return;
      currentProfile = state.profile;
      currentDiet = state.diet || state.profile.dietPreference || 'fresh-cooked';
      renderResults(currentProfile, currentDiet, false);
    } catch {
      clearResultsState();
    }
  }

  function renderResults(profile: any, dietOverride?: string, shouldScroll: boolean = true) {
    const result = calculateCanineNutrition(profile);
    const diet = dietOverride || profile.dietPreference;
    const { recipe, hadNoSafeMatch } = selectRecipe(profile, diet);

    const section = document.getElementById('results-section') as HTMLElement;
    section.classList.remove('hidden');
    if (shouldScroll) {
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    const plannerSection = document.getElementById('planner-section') as HTMLElement;
    if (plannerSection) plannerSection.classList.add('hidden');

    const dogName = result.dogName;
    document.querySelectorAll('#res-dog-name, .res-dog-name-inline').forEach(el => el.textContent = dogName);

    const summaryEl = document.getElementById('res-summary') as HTMLElement;
    if (summaryEl) summaryEl.textContent = result.summary;

    (document.getElementById('res-mer-calories') as HTMLElement).textContent = result.merKcal.toLocaleString();
    (document.getElementById('res-daily-grams') as HTMLElement).textContent = result.activeDailyGrams + 'g';
    (document.getElementById('res-per-meal-grams') as HTMLElement).textContent = result.perMealGrams + 'g';
    (document.getElementById('res-meals-label') as HTMLElement).textContent = result.mealsPerDay + 'x/day';
    (document.getElementById('res-treat-kcal') as HTMLElement).textContent = result.treatKcal.toLocaleString();

    const schedContainer = document.getElementById('feeding-schedule-container') as HTMLElement;
    schedContainer.innerHTML = result.dailySchedule.map((slot: any) => `
      <div class="flex items-center justify-between p-3 rounded-xl bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510]">
        <div>
          <div class="text-xs font-mono font-semibold text-[#c47a2b] dark:text-[#e8a44a]">${slot.timeLabel}</div>
          <div class="text-sm font-semibold text-[#1c0f00] dark:text-[#fde8c8]">${slot.slotName}</div>
        </div>
        <div class="text-right">
          <div class="text-lg font-bold text-[#1c0f00] dark:text-[#fde8c8] font-mono">${slot.portionGrams}g</div>
          <div class="text-[11px] text-[#92400e] dark:text-[#c4956a] font-mono">≈ ${slot.portionCups} cups</div>
        </div>
      </div>
    `).join('');

    // ── Single focused insight — specific to this dog's profile ──────────────
    const insightEl = document.getElementById('insight-text') as HTMLElement;
    if (insightEl) {
      const name = result.dogName;
      const goal = profile.targetGoal;
      const activity = profile.activityLevel;
      const health = profile.healthFocus || '';
      const breed = profile.breed || '';
      const bcs = Number(profile.bcs || 5);
      const ageStage = profile.ageStage || 'adult';

      // Build a single, specific sentence from the user's actual answers
      let insight = '';

      if (ageStage === 'puppy-early') {
        insight = `${name} is in rapid growth phase — feed 3× daily and prioritise calcium-to-phosphorus balance (1.2:1) to support bone development.`;
      } else if (ageStage === 'puppy-late') {
        insight = `${name} is transitioning to adult size — reduce to 2× daily and begin tapering calories as growth slows.`;
      } else if (ageStage === 'senior') {
        insight = `Senior ${name} needs 20% fewer calories than an adult — prioritise joint-supporting omega-3s and easily digestible proteins.`;
      } else if (goal === 'lose' || bcs >= 7) {
        insight = `${name} is overweight (BCS ${bcs}/9) — reduce portion by 10–15% and add 1–2 tbsp pure pumpkin per meal to increase satiety without extra calories.`;
      } else if (goal === 'gain' || bcs <= 3) {
        insight = `${name} is underweight (BCS ${bcs}/9) — increase daily portion by 10% and add a raw egg yolk or 1 tsp salmon oil per meal for calorie-dense nutrition.`;
      } else if (activity === 'working') {
        insight = `${name} is a working dog — this plan runs at 2.5–3× RER. Weigh food daily; adjust by ±10% based on body condition every 2 weeks.`;
      } else if (activity === 'sedentary') {
        insight = `${name} is sedentary — this plan uses a 1.2× RER multiplier. Avoid free-feeding; pick up the bowl after 15 minutes to prevent overeating.`;
      } else if (health.includes('Joint') || health.includes('Hip')) {
        insight = `For ${name}'s joint health, add 1 tsp salmon oil daily (EPA/DHA) and consider green-lipped mussel powder — both are proven to reduce canine joint inflammation.`;
      } else if (health.includes('Skin') || health.includes('Coat')) {
        insight = `For ${name}'s skin and coat, add 1 tsp wild salmon oil per 20 lbs of body weight daily — visible coat improvement typically appears within 3–4 weeks.`;
      } else if (health.includes('Digest') || health.includes('Gut')) {
        insight = `For ${name}'s sensitive digestion, add 1–2 tbsp plain pumpkin purée per meal and introduce new proteins one at a time over 7 days.`;
      } else if (health.includes('Weight')) {
        insight = `For ${name}'s weight management, weigh every meal on a kitchen scale — eyeballing portions causes 20–30% overfeeding in most households.`;
      } else if (breed.includes('Bulldog') || breed.includes('Pug') || breed.includes('French')) {
        insight = `${name}'s brachycephalic anatomy slows eating — use a slow-feeder bowl and avoid exercise for 30 minutes after meals to prevent bloat.`;
      } else if (breed.includes('Labrador') || breed.includes('Beagle')) {
        insight = `${name}'s breed is highly food-motivated and prone to obesity — stick strictly to this portion and avoid table scraps entirely.`;
      } else if (breed.includes('Husky') || breed.includes('Border Collie') || breed.includes('Australian')) {
        insight = `${name} is a high-drive working breed — on rest days reduce this portion by 10%; on active days increase by 10%.`;
      } else {
        insight = `${name}'s plan is calibrated to ${result.merKcal} kcal/day. Weigh each meal on a kitchen scale — cup measurements vary by up to 30% depending on food density.`;
      }

      insightEl.textContent = insight;
    }

    const noRecipeWarning = document.getElementById('no-recipe-warning') as HTMLElement;
    if (noRecipeWarning) noRecipeWarning.classList.toggle('hidden', !hadNoSafeMatch);

    if (recipe) {
      (document.getElementById('recipe-diet-tag') as HTMLElement).textContent = diet.replace(/-/g, ' ').toUpperCase();
      (document.getElementById('recipe-title') as HTMLElement).textContent = recipe.name;
      (document.getElementById('recipe-description') as HTMLElement).textContent = recipe.description;

      const ingContainer = document.getElementById('ingredient-rows-container') as HTMLElement;
      ingContainer.innerHTML = recipe.ingredients.map((ing: any) => {
        const grams = Math.round((ing.percentage / 100) * result.activeDailyGrams);
        const buyBtn = ing.affiliateUrl
          ? `<a href="${ing.affiliateUrl}" target="_blank" rel="noopener noreferrer sponsored"
               class="shrink-0 ml-3 px-2.5 py-1 text-[10px] font-semibold bg-[#c47a2b] hover:bg-[#a8621f] text-white rounded-lg transition-colors whitespace-nowrap">
               Buy →
             </a>`
          : '';
        return `
          <div class="flex items-center justify-between px-4 py-3 bg-white dark:bg-[#1c1208] hover:bg-[#fdf8f3] dark:hover:bg-[#2a1a08] transition-colors">
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-[#1c0f00] dark:text-[#fde8c8]">${ing.name}</div>
            </div>
            <div class="flex items-center gap-2 shrink-0 ml-3">
              <span class="text-sm font-bold text-[#1c0f00] dark:text-[#fde8c8] font-mono">${grams}g</span>
              ${buyBtn}
            </div>
          </div>
        `;
      }).join('');

      const prepContainer = document.getElementById('prep-steps-container') as HTMLElement;
      prepContainer.innerHTML = recipe.preparationNotes.map((step: string, i: number) => `
        <li class="flex items-start gap-3">
          <span class="w-5 h-5 rounded-full bg-[#c47a2b]/10 text-[#c47a2b] dark:text-[#e8a44a] text-[11px] font-bold flex items-center justify-center shrink-0 mt-0.5">${i + 1}</span>
          <span class="text-[#6b4226] dark:text-[#c4956a]">${step}</span>
        </li>
      `).join('');

    }

    document.querySelectorAll('.diet-tab-btn').forEach(btn => {
      const btnDiet = (btn as HTMLElement).dataset.diet;
      const isActive = btnDiet === diet;
      btn.classList.toggle('bg-white', isActive);
      btn.classList.toggle('dark:bg-[#2a1a08]', isActive);
      btn.classList.toggle('text-[#1c0f00]', isActive);
      btn.classList.toggle('dark:text-[#fde8c8]', isActive);
      btn.classList.toggle('shadow-sm', isActive);
      btn.classList.toggle('text-[#92400e]', !isActive);
      btn.classList.toggle('dark:text-[#c4956a]', !isActive);
    });

    currentProfile = profile;
    currentDiet = diet;
    saveResultsState(profile, diet);
  }

  document.addEventListener('dogPlannerSubmit', (e: Event) => {
    const profile = (e as CustomEvent).detail;
    currentProfile = profile;
    currentDiet = profile.dietPreference;
    renderResults(profile);
  });

  document.querySelectorAll('.diet-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!currentProfile) return;
      currentDiet = (btn as HTMLElement).dataset.diet || currentProfile.dietPreference;
      renderResults(currentProfile, currentDiet);
    });
  });

  restoreResultsState();

  function startOver() {
    const resultsSection = document.getElementById('results-section') as HTMLElement;
    const plannerSection = document.getElementById('planner-section') as HTMLElement;
    clearResultsState();
    resultsSection.classList.add('hidden');
    if (plannerSection) {
      plannerSection.classList.remove('hidden');
      plannerSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  document.getElementById('start-over-btn')?.addEventListener('click', startOver);
  document.getElementById('start-over-btn-mobile')?.addEventListener('click', startOver);
</script>
