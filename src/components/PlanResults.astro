      input?.setAttribute('aria-expanded', 'true');
      chevron?.classList.add('rotate-180');

      const initialQuery = forceShowAll ? '' : (input?.value || '');
      renderIngredientList(initialQuery);
    }

    function closeDropdown() {
      if (!isDropdownOpen) return;
      isDropdownOpen = false;
      activeHighlightedIndex = -1;
      dropdownList?.classList.add('hidden');
      input?.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-180');
    }

    function updateClearBtnVisibility() {
      if (!clearBtn || !input) return;
      if (input.value.trim().length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
    }

    function updateHighlightedOption() {
      const options = dropdownList?.querySelectorAll<HTMLElement>('.ingredient-option');
      if (!options || !options.length) return;
      options.forEach((opt, idx) => {
        if (idx === activeHighlightedIndex) {
          opt.classList.add('bg-[#c47a2b]/20', 'dark:bg-[#c47a2b]/30', 'ring-1', 'ring-[#c47a2b]/50');
          opt.scrollIntoView({ block: 'nearest' });
        } else {
          opt.classList.remove('bg-[#c47a2b]/20', 'dark:bg-[#c47a2b]/30', 'ring-1', 'ring-[#c47a2b]/50');
        }
      });
    }

    function moveHighlight(direction: number) {
      if (!currentFiltered.length) return;
      activeHighlightedIndex += direction;
      if (activeHighlightedIndex < 0) activeHighlightedIndex = currentFiltered.length - 1;
      if (activeHighlightedIndex >= currentFiltered.length) activeHighlightedIndex = 0;
      updateHighlightedOption();
    }

    function cleanupAndClose() {
      document.removeEventListener('click', outsideClickListener);
      renderAddButton(bowl, profile);
    }

    const outsideClickListener = (e: MouseEvent) => {
      if (!container.contains(e.target as Node)) {
        cleanupAndClose();
      }
    };

    // Attach listeners
    input?.addEventListener('click', () => {
      if (!isDropdownOpen) {
        openDropdown();
        input.select();
      }
    });

    input?.addEventListener('focus', () => {
      if (!isDropdownOpen) {
        openDropdown();
        input.select();
      }
    });

    input?.addEventListener('input', () => {
      const query = input.value;
      updateClearBtnVisibility();
      if (!isDropdownOpen) {
        openDropdown();
      }
      renderIngredientList(query);
    });

    input?.addEventListener('keydown', (e) => {
      if (!isDropdownOpen) {
        if (e.key === 'ArrowDown' || e.key === 'Enter') {
          e.preventDefault();
          openDropdown();
          input.select();
          return;
        }
      }

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        moveHighlight(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        moveHighlight(-1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (isDropdownOpen) {
          if (activeHighlightedIndex >= 0 && activeHighlightedIndex < currentFiltered.length) {
            selectIngredient(currentFiltered[activeHighlightedIndex]);
          } else if (currentFiltered.length > 0) {
            selectIngredient(currentFiltered[0]);
          }
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        cleanupAndClose();
      } else if (e.key === 'Tab') {
        if (isDropdownOpen && activeHighlightedIndex >= 0 && activeHighlightedIndex < currentFiltered.length) {
          selectIngredient(currentFiltered[activeHighlightedIndex]);
        }
      }
    });

    clearBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (input) {
        input.value = '';
        input.focus();
        updateClearBtnVisibility();
        renderIngredientList('');
        if (!isDropdownOpen) openDropdown(true);
      }
    });

    toggleBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (isDropdownOpen) {
        closeDropdown();
      } else {
        openDropdown(true);
        input?.focus();
        input?.select();
      }
    });

    cancelBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      cleanupAndClose();
    });

    // Auto-open and focus upon clicking "+ Add extra ingredient"
    openDropdown(true);
    input?.focus();

    setTimeout(() => {
      document.addEventListener('click', outsideClickListener);
    }, 10);
  }

  function createSitterLine(value = '', ariaLabel = 'Extra pet sitter instruction line') {
    const lineDiv = document.createElement('div');
    lineDiv.className = 'sitter-blank-line relative flex items-center border-b border-dashed border-[#d8b488] dark:border-[#523518] min-h-[22px]';
    const input = document.createElement('input');
    input.type = 'text';
    input.value = value;
    input.setAttribute('value', value);
    input.className = 'w-full text-xs bg-transparent border-none px-1 py-0.5 text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none';
    input.setAttribute('aria-label', ariaLabel);
    lineDiv.appendChild(input);
    return { lineDiv, input };
  }

  function resetSitterLines() {
    const sitterContainer = document.getElementById('sitter-blank-lines-container');
    if (!sitterContainer) return;
    const lines = Array.from(sitterContainer.querySelectorAll('.sitter-blank-line'));
    while (lines.length > 3) {
      lines.pop()?.remove();
    }
    const inputs = sitterContainer.querySelectorAll<HTMLInputElement>('input');
    if (inputs[0]) { inputs[0].value = 'Fresh water changed 2x daily. Rest 30m before walks.'; inputs[0].setAttribute('value', inputs[0].value); }
    if (inputs[1]) { inputs[1].value = ''; inputs[1].setAttribute('value', ''); }
    if (inputs[2]) { inputs[2].value = ''; inputs[2].setAttribute('value', ''); }
  }

  function saveCurrentState() {
    if (!currentProfile) return;
    const sitterContainer = document.getElementById('sitter-blank-lines-container');
    const sitterNotes = sitterContainer
      ? Array.from(sitterContainer.querySelectorAll<HTMLInputElement>('input')).map(i => i.value)
      : [];
    const vetPhone = (document.getElementById('vet-phone-input') as HTMLInputElement)?.value;
    const amTime = (document.getElementById('am-time-input') as HTMLInputElement)?.value;
    const pmTime = (document.getElementById('pm-time-input') as HTMLInputElement)?.value;
    sessionStorage.setItem(
      RESULTS_STATE_KEY,
      JSON.stringify({
        profile: currentProfile,
        diet: currentProfile.currentDiet || 'fresh',
        amCustomItems,
        pmCustomItems,
        sitterNotes,
        sitterNote1: sitterNotes[0],
        sitterNote2: sitterNotes[1],
        sitterNote3: sitterNotes[2],
        vetPhone,
        amTime,
        pmTime,
      })
    );
  }

  function renderResults(profile: any, dietOverride?: string, shouldScroll: boolean = true) {
    const lang = getCurrentLang();
    const result = calculateCanineNutrition(profile);
    const diet = dietOverride || profile.dietPreference || 'fresh';

    const section = document.getElementById('results-section') as HTMLElement;
    section.classList.remove('hidden');
    if (shouldScroll) {
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    const plannerSection = document.getElementById('planner-section') as HTMLElement;
    if (plannerSection) plannerSection.classList.add('hidden');

    const dogName = result.dogName || 'Lucy';
    const breed = profile.breed || 'Dog';
    const weightDisplay = profile.weightLbs ? `${Math.round(profile.weightLbs)} lbs` : `${result.weightKg} kg`;

    document.querySelectorAll('#card-dog-name').forEach(el => el.textContent = dogName);

    // Card Header
    const cardBreed = document.getElementById('card-dog-breed');
    if (cardBreed) cardBreed.textContent = breed;
    const cardWeight = document.getElementById('card-dog-weight');
    if (cardWeight) cardWeight.textContent = weightDisplay;
    const cardStage = document.getElementById('card-dog-stage');
    if (cardStage) {
      const stage = profile.ageStage || 'adult';
      cardStage.textContent = stage.includes('puppy') ? 'Puppy' : (stage === 'senior' ? 'Senior' : 'Adult');
    }
    const cardDiet = document.getElementById('card-dog-diet');
    if (cardDiet) cardDiet.textContent = getDietDisplayName(profile.currentDiet || profile.dietPreference, lang);
    const cardKcal = document.getElementById('card-dog-kcal');
    if (cardKcal) cardKcal.textContent = `${result.merKcal.toLocaleString(lang)} kcal/day`;

    // Allergies banner
    const allergyBanner = document.getElementById('card-allergy-banner');
    const noAllergyBanner = document.getElementById('card-no-allergy-banner');
    const allergiesList = document.getElementById('card-allergies-list');
    const cleanAllergies = (profile.allergies || []).filter((a: string) => a !== 'none / no allergies');

    if (cleanAllergies.length > 0) {
      allergyBanner?.classList.remove('hidden');
      noAllergyBanner?.classList.add('hidden');
      if (allergiesList) allergiesList.textContent = `Strictly Avoid: ${cleanAllergies.join(', ')}`;
    } else {
      allergyBanner?.classList.add('hidden');
      noAllergyBanner?.classList.remove('hidden');
    }

    // Treat Limit & breakdown (Daily treat cap text removed, Training Bites with exact link)
    const treatLimitEl = document.getElementById('card-treat-limit');
    if (treatLimitEl) treatLimitEl.textContent = String(result.treatKcal);
    const treatBreakdown = document.getElementById('card-treat-breakdown');
    const treatPiecesEl = document.getElementById('card-treat-pieces');
    const trainingBitesCount = Math.max(2, Math.round(result.treatKcal / 10));
    const smallBiscuitsCount = Math.max(1, Math.round(result.treatKcal / 35));

    if (treatBreakdown) {
      treatBreakdown.innerHTML = `<a href="https://link.amazon/B0h2wswVk" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-[#1c0f00] dark:text-[#fde8c8] underline decoration-black dark:decoration-zinc-300 decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">Training Bites</a>`;
    }
    if (treatPiecesEl) {
      treatPiecesEl.textContent = `~${trainingBitesCount} training bites OR ${smallBiscuitsCount} small biscuits`;
    }

    // Weekly checklist table
    const table = document.getElementById('weekly-checklist-table');
    if (table) {
      table.innerHTML = renderWeeklyChecklist(Boolean(profile.hasMeds), lang);
    }


    // Initialize custom bowl items if not restored from session
    if (!sessionStorage.getItem(RESULTS_STATE_KEY)) {
      const weightLbs = profile.weightLbs || 45;
      const stage = profile.ageStage || 'adult';
      const goal = profile.targetGoal || 'maintain';

      // AM default: Salmon Oil
      const salmonItem = INGREDIENTS_CATALOG.find(i => i.id === 'salmon-oil');
      amCustomItems = salmonItem ? [{
        id: salmonItem.id,
        name: salmonItem.name,
        icon: '',
        dose: salmonItem.calculateDose(weightLbs, stage, goal),
        url: salmonItem.affiliateUrl,
      }] : [];

      // PM default: Pumpkin Puree (or Joint Chew for senior)
      const pmTargetId = stage === 'senior' ? 'joint-chew' : 'pumpkin';
      const pmItem = INGREDIENTS_CATALOG.find(i => i.id === pmTargetId);
      pmCustomItems = pmItem ? [{
        id: pmItem.id,
        name: pmItem.name,
        icon: '',
        dose: pmItem.calculateDose(weightLbs, stage, goal),
        url: pmItem.affiliateUrl,
      }] : [];
    }

    // Render bowls & initial '+' buttons
    renderBowlsOnly(profile, lang);

    currentProfile = profile;
    saveCurrentState();
    ensureCardLinksOpenNewTab();
  }

  function ensureCardLinksOpenNewTab() {
    document.querySelectorAll('#fridge-planner-card a').forEach((link) => {
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener noreferrer sponsored');
    });
  }

  function restoreResultsState() {
    const raw = sessionStorage.getItem(RESULTS_STATE_KEY);
    if (!raw) return;
    try {
      const state = JSON.parse(raw);
      if (!state?.profile) return;
      currentProfile = state.profile;
      if (Array.isArray(state.amCustomItems)) amCustomItems = state.amCustomItems;
      if (Array.isArray(state.pmCustomItems)) pmCustomItems = state.pmCustomItems;
      renderResults(currentProfile, state.diet || 'fresh', false);

      const sitterContainer = document.getElementById('sitter-blank-lines-container');
      if (sitterContainer) {
        const notesToRestore = Array.isArray(state.sitterNotes)
          ? state.sitterNotes
          : [state.sitterNote1, state.sitterNote2, state.sitterNote3].filter(n => n !== undefined);

        if (notesToRestore.length > 0) {
          const currentInputs = Array.from(sitterContainer.querySelectorAll<HTMLInputElement>('input'));
          for (let i = 0; i < currentInputs.length; i++) {
            if (notesToRestore[i] !== undefined) {
              currentInputs[i].value = notesToRestore[i];
            }
          }
          for (let i = currentInputs.length; i < notesToRestore.length; i++) {
            const { lineDiv, input } = createSitterLine(notesToRestore[i], `Extra pet sitter instruction line ${i + 1}`);
            sitterContainer.appendChild(lineDiv);
          }
        }
      }

      if (state.vetPhone !== undefined) {
        const el = document.getElementById('vet-phone-input') as HTMLInputElement | null;
        if (el) el.value = state.vetPhone;
      }
      if (state.amTime !== undefined) {
        const el = document.getElementById('am-time-input') as HTMLInputElement | null;
        if (el) el.value = state.amTime;
      }
      if (state.pmTime !== undefined) {
        const el = document.getElementById('pm-time-input') as HTMLInputElement | null;
        if (el) el.value = state.pmTime;
      }
      ensureCardLinksOpenNewTab();
    } catch {
      sessionStorage.removeItem(RESULTS_STATE_KEY);
    }
  }

  function startOver() {
    sessionStorage.removeItem(RESULTS_STATE_KEY);
    currentProfile = null;
    amCustomItems = [];
    pmCustomItems = [];
    resetSitterLines();
    document.getElementById('results-section')?.classList.add('hidden');
    const plannerSection = document.getElementById('planner-section');
    if (plannerSection) {
      plannerSection.classList.remove('hidden');
      document.dispatchEvent(new CustomEvent('dogPlannerReset'));
      plannerSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function syncPrintInputs() {
    const sitterContainer = document.getElementById('sitter-blank-lines-container');
    sitterContainer?.querySelectorAll<HTMLInputElement>('input').forEach(input => {
      input.setAttribute('value', input.value);
    });
    ['vet-phone-input', 'am-time-input', 'pm-time-input'].forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.setAttribute('value', el.value);
    });
  }

  function printPlan() {
    ensureCardLinksOpenNewTab();
    syncPrintInputs();
    document.body.classList.add('printing-plan');
    window.print();
  }

  window.addEventListener('beforeprint', () => {
    const results = document.getElementById('results-section');
    if (results && !results.classList.contains('hidden')) {
      syncPrintInputs();
      document.body.classList.add('printing-plan');
    }
  });

  window.addEventListener('afterprint', () => {
    document.body.classList.remove('printing-plan');
  });

  document.addEventListener('dogPlannerSubmit', (e: Event) => {
    const profile = (e as CustomEvent).detail;
    currentProfile = profile;
    amCustomItems = [];
    pmCustomItems = [];
    sessionStorage.removeItem(RESULTS_STATE_KEY);
    resetSitterLines();
    renderResults(profile);
  });

  document.querySelectorAll('.edit-plan-btn').forEach(btn => {
    btn.addEventListener('click', startOver);
  });
  document.querySelectorAll('.print-card-btn').forEach(btn => {
    btn.addEventListener('click', printPlan);
  });

  const sitterContainer = document.getElementById('sitter-blank-lines-container');
  sitterContainer?.addEventListener('keydown', (e: KeyboardEvent) => {
    const target = e.target as HTMLInputElement;
    if (!target || target.tagName !== 'INPUT') return;
    const inputs = Array.from(sitterContainer.querySelectorAll<HTMLInputElement>('input'));
    const idx = inputs.indexOf(target);
    if (idx === -1) return;

    if (e.key === 'Enter') {
      e.preventDefault();
      if (idx < inputs.length - 1) {
        const next = inputs[idx + 1];
        next.focus();
        const nextLen = next.value.length;
        next.setSelectionRange(nextLen, nextLen);
      } else {
        // Last line: add another line down and focus it
        const { lineDiv, input } = createSitterLine('', `Extra pet sitter instruction line ${inputs.length + 1}`);
        sitterContainer.appendChild(lineDiv);
        input.focus();
        saveCurrentState();
      }
    } else if (e.key === 'Backspace' && idx > 0) {
      if (target.value === '') {
        e.preventDefault();
        const prev = inputs[idx - 1];
        if (inputs.length > 3) {
          target.closest('.sitter-blank-line')?.remove();
        }
        prev.focus();
        const len = prev.value.length;
        prev.setSelectionRange(len, len);
        saveCurrentState();
      } else if (target.selectionStart === 0 && target.selectionEnd === 0) {
        e.preventDefault();
        const prev = inputs[idx - 1];
        prev.focus();
        const len = prev.value.length;
        prev.setSelectionRange(len, len);
      }
    } else if (e.key === 'ArrowUp' && idx > 0) {
      e.preventDefault();
      const prev = inputs[idx - 1];
      prev.focus();
      const pos = Math.min(target.selectionStart ?? prev.value.length, prev.value.length);
      prev.setSelectionRange(pos, pos);
    } else if (e.key === 'ArrowDown' && idx < inputs.length - 1) {
      e.preventDefault();
      const next = inputs[idx + 1];
      next.focus();
      const pos = Math.min(target.selectionStart ?? next.value.length, next.value.length);
      next.setSelectionRange(pos, pos);
    }
  });

  sitterContainer?.addEventListener('input', () => {
    saveCurrentState();
  });

  ['vet-phone-input', 'am-time-input', 'pm-time-input'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', () => {
      saveCurrentState();
    });
  });

  // Restore on page load if present
  restoreResultsState();
</script>
