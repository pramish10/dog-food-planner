  function parseFractionOrDecimal(str?: string): number {
    if (!str) return 1;
    str = str.trim();
    if (str.includes('/')) {
      const parts = str.split('/');
      const n = parseFloat(parts[0]);
      const d = parseFloat(parts[1]);
      return d !== 0 ? n / d : 1;
    }
    return parseFloat(str) || 1;
  }

  function parseLeadingNumber(str?: string): number {
    if (!str) return 1;
    const m = str.trim().match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)/);
    if (m) {
      return parseFractionOrDecimal(m[1]);
    }
    return 1;
  }

  interface DoseParts {
    num: number;
    step: number;
    min: number;
    unit: string;
  }

  function parseDoseParts(doseStr: string): DoseParts {
    if (!doseStr) return { num: 1, step: 1, min: 0.1, unit: '' };

    // 1. Cups with optional grams: e.g. "0.65 cups (152g)"
    const cupMatch = doseStr.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*(cup[s]?(?:\s*\([0-9]+\s*g\))?.*)$/i);
    if (cupMatch) {
      const num = parseFractionOrDecimal(cupMatch[1]);
      return {
        num: Math.round(num * 100) / 100,
        step: 0.05,
        min: 0.05,
        unit: cupMatch[2].trim()
      };
    }

    // 2. Grams: e.g. "15g" or "25 g"
    const gMatch = doseStr.match(/^([0-9]+(?:\.[0-9]+)?)\s*(g(?:rams?)?.*)$/i);
    if (gMatch) {
      const num = parseFloat(gMatch[1]) || 1;
      return {
        num: Math.round(num),
        step: 1,
        min: 1,
        unit: gMatch[2].trim()
      };
    }

    // 3. Small units like tsp, tbsp, pump, can, piece, egg, patty, chew
    const unitMatch = doseStr.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*(.*)$/);
    if (unitMatch) {
      const num = parseFractionOrDecimal(unitMatch[1]);
      const unit = unitMatch[2].trim();
      const isFractional = /^(?:tsp|tbsp|cup|can|pump|oz|piece|egg|patty)/i.test(unit);
      return {
        num: Math.round(num * 100) / 100,
        step: isFractional ? 0.25 : 1,
        min: isFractional ? 0.25 : 1,
        unit
      };
    }

    // 4. Fallback for ranges like "3-5 bites (~30 kcal)"
    const rangeMatch = doseStr.match(/^([0-9]+)(?:-[0-9]+)?\s*(.*)$/);
    if (rangeMatch) {
      const num = parseFloat(rangeMatch[1]) || 1;
      return {
        num,
        step: 1,
        min: 1,
        unit: rangeMatch[2].trim()
      };
    }

    return { num: 1, step: 1, min: 0.1, unit: doseStr };
  }

  function formatFraction(n: number): string {
    if (n <= 0) return '0';
    if (Math.abs(n - 0.125) < 0.04) return '1/8';
    if (Math.abs(n - 0.25) < 0.05) return '1/4';
    if (Math.abs(n - 0.33) < 0.05) return '1/3';
    if (Math.abs(n - 0.5) < 0.05) return '1/2';
    if (Math.abs(n - 0.66) < 0.05) return '2/3';
    if (Math.abs(n - 0.75) < 0.05) return '3/4';
    if (Math.abs(n - 1.25) < 0.05) return '1 1/4';
    if (Math.abs(n - 1.5) < 0.05) return '1 1/2';
    if (Math.abs(n - 1.75) < 0.05) return '1 3/4';
    if (Math.abs(n - 2.5) < 0.05) return '2 1/2';
    if (Number.isInteger(n)) return n.toString();
    return (Math.round(n * 10) / 10).toString();
  }

  function formatDoseString(baseDose: string, qty: number): string {
    if (!baseDose) return `${qty}x`;
    // Check for pump with optional tsp note, e.g. "1 pump (1 tsp)" or "2 pumps (2 tsp)"
    const pumpMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*pump[s]?\s*(?:\((?:(\d+\/\d+|[0-9]+(?:\.[0-9]+)?))\s*tsp\))?/i);
    if (pumpMatch) {
      const basePumps = parseFractionOrDecimal(pumpMatch[1]);
      const currentPumps = Math.max(0.25, Math.round(basePumps * qty * 100) / 100);
      const pumpStr = `${formatFraction(currentPumps)} ${currentPumps <= 1 ? 'pump' : 'pumps'}`;
      if (pumpMatch[2]) {
        const baseTsp = parseFractionOrDecimal(pumpMatch[2]);
        const currentTsp = Math.max(0.25, Math.round(baseTsp * qty * 100) / 100);
        return `${pumpStr} (${formatFraction(currentTsp)} tsp)`;
      }
      return pumpStr;
    }

    // Check for "tbsp"
    const tbspMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*tbsp(.*)$/i);
    if (tbspMatch) {
      const baseVal = parseFractionOrDecimal(tbspMatch[1]);
      const currentVal = Math.max(0.25, baseVal * qty);
      return `${formatFraction(currentVal)} tbsp${tbspMatch[2] || ''}`;
    }

    // Check for "tsp"
    const tspMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*tsp(.*)$/i);
    if (tspMatch) {
      const baseVal = parseFractionOrDecimal(tspMatch[1]);
      const currentVal = Math.max(0.125, baseVal * qty);
      return `${formatFraction(currentVal)} tsp${tspMatch[2] || ''}`;
    }

    // Check for "chew"
    const chewMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*chew[s]?(.*)$/i);
    if (chewMatch) {
      const baseVal = parseFractionOrDecimal(chewMatch[1]);
      const currentVal = Math.max(0.25, baseVal * qty);
      return `${formatFraction(currentVal)} ${currentVal <= 1 ? 'chew' : 'chews'}${chewMatch[2] || ''}`;
    }

    // Check for "egg"
    const eggMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*(?:whole\s*)?egg(.*)$/i);
    if (eggMatch) {
      const baseVal = parseFractionOrDecimal(eggMatch[1]);
      const currentVal = Math.max(0.25, baseVal * qty);
      return `${formatFraction(currentVal)} egg${eggMatch[2] || ''}`;
    }

    // Check for "piece"
    const pieceMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*(?:whole\s*)?piece[s]?(.*)$/i);
    if (pieceMatch) {
      const baseVal = parseFractionOrDecimal(pieceMatch[1]);
      const currentVal = Math.max(0.25, baseVal * qty);
      return `${formatFraction(currentVal)} ${currentVal <= 1 ? 'piece' : 'pieces'}${pieceMatch[2] || ''}`;
    }

    // Check for "can"
    const canMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*can[s]?(.*)$/i);
    if (canMatch) {
      const baseVal = parseFractionOrDecimal(canMatch[1]);
      const currentVal = Math.max(0.25, baseVal * qty);
      return `${formatFraction(currentVal)} ${currentVal <= 1 ? 'can' : 'cans'}${canMatch[2] || ''}`;
    }

    // Check for "patty"
    const pattyMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*patt(?:y|ies)(.*)$/i);
    if (pattyMatch) {
      const baseVal = parseFractionOrDecimal(pattyMatch[1]);
      const currentVal = Math.max(0.5, baseVal * qty);
      return `${formatFraction(currentVal)} ${currentVal <= 1 ? 'patty' : 'patties'}${pattyMatch[2] || ''}`;
    }

    // Check for "cup" with optional grams, e.g. "0.65 cups (152g)"
    const cupMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)\s*cup[s]?(?:\s*\(([0-9]+)\s*g\))?(.*)$/i);
    if (cupMatch) {
      const baseVal = parseFractionOrDecimal(cupMatch[1]);
      const currentVal = Math.max(0.05, Math.round(baseVal * qty * 100) / 100);
      const cupStr = `${currentVal} ${currentVal === 1 ? 'cup' : 'cups'}`;
      if (cupMatch[2]) {
        const baseGrams = parseFloat(cupMatch[2]);
        const currentGrams = Math.round((baseGrams / (baseVal || 1)) * currentVal);
        return `${cupStr} (${currentGrams}g)${cupMatch[3] || ''}`;
      }
      return `${cupStr}${cupMatch[3] || ''}`;
    }

    // Check for leading fraction/number
    const numMatch = baseDose.match(/^(\d+\/\d+|[0-9]+(?:\.[0-9]+)?)(.*)$/);
    if (numMatch) {
      const baseVal = parseFractionOrDecimal(numMatch[1]);
      const currentVal = Math.max(0.25, baseVal * qty);
      return `${formatFraction(currentVal)}${numMatch[2]}`;
    }

    return `${formatFraction(qty)}x ${baseDose}`;
  }

  function calculateOptimizedMealCalorieRange(profile: any, targetMealKcal: number): { minKcal: number; maxKcal: number } {
    let minRatio = 0.90;
    let maxRatio = 1.10;

    const goal = (profile.targetGoal || 'maintain').toLowerCase();
    const bcs = Number(profile.bcs) || 5;
    const stage = (profile.ageStage || 'adult').toLowerCase();
    const weight = Number(profile.weightLbs) || 45;
    const breed = (profile.breed || '').toLowerCase();
    const hasMeds = Boolean(profile.hasMeds);

    // 1. Goal & Body Condition Score (BCS)
    if (goal === 'lose' || bcs >= 7) {
      // Weight loss target: tighter ceiling to prevent accidental surplus
      minRatio = 0.86;
      maxRatio = 1.02;
    } else if (goal === 'gain' || bcs <= 3) {
      // Weight gain / building: elevated floor and ceiling
      minRatio = 0.98;
      maxRatio = 1.16;
    }

    // 2. Life Stage
    if (stage.includes('puppy')) {
      minRatio = Math.max(minRatio, 0.92);
      maxRatio = Math.max(maxRatio, 1.14);
    } else if (stage === 'senior') {
      maxRatio = Math.min(maxRatio, 1.07);
      minRatio = Math.min(minRatio, 0.89);
    }

    // 3. Breed Metabolism & Predispositions
    const slowMetabolismBreeds = ['labrador', 'bulldog', 'pug', 'beagle', 'basset', 'dachshund', 'cocker'];
    const highEnergyBreeds = ['border collie', 'australian shepherd', 'jack russell', 'whippet', 'greyhound', 'husky', 'malinois', 'vizsla'];
    const bloatRiskBreeds = ['great dane', 'german shepherd', 'boxer', 'weimaraner', 'doberman', 'poodle'];

    if (slowMetabolismBreeds.some(b => breed.includes(b))) {
      maxRatio -= 0.03;
    } else if (highEnergyBreeds.some(b => breed.includes(b))) {
      maxRatio += 0.04;
    }

    if (bloatRiskBreeds.some(b => breed.includes(b))) {
      maxRatio = Math.min(maxRatio, 1.08);
    }

    // 4. Toy vs Giant size thermal & metabolic scaling
    if (weight < 15) {
      maxRatio += 0.02;
    } else if (weight > 85) {
      maxRatio -= 0.02;
    }

    // 5. Medicine: Ensure adequate food volume for GI buffer
    if (hasMeds) {
      minRatio = Math.max(minRatio, 0.92);
    }

    // Ensure min is always less than max
    if (minRatio >= maxRatio) {
      minRatio = maxRatio - 0.08;
    }

    const minKcal = Math.round(targetMealKcal * minRatio);
    const maxKcal = Math.round(targetMealKcal * maxRatio);

    return { minKcal, maxKcal };
  }

  function getCurrentLang(): Lang {
    const section = document.getElementById('results-section');
    const sectionLang = section?.getAttribute('data-lang') as Lang;
    if (sectionLang && ['en', 'es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].includes(sectionLang)) {
      return sectionLang;
    }
    const path = window.location.pathname;
    const match = path.match(/^\/([a-z]{2})(\/|$)/);
    if (match && ['en', 'es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].includes(match[1])) {
      return match[1] as Lang;
    }
    return 'en';
  }

  function getExtraTranslations(lang: Lang) {
    return plannerExtraTranslations[lang] || plannerExtraTranslations.en;
  }

  function renderWeeklyChecklist(hasMeds: boolean, lang: Lang): string {
    const days = WEEK_DAYS[lang] || WEEK_DAYS.en;
    const tx = getExtraTranslations(lang);

    const headerCells = days.map(d => `<th class="py-1 px-1 font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] border-b border-[#f0d5a8] dark:border-[#3a2510]">${d}</th>`).join('');

    const amBoxes = days.map((_, i) => `<td class="py-1.5 px-1 border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50"><label class="inline-flex items-center justify-center cursor-pointer"><input type="checkbox" data-check="am-${i}" class="w-4 h-4 rounded border-2 border-[#c47a2b] dark:border-[#e8a44a] text-[#c47a2b] focus:ring-0 cursor-pointer accent-[#c47a2b]" /></label></td>`).join('');

    const pmBoxes = days.map((_, i) => `<td class="py-1.5 px-1 border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50"><label class="inline-flex items-center justify-center cursor-pointer"><input type="checkbox" data-check="pm-${i}" class="w-4 h-4 rounded border-2 border-[#c47a2b] dark:border-[#e8a44a] text-[#c47a2b] focus:ring-0 cursor-pointer accent-[#c47a2b]" /></label></td>`).join('');

    const medsRow = hasMeds ? `
      <tr class="hover:bg-[#fdf8f3]/80 dark:hover:bg-[#2a1a08]/50">
        <td class="py-1.5 px-2 text-left font-bold text-xs text-[#16a34a] whitespace-nowrap border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50">💊 ${tx.medsRow}</td>
        ${days.map((_, i) => `<td class="py-1.5 px-1 border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50"><label class="inline-flex items-center justify-center cursor-pointer"><input type="checkbox" data-check="meds-${i}" class="w-4 h-4 rounded border-2 border-[#16a34a] text-[#16a34a] focus:ring-0 cursor-pointer accent-[#16a34a]" /></label></td>`).join('')}
      </tr>
    ` : '';

    return `
      <thead class="bg-[#fdf8f3] dark:bg-[#2a1a08]">
        <tr>
          <th class="py-1 px-2 text-left font-bold text-xs text-[#92400e] dark:text-[#c4956a] border-b border-[#f0d5a8] dark:border-[#3a2510]">Day</th>
          ${headerCells}
        </tr>
      </thead>
      <tbody class="divide-y divide-[#f0d5a8]/40 dark:divide-[#3a2510]/40">
        <tr class="hover:bg-[#fdf8f3]/80 dark:hover:bg-[#2a1a08]/50">
          <td class="py-1.5 px-2 text-left font-bold text-xs text-[#92400e] dark:text-[#c4956a] whitespace-nowrap border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50">${tx.amFeedRow}</td>
          ${amBoxes}
        </tr>
        <tr class="hover:bg-[#fdf8f3]/80 dark:hover:bg-[#2a1a08]/50">
          <td class="py-1.5 px-2 text-left font-bold text-xs text-[#92400e] dark:text-[#c4956a] whitespace-nowrap border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50">${tx.pmFeedRow}</td>
          ${pmBoxes}
        </tr>
        ${medsRow}
      </tbody>
    `;
  }

  function getCupUnitString(val: number, lang: Lang): string {
    if (lang === 'en') return val === 1 ? 'cup' : 'cups';
    if (lang === 'es') return val === 1 ? 'taza' : 'tazas';
    if (lang === 'fr') return val === 1 ? 'tasse' : 'tasses';
    if (lang === 'de') return val === 1 ? 'Tasse' : 'Tassen';
    if (lang === 'it') return val === 1 ? 'tazza' : 'tazze';
    if (lang === 'pt') return val === 1 ? 'xícara' : 'xícaras';
    const tx = getExtraTranslations(lang);
    return tx.cupsUnit;
  }

  function getDietDisplayName(dietKey: string, lang: Lang): string {
    const tx = getExtraTranslations(lang);
    switch (dietKey) {
      case 'fresh':
      case 'fresh-cooked':
        return tx.dietFresh;
      case 'canned':
        return tx.dietCanned;
      case 'mixed':
        return tx.dietMixed;
      case 'raw':
      case 'raw-barf':
        return tx.dietRaw;
      case 'kibble':
      default:
        return tx.dietKibble;
    }
  }

  function getDetailedRecipeName(profile: any, dietKey: string, lang: Lang): { title: string; amazonQuery: string } {
    const protein = profile.proteinChoice && profile.proteinChoice !== 'auto' ? profile.proteinChoice : 'Salmon';
    const capitalizedProtein = protein.charAt(0).toUpperCase() + protein.slice(1);
    const stage = profile.ageStage || 'adult';
    const allergies = profile.allergies || [];
    const isChickenFree = allergies.some((a: string) => a.toLowerCase().includes('chicken') || a.toLowerCase().includes('poultry'));

    let stagePrefix = 'Adult Complete';
    let queryStage = 'adult';

    if (stage.includes('puppy')) {
      stagePrefix = 'Puppy Growth & Skeletal DHA';
      queryStage = 'puppy';
    } else if (stage === 'senior') {
      stagePrefix = 'Senior Vitality & Mobility';
      queryStage = 'senior';
    }

    let dietSuffix = 'Dry Kibble';
    let queryDiet = 'dry+dog+food';
    if (dietKey === 'canned') {
      dietSuffix = 'Grain-Free Wet Loaf';
      queryDiet = 'grain+free+wet+dog+food';
    } else if (dietKey === 'mixed') {
      dietSuffix = 'Kibble & Fresh Topper Mix';
      queryDiet = 'dry+dog+food+with+toppers';
    } else if (dietKey === 'fresh' || dietKey === 'fresh-cooked') {
      dietSuffix = 'Human-Grade Gently Cooked Bowl';
      queryDiet = 'human+grade+fresh+dog+food';
    } else if (dietKey === 'raw' || dietKey === 'raw-barf') {
      dietSuffix = 'Freeze-Dried Raw BARF Patty';
      queryDiet = 'freeze+dried+raw+dog+food';
    }

    let query = `${queryStage}+${protein}+${queryDiet}`;
    if (isChickenFree && !query.includes('chicken+free')) {
      query += '+chicken+free';
    }

    const title = `${stagePrefix} (${capitalizedProtein} Formula) ${dietSuffix}`;
    return { title, amazonQuery: query };
  }

  function renderBowlsOnly(profile: any, lang: Lang) {
    const result = calculateCanineNutrition(profile);
    const tx = getExtraTranslations(lang);

    const meals = Math.max(1, result.mealsPerDay || 2);
    const defaultMealCupsNum = Number((result.dailyCupsEst / meals).toFixed(2));
    const defaultMealGramsNum = result.perMealGrams;
    const defaultMealKcal = Math.round(result.mealKcal / meals);

    // Scaling factors for cups to grams and kcal
    const gramsPerCup = defaultMealCupsNum > 0 ? (defaultMealGramsNum / defaultMealCupsNum) : 230;
    const kcalPerCup = defaultMealCupsNum > 0 ? (defaultMealKcal / defaultMealCupsNum) : 300;

    // Initialize or keep custom cups state
    if (amCustomCups === null) amCustomCups = defaultMealCupsNum;
    if (pmCustomCups === null) pmCustomCups = defaultMealCupsNum;

    const currentAmCups = amCustomCups;
    const currentAmGrams = Math.round(currentAmCups * gramsPerCup);
    const currentAmDishKcal = Math.round(currentAmCups * kcalPerCup);

    const currentPmCups = pmCustomCups;
    const currentPmGrams = Math.round(currentPmCups * gramsPerCup);
    const currentPmDishKcal = Math.round(currentPmCups * kcalPerCup);

    const dietKey = profile.currentDiet || profile.dietPreference || 'fresh';
    const recipe = getDetailedRecipeName(profile, dietKey, lang);
    const isFresh = dietKey === 'fresh' || dietKey === 'fresh-cooked';
    const isKibble = dietKey === 'kibble';
    const protein = (profile.proteinChoice || 'salmon').toLowerCase();

    const isChickenFree = Array.isArray(profile.allergies) && profile.allergies.some((a: string) => a.toLowerCase().includes('chicken') || a.toLowerCase().includes('poultry'));

    let recipeUrl = `https://www.amazon.com/s?k=${recipe.amazonQuery}&tag=dogfoodplanner-20`;
    if (isFresh) {
      if (isChickenFree && protein === 'salmon') {
        recipeUrl = 'https://link.amazon/B0a52bV8X';
      } else if (protein === 'salmon' || protein === 'auto') {
        recipeUrl = 'https://link.amazon/B0gWhHriE';
      } else if (protein === 'chicken' || protein === 'turkey') {
        recipeUrl = 'https://link.amazon/B0fpxfvVg';
      } else {
        recipeUrl = 'https://link.amazon/B0gWhHriE';
      }
    } else if (isKibble && (protein === 'salmon' || protein === 'auto')) {
      recipeUrl = 'https://link.amazon/B0h1I7guA';
    } else if (isKibble && (protein === 'chicken' || protein === 'turkey')) {
      recipeUrl = 'https://link.amazon/B0j9UbC9Z';
    } else if (dietKey === 'canned') {
      if (isChickenFree && protein === 'salmon') {
        recipeUrl = 'https://link.amazon/B0a52bV8X';
      } else if (protein === 'salmon' || protein === 'auto') {
        recipeUrl = 'https://link.amazon/B0gWhHriE';
      } else {
        recipeUrl = 'https://link.amazon/B0cbv1oLz';
      }
    } else if (dietKey === 'raw' || dietKey === 'raw-barf') {
      recipeUrl = 'https://link.amazon/B0i140Q91';
    }

    const amList = document.getElementById('card-am-items');
    const pmList = document.getElementById('card-pm-items');

    // Calculate scientifically optimized meal calorie range based on breed, age, weight, medicine, and goals
    const targetMealKcal = defaultMealKcal;
    const { minKcal, maxKcal } = calculateOptimizedMealCalorieRange(profile, targetMealKcal);

    // Calculate current total calories in AM and PM
    const amBaseKcal = amIncludeBase ? currentAmDishKcal : 0;
    const amItemsKcal = amCustomItems.reduce((acc, it) => acc + (it.kcal || 0), 0);
    const amTotalKcal = amBaseKcal + amItemsKcal;

    const pmBaseKcal = pmIncludeBase ? currentPmDishKcal : 0;
    const pmItemsKcal = pmCustomItems.reduce((acc, it) => acc + (it.kcal || 0), 0);
    const pmTotalKcal = pmBaseKcal + pmItemsKcal;

    const dailyTotalKcal = amTotalKcal + pmTotalKcal;
    const dailyTargetKcal = defaultMealKcal * 2;
    const { minKcal: dailyMinKcal, maxKcal: dailyMaxKcal } = calculateOptimizedMealCalorieRange(profile, dailyTargetKcal);

    // Helper to generate base dish HTML for a given bowl with small adjuster before recipe name
    // Helper to generate base dish HTML for a given bowl with small, simple up/down adjuster before recipe name
    function getBaseItemHtml(bowl: 'am' | 'pm', isIncluded: boolean): string {
      const currentCups = bowl === 'am' ? currentAmCups : currentPmCups;
      const currentGrams = bowl === 'am' ? currentAmGrams : currentPmGrams;
      const dishKcal = bowl === 'am' ? currentAmDishKcal : currentPmDishKcal;

      if (isIncluded) {
        return `
          <li class="flex items-start gap-2 font-medium text-xs sm:text-sm mb-2.5 pb-0.5 print:mb-3 print:pb-1 group">
            <span class="text-[#c47a2b] font-bold shrink-0 mt-0.5">•</span>
            <div class="leading-relaxed flex-1 min-w-0">
              <strong class="font-bold text-[#1c0f00] dark:text-[#fde8c8] font-mono">${currentCups} ${getCupUnitString(currentCups, lang)}</strong>
              <span class="text-[#92400e]/80 dark:text-[#c4956a]/80 font-mono">(${currentGrams}${tx.gramsUnit})</span>
              <span class="stepper-box inline-flex flex-col justify-center items-center select-none no-print border border-[#d6c4b2] dark:border-[#523920] rounded-[3px] bg-[#fbf7f2] dark:bg-[#25170b] overflow-hidden shrink-0 mx-1" style="width: 14px; height: 16px; vertical-align: middle; position: relative; top: -2px;">
                <button
                  type="button"
                  data-step-base="${bowl}"
                  data-delta="0.05"
                  class="step-base-btn stepper-arrow-btn text-stone-600 hover:text-[#c47a2b] hover:bg-[#c47a2b]/20 active:bg-[#c47a2b]/40 dark:text-stone-300 dark:hover:text-[#f59e0b] cursor-pointer transition-colors"
                  title="Increase portion (+0.05 ${getCupUnitString(Math.round((currentCups + 0.05) * 100) / 100, lang)})"
                  aria-label="Increase portion"
                >
                  <svg class="w-2 h-1.5 pointer-events-none" viewBox="0 0 10 6" fill="currentColor"><path d="M5 0.5L9.5 5.5H0.5L5 0.5Z"/></svg>
                </button>
                <div style="height: 1px; width: 100%;" class="bg-[#e5d5c5] dark:bg-[#3d2813]"></div>
                <button
                  type="button"
                  data-step-base="${bowl}"
                  data-delta="-0.05"
                  class="step-base-btn stepper-arrow-btn text-stone-600 hover:text-[#c47a2b] hover:bg-[#c47a2b]/20 active:bg-[#c47a2b]/40 dark:text-stone-300 dark:hover:text-[#f59e0b] cursor-pointer transition-colors"
                  title="Decrease portion (-0.05 ${getCupUnitString(Math.max(0.05, Math.round((currentCups - 0.05) * 100) / 100), lang)})"
                  aria-label="Decrease portion"
                >
                  <svg class="w-2 h-1.5 pointer-events-none" viewBox="0 0 10 6" fill="currentColor"><path d="M5 5.5L0.5 0.5H9.5L5 5.5Z"/></svg>
                </button>
              </span>
              <a href="${recipeUrl}" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-[#1c0f00] dark:text-[#fde8c8] hover:text-[#c47a2b] transition-colors cursor-pointer">
                <span>${recipe.title}</span>
              </a>
              <span class="base-dish-kcal inline-block ml-1 font-mono text-[10px] font-bold text-[#b45309] dark:text-[#fbbf24] bg-amber-50 dark:bg-amber-950/40 px-1.5 py-0.5 rounded border border-amber-200 dark:border-amber-800/60">${dishKcal} kcal</span>
              <button type="button" data-remove-base="${bowl}" class="remove-base-btn inline-flex items-center justify-center w-3.5 h-3.5 rounded text-[#92400e]/50 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer ml-1 align-middle no-print" title="Remove main dish" aria-label="Remove main dish">
                <svg class="w-3 h-3 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </li>
        `;
      }
      return '';
    }

    // Helper to generate custom added items HTML for a given bowl with small, simple up/down adjuster before ingredient name
    function getCustomItemsHtml(bowl: 'am' | 'pm', items: BowlCustomItem[], hasBase: boolean): string {
      return items.map((item, index) => {
        return `
          <li class="flex items-start gap-1.5 text-xs sm:text-sm text-[#1c0f00] dark:text-[#fde8c8] group py-1.5 ${index === 0 && hasBase ? 'mt-2.5 pt-1' : 'mt-1.5 print:mt-2.5'}">
            <span class="text-[#c47a2b] font-bold shrink-0 mt-0.5">•</span>
            <div class="leading-relaxed flex-1 min-w-0">
              <strong class="font-bold text-[#1c0f00] dark:text-[#fde8c8] font-mono">${escapeHtml(item.dose)}</strong>
              <span class="stepper-box inline-flex flex-col justify-center items-center select-none no-print border border-[#d6c4b2] dark:border-[#523920] rounded-[3px] bg-[#fbf7f2] dark:bg-[#25170b] overflow-hidden shrink-0 mx-1" style="width: 14px; height: 16px; vertical-align: middle; position: relative; top: -2px;">
                <button
                  type="button"
                  data-step-item="${bowl}"
                  data-item-index="${index}"
                  data-delta="0.25"
                  class="step-item-btn stepper-arrow-btn text-stone-600 hover:text-[#c47a2b] hover:bg-[#c47a2b]/20 active:bg-[#c47a2b]/40 dark:text-stone-300 dark:hover:text-[#f59e0b] cursor-pointer transition-colors"
                  title="Increase dose"
                  aria-label="Increase dose"
                >
                  <svg class="w-2 h-1.5 pointer-events-none" viewBox="0 0 10 6" fill="currentColor"><path d="M5 0.5L9.5 5.5H0.5L5 0.5Z"/></svg>
                </button>
                <div style="height: 1px; width: 100%;" class="bg-[#e5d5c5] dark:bg-[#3d2813]"></div>
                <button
                  type="button"
                  data-step-item="${bowl}"
                  data-item-index="${index}"
                  data-delta="-0.25"
                  class="step-item-btn stepper-arrow-btn text-stone-600 hover:text-[#c47a2b] hover:bg-[#c47a2b]/20 active:bg-[#c47a2b]/40 dark:text-stone-300 dark:hover:text-[#f59e0b] cursor-pointer transition-colors"
                  title="Decrease dose"
                  aria-label="Decrease dose"
                >
                  <svg class="w-2 h-1.5 pointer-events-none" viewBox="0 0 10 6" fill="currentColor"><path d="M5 5.5L0.5 0.5H9.5L5 5.5Z"/></svg>
                </button>
              </span>
              <a href="${item.url}" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-[#1c0f00] dark:text-[#fde8c8] hover:text-[#c47a2b] transition-colors cursor-pointer">
                <span>${item.name}</span>
              </a>
              <span class="item-dish-kcal inline-block ml-1 font-mono text-[10px] font-bold text-[#b45309] dark:text-[#fbbf24] bg-amber-50 dark:bg-amber-950/40 px-1.5 py-0.5 rounded border border-amber-200 dark:border-amber-800/60 shrink-0">+${item.kcal} kcal</span>
              <button type="button" data-remove-bowl="${bowl}" data-item-index="${index}" class="remove-ingredient-btn inline-flex items-center justify-center w-3.5 h-3.5 rounded text-[#92400e]/50 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer shrink-0 ml-1 align-middle no-print" title="Remove ingredient" aria-label="Remove ${item.name}">
                <svg class="w-3 h-3 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </li>
        `;
      }).join('');
    }

    const medsHtml = profile.hasMeds
      ? `
        <li class="flex items-start gap-2 text-xs text-[#16a34a] font-semibold mt-2 pt-2 border-t border-[#f0d5a8]/50 dark:border-[#3a2510]/50">
          <span>•</span>
          <span>[ ] Daily Medication (Administer in morning bowl)</span>
        </li>
      `
      : '';

    if (amList) {
      amList.innerHTML = getBaseItemHtml('am', amIncludeBase) + getCustomItemsHtml('am', amCustomItems, amIncludeBase) + medsHtml;
    }
    if (pmList) {
      pmList.innerHTML = getBaseItemHtml('pm', pmIncludeBase) + getCustomItemsHtml('pm', pmCustomItems, pmIncludeBase);
    }

    // Helper to generate Calorie Display Widget HTML: Clean range only, no progressive meter line
    function renderCalorieWidgetHtml(totalKcal: number): string {
      return `
        <div class="bg-[#fdf8f3] dark:bg-[#1a0f05]/70 border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl p-2.5">
          <!-- Total calories in that food (Centered) -->
          <div class="px-3 py-1.5 bg-[#c47a2b]/10 dark:bg-[#c47a2b]/25 border border-[#c47a2b]/30 dark:border-[#c47a2b]/40 rounded-lg text-center shadow-xs">
            <span class="block text-[10px] sm:text-xs font-mono uppercase font-black text-[#c47a2b] dark:text-[#f59e0b] leading-tight">
              ${tx.totalCaloriesLabel}
            </span>
            <span class="text-base sm:text-lg font-mono font-black text-[#b45309] dark:text-[#fbbf24] tracking-tight">
              <span class="bowl-total-kcal">${totalKcal}</span> <span class="text-xs font-bold">kcal</span>
            </span>
          </div>

          <!-- Clean Range of numbers below it (No progress lines, no extra text) -->
          <div class="mt-1.5 text-center text-xs font-mono font-bold text-[#92400e] dark:text-[#e8a44a] tracking-wide">
            <span>${minKcal} kcal – ${maxKcal} kcal</span>
          </div>
        </div>
      `;
    }

    // Helper to generate Total Daily Consumed Calorie Widget HTML (Clean range based on breed, age, weight, goal & medicine)
    function renderDailyCalorieWidgetHtml(totalDailyKcal: number): string {
      return `
        <div class="bg-[#fdf8f3] dark:bg-[#1a0f05]/70 border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl p-2.5">
          <div class="max-w-md mx-auto">
            <!-- Total daily calories consumed (Centered) -->
            <div class="px-3 py-1.5 bg-[#c47a2b]/10 dark:bg-[#c47a2b]/25 border border-[#c47a2b]/30 dark:border-[#c47a2b]/40 rounded-lg text-center shadow-xs">
              <span class="block text-[10px] sm:text-xs font-mono uppercase font-black text-[#c47a2b] dark:text-[#f59e0b] leading-tight">
                ${tx.totalDailyCaloriesLabel}
              </span>
              <span class="text-base sm:text-lg font-mono font-black text-[#b45309] dark:text-[#fbbf24] tracking-tight">
                <span class="daily-total-kcal">${totalDailyKcal}</span> <span class="text-xs font-bold">kcal</span>
              </span>
            </div>

            <!-- Clean Daily Range of numbers below it (Accurate to breed, age, weight, goal & medicine) -->
            <div class="mt-1.5 text-center text-xs font-mono font-bold text-[#92400e] dark:text-[#e8a44a] tracking-wide">
              <span>${dailyMinKcal} kcal – ${dailyMaxKcal} kcal</span>
            </div>
          </div>
        </div>
      `;
    }

    const amWidget = document.getElementById('am-calories-widget');
    const pmWidget = document.getElementById('pm-calories-widget');
    const dailyWidget = document.getElementById('daily-calories-widget');
    if (amWidget) amWidget.innerHTML = renderCalorieWidgetHtml(amTotalKcal);
    if (pmWidget) pmWidget.innerHTML = renderCalorieWidgetHtml(pmTotalKcal);
    if (dailyWidget) dailyWidget.innerHTML = renderDailyCalorieWidgetHtml(dailyTotalKcal);

    // Helper to refresh total meal & daily calorie widgets dynamically
    function refreshCalorieWidgets() {
      const amBaseK = amIncludeBase ? Math.round(defaultMealKcal * ((amCustomCups ?? defaultMealCupsNum) / defaultMealCupsNum)) : 0;
      const amItemsK = amCustomItems.reduce((acc, it) => acc + (it.kcal || 0), 0);
      const pmBaseK = pmIncludeBase ? Math.round(defaultMealKcal * ((pmCustomCups ?? defaultMealCupsNum) / defaultMealCupsNum)) : 0;
      const pmItemsK = pmCustomItems.reduce((acc, it) => acc + (it.kcal || 0), 0);

      const amTot = amBaseK + amItemsK;
      const pmTot = pmBaseK + pmItemsK;
      const dailyTot = amTot + pmTot;

      const amW = document.getElementById('am-calories-widget');
      const pmW = document.getElementById('pm-calories-widget');
      const dailyW = document.getElementById('daily-calories-widget');
      if (amW) amW.innerHTML = renderCalorieWidgetHtml(amTot);
      if (pmW) pmW.innerHTML = renderCalorieWidgetHtml(pmTot);
      if (dailyW) dailyW.innerHTML = renderDailyCalorieWidgetHtml(dailyTot);
    }

    // Attach base portion stepper handlers ([-] and [+] buttons for cups)
    document.querySelectorAll('.step-base-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const delta = parseFloat((btn as HTMLElement).dataset.delta || '0');
        const bowl = (btn as HTMLElement).dataset.stepBase;
        if (bowl === 'am') {
          amCustomCups = Math.max(0.05, Math.round(((amCustomCups ?? defaultMealCupsNum) + delta) * 100) / 100);
        } else if (bowl === 'pm') {
          pmCustomCups = Math.max(0.05, Math.round(((pmCustomCups ?? defaultMealCupsNum) + delta) * 100) / 100);
        }
        renderBowlsOnly(profile, lang);
        saveCurrentState();
      });
    });

    // Attach custom item stepper handlers ([-] and [+] buttons for extra ingredients)
    document.querySelectorAll('.step-item-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const bowl = (btn as HTMLElement).dataset.stepItem;
        const index = parseInt((btn as HTMLElement).dataset.itemIndex || '-1', 10);
        const delta = parseFloat((btn as HTMLElement).dataset.delta || '0');
        if (index >= 0) {
          const list = bowl === 'am' ? amCustomItems : pmCustomItems;
          const item = list[index];
          if (item) {
            const isFormula = item.id.includes('formula') || item.id.includes('diet') || (item.baseDose && item.baseDose.includes('cup'));
            const stepDelta = isFormula ? (delta > 0 ? 0.05 : -0.05) : delta;
            item.qty = Math.max(0.05, Math.round(((item.qty || 1) + stepDelta) * 100) / 100);
            item.dose = formatDoseString(item.baseDose || item.dose, item.qty);
            item.kcal = Math.max(1, Math.round((item.baseKcal || 20) * item.qty));
            renderBowlsOnly(profile, lang);
            saveCurrentState();
          }
        }
      });
    });

    // Attach remove handlers for custom ingredients
    document.querySelectorAll('.remove-ingredient-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const bowl = (btn as HTMLElement).dataset.removeBowl;
        const index = parseInt((btn as HTMLElement).dataset.itemIndex || '-1', 10);
        if (index >= 0) {
          if (bowl === 'am') amCustomItems.splice(index, 1);
          if (bowl === 'pm') pmCustomItems.splice(index, 1);
          renderBowlsOnly(profile, lang);
          saveCurrentState();
        }
      });
    });

    // Attach remove handlers for base formula
    document.querySelectorAll('.remove-base-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const bowl = (btn as HTMLElement).dataset.removeBase;
        if (bowl === 'am') amIncludeBase = false;
        if (bowl === 'pm') pmIncludeBase = false;
        renderBowlsOnly(profile, lang);
        saveCurrentState();
      });
    });

    // Render the single '+' Add extra ingredient buttons for AM & PM
    renderAddButton('am', profile);
    renderAddButton('pm', profile);
  }

