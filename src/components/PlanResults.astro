    if (isFresh) {
      if (isChickenFree && protein === 'salmon') {
        recipeUrl = 'https://link.amazon/B0a52bV8X';
      } else if (protein === 'salmon' || protein === 'auto') {
        recipeUrl = 'https://link.amazon/B0gWhHriE';
      } else if (protein === 'chicken' || protein === 'turkey') {
        recipeUrl = 'https://link.amazon/B0fpxfvVg';
      } else {
        recipeUrl = 'https://link.amazon/B0gWhHriE';
      }
    } else if (isKibble && (protein === 'salmon' || protein === 'auto')) {
      recipeUrl = 'https://link.amazon/B0h1I7guA';
    } else if (isKibble && (protein === 'chicken' || protein === 'turkey')) {
      recipeUrl = 'https://link.amazon/B0j9UbC9Z';
    } else if (dietKey === 'canned') {
      if (isChickenFree && protein === 'salmon') {
        recipeUrl = 'https://link.amazon/B0a52bV8X';
      } else if (protein === 'salmon' || protein === 'auto') {
        recipeUrl = 'https://link.amazon/B0gWhHriE';
      } else {
        recipeUrl = 'https://link.amazon/B0cbv1oLz';
