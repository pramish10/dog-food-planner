---
import { getLangFromUrl } from '../i18n/utils';
import { plannerTranslations } from '../i18n/planner';
import { plannerExtraTranslations } from '../i18n/plannerExtra';

const lang = getLangFromUrl(Astro.url);
const p = plannerTranslations[lang] || plannerTranslations.en;
const px = plannerExtraTranslations[lang] || plannerExtraTranslations.en;
---

<section id="results-section" class="hidden py-6 sm:py-8 bg-[#fdf8f3] dark:bg-[#150d04] border-b border-[#f0e0cc] dark:border-[#2a1f14]" data-lang={lang}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6">

    <!-- ────────────────────────────────────────────────────────────────────────
         THE PRINTABLE FRIDGE PLANNER & PET SITTER CARD (Centerpiece)
         ──────────────────────────────────────────────────────────────────────── -->
    <div id="fridge-planner-card" class="bg-white dark:bg-[#1c1208] border-2 border-[#1c0f00] dark:border-[#f0d5a8] rounded-2xl p-4 sm:p-6 shadow-md text-[#1c0f00] dark:text-[#fde8c8]">

      <!-- Card Top Header (Goal badge removed per user request) -->
      <div class="border-b-2 border-[#1c0f00] dark:border-[#f0d5a8] pb-3 mb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xl">🐾</span>
            <h3 class="text-base sm:text-lg font-black text-[#1c0f00] dark:text-[#fde8c8] tracking-tight uppercase">
              <span id="card-dog-name">LUCY</span>'S {px.cardHeaderBadge}
            </h3>
          </div>
          <div class="text-xs font-mono text-[#92400e] dark:text-[#c4956a] mt-0.5">
            <span id="card-dog-breed">Golden Retriever</span> • <span id="card-dog-weight">55 lbs</span> • <span id="card-dog-stage">Adult</span> • <span id="card-dog-diet">Fresh Cooked</span> • <span id="card-dog-kcal" class="text-[#c47a2b] font-bold">1,075 kcal/day</span>
          </div>
        </div>

        <!-- Emergency Vet Phone Box -->
        <div class="flex items-center gap-2 border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl px-3 py-1.5 bg-[#fdf8f3] dark:bg-[#2a1a08] shrink-0">
          <span class="text-sm">🏥</span>
          <div>
            <div class="text-[9px] font-mono uppercase font-bold text-[#92400e] dark:text-[#c4956a] leading-none">{px.vetPhoneLabel}</div>
            <input type="text" id="vet-phone-input" value="(555) 0199" placeholder={px.vetPhonePlaceholder}
              class="text-xs font-bold font-mono text-[#1c0f00] dark:text-[#fde8c8] bg-transparent border-none p-0 focus:outline-none w-32" />
          </div>
        </div>
      </div>

      <!-- Allergy Alert Banner -->
      <div id="card-allergy-banner" class="mb-3 p-2 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-300 dark:border-red-800 flex items-center gap-2 text-xs text-red-900 dark:text-red-200 font-semibold">
        <span class="text-base shrink-0">⚠️</span>
        <div>
          <span class="font-bold uppercase tracking-wider">{px.allergyAlertPrefix}:</span>
          <span id="card-allergies-list" class="font-bold underline ml-1">No Chicken / Poultry!</span>
        </div>
      </div>
      <div id="card-no-allergy-banner" class="hidden mb-3 p-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 flex items-center gap-2 text-xs text-emerald-800 dark:text-emerald-300 font-medium">
        <span>✅</span>
        <span>{px.noAllergiesNotice}</span>
      </div>

      <!-- Morning & Evening Bowls (Side by Side with Interactive Inline Add Ingredient) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3 items-start" id="card-bowls-grid" style="align-items: start;">
        <!-- Morning Bowl -->
        <div class="border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl p-3 bg-[#fdf8f3]/60 dark:bg-[#2a1a08]/40 self-start h-auto" style="align-self: start; height: fit-content;">
          <div class="flex items-center justify-between border-b border-[#f0d5a8] dark:border-[#3a2510] pb-1.5 mb-2">
            <div class="flex items-center gap-1.5 font-bold text-xs font-mono uppercase text-[#1c0f00] dark:text-[#fde8c8]">
              <span>☀️</span>
              <span id="am-bowl-title">{px.morningBowlTitle}</span>
            </div>
            <input type="text" id="am-time-input" value="7:30 AM" class="text-xs font-mono font-bold text-[#c47a2b] bg-transparent border-b border-[#c47a2b]/30 w-20 text-right focus:outline-none" />
          </div>
          <ul id="card-am-items" class="space-y-2.5 text-xs sm:text-sm text-[#1c0f00] dark:text-[#fde8c8]">
            <!-- populated by JS -->
          </ul>

          <!-- Add Ingredient Interactive Row (AM) - sits immediately below previous ingredient -->
          <div id="am-add-container" class="mt-2 no-print">
            <!-- Populated by JS -->
          </div>
        </div>

        <!-- Evening Bowl -->
        <div class="border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl p-3 bg-[#fdf8f3]/60 dark:bg-[#2a1a08]/40 self-start h-auto" style="align-self: start; height: fit-content;" id="card-pm-bowl-wrapper">
          <div class="flex items-center justify-between border-b border-[#f0d5a8] dark:border-[#3a2510] pb-1.5 mb-2">
            <div class="flex items-center gap-1.5 font-bold text-xs font-mono uppercase text-[#1c0f00] dark:text-[#fde8c8]">
              <span>🌙</span>
              <span id="pm-bowl-title">{px.eveningBowlTitle}</span>
            </div>
            <input type="text" id="pm-time-input" value="6:00 PM" class="text-xs font-mono font-bold text-[#c47a2b] bg-transparent border-b border-[#c47a2b]/30 w-20 text-right focus:outline-none" />
          </div>
          <ul id="card-pm-items" class="space-y-2.5 text-xs sm:text-sm text-[#1c0f00] dark:text-[#fde8c8]">
            <!-- populated by JS -->
          </ul>

          <!-- Add Ingredient Interactive Row (PM) - sits immediately below previous ingredient -->
          <div id="pm-add-container" class="mt-2 no-print">
            <!-- Populated by JS -->
          </div>
        </div>
      </div>

      <!-- Treat Limit & Training Budget Box (Daily treat cap text removed, Training Bites with inline styled link) -->
      <div class="border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl p-2.5 bg-amber-50/50 dark:bg-amber-950/20 mb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
        <div class="flex items-start gap-2">
          <span class="text-base shrink-0">🦴</span>
          <div>
            <div class="font-bold text-[#1c0f00] dark:text-[#fde8c8] uppercase font-mono">{px.treatBudgetHeader}</div>
            <div class="text-xs text-[#92400e] dark:text-[#c4956a] mt-0.5" id="card-treat-breakdown">
              <a href="https://link.amazon/B0h2wswVk" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-[#1c0f00] dark:text-[#fde8c8] underline decoration-black dark:decoration-zinc-300 decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
                Training Bites
              </a>
            </div>
          </div>
        </div>
        <div class="font-mono font-bold text-sm text-[#c47a2b] sm:text-right shrink-0">
          <span id="card-treat-limit">95</span> kcal/day
          <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] font-normal" id="card-treat-pieces">~2 small biscuits or rewards</div>
        </div>
      </div>

      <!-- Weekly Feeding Checklist Table -->
      <div class="border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl p-2.5 mb-3 bg-white dark:bg-[#1c1208]">
        <div class="text-xs font-bold font-mono text-[#1c0f00] dark:text-[#fde8c8] uppercase mb-1.5 flex items-center gap-1.5">
          <span>📅</span>
          <span>{px.weeklyChecklistHeader}</span>
          <span class="text-[10px] font-normal text-[#92400e] dark:text-[#c4956a] normal-case ml-auto">(Tick when fed)</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-center text-xs font-mono border-collapse" id="weekly-checklist-table">
            <!-- populated by JS -->
          </table>
        </div>
      </div>

      <!-- Pet Sitter & Family Instructions -->
      <div class="border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl p-2.5 bg-[#fdf8f3]/60 dark:bg-[#2a1a08]/40 mb-3">
        <label for="sitter-note-input" class="block text-[10px] font-mono uppercase font-semibold text-[#92400e] dark:text-[#c4956a] mb-1">
          Pet Sitter & Family Instructions:
        </label>
        <!-- 3 matching lines: Line 1 with prefilled text, plus 2 blank lines for extra notes/handwriting -->
        <div class="space-y-1.5" id="sitter-blank-lines-container">
          <div class="sitter-blank-line relative flex items-center border-b border-dashed border-[#d8b488] dark:border-[#523518] min-h-[22px]">
            <input type="text" id="sitter-note-input" value="Fresh water changed 2x daily. Rest 30m before walks." aria-label="Pet Sitter & Family Instructions Line 1"
              class="w-full text-xs bg-transparent border-none px-1 py-0.5 text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none" />
          </div>
          <div class="sitter-blank-line relative flex items-center border-b border-dashed border-[#d8b488] dark:border-[#523518] min-h-[22px]">
            <input type="text" id="sitter-note-input-2" placeholder="" aria-label="Extra pet sitter instruction line 2"
              class="w-full text-xs bg-transparent border-none px-1 py-0.5 text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none" />
          </div>
          <div class="sitter-blank-line relative flex items-center border-b border-dashed border-[#d8b488] dark:border-[#523518] min-h-[22px]">
            <input type="text" id="sitter-note-input-3" placeholder="" aria-label="Extra pet sitter instruction line 3"
              class="w-full text-xs bg-transparent border-none px-1 py-0.5 text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none" />
          </div>
        </div>
      </div>

      <!-- Action Bar: Print Fridge Card only + Start Over near it (Zero duplicates, hidden in print) -->
      <div class="mt-3 pt-3 border-t border-[#f0d5a8] dark:border-[#3a2510] flex items-center justify-between gap-3 no-print">
        <div class="flex items-center gap-2.5">
          <button type="button" class="print-card-btn px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-[#c47a2b] hover:bg-[#a8621f] rounded-xl transition-all shadow-sm flex items-center gap-2 cursor-pointer touch-manipulation min-h-[42px]">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
            </svg>
            <span>{px.printFridgeBtn}</span>
          </button>
          <button type="button" class="edit-plan-btn text-xs sm:text-sm font-semibold text-[#92400e] dark:text-[#c4956a] hover:text-[#c47a2b] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl px-4 py-2.5 transition-colors flex items-center gap-1.5 cursor-pointer min-h-[42px]">
            <span>🔄</span>
            <span>{p.startOverBtn}</span>
          </button>
        </div>
      </div>


    </div><!-- end #fridge-planner-card -->

  </div>
</section>

<script>
  import { calculateCanineNutrition } from '../utils/nutritionEngine';
  import { plannerExtraTranslations } from '../i18n/plannerExtra';
  import type { Lang } from '../i18n/ui';

  const WEEK_DAYS: Record<Lang, string[]> = {
    en: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    es: ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'],
    ja: ['月', '火', '水', '木', '金', '土', '日'],
    fr: ['Lun', 'Mer', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'],
    de: ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'],
    pt: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'],
    ko: ['월', '화', '수', '목', '금', '토', '일'],
    it: ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'],
  };

  interface CatalogItem {
    id: string;
    icon: string;
    name: string;
    affiliateUrl: string;
    calculateDose: (weightLbs: number, stage: string, goal: string) => string;
  }

  // Predefined catalog with exact affiliate URLs & automated personalized canine portion calculation
  const INGREDIENTS_CATALOG: CatalogItem[] = [
    {
      id: 'salmon-oil',
      icon: '🐟',
      name: 'Salmon Oil',
      affiliateUrl: 'https://link.amazon/B02zrZWPG',
      calculateDose: (w) => (w < 25 ? '1/2 pump (1/2 tsp)' : w > 60 ? '2 pumps (2 tsp)' : '1 pump (1 tsp)'),
    },
    {
      id: 'pumpkin',
      icon: '🎃',
      name: 'Pumpkin Puree',
      affiliateUrl: 'https://link.amazon/B06zoxxSD',
      calculateDose: (w) => (w < 20 ? '1 tsp' : w > 50 ? '2 tbsp' : '1 tbsp'),
    },
    {
      id: 'bone-broth',
      icon: '🥣',
      name: 'Bone Broth',
      affiliateUrl: 'https://link.amazon/B0c8qZk7Y',
      calculateDose: (w) => (w < 20 ? '1 tbsp' : w > 50 ? '1/4 cup (2 oz)' : '2 tbsp (1 oz)'),
    },
    {
      id: 'blueberries',
      icon: '🫐',
      name: 'Fresh Blueberries',
      affiliateUrl: 'https://link.amazon/B09gsTFIp',
      calculateDose: (w) => (w < 20 ? '3–4 berries' : w > 50 ? '2 tbsp (~12 berries)' : '1 tbsp (~6 berries)'),
    },
    {
      id: 'joint-chew',
      icon: '🦴',
      name: 'Joint Chew',
      affiliateUrl: 'https://link.amazon/B01H3PPzn',
      calculateDose: (w) => (w < 30 ? '1/2 chew' : w > 70 ? '2 chews' : '1 chew'),
    },
    {
      id: 'egg',
      icon: '🥚',
      name: 'Hard-Boiled Egg',
      affiliateUrl: 'https://www.amazon.com/s?k=organic+dog+food+eggs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '1/4 egg' : w > 60 ? '1 whole egg' : '1/2 egg'),
    },
    {
      id: 'greek-yogurt',
      icon: '🥛',
      name: 'Plain Greek Yogurt',
      affiliateUrl: 'https://link.amazon/B0ar2KGqk',
      calculateDose: (w) => (w < 25 ? '1 tsp' : w > 60 ? '2 tbsp' : '1 tbsp'),
    },
    {
      id: 'goat-kefir',
      icon: '🍶',
      name: 'Goat Milk Kefir',
      affiliateUrl: 'https://www.amazon.com/s?k=raw+goat+milk+for+dogs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '1 tbsp' : w > 60 ? '1/4 cup' : '2 tbsp'),
    },
    {
      id: 'chia-seeds',
      icon: '🌱',
      name: 'Chia Seeds (Hydrated)',
      affiliateUrl: 'https://www.amazon.com/s?k=organic+chia+seeds+for+dogs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '1/4 tsp' : w > 60 ? '1 tsp' : '1/2 tsp'),
    },
    {
      id: 'carrots',
      icon: '🥕',
      name: 'Steamed Carrots (Diced)',
      affiliateUrl: 'https://www.amazon.com/s?k=freeze+dried+carrots+for+dogs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '1 tbsp' : w > 60 ? '3 tbsp' : '2 tbsp'),
    },
    {
      id: 'spinach',
      icon: '🥬',
      name: 'Steamed Spinach',
      affiliateUrl: 'https://www.amazon.com/s?k=green+superfood+powder+for+dogs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '1/2 tbsp' : w > 60 ? '2 tbsp' : '1 tbsp'),
    },
    {
      id: 'green-beans',
      icon: '🫘',
      name: 'Steamed Green Beans',
      affiliateUrl: 'https://www.amazon.com/s?k=dehydrated+green+beans+dog&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '2–3 beans' : w > 60 ? '1/2 cup' : '1/4 cup'),
    },
    {
      id: 'beef-tripe',
      icon: '🥩',
      name: 'Green Beef Tripe',
      affiliateUrl: 'https://www.amazon.com/s?k=freeze+dried+green+beef+tripe+dogs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '1 tbsp' : w > 60 ? '1/4 cup' : '2 tbsp'),
    },
    {
      id: 'beef-liver',
      icon: '🍖',
      name: 'Freeze-Dried Beef Liver',
      affiliateUrl: 'https://link.amazon/B0gmcEnwI',
      calculateDose: (w) => (w < 25 ? '1 small piece' : w > 60 ? '3 pieces' : '2 pieces'),
    },
    {
      id: 'sardines',
      icon: '🐟',
      name: 'Canned Sardines (in water)',
      affiliateUrl: 'https://link.amazon/B01vM8LZC',
      calculateDose: (w) => (w < 25 ? '1/2 sardine' : w > 60 ? '2 sardines' : '1 sardine'),
    },
    {
      id: 'coconut-oil',
      icon: '🥥',
      name: 'Virgin Coconut Oil',
      affiliateUrl: 'https://www.amazon.com/s?k=organic+virgin+coconut+oil+dogs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '1/4 tsp' : w > 60 ? '1 tsp' : '1/2 tsp'),
    },
    {
      id: 'turmeric-paste',
      icon: '✨',
      name: 'Turmeric Golden Paste',
      affiliateUrl: 'https://www.amazon.com/s?k=turmeric+curcumin+supplement+dogs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '1/8 tsp' : w > 60 ? '1/2 tsp' : '1/4 tsp'),
    },
    {
      id: 'zucchini',
      icon: '🥒',
      name: 'Steamed Zucchini',
      affiliateUrl: 'https://www.amazon.com/s?k=healthy+veggie+mix+for+dogs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '1 tbsp' : w > 60 ? '3 tbsp' : '2 tbsp'),
    },
    {
      id: 'cranberries',
      icon: '🍒',
      name: 'Cranberries (Unsweetened)',
      affiliateUrl: 'https://www.amazon.com/s?k=cranberry+bladder+support+dogs&tag=dogfoodplanner-20',
      calculateDose: (w) => (w < 25 ? '3–4 berries' : w > 60 ? '1.5 tbsp' : '1 tbsp'),
    },
  ];

  interface BowlCustomItem {
    id: string;
    name: string;
    icon: string;
    dose: string;
    url: string;
  }

  const RESULTS_STATE_KEY = 'dfp-results-state';
  let currentProfile: any = null;
  let amCustomItems: BowlCustomItem[] = [];
  let pmCustomItems: BowlCustomItem[] = [];

  function getCurrentLang(): Lang {
    const section = document.getElementById('results-section');
    const sectionLang = section?.getAttribute('data-lang') as Lang;
    if (sectionLang && ['en', 'es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].includes(sectionLang)) {
      return sectionLang;
    }
    const path = window.location.pathname;
    const match = path.match(/^\/([a-z]{2})(\/|$)/);
    if (match && ['en', 'es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'].includes(match[1])) {
      return match[1] as Lang;
    }
    return 'en';
  }

  function getExtraTranslations(lang: Lang) {
    return plannerExtraTranslations[lang] || plannerExtraTranslations.en;
  }

  function renderWeeklyChecklist(hasMeds: boolean, lang: Lang): string {
    const days = WEEK_DAYS[lang] || WEEK_DAYS.en;
    const tx = getExtraTranslations(lang);

    const headerCells = days.map(d => `<th class="py-1 px-1 font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] border-b border-[#f0d5a8] dark:border-[#3a2510]">${d}</th>`).join('');

    const amBoxes = days.map((_, i) => `<td class="py-1.5 px-1 border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50"><label class="inline-flex items-center justify-center cursor-pointer"><input type="checkbox" data-check="am-${i}" class="w-4 h-4 rounded border-2 border-[#c47a2b] dark:border-[#e8a44a] text-[#c47a2b] focus:ring-0 cursor-pointer accent-[#c47a2b]" /></label></td>`).join('');

    const pmBoxes = days.map((_, i) => `<td class="py-1.5 px-1 border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50"><label class="inline-flex items-center justify-center cursor-pointer"><input type="checkbox" data-check="pm-${i}" class="w-4 h-4 rounded border-2 border-[#c47a2b] dark:border-[#e8a44a] text-[#c47a2b] focus:ring-0 cursor-pointer accent-[#c47a2b]" /></label></td>`).join('');

    const medsRow = hasMeds ? `
      <tr class="hover:bg-[#fdf8f3]/80 dark:hover:bg-[#2a1a08]/50">
        <td class="py-1.5 px-2 text-left font-bold text-xs text-[#16a34a] whitespace-nowrap border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50">💊 ${tx.medsRow}</td>
        ${days.map((_, i) => `<td class="py-1.5 px-1 border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50"><label class="inline-flex items-center justify-center cursor-pointer"><input type="checkbox" data-check="meds-${i}" class="w-4 h-4 rounded border-2 border-[#16a34a] text-[#16a34a] focus:ring-0 cursor-pointer accent-[#16a34a]" /></label></td>`).join('')}
      </tr>
    ` : '';

    return `
      <thead class="bg-[#fdf8f3] dark:bg-[#2a1a08]">
        <tr>
          <th class="py-1 px-2 text-left font-bold text-xs text-[#92400e] dark:text-[#c4956a] border-b border-[#f0d5a8] dark:border-[#3a2510]">Day</th>
          ${headerCells}
        </tr>
      </thead>
      <tbody class="divide-y divide-[#f0d5a8]/40 dark:divide-[#3a2510]/40">
        <tr class="hover:bg-[#fdf8f3]/80 dark:hover:bg-[#2a1a08]/50">
          <td class="py-1.5 px-2 text-left font-bold text-xs text-[#92400e] dark:text-[#c4956a] whitespace-nowrap border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50">${tx.amFeedRow}</td>
          ${amBoxes}
        </tr>
        <tr class="hover:bg-[#fdf8f3]/80 dark:hover:bg-[#2a1a08]/50">
          <td class="py-1.5 px-2 text-left font-bold text-xs text-[#92400e] dark:text-[#c4956a] whitespace-nowrap border-b border-[#f0d5a8]/50 dark:border-[#3a2510]/50">${tx.pmFeedRow}</td>
          ${pmBoxes}
        </tr>
        ${medsRow}
      </tbody>
    `;
  }

  function getDietDisplayName(dietKey: string, lang: Lang): string {
    const tx = getExtraTranslations(lang);
    switch (dietKey) {
      case 'fresh':
      case 'fresh-cooked':
        return tx.dietFresh;
      case 'canned':
        return tx.dietCanned;
      case 'mixed':
        return tx.dietMixed;
      case 'raw':
      case 'raw-barf':
        return tx.dietRaw;
      case 'kibble':
      default:
        return tx.dietKibble;
    }
  }

  function getDetailedRecipeName(profile: any, dietKey: string, lang: Lang): { title: string; amazonQuery: string } {
    const protein = profile.proteinChoice && profile.proteinChoice !== 'auto' ? profile.proteinChoice : 'Salmon';
    const capitalizedProtein = protein.charAt(0).toUpperCase() + protein.slice(1);
    const stage = profile.ageStage || 'adult';
    const allergies = profile.allergies || [];
    const isChickenFree = allergies.some((a: string) => a.toLowerCase().includes('chicken') || a.toLowerCase().includes('poultry'));

    let stagePrefix = 'Adult Complete';
    let queryStage = 'adult';

    if (stage.includes('puppy')) {
      stagePrefix = 'Puppy Growth & Skeletal DHA';
      queryStage = 'puppy';
    } else if (stage === 'senior') {
      stagePrefix = 'Senior Vitality & Mobility';
      queryStage = 'senior';
    }

    let dietSuffix = 'Dry Kibble';
    let queryDiet = 'dry+dog+food';
    if (dietKey === 'canned') {
      dietSuffix = 'Grain-Free Wet Loaf';
      queryDiet = 'grain+free+wet+dog+food';
    } else if (dietKey === 'mixed') {
      dietSuffix = 'Kibble & Fresh Topper Mix';
      queryDiet = 'dry+dog+food+with+toppers';
    } else if (dietKey === 'fresh' || dietKey === 'fresh-cooked') {
      dietSuffix = 'Human-Grade Gently Cooked Bowl';
      queryDiet = 'human+grade+fresh+dog+food';
    } else if (dietKey === 'raw' || dietKey === 'raw-barf') {
      dietSuffix = 'Freeze-Dried Raw BARF Patty';
      queryDiet = 'freeze+dried+raw+dog+food';
    }

    let query = `${queryStage}+${protein}+${queryDiet}`;
    if (isChickenFree && !query.includes('chicken+free')) {
      query += '+chicken+free';
    }

    const title = `${stagePrefix} (${capitalizedProtein} Formula) ${dietSuffix}`;
    return { title, amazonQuery: query };
  }

  function renderBowlsOnly(profile: any, lang: Lang) {
    const result = calculateCanineNutrition(profile);
    const tx = getExtraTranslations(lang);

    const meals = Math.max(1, result.mealsPerDay || 2);
    const perMealGrams = result.perMealGrams;
    const perMealCups = (result.dailyCupsEst / meals).toFixed(2);
    const dietKey = profile.currentDiet || profile.dietPreference || 'fresh';

    const recipe = getDetailedRecipeName(profile, dietKey, lang);
    const isFresh = dietKey === 'fresh' || dietKey === 'fresh-cooked';
    const isKibble = dietKey === 'kibble';
    const protein = (profile.proteinChoice || 'salmon').toLowerCase();

    const isChickenFree = Array.isArray(profile.allergies) && profile.allergies.some((a: string) => a.toLowerCase().includes('chicken') || a.toLowerCase().includes('poultry'));

    // Specific affiliate links:
