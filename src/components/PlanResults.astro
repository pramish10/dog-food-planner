---
import { RECIPES } from '../data/recipes';
import { getLangFromUrl } from '../i18n/utils';
import { plannerTranslations } from '../i18n/planner';

const lang = getLangFromUrl(Astro.url);
const p = plannerTranslations[lang] || plannerTranslations.en;
---

<section id="results-section" class="py-12 sm:py-20 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626] transition-all hidden" data-lang={lang}>
  <div class="max-w-5xl mx-auto px-3.5 sm:px-6">
    
    <!-- Results Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8 sm:mb-10 pb-6 border-b border-[#ebebeb] dark:border-[#262626]">
      <div>
        <div class="inline-flex items-center gap-1.5 font-mono text-[10px] sm:text-xs uppercase font-medium text-[#10b981] bg-[#10b981]/10 px-3 py-1 rounded-full mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
          {p.readyBadge}
        </div>
        <h2 class="text-2xl sm:text-4xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">
          {p.mealPlanFor} <span id="res-dog-name" class="text-[#0070f3] dark:text-[#3291ff]">Lucy</span>
        </h2>
        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-1" id="res-dog-subtitle">
          {p.planSubtitle}
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2 w-full sm:w-auto">
        <button 
          id="print-plan-btn"
          class="no-print w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-semibold text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#ebebeb] dark:hover:bg-[#262626] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-full transition-all shadow-2xs cursor-pointer touch-manipulation active:scale-[0.98]"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.75A2.25 2.25 0 0014.25 1.5h-4.5A2.25 2.25 0 007.5 3.75v3.456"/>
          </svg>
          {p.printBtn}
        </button>
      </div>
    </div>

    <!-- General Purpose & Educational Disclaimer Banner -->
    <div class="mb-8 p-3.5 sm:p-4 rounded-xl bg-amber-500/10 border border-amber-500/25 flex items-start gap-3 text-xs text-[#4d4d4d] dark:text-[#cccccc] leading-relaxed">
      <span class="text-base sm:text-lg shrink-0 mt-0.5">🐾</span>
      <div>
        <strong class="font-semibold text-amber-900 dark:text-amber-300">{p.resultsDisclaimerTitle}</strong>
        <span> {p.resultsDisclaimerText}</span>
      </div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3.5 mb-8 sm:mb-10">
      
      <!-- Card 1: Daily food energy -->
      <div class="p-3.5 sm:p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414]">
        <div class="flex items-center justify-between text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono mb-1 sm:mb-2 uppercase">
          <span>{p.cardEnergyTitle}</span>
          <span class="text-[#0070f3] dark:text-[#3291ff]">{p.cardEnergyGuide}</span>
        </div>
        <div class="text-xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed] font-mono tracking-tight" id="res-mer-calories">
          984 <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f] dark:text-[#737373]">kcal</span>
        </div>
        <div class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] mt-0.5 sm:mt-1 font-mono">
          {p.cardEnergyBase} <span id="res-rer-base">615</span> kcal
        </div>
      </div>

      <!-- Card 2: Total Daily Weight -->
      <div class="p-3.5 sm:p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414]">
        <div class="flex items-center justify-between text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono mb-1 sm:mb-2 uppercase">
          <span>{p.cardPortionTitle}</span>
          <span class="text-[#10b981]">{p.cardPortionTotal}</span>
        </div>
        <div class="text-xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed] font-mono tracking-tight" id="res-daily-grams">
          728 <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f] dark:text-[#737373]">{p.cardPortionGrams}</span>
        </div>
        <div class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] mt-0.5 sm:mt-1 font-mono">
          ≈ <span id="res-daily-cups">3.2</span> {p.cardPortionCups}
        </div>
      </div>

      <!-- Card 3: Per Meal Split -->
      <div class="p-3.5 sm:p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414]">
        <div class="flex items-center justify-between text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono mb-1 sm:mb-2 uppercase">
          <span>{p.cardPerMealTitle}</span>
          <span class="text-[#7928ca] dark:text-[#a35cf0]" id="res-meals-count">{p.cardPerMealTimes}</span>
        </div>
        <div class="text-xl sm:text-3xl font-bold text-[#171717] dark:text-[#ededed] font-mono tracking-tight" id="res-per-meal-grams">
          364 <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f] dark:text-[#737373]">{p.cardPerMealBowl}</span>
        </div>
        <div class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] mt-0.5 sm:mt-1 font-mono">
          {p.cardPerMealSched}
        </div>
      </div>

      <!-- Card 4: Treat & Snack Allowance -->
      <div class="p-3.5 sm:p-5 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414]">
        <div class="flex items-center justify-between text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono mb-1 sm:mb-2 uppercase">
          <span>{p.cardTreatTitle}</span>
          <span class="text-[#f5a623] font-semibold" id="res-treat-pct">10%</span>
        </div>
        <div class="text-xl sm:text-3xl font-bold text-[#f5a623] font-mono tracking-tight" id="res-treat-kcal">
          98 <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f] dark:text-[#737373]">{p.cardTreatKcalDay}</span>
        </div>
        <div class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] mt-0.5 sm:mt-1 font-mono">
          {p.cardTreatAllowance}
        </div>
      </div>

    </div>

    <!-- Diet Switcher Pills -->
    <div class="no-print overflow-x-auto pb-2 sm:pb-0 mb-6 sm:mb-8 no-scrollbar">
      <div class="flex items-center gap-1.5 sm:gap-2 p-1 bg-[#f2f2f2] dark:bg-[#1a1a1a] rounded-lg border border-[#ebebeb] dark:border-[#2e2e2e] min-w-max">
        <button 
          type="button" 
          data-diet="fresh-cooked" 
          class="diet-tab-btn active px-3 sm:px-4 py-2 text-[11px] sm:text-xs font-semibold rounded-md bg-white dark:bg-[#262626] text-[#171717] dark:text-white shadow-xs transition-all touch-manipulation cursor-pointer"
        >
          🍲 {p.dietFresh}
        </button>
        <button 
          type="button" 
          data-diet="raw-barf" 
          class="diet-tab-btn px-3 sm:px-4 py-2 text-[11px] sm:text-xs font-semibold rounded-md text-[#8f8f8f] dark:text-[#737373] hover:text-[#171717] dark:hover:text-white transition-all touch-manipulation cursor-pointer"
        >
          🥩 {p.dietRaw}
        </button>
        <button 
          type="button" 
          data-diet="superfood-topper" 
          class="diet-tab-btn px-3 sm:px-4 py-2 text-[11px] sm:text-xs font-semibold rounded-md text-[#8f8f8f] dark:text-[#737373] hover:text-[#171717] dark:hover:text-white transition-all touch-manipulation cursor-pointer"
        >
          🥣 {p.dietTopper}
        </button>
      </div>
    </div>

    <!-- SECTION A: Recipe-specific daily meal schedule -->
    <div class="hairline-card p-4 sm:p-8 mb-8 sm:mb-10 bg-white dark:bg-[#141414]">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#ebebeb] dark:border-[#262626]">
        <div>
          <span class="font-mono text-[10px] sm:text-xs font-bold text-[#0070f3] dark:text-[#3291ff] uppercase tracking-wider">
            {p.todayRecipePrefix}
          </span>
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mt-0.5">
            {p.bowlSectionTitle} <span class="res-dog-name-inline">Lucy</span>
          </h3>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="timed-schedule-container">
        <!-- Dynamically rendered via JS -->
      </div>
    </div>

      <!-- SECTION B: Your recipe and a simple meal overview -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 mb-10 sm:mb-12">
      
      <!-- Left 2 Cols: Ingredient Blueprint -->
      <div class="lg:col-span-2 space-y-5 sm:space-y-6">
        
        <div class="hairline-card p-4 sm:p-8 bg-white dark:bg-[#141414]">
          <div class="flex items-center justify-between mb-2.5 sm:mb-3">
            <span class="font-mono text-[10px] sm:text-xs text-[#0070f3] dark:text-[#3291ff] font-semibold uppercase tracking-wider" id="recipe-diet-tag">
              {p.todayRecipePrefix}
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-semibold text-[#171717] dark:text-[#ededed] mb-2" id="recipe-title">
            Gently Cooked Lean Turkey & Pumpkin Feast
          </h3>
          <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed mb-5 sm:mb-6" id="recipe-description">
            Slow-simmered lean ground turkey paired with antioxidant-rich pumpkin puree, steamed greens, and wild Alaskan salmon oil.
          </p>
          <p class="text-[11px] text-[#8f8f8f] dark:text-[#737373] -mt-3 mb-5" id="recipe-match-note" aria-live="polite"></p>

          <!-- Ingredients Grams Table -->
          <div class="mb-5 sm:mb-6">
            <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono mb-2.5 sm:mb-3">
              {p.ingredientsHeader}
            </h4>
            <div class="divide-y divide-[#ebebeb] dark:divide-[#262626] border border-[#ebebeb] dark:border-[#262626] rounded-lg overflow-hidden" id="ingredient-rows-container">
              <!-- Dynamically populated via JS -->
            </div>
          </div>

          <!-- Step-by-Step Preparation Guide -->
          <div>
            <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono mb-2.5 sm:mb-3">
              {p.prepStepsHeader}
            </h4>
            <ol class="space-y-2 text-xs text-[#4d4d4d] dark:text-[#a1a1a1]" id="prep-steps-container">
              <!-- Populated via JS -->
            </ol>
          </div>

        </div>

      </div>

      <!-- Right Col: Simple meal overview -->
      <div class="space-y-5 sm:space-y-6">
        
        <!-- Macro Breakdown Card -->
        <div class="hairline-card p-4 sm:p-6 bg-white dark:bg-[#141414]">
          <div class="flex items-center justify-between mb-3 sm:mb-4">
            <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
              Macronutrient Target
            </h4>
          </div>

          <div class="space-y-3 sm:space-y-4 mb-5 sm:mb-6">
            <div>
              <div class="flex justify-between text-xs font-medium mb-1">
                <span class="text-[#171717] dark:text-[#ededed]">Protein</span>
                <span class="font-mono text-[#0070f3] dark:text-[#3291ff]" id="macro-protein-pct">48%</span>
              </div>
              <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-2 rounded-full overflow-hidden">
                <div class="bg-[#0070f3] dark:bg-[#3291ff] h-full rounded-full" id="macro-protein-bar" style="width: 48%;"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-medium mb-1">
                <span class="text-[#171717] dark:text-[#ededed]">Healthy Fats & Omegas</span>
                <span class="font-mono text-[#7928ca] dark:text-[#a35cf0]" id="macro-fat-pct">32%</span>
              </div>
              <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-2 rounded-full overflow-hidden">
                <div class="bg-[#7928ca] dark:bg-[#a35cf0] h-full rounded-full" id="macro-fat-bar" style="width: 32%;"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-medium mb-1">
                <span class="text-[#171717] dark:text-[#ededed]">Vegetables & fibre</span>
                <span class="font-mono text-[#10b981]" id="macro-fiber-pct">4%</span>
              </div>
              <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-2 rounded-full overflow-hidden">
                <div class="bg-[#10b981] h-full rounded-full" id="macro-fiber-bar" style="width: 4%;"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-medium mb-1">
                <span class="text-[#171717] dark:text-[#ededed]">Hydration / Moisture</span>
                <span class="font-mono text-[#50e3c2]" id="macro-moisture-pct">74%</span>
              </div>
              <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-2 rounded-full overflow-hidden">
                <div class="bg-[#50e3c2] h-full rounded-full" id="macro-moisture-bar" style="width: 74%;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 7-Day Transition Card -->
        <div class="hairline-card p-4 sm:p-6 bg-white dark:bg-[#141414] space-y-3">
          <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
            {p.transitionHeader}
          </h4>
          <ul class="space-y-1.5 text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">
            <li class="flex items-center gap-2"><span>🟢</span> {p.transitionP1}</li>
            <li class="flex items-center gap-2"><span>🟡</span> {p.transitionP2}</li>
            <li class="flex items-center gap-2"><span>🟠</span> {p.transitionP3}</li>
            <li class="flex items-center gap-2"><span>⭐</span> {p.transitionP4}</li>
          </ul>
        </div>

        <!-- Recipe selection summary -->
        <div class="hairline-card p-4 sm:p-6 bg-gradient-to-b from-white to-[#fafafa] dark:from-[#141414] dark:to-[#171717]">
          <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono mb-3">Why this recipe</h4>
          <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed" id="recipe-selection-summary">This recipe is selected from your feeding style, protein preference, health focus, and stated sensitivities.</p>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] leading-relaxed" id="recipe-method-summary">Recipe matching uses feeding style first, removes selected sensitivities, then ranks the remaining recipes by protein preference, health focus, and energy density. Energy is a starting estimate; use a complete and balanced recipe formulated for your dog's life stage and review it with your veterinarian for long-term feeding.</p>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  import { calculateCanineNutrition } from '../utils/nutritionEngine';
  import { RECIPES } from '../data/recipes';

  let currentProfile: any = null;

  const ALLERGY_ALIASES: Record<string, string[]> = {
    'chicken / poultry': ['chicken', 'poultry', 'turkey'],
    beef: ['beef'],
    dairy: ['dairy'],
    eggs: ['egg'],
    'grains / wheat': ['grain', 'wheat'],
    soy: ['soy'],
    corn: ['corn']
  };

  function selectRecipe(profile: any) {
    const dietRecipes = RECIPES.filter((recipe) => recipe.dietType === profile.dietPreference);
    const avoidedAllergies = (profile.allergies || []).filter((allergy: string) => allergy !== 'none / no allergies');
    const allergySafeRecipes = dietRecipes.filter((recipe) => !recipe.ingredients.some((ingredient) =>
      (ingredient.allergens || []).some((allergen) => avoidedAllergies.some((allergy: string) =>
        (ALLERGY_ALIASES[allergy] || [allergy]).some((alias) => allergen.toLowerCase().includes(alias))
      ))
    ));
    const availableRecipes = allergySafeRecipes;
    const preferredProtein = profile.proteinChoice?.toLowerCase();
    const needsLowerEnergy = profile.targetGoal === 'lose' || profile.bcs >= 7 || profile.activityLevel === 'sedentary';
    const needsMoreEnergy = profile.targetGoal === 'gain' || profile.bcs <= 3 || ['active', 'working'].includes(profile.activityLevel);
    const scoredRecipes = availableRecipes.map((recipe) => {
      let score = 0;
      if (preferredProtein && !preferredProtein.includes('no pref') && recipe.primaryProtein.toLowerCase() === preferredProtein) score += 100;
      if (recipe.healthFocusMatches.includes(profile.healthFocus)) score += 30;
      if (needsLowerEnergy) score -= recipe.macroProfile.kcalPerGram * 10;
      if (needsMoreEnergy) score += recipe.macroProfile.kcalPerGram * 10;
      return { recipe, score };
    }).sort((a, b) => b.score - a.score);

    // Sensitivities are hard exclusions. A no-match result is handled in the caller.
    return scoredRecipes[0]?.recipe || null;
  }

  const INGREDIENT_IMAGES: Record<string, string> = {
    'Muscle Meat': 'https://images.unsplash.com/photo-1604503468506-a8da13d82791?auto=format&fit=crop&w=160&h=160&q=80',
    'Organ': 'https://images.unsplash.com/photo-1603360946369-dc9bb6258143?auto=format&fit=crop&w=160&h=160&q=80',
    'Raw Bone': 'https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&w=160&h=160&q=80',
    'Vegetables & Greens': 'https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=160&h=160&q=80',
    'Healthy Fats & Oils': 'https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?auto=format&fit=crop&w=160&h=160&q=80',
    'Natural Supplements': 'https://images.unsplash.com/photo-1550572017-edd951b55104?auto=format&fit=crop&w=160&h=160&q=80'
  };

  function ingredientShoppingLinks(name: string) {
    const query = encodeURIComponent(name);
    return {
      grocery: `https://www.google.com/search?tbm=shop&q=${query}`,
      amazon: `https://www.amazon.com/s?k=${query}`
    };
  }

  function renderPlan(profile: any) {
    const result = calculateCanineNutrition(profile);

    // Update Headings
    const dogNameEl = document.getElementById('res-dog-name');
    const subtitleEl = document.getElementById('res-dog-subtitle');
    const inlines = document.querySelectorAll('.res-dog-name-inline');
    
    if (dogNameEl) dogNameEl.textContent = result.dogName;
    inlines.forEach((el) => { el.textContent = result.dogName; });

    if (subtitleEl) {
      subtitleEl.textContent = `${profile.breed} · ${Math.round(profile.weightLbs)} lbs (${result.weightKg} kg) · Goal: ${profile.targetGoal.toUpperCase()}`;
    }

    // Update Top Metric Cards
    const merEl = document.getElementById('res-mer-calories');
    const rerEl = document.getElementById('res-rer-base');
    const dailyGramsEl = document.getElementById('res-daily-grams');
    const dailyCupsEl = document.getElementById('res-daily-cups');
    const perMealEl = document.getElementById('res-per-meal-grams');
    const mealsCountEl = document.getElementById('res-meals-count');
    const treatPctEl = document.getElementById('res-treat-pct');
    const treatKcalEl = document.getElementById('res-treat-kcal');

    if (merEl) merEl.innerHTML = `${result.merKcal} <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f]">kcal</span>`;
    if (rerEl) rerEl.textContent = `${result.rerKcal}`;
    if (dailyGramsEl) dailyGramsEl.innerHTML = `${result.activeDailyGrams} <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f]">grams</span>`;
    if (dailyCupsEl) dailyCupsEl.textContent = `${result.dailyCupsEst}`;
    if (perMealEl) perMealEl.innerHTML = `${result.perMealGrams} <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f]">g/bowl</span>`;
    if (mealsCountEl) mealsCountEl.textContent = `${result.mealsPerDay}x Daily`;
    if (treatPctEl) treatPctEl.textContent = `${profile.treatBudgetPct ?? 10}%`;
    if (treatKcalEl) treatKcalEl.innerHTML = `${result.treatKcal} <span class="text-[10px] sm:text-xs font-normal text-[#8f8f8f]">kcal/day</span>`;

    // Find Matching Recipe
    const recipe = selectRecipe(profile);
    if (!recipe) {
      const selectionSummary = document.getElementById('recipe-selection-summary');
      if (selectionSummary) selectionSummary.textContent = 'No recipe in this feeding style safely matches every selected sensitivity. Please choose another feeding style or ask your veterinarian for a formulated diet.';
      return;
    }

    const dietTagEl = document.getElementById('recipe-diet-tag');
    const recipeTitleEl = document.getElementById('recipe-title');
    const recipeDescEl = document.getElementById('recipe-description');
    const rowsContainer = document.getElementById('ingredient-rows-container');
    const prepContainer = document.getElementById('prep-steps-container');

    if (dietTagEl) dietTagEl.textContent = `TODAY'S RECIPE: ${recipe.dietType.replace('-', ' ')}`;
    if (recipeTitleEl) recipeTitleEl.textContent = recipe.name;
    if (recipeDescEl) recipeDescEl.textContent = recipe.description;

    const matchNote = document.getElementById('recipe-match-note');
    const avoidedAllergies = (profile.allergies || []).filter((allergy: string) => allergy !== 'none / no allergies');
    const selectionSummary = document.getElementById('recipe-selection-summary');
    const methodSummary = document.getElementById('recipe-method-summary');
    const dietName = recipe.dietType === 'fresh-cooked'
      ? 'fresh-cooked meals'
      : recipe.dietType === 'raw-barf'
        ? 'raw BARF meals'
        : 'a superfood topper';
    const proteinSelected = profile.proteinChoice && !profile.proteinChoice.includes('No Pref');
    const proteinReason = proteinSelected
      ? `You selected ${profile.proteinChoice}, and ${recipe.name} uses ${recipe.primaryProtein.toLowerCase()} as its main protein.`
      : `You selected a balanced protein choice, so we chose this lean ${recipe.primaryProtein.toLowerCase()} recipe as an everyday option.`;
    const healthReason = recipe.healthFocusMatches.includes(profile.healthFocus)
      ? `It supports your ${profile.healthFocus} focus.`
      : `It is the closest available match for your ${profile.healthFocus || 'General Health'} focus.`;
    const safetyReason = avoidedAllergies.length
      ? ` It also avoids your selected sensitivity: ${avoidedAllergies.join(', ')}.`
      : ' No ingredient sensitivities were selected.';
    const ageStageLabel = ({ 'puppy-early': 'early puppy growth stage', 'puppy-late': 'late puppy growth stage', adult: 'adult life stage', senior: 'senior life stage' } as Record<string, string>)[profile.ageStage] || profile.ageStage;
    const sensitivityReason = avoidedAllergies.length
      ? `The recipe excludes your reported sensitivities: ${avoidedAllergies.join(', ')}.`
      : 'No ingredient sensitivities were reported, so no ingredients needed to be excluded.';
    const energyReason = `Your daily starting amount is ${result.merKcal} kcal, calculated from a ${result.weightKg} kg dog in the ${ageStageLabel} with ${profile.activityLevel} activity and a ${profile.targetGoal} weight goal.`;
    const summary = `This ${dietName} recommendation was selected because you chose ${proteinSelected ? profile.proteinChoice : 'a balanced protein rotation'} and ${profile.healthFocus} as the health focus. ${proteinReason} ${healthReason} ${sensitivityReason} ${energyReason} Monitor body condition and adjust with your veterinarian as needed.`;
    if (matchNote) matchNote.textContent = `${recipe.primaryProtein} recipe selected for your answers.`;
    if (selectionSummary) selectionSummary.textContent = summary;
    if (methodSummary) methodSummary.textContent = 'Recipe matching uses feeding style first, removes selected sensitivities, then ranks the remaining recipes by protein preference, health focus, and energy density. Energy is a starting estimate; use a complete and balanced recipe formulated for your dog’s life stage and review it with your veterinarian for long-term feeding.';

    // Every bowl is derived from this exact recipe, not from a separate generic schedule.
    const timedContainer = document.getElementById('timed-schedule-container');
    if (timedContainer) {
      const mealLabels = result.mealsPerDay === 3
        ? [{ time: '07:30 AM', name: 'Breakfast bowl' }, { time: '01:00 PM', name: 'Midday bowl' }, { time: '06:30 PM', name: 'Dinner bowl' }]
        : [{ time: '07:30 AM', name: 'Morning bowl' }, { time: '06:30 PM', name: 'Evening bowl' }];
      const mealPortion = Math.round(result.activeDailyGrams / result.mealsPerDay);
      const ingredientRows = recipe.ingredients.map((ingredient) => {
        const amount = (result.activeDailyGrams * ingredient.percentage) / 100 / result.mealsPerDay;
        const formattedAmount = Number.isInteger(amount) ? amount.toString() : amount.toFixed(1);
        return `<li class="flex items-center justify-between gap-3 py-1.5 border-b border-[#ebebeb]/60 dark:border-[#2e2e2e] last:border-0"><span class="text-[#171717] dark:text-[#ededed] font-medium">${ingredient.name}</span><span class="shrink-0 font-mono text-[11px] font-bold text-[#0070f3] dark:text-[#3291ff]">${formattedAmount}g</span></li>`;
      }).join('');
      timedContainer.innerHTML = mealLabels.map((meal) => `
        <article class="p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#1a1a1a]">
          <div class="flex items-center justify-between gap-3 mb-2"><span class="font-mono text-xs font-bold text-[#171717] dark:text-[#ededed] bg-[#f2f2f2] dark:bg-[#262626] px-2 py-0.5 rounded">${meal.time}</span><span class="text-[10px] font-mono text-[#8f8f8f] dark:text-[#737373]">${mealPortion}g total</span></div>
          <h4 class="font-semibold text-sm text-[#171717] dark:text-[#ededed] mb-2">${meal.name}</h4>
          <ul class="text-xs">${ingredientRows}</ul>
        </article>
      `).join('');
    }

    // Render Ingredients with exact grams
    if (rowsContainer) {
      rowsContainer.innerHTML = '';
      recipe.ingredients.forEach((ing) => {
        const ingGrams = Math.round((result.activeDailyGrams * ing.percentage) / 100);
        const buyLinks = ingredientShoppingLinks(ing.name);
        const row = document.createElement('div');
        row.className = 'p-3 sm:p-3.5 bg-white dark:bg-[#141414] hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] flex flex-col sm:flex-row sm:items-center gap-3 text-xs transition-colors';
        row.innerHTML = `
          <img src="${INGREDIENT_IMAGES[ing.category]}" alt="${ing.name}" loading="lazy" class="w-12 h-12 rounded-md object-cover shrink-0 border border-[#ebebeb] dark:border-[#2e2e2e]" />
          <div class="flex items-center gap-2.5 min-w-0 flex-1">
            <span class="font-mono text-[10px] sm:text-[11px] font-bold text-[#171717] dark:text-[#ededed] bg-[#f2f2f2] dark:bg-[#262626] px-2 py-0.5 rounded shrink-0">${ingGrams}g</span>
            <div>
              <div class="font-medium text-[#171717] dark:text-[#ededed]">${ing.name}</div>
              <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373]">${ing.purpose}</div>
            </div>
          </div>
          <div class="flex items-center gap-2 sm:justify-end shrink-0">
            <span class="font-mono text-[9px] sm:text-[10px] uppercase text-[#8f8f8f] dark:text-[#737373] bg-[#fafafa] dark:bg-[#1f1f1f] border border-[#ebebeb] dark:border-[#2e2e2e] px-2 py-0.5 rounded hidden xs:inline-block">${ing.category}</span>
            <a href="${buyLinks.amazon}" target="_blank" rel="noopener noreferrer" class="no-print inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#171717] dark:bg-white text-white dark:text-[#171717] hover:bg-[#333333] dark:hover:bg-[#ebebeb] text-[11px] font-semibold transition-all shadow-xs active:scale-95 touch-manipulation">
              <span>Buy Now</span>
              <span class="text-xs">🛒</span>
            </a>
          </div>
        `;
        rowsContainer.appendChild(row);
      });
    }

    // Render Preparation Notes
    if (prepContainer) {
      prepContainer.innerHTML = '';
      recipe.preparationNotes.forEach((step, idx) => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2';
        li.innerHTML = `
          <span class="font-mono font-bold text-[#171717] dark:text-[#ededed] bg-[#f2f2f2] dark:bg-[#262626] w-4 h-4 sm:w-5 sm:h-5 rounded-full flex items-center justify-center shrink-0 text-[9px] sm:text-[10px] mt-0.5">${idx + 1}</span>
          <span class="leading-relaxed text-[#4d4d4d] dark:text-[#a1a1a1]">${step}</span>
        `;
        prepContainer.appendChild(li);
      });
    }

    // Update Macros
    const protPctEl = document.getElementById('macro-protein-pct');
    const protBar = document.getElementById('macro-protein-bar');
    const fatPctEl = document.getElementById('macro-fat-pct');
    const fatBar = document.getElementById('macro-fat-bar');
    const fiberPctEl = document.getElementById('macro-fiber-pct');
    const fiberBar = document.getElementById('macro-fiber-bar');
    const moistPctEl = document.getElementById('macro-moisture-pct');
    const moistBar = document.getElementById('macro-moisture-bar');
    const caPhosEl = document.getElementById('ca-phos-ratio');

    if (protPctEl) protPctEl.textContent = `${recipe.macroProfile.proteinPct}%`;
    if (protBar) protBar.style.width = `${recipe.macroProfile.proteinPct}%`;

    if (fatPctEl) fatPctEl.textContent = `${recipe.macroProfile.fatPct}%`;
    if (fatBar) fatBar.style.width = `${recipe.macroProfile.fatPct}%`;

    if (fiberPctEl) fiberPctEl.textContent = `${recipe.macroProfile.carbsPct}%`;
    if (fiberBar) fiberBar.style.width = `${recipe.macroProfile.carbsPct * 4}%`;

    if (moistPctEl) moistPctEl.textContent = `${recipe.macroProfile.moisturePct}%`;
    if (moistBar) moistBar.style.width = `${recipe.macroProfile.moisturePct}%`;

    if (caPhosEl) caPhosEl.textContent = recipe.macroProfile.caPhosphorusRatio;

  }

  // Listen to plan generation events
  window.addEventListener('generate-plan', (e: any) => {
    currentProfile = e.detail;
    renderPlan(currentProfile);
  });

  // Diet tab switcher
  document.querySelectorAll('.diet-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!currentProfile) return;
      document.querySelectorAll('.diet-tab-btn').forEach((b) => {
        b.classList.remove('active', 'bg-white', 'dark:bg-[#262626]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
        b.classList.add('text-[#8f8f8f]', 'dark:text-[#737373]');
      });
      btn.classList.add('active', 'bg-white', 'dark:bg-[#262626]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
      btn.classList.remove('text-[#8f8f8f]', 'dark:text-[#737373]');

      const diet = btn.getAttribute('data-diet') || 'fresh-cooked';
      currentProfile.dietPreference = diet as any;
      renderPlan(currentProfile);
    });
  });

  // Print button
  document.getElementById('print-plan-btn')?.addEventListener('click', () => {
    document.body.classList.add('printing-plan');
    window.print();
  });

  window.addEventListener('afterprint', () => document.body.classList.remove('printing-plan'));
</script>
