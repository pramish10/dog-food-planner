  function syncProteinOptionsWithSensitivities() {
    const chickenSensitivitySelected = allergyInputs.some((input) =>
      input.checked && input.value === 'chicken / poultry'
    );
    const chickenOption = document.querySelector('[data-protein-option="chicken"]') as HTMLElement | null;
    const chickenInput = chickenOption?.querySelector('input[name="protein-choice"]') as HTMLInputElement | null;

    if (!chickenOption || !chickenInput) return;
    chickenOption.classList.toggle('hidden', chickenSensitivitySelected);
    chickenInput.disabled = chickenSensitivitySelected;

    if (chickenSensitivitySelected && chickenInput.checked) {
      const balancedOption = document.querySelector('input[name="protein-choice"][value="Balanced Rotation (No Pref)"]') as HTMLInputElement | null;
      if (balancedOption) balancedOption.checked = true;
    }
  }

  allergyInputs.forEach((input) => {
    input.addEventListener('change', () => {
      const noneInput = allergyInputs.find((option) => option.value === 'none / no allergies');
      if (input === noneInput && input.checked) {
        allergyInputs.forEach((option) => {
          if (option !== input) option.checked = false;
        });
      } else if (input.checked && noneInput) {
        noneInput.checked = false;
      }

      // Keep one explicit state selected when every sensitivity is cleared.
      if (!allergyInputs.some((option) => option.checked) && noneInput) {
        noneInput.checked = true;
      }
      syncProteinOptionsWithSensitivities();
    });
  });

  syncProteinOptionsWithSensitivities();

