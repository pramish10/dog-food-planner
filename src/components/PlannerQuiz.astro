---
import { CANINE_BREEDS } from '../data/breeds';
import { getLangFromUrl } from '../i18n/utils';
import { plannerTranslations } from '../i18n/planner';
import { plannerExtraTranslations } from '../i18n/plannerExtra';

const lang = getLangFromUrl(Astro.url);
const p = plannerTranslations[lang] || plannerTranslations.en;
const px = plannerExtraTranslations[lang] || plannerExtraTranslations.en;
const TOTAL_STEPS = 2;
---

<section id="planner-section" class="py-6 sm:py-8 bg-[#fdf8f3] dark:bg-[#150d04] border-b border-[#f0d5a8] dark:border-[#3a2510]" data-lang={lang}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div class="text-center mb-4 sm:mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-[#1c0f00] dark:text-[#fde8c8] tracking-tight mb-1">
        {p.title}
      </h2>
      <p class="text-xs sm:text-sm text-[#92400e] dark:text-[#c4956a] max-w-sm mx-auto">
        {p.subtitle}
      </p>
    </div>

    <!-- Quiz Card -->
    <div class="bg-white dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-2xl shadow-sm overflow-hidden">

      <!-- Progress Header -->
      <div class="px-5 pt-4 pb-0 border-b border-[#f0d5a8]/40 dark:border-[#3a2510]/40">
        <div class="flex items-center justify-between mb-2">
          <span id="step-label" class="text-xs font-bold text-[#c47a2b] font-mono uppercase tracking-wider">
            {p.stepPrefix} 1 {p.ofStep}
          </span>
          <span id="step-title-badge" class="text-xs font-semibold text-[#1c0f00] dark:text-[#fde8c8]">
            {p.step1Title}
          </span>
        </div>
        <div class="w-full bg-[#fdf3e7] dark:bg-[#2a1a08] h-1.5 rounded-full overflow-hidden">
          <div id="quiz-progress-bar" class="h-full rounded-full transition-all duration-300 ease-out" style="width: 50%; background: linear-gradient(90deg, #c47a2b, #e8a44a)"></div>
        </div>
      </div>

      <form id="dog-planner-form" onsubmit="return false;" novalidate class="p-5 sm:p-6 flex flex-col gap-4">

        <!-- STEP 1: Dog Profile & Target Weight -->
        <div class="quiz-step" data-step="1">
          <div class="space-y-4">

            <!-- Name & Breed -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div>
                <label for="dog-name" class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1 font-mono">{p.nameLabel}</label>
                <input type="text" id="dog-name" placeholder={p.namePlaceholder} value="Lucy" autocomplete="off"
                  class="w-full px-3.5 py-2 text-sm bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] focus:ring-2 focus:ring-[#c47a2b]/20 transition-all font-medium" />
              </div>

              <div>
                <label for="dog-breed" class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1 font-mono">{p.breedLabel}</label>
                <select id="dog-breed"
                  class="w-full px-3.5 py-2 text-sm bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] focus:ring-2 focus:ring-[#c47a2b]/20 font-medium">
                  {CANINE_BREEDS.map((b) => (
                    <option value={b.name}>{b.name}</option>
                  ))}
                </select>
              </div>
            </div>

            <!-- Life Stage & Weight Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div>
                <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1 font-mono">{p.ageLabel}</label>
                <div class="grid grid-cols-3 gap-1.5">
                  <label class="cursor-pointer">
                    <input type="radio" name="age-stage" value="puppy" class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <div class="text-base">🍼</div>
                      <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">Puppy</div>
                      <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">Growth</div>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="age-stage" value="adult" checked class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <div class="text-base">🦮</div>
                      <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.adult}</div>
                      <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">1–7 yrs</div>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="age-stage" value="senior" class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <div class="text-base">🐾</div>
                      <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.senior}</div>
                      <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">7+ yrs</div>
                    </div>
                  </label>
                </div>
              </div>

              <div>
                <div class="flex items-center justify-between mb-1">
                  <label for="dog-weight" class="text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider font-mono">{p.weightLabel}</label>
                  <div class="flex items-center text-xs font-mono border border-[#f0d5a8] dark:border-[#3a2510] rounded-lg overflow-hidden">
                    <button type="button" id="unit-lbs" class="px-2 py-0.5 bg-[#c47a2b] text-white font-semibold transition-colors cursor-pointer text-xs">LBS</button>
                    <button type="button" id="unit-kg" class="px-2 py-0.5 bg-white dark:bg-[#1c1208] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer text-xs">KG</button>
                  </div>
                </div>
                <div class="relative">
                  <input type="number" id="dog-weight" value="45"
                    class="w-full px-3.5 pr-12 py-2 text-sm bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] focus:ring-2 focus:ring-[#c47a2b]/20 font-bold" />
                  <span id="weight-unit-label" class="absolute right-3 top-2.5 text-xs text-[#92400e] dark:text-[#c4956a] font-mono font-semibold">LBS</span>
                </div>
              </div>
            </div>

            <!-- Weight Management Goal -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.weightGoalLabel}</label>
              <div class="grid grid-cols-3 gap-2">
                <label class="cursor-pointer">
                  <input type="radio" name="weight-goal" value="maintain" checked class="peer sr-only" />
                  <div class="p-2.5 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-base">⚖️</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.goalMaintain}</div>
                    <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">Stable</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="weight-goal" value="lose" class="peer sr-only" />
                  <div class="p-2.5 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-base">📉</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.goalLose}</div>
                    <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">-15% Calorie Deficit</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="weight-goal" value="gain" class="peer sr-only" />
                  <div class="p-2.5 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-base">💪</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.goalGain}</div>
                    <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">+10% Calorie Surplus</div>
                  </div>
                </label>
              </div>
            </div>

          </div>
        </div>

        <!-- STEP 2: Food Preference, Protein & Allergies -->
        <div class="quiz-step hidden" data-step="2">
          <div class="space-y-4">

            <!-- Primary Food Type -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{px.currentDietLabel}</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                {[
                  { value: 'fresh',  label: px.dietFresh,  sub: px.dietFreshSub,  emoji: '🍲', checked: true },
                  { value: 'kibble', label: px.dietKibble, sub: px.dietKibbleSub, emoji: '🟤', checked: false },
                  { value: 'canned', label: px.dietCanned, sub: px.dietCannedSub, emoji: '🥫', checked: false },
                  { value: 'raw',    label: px.dietRaw,    sub: px.dietRawSub,    emoji: '🥩', checked: false },
                ].map(d => (
                  <label class="cursor-pointer">
                    <input type="radio" name="current-diet" value={d.value} checked={d.checked} class="peer sr-only" />
                    <div class="p-2.5 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <div class="text-lg">{d.emoji}</div>
                      <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{d.label}</div>
                      <div class="text-[9px] text-[#92400e] dark:text-[#c4956a] truncate w-full">{d.sub}</div>
                    </div>
                  </label>
                ))}
              </div>
            </div>

            <!-- Protein Preference -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.proteinLabel}</label>
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-1.5">
                {[
                  { value: 'salmon',  label: p.proteinSalmon,   emoji: '🐟', checked: true },
                  { value: 'beef',    label: p.proteinBeef,     emoji: '🥩', checked: false },
                  { value: 'chicken', label: p.proteinChicken,  emoji: '🍗', checked: false },
                  { value: 'turkey',  label: p.proteinTurkey,   emoji: '🦃', checked: false },
                  { value: 'lamb',    label: p.proteinLamb,     emoji: '🐑', checked: false },
                  { value: 'auto',    label: p.proteinRotation, emoji: '🔄', checked: false },
                ].map((opt) => (
                  <label data-protein={opt.value} class="relative cursor-pointer flex flex-col items-center gap-1 p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl bg-white dark:bg-[#1c1208] has-[:checked]:border-[#c47a2b] has-[:checked]:bg-[#c47a2b]/8 transition-all text-center">
                    <input type="radio" name="protein" value={opt.value} class="sr-only" checked={opt.checked} />
                    <span class="text-lg">{opt.emoji}</span>
                    <span class="text-[10px] font-semibold text-[#1c0f00] dark:text-[#fde8c8] leading-tight truncate w-full">{opt.label}</span>
                    <span class="protein-blocked-badge hidden absolute -top-1 -right-1 text-[9px] bg-red-500 text-white rounded-full w-3.5 h-3.5 flex items-center justify-center font-bold leading-none">✕</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Allergies & Daily Meds -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.allergiesLabel}</label>
                <div class="grid grid-cols-4 gap-1.5">
                  <label id="allergy-none-label" class="cursor-pointer flex flex-col items-center gap-1 p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl bg-white dark:bg-[#1c1208] has-[:checked]:border-[#22c55e] has-[:checked]:bg-[#22c55e]/8 transition-all text-center relative">
                    <input type="checkbox" id="allergy-none" name="allergy" value="none / no allergies" class="sr-only" checked />
                    <span class="text-base">✅</span>
                    <span class="text-[10px] font-semibold text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.allergyNone}</span>
                    <svg id="allergy-none-check" class="hidden absolute top-1 right-1 w-3 h-3 text-[#22c55e]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  </label>
                  <div class="contents" id="allergy-chips">
                    {[
                      { value: 'chicken / poultry', label: p.allergyChicken, emoji: '🍗' },
                      { value: 'beef',               label: p.allergyBeef,    emoji: '🥩' },
                      { value: 'dairy',              label: p.allergyDairy,   emoji: '🥛' },
                      { value: 'grains / wheat',     label: p.allergyWheat,   emoji: '🌾' },
                      { value: 'soy',                label: p.allergySoy,     emoji: '🫘' },
                      { value: 'eggs',               label: p.allergyEggs,    emoji: '🥚' },
                    ].map(a => (
                      <label class="allergy-chip cursor-pointer flex flex-col items-center gap-1 p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl bg-white dark:bg-[#1c1208] has-[:checked]:border-[#ef4444] has-[:checked]:bg-[#ef4444]/8 transition-all text-center">
                        <input type="checkbox" name="allergy" value={a.value} class="sr-only" />
                        <span class="text-base">{a.emoji}</span>
                        <span class="text-[10px] font-semibold text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{a.label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{px.medsLabel}</label>
                <div class="grid grid-cols-2 gap-1.5">
                  <label class="cursor-pointer">
                    <input type="radio" name="daily-meds" value="none" checked class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <span class="text-base">❌</span>
                      <span class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{px.medsNone}</span>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="daily-meds" value="yes" class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <span class="text-base">💊</span>
                      <span class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{px.medsYes}</span>
                    </div>
                  </label>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex items-center justify-between pt-3 border-t border-[#f0d5a8] dark:border-[#3a2510]">
          <button type="button" id="prev-btn"
            class="hidden px-5 py-2.5 text-xs sm:text-sm font-semibold text-[#92400e] dark:text-[#c4956a] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl hover:text-[#1c0f00] hover:border-[#c47a2b] transition-all cursor-pointer min-h-[42px]">
            {p.prevBtn}
          </button>
          <div id="prev-placeholder"></div>
          <button type="button" id="next-btn"
            class="px-7 py-2.5 text-xs sm:text-sm font-bold bg-[#c47a2b] hover:bg-[#b8691f] text-white rounded-xl transition-all cursor-pointer shadow-sm min-h-[42px]">
            {p.nextBtn}
          </button>
          <button type="submit" id="submit-btn"
            class="hidden px-7 py-2.5 text-xs sm:text-sm font-bold bg-[#c47a2b] hover:bg-[#b8691f] text-white rounded-xl transition-all cursor-pointer shadow-sm min-h-[42px]">
            {p.submitBtn}
          </button>
        </div>

      </form>
    </div>

  </div>
</section>

<script>
  import { plannerTranslations } from '../i18n/planner';
  import { plannerExtraTranslations } from '../i18n/plannerExtra';
  import type { Lang } from '../i18n/ui';

  const TOTAL_STEPS = 2;
  const PLANNER_STATE_KEY = 'dfp-planner-state';
  let currentStep = 1;
  let weightUnit: 'lbs' | 'kg' = 'lbs';
  let currentWeightKg = false;

  function getTranslations() {
    const section = document.getElementById('planner-section') as HTMLElement;
    const lang = (section?.dataset.lang || 'en') as Lang;
    return plannerTranslations[lang] || plannerTranslations.en;
  }

  function getExtraTranslations() {
    const section = document.getElementById('planner-section') as HTMLElement;
    const lang = (section?.dataset.lang || 'en') as Lang;
    return plannerExtraTranslations[lang] || plannerExtraTranslations.en;
  }

  function updateProgress() {
    const pct = (currentStep / TOTAL_STEPS) * 100;
    const bar = document.getElementById('quiz-progress-bar') as HTMLElement;
    const label = document.getElementById('step-label') as HTMLElement;
    const badge = document.getElementById('step-title-badge') as HTMLElement;
    if (bar) bar.style.width = pct + '%';
    if (label) {
      const t = getTranslations();
      label.textContent = `${t.stepPrefix || 'STEP'} ${currentStep} ${t.ofStep || 'OF 2'}`;
    }
    if (badge) {
      const t = getTranslations();
      const tx = getExtraTranslations();
      const titles = [t.step1Title, tx.step4Title];
      badge.textContent = titles[currentStep - 1] || '';
    }
  }

  function showStep(step: number) {
    document.querySelectorAll('.quiz-step').forEach((el) => {
      (el as HTMLElement).classList.add('hidden');
    });
    const target = document.querySelector(`.quiz-step[data-step="${step}"]`) as HTMLElement;
    if (target) target.classList.remove('hidden');

    const prevBtn = document.getElementById('prev-btn') as HTMLElement;
    const prevPlaceholder = document.getElementById('prev-placeholder') as HTMLElement;
    const nextBtn = document.getElementById('next-btn') as HTMLElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLElement;

    if (step === 1) {
      prevBtn.classList.add('hidden');
      prevPlaceholder.classList.remove('hidden');
      nextBtn.classList.remove('hidden');
      submitBtn.classList.add('hidden');
    } else {
      prevBtn.classList.remove('hidden');
      prevPlaceholder.classList.add('hidden');
      nextBtn.classList.add('hidden');
      submitBtn.classList.remove('hidden');
    }

    updateProgress();
  }

  // Next & Prev button listeners
  document.getElementById('next-btn')?.addEventListener('click', () => {
    if (currentStep < TOTAL_STEPS) {
      currentStep++;
      showStep(currentStep);
      document.getElementById('planner-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  document.getElementById('prev-btn')?.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      showStep(currentStep);
      document.getElementById('planner-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  // Allergy blocking
  const ALLERGEN_PROTEIN_MAP: Record<string, string[]> = {
    'chicken / poultry': ['chicken'],
    'beef':              ['beef'],
    'dairy':             [],
    'grains / wheat':    [],
    'soy':               [],
    'eggs':              [],
  };

  const noneBox = document.getElementById('allergy-none') as HTMLInputElement;
  const noneCheck = document.getElementById('allergy-none-check') as HTMLElement;
  const allergyChips = document.querySelectorAll<HTMLInputElement>('#allergy-chips input[type="checkbox"]');
  const proteinCards = document.querySelectorAll<HTMLInputElement>('input[name="protein"]');

  function syncNoneVisual() {
    noneCheck?.classList.toggle('hidden', !noneBox?.checked);
  }

  function syncProteinBlocking() {
    const blocked = new Set<string>();
    allergyChips.forEach(cb => {
      if (cb.checked) {
        (ALLERGEN_PROTEIN_MAP[cb.value] || []).forEach(p => blocked.add(p));
      }
    });

    proteinCards.forEach(radio => {
      const card = radio.closest('label') as HTMLElement;
      if (!card) return;
      const badge = card.querySelector('.protein-blocked-badge') as HTMLElement;

      if (blocked.has(radio.value)) {
        radio.disabled = true;
        if (radio.checked) {
          radio.checked = false;
          const safeRadio = document.querySelector<HTMLInputElement>('input[name="protein"][value="salmon"]');
          if (safeRadio && !safeRadio.disabled) {
            safeRadio.checked = true;
          } else {
            const autoRadio = document.querySelector<HTMLInputElement>('input[name="protein"][value="auto"]');
            if (autoRadio) autoRadio.checked = true;
          }
        }
        card.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        badge?.classList.remove('hidden');
      } else {
        radio.disabled = false;
        card.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        badge?.classList.add('hidden');
      }
    });
  }

  noneBox?.addEventListener('change', () => {
    if (noneBox.checked) {
      allergyChips.forEach(cb => { cb.checked = false; });
    }
    syncNoneVisual();
    syncProteinBlocking();
  });

  allergyChips.forEach(cb => {
    cb.addEventListener('change', () => {
      if (cb.checked && noneBox?.checked) {
        noneBox.checked = false;
      }
      const anyChecked = Array.from(allergyChips).some(c => c.checked);
      if (!anyChecked) {
        noneBox.checked = true;
      }
      syncNoneVisual();
      syncProteinBlocking();
    });
  });

  // Weight unit toggle
  document.getElementById('unit-lbs')?.addEventListener('click', () => {
    if (currentWeightKg) {
      const input = document.getElementById('dog-weight') as HTMLInputElement;
      const val = parseFloat(input.value) || 0;
      input.value = Math.round(val * 2.20462).toString();
    }
    currentWeightKg = false;
    weightUnit = 'lbs';
    (document.getElementById('unit-lbs') as HTMLElement).className = 'px-2 py-0.5 bg-[#c47a2b] text-white font-semibold transition-colors cursor-pointer text-xs';
    (document.getElementById('unit-kg') as HTMLElement).className = 'px-2 py-0.5 bg-white dark:bg-[#1c1208] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer text-xs';
    (document.getElementById('weight-unit-label') as HTMLElement).textContent = 'LBS';
  });

  document.getElementById('unit-kg')?.addEventListener('click', () => {
    if (!currentWeightKg) {
      const input = document.getElementById('dog-weight') as HTMLInputElement;
      const val = parseFloat(input.value) || 0;
      input.value = Math.round(val / 2.20462).toString();
    }
    currentWeightKg = true;
    weightUnit = 'kg';
    (document.getElementById('unit-kg') as HTMLElement).className = 'px-2 py-0.5 bg-[#c47a2b] text-white font-semibold transition-colors cursor-pointer text-xs';
    (document.getElementById('unit-lbs') as HTMLElement).className = 'px-2 py-0.5 bg-white dark:bg-[#1c1208] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer text-xs';
    (document.getElementById('weight-unit-label') as HTMLElement).textContent = 'KG';
  });

  // Reset handler
  document.addEventListener('dogPlannerReset', () => {
    sessionStorage.removeItem(PLANNER_STATE_KEY);
    currentStep = 1;
    const form = document.getElementById('dog-planner-form') as HTMLFormElement | null;
    if (form) form.reset();
    syncNoneVisual();
    syncProteinBlocking();
    showStep(1);
  });

  // Submit handler
  function submitForm() {
    const name = (document.getElementById('dog-name') as HTMLInputElement).value.trim() || 'Lucy';
    const breed = (document.getElementById('dog-breed') as HTMLSelectElement).value;
    const ageStage = (document.querySelector('input[name="age-stage"]:checked') as HTMLInputElement)?.value || 'adult';
    const weightGoal = (document.querySelector('input[name="weight-goal"]:checked') as HTMLInputElement)?.value || 'maintain';
    const currentDiet = (document.querySelector('input[name="current-diet"]:checked') as HTMLInputElement)?.value || 'fresh';
    const proteinChoice = (document.querySelector('input[name="protein"]:checked') as HTMLInputElement)?.value || 'salmon';
    const hasMeds = (document.querySelector('input[name="daily-meds"]:checked') as HTMLInputElement)?.value === 'yes';

    const rawWeight = parseFloat((document.getElementById('dog-weight') as HTMLInputElement).value) || 45;
    const weightLbs = currentWeightKg ? rawWeight * 2.20462 : rawWeight;

    const allergies = Array.from(document.querySelectorAll('input[name="allergy"]:checked'))
      .map(el => (el as HTMLInputElement).value);

    const profile = {
      name,
      breed,
      ageStage,
      gender: 'female-spayed',
      weightLbs,
      targetGoal: weightGoal,
      bcs: weightGoal === 'lose' ? 7 : (weightGoal === 'gain' ? 3 : 5),
      activityLevel: 'moderate',
      allergies: allergies.length ? allergies : ['none / no allergies'],
      healthFocus: ageStage === 'senior' ? 'Joints & Mobility Support' : 'General Longevity & Health',
      dietPreference: currentDiet,
      proteinChoice,
      currentDiet,
      mealsCount: 2,
      treatHabit: 'moderate',
      hasMeds,
    };

    document.dispatchEvent(new CustomEvent('dogPlannerSubmit', { detail: profile }));
  }

  document.getElementById('dog-planner-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    submitForm();
  });
  document.getElementById('submit-btn')?.addEventListener('click', submitForm);

  syncNoneVisual();
  syncProteinBlocking();
  showStep(1);
</script>
