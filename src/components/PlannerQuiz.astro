                    <div class="p-2 sm:p-2.5 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] hover:border-[#c47a2b]/60 flex flex-col items-center justify-center gap-0.5 min-w-[95px] sm:min-w-[115px]">
