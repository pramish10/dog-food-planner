    scannerPlaceholder?.classList.remove('hidden');
    scannerImgPreview?.classList.add('hidden');
    if (scannerVideo) scannerVideo.classList.add('hidden');
    stopCamera();
    cancelLaserAnimation();
  }

  function stopCamera() {
    if (scannerVideo && scannerVideo.srcObject) {
      const stream = scannerVideo.srcObject as MediaStream;
      stream.getTracks().forEach((track) => track.stop());
      scannerVideo.srcObject = null;
    }
  }

  function startLaserAnimation() {
    if (!scannerLaser) return;
    scannerLaser.classList.remove('hidden');
    laserPos = 0;
    laserDir = 1;
    function loop() {
      laserPos += laserDir * 2;
      if (laserPos > 94) laserDir = -1;
      if (laserPos < 2) laserDir = 1;
      if (scannerLaser) scannerLaser.style.top = `${laserPos}%`;
      animFrameId = requestAnimationFrame(loop);
    }
    cancelLaserAnimation();
    loop();
  }

  function cancelLaserAnimation() {
    if (animFrameId) {
      cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }
  }

  // Live Camera Scanner
  startCameraBtn?.addEventListener('click', async () => {
    resetScannerUI();
    scannerPlaceholder?.classList.add('hidden');
    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ 
          video: { facingMode: 'environment', width: { ideal: 640 }, height: { ideal: 480 } } 
        });
        if (scannerVideo) {
          scannerVideo.srcObject = stream;
          scannerVideo.classList.remove('hidden');
          await scannerVideo.play();
        }
        processLiveVideoFrameWithAI();
      } catch (err) {
        showSubjectWarning('Camera unavailable', 'Camera access is required for a live scan. You can instead upload a clear photo containing one dog.');
      }
    } else {
      showSubjectWarning('Camera unavailable', 'This browser cannot provide a camera feed. Upload a clear photo containing one dog instead.');
    }
  });

  // Photo Upload Scanner
  photoUpload?.addEventListener('change', () => {
    if (photoUpload.files && photoUpload.files[0]) {
      const file = photoUpload.files[0];
      const reader = new FileReader();
      reader.onload = (e) => {
        resetScannerUI();
        scannerPlaceholder?.classList.add('hidden');
        if (scannerImgPreview && e.target?.result) {
          scannerImgPreview.src = e.target.result as string;
          scannerImgPreview.classList.remove('hidden');
          scannerImgPreview.onload = () => {
            executeDeepVisionInference(scannerImgPreview, file.name.toLowerCase());
          };
        }
      };
      reader.readAsDataURL(file);
    }
  });

  // Live Video Frame Analysis with Real MobileNet Model & Biometric Fallbacks
  async function processLiveVideoFrameWithAI() {
    startLaserAnimation();
    if (scannerProcessingTag) scannerProcessingTag.classList.remove('hidden');
    if (telemetryBadge) telemetryBadge.classList.remove('hidden');

    let stepCount = 0;
    const interval = setInterval(() => {
      stepCount++;
      if (scanStepText) {
        if (stepCount === 1) scanStepText.textContent = 'CHECKING AMBIENT LIGHT & LUX SENSOR...';
        else if (stepCount === 2) scanStepText.textContent = 'RUNNING NEURAL SUBJECT CLASSIFICATION...';
        else if (stepCount === 3) scanStepText.textContent = 'DISCRIMINATING BIPEDAL VS CANINE MORPHOLOGY...';
      }

      // Sample video frame onto offscreen canvas
      if (scannerVideo && scannerCanvas && scannerVideo.videoWidth > 0) {
        scannerCanvas.width = 224;
        scannerCanvas.height = 224;
        const ctx = scannerCanvas.getContext('2d', { willReadFrequently: true });
        if (ctx) {
          ctx.drawImage(scannerVideo, 0, 0, 224, 224);
          const frameData = ctx.getImageData(0, 0, 224, 224);
          const luminance = calculateAverageLuminance(frameData.data);
          updateLightingIndicator(luminance);
        }
      }
    }, 400);

    // Wait a brief moment for video stream stabilization then evaluate with Edge AI
    setTimeout(async () => {
      clearInterval(interval);
      cancelLaserAnimation();
      if (scannerLaser) scannerLaser.classList.add('hidden');
      if (scannerProcessingTag) scannerProcessingTag.classList.add('hidden');

      if (scannerVideo && scannerVideo.videoWidth > 0) {
        await executeDeepVisionInference(scannerVideo, '');
      } else {
        showSubjectWarning('Camera feed unavailable', 'We could not read a camera frame. Try again or upload a clear photo containing one dog.');
      }
    }, 2200);
  }

  function showSubjectWarning(title: string, message: string) {
    const warningTitle = document.getElementById('subject-warning-title');
    const warningMessage = document.getElementById('subject-warning-message');
    if (warningTitle) warningTitle.textContent = title;
    if (warningMessage) warningMessage.textContent = message;
    humanWarningBox?.classList.remove('hidden');
    scanResultBox?.classList.add('hidden');
  }

  function cropToDetection(source: HTMLImageElement | HTMLVideoElement, bbox: number[]) {
    const sourceWidth = source instanceof HTMLVideoElement ? source.videoWidth : source.naturalWidth;
    const sourceHeight = source instanceof HTMLVideoElement ? source.videoHeight : source.naturalHeight;
    const [x, y, width, height] = bbox;
    const crop = document.createElement('canvas');
    crop.width = Math.max(1, Math.round(width));
    crop.height = Math.max(1, Math.round(height));
    const context = crop.getContext('2d');
    if (!context || !sourceWidth || !sourceHeight) return source;
    context.drawImage(source, x, y, width, height, 0, 0, crop.width, crop.height);
    return crop;
  }

  // ResNet-50 is an ImageNet classifier, so its results can include labels such as
  // "snail" or "screw". Never turn one of those generic labels into a dog breed.
  // A result is only displayable when it maps to a breed in the planner catalogue.
  function findBreedProfile(label: string, confidence: number): ExtendedBreedProfile | null {
    const normalizedLabel = label.toLowerCase();
    const knownProfile = ALL_BREED_PROFILES
      .flatMap((profile) => profile.aliases.map((alias) => ({ profile, alias })))
      .filter(({ alias }) => normalizedLabel.includes(alias) || alias.includes(normalizedLabel))
      .sort((a, b) => b.alias.length - a.alias.length)[0]?.profile;

    if (knownProfile) return { ...knownProfile, confidence: Math.round(confidence * 1000) / 10 };

    return null;
  }

  async function classifyWithHostedBreedAi(source: HTMLImageElement | HTMLVideoElement, bbox: number[]) {
    const crop = cropToDetection(source, bbox);
    const originalWidth = crop instanceof HTMLCanvasElement ? crop.width : crop instanceof HTMLVideoElement ? crop.videoWidth : crop.naturalWidth;
    const originalHeight = crop instanceof HTMLCanvasElement ? crop.height : crop instanceof HTMLVideoElement ? crop.videoHeight : crop.naturalHeight;
    const scale = Math.min(1, 1024 / Math.max(originalWidth, originalHeight));
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(originalWidth * scale));
    canvas.height = Math.max(1, Math.round(originalHeight * scale));
    const context = canvas.getContext('2d');
    if (!context) throw new Error('Could not prepare the dog photo.');
    context.drawImage(crop, 0, 0, canvas.width, canvas.height);

    const image = canvas.toDataURL('image/jpeg', 0.88).split(',')[1];
    const response = await fetch('/api/breed', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ image })
    });
    if (!response.ok) throw new Error('Hosted breed AI unavailable');
    const result = await response.json();
    if (!Array.isArray(result.predictions)) throw new Error('Invalid breed AI response');
    const matches = result.predictions
      .filter((prediction: any) => typeof prediction?.label === 'string' && typeof prediction?.score === 'number')
      .map((prediction: any) => findBreedProfile(prediction.label, prediction.score))
      .filter((profile): profile is ExtendedBreedProfile => profile !== null)
      .filter((profile: ExtendedBreedProfile, index: number, profiles: ExtendedBreedProfile[]) =>
        profiles.findIndex((candidate) => candidate.name === profile.name) === index
      );
    if (!matches.length) throw new Error('No breed predictions returned');
    return matches;
  }

  // Core Vision Inference: first confirm a dog object, then classify its cropped image.
  async function executeDeepVisionInference(visualSource: HTMLImageElement | HTMLVideoElement, filename: string) {
    startLaserAnimation();
    if (scannerProcessingTag) scannerProcessingTag.classList.remove('hidden');
    if (telemetryBadge) telemetryBadge.classList.remove('hidden');

    // 1. Pixel luminance is only a photo-quality hint. Subject detection is left
    // entirely to the neural object detector; colour heuristics misclassify dogs.
    let isLowLight = false;
    if (scannerCanvas) {
      scannerCanvas.width = 224;
      scannerCanvas.height = 224;
      const ctx = scannerCanvas.getContext('2d', { willReadFrequently: true });
      if (ctx) {
        ctx.drawImage(visualSource, 0, 0, 224, 224);
        const imgData = ctx.getImageData(0, 0, 224, 224);
        const luminance = calculateAverageLuminance(imgData.data);
        updateLightingIndicator(luminance);

        if (luminance < 35) {
          isLowLight = true;
          if (lowLightWarningBox && luxPctText) {
            luxPctText.textContent = `${Math.round(luminance)}%`;
            lowLightWarningBox.classList.remove('hidden');
          }
        }

      }
    }

    // 2. Object detection is the safety gate. It distinguishes dog, person, cat, and other supported animals.
    let detectedDogBreed: ExtendedBreedProfile | null = null;
    let breedCandidates: ExtendedBreedProfile[] = [];
    let dogDetection: any = null;
    let nonDogAnimal: string | null = null;
    let personDetected = false;
    let hostedBreedAiUnavailable = false;

    if (!mobileNetModel) {
      await loadEdgeModel();
    }

    if (cocoSsdModel) {
      try {
        const detections = await cocoSsdModel.detect(visualSource);
        dogDetection = detections
          .filter((detection: any) => detection.class === 'dog' && detection.score >= 0.6)
          .sort((a: any, b: any) => b.score - a.score)[0] || null;
        personDetected = detections.some((detection: any) => detection.class === 'person' && detection.score >= 0.6);
        nonDogAnimal = detections
          .filter((detection: any) => ['cat', 'bird', 'horse', 'sheep', 'cow', 'elephant', 'bear', 'zebra', 'giraffe'].includes(detection.class) && detection.score >= 0.55)
          .sort((a: any, b: any) => b.score - a.score)[0]?.class || null;
      } catch (err) {
        console.warn('Object detection error:', err);
      }
    }

    // 3. Use the hosted 120-breed classifier on the cropped dog. The local
    // MobileNet model is only a resilient fallback for offline/unconfigured deployments.
    if (dogDetection) {
      try {
        if (scanStepText) scanStepText.textContent = 'RUNNING 120-BREED DEEP-LEARNING MODEL...';
        const hostedMatches = await classifyWithHostedBreedAi(visualSource, dogDetection.bbox);
        detectedDogBreed = hostedMatches[0];
        breedCandidates = hostedMatches;
      } catch (hostedError) {
        hostedBreedAiUnavailable = true;
        console.warn('Hosted breed AI unavailable; trying on-device fallback:', hostedError);
        if (mobileNetModel) {
          try {
            const predictions = await mobileNetModel.classify(cropToDetection(visualSource, dogDetection.bbox), 5);
            for (const prediction of predictions) {
              const label = prediction.className.toLowerCase();
              const breed = ALL_BREED_PROFILES
                .flatMap((candidate) => candidate.aliases
                  .filter((alias) => label.includes(alias))
                  .map((alias) => ({ candidate, alias })))
                .sort((a, b) => b.alias.length - a.alias.length)[0]?.candidate;
              if (breed && prediction.probability >= 0.05 && !breedCandidates.some((candidate) => candidate.name === breed.name)) {
                breedCandidates.push({ ...breed, confidence: Math.round(prediction.probability * 1000) / 10 });
              }
            }
            detectedDogBreed = breedCandidates[0] || null;
          } catch (fallbackError) {
            console.warn('On-device breed classification error:', fallbackError);
          }
        }
      }
    }

    cancelLaserAnimation();
    if (scannerLaser) scannerLaser.classList.add('hidden');
    if (scannerProcessingTag) scannerProcessingTag.classList.add('hidden');

    if (!cocoSsdModel) {
      showSubjectWarning('Dog detector unavailable', 'The on-device dog detector did not load. Check your connection and try again; no breed has been assigned.');
    } else if (!dogDetection && nonDogAnimal) {
      showSubjectWarning('Non-dog animal detected', `This photo appears to contain a ${nonDogAnimal}, not a dog. Upload a clear photo of one dog.`);
    } else if (!dogDetection && personDetected) {
      showSubjectWarning('Human detected', 'This photo appears to contain a person rather than a dog. No breed has been assigned.');
    } else if (!dogDetection) {
      showSubjectWarning('Dog not detected', 'We could not confidently find a dog in this image. Use a well-lit photo that shows one dog clearly.');
    } else if (!detectedDogBreed && hostedBreedAiUnavailable) {
      showSubjectWarning('Breed AI temporarily unavailable', 'Your dog was detected, but the hosted 120-breed model is unavailable right now. Please try again in a moment.');
    } else if (!detectedDogBreed) {
      showSubjectWarning('Dog confirmed; breed uncertain', 'A dog was detected, but the model cannot make a reliable breed match from this photo. Please choose the breed or size manually rather than receiving a guess.');
    } else {
      renderCanineRecognitionResults(detectedDogBreed, breedCandidates);
    }
  }

  // Detects human skin pigment clustering across central crop
  function detectHumanSkinChromaCluster(pixels: Uint8ClampedArray): boolean {
    let skinPixelCount = 0;
    const totalPixels = pixels.length / 4;
    for (let i = 0; i < pixels.length; i += 4) {
      const r = pixels[i];
      const g = pixels[i + 1];
      const b = pixels[i + 2];

      // Standard peer-reviewed RGB skin detection rule:
      // R > 95, G > 40, B > 20, max(R,G,B) - min(R,G,B) > 15, |R - G| > 15, R > G, R > B
      if (r > 95 && g > 40 && b > 20 &&
          (Math.max(r, g, b) - Math.min(r, g, b) > 15) &&
          Math.abs(r - g) > 15 && r > g && r > b) {
        skinPixelCount++;
      }
    }
    const skinRatio = skinPixelCount / totalPixels;
    // If over 38% of the viewfinder is human skin tone
    return skinRatio > 0.38;
  }

  function calculateAverageLuminance(pixels: Uint8ClampedArray): number {
    let totalLuma = 0;
    const count = pixels.length / 4;
    for (let i = 0; i < pixels.length; i += 4) {
      const luma = 0.299 * pixels[i] + 0.587 * pixels[i + 1] + 0.114 * pixels[i + 2];
      totalLuma += luma;
    }
    const avg = totalLuma / count;
    return Math.min(100, Math.max(0, (avg / 255) * 100));
  }

  function updateLightingIndicator(lumaPct: number) {
    if (!lightingBadge || !lightingDot || !lightingText) return;
    const rounded = Math.round(lumaPct);
    if (lumaPct < 35) {
      lightingDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse';
      lightingText.textContent = `LUX: LOW (${rounded}%)`;
    } else if (lumaPct > 90) {
      lightingDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-400';
      lightingText.textContent = `LUX: OVEREXPOSED (${rounded}%)`;
    } else {
      lightingDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
      lightingText.textContent = `LUX: OPTIMAL (${rounded}%)`;
    }
    if (cranialRatioVal) {
      cranialRatioVal.textContent = 'VERIFYING';
    }
  }

  function renderCanineRecognitionResults(topMatch: ExtendedBreedProfile, visualMatches: ExtendedBreedProfile[] = [topMatch]) {
    activeSelectedBreedName = topMatch.name;
    activeSelectedWeight = Math.round((topMatch.avgWeightLbs[0] + topMatch.avgWeightLbs[1]) / 2);

    if (scanResultBox && detectedBreedName && detectedBreedDesc && detectedConfidenceText && detectedCategoryBadge) {
      scanResultBox.classList.remove('hidden');
      if (humanWarningBox) humanWarningBox.classList.add('hidden');

      detectedBreedName.textContent = topMatch.name;
      detectedBreedDesc.textContent = topMatch.description;
      detectedConfidenceText.textContent = `${topMatch.confidence}%`;
      detectedCategoryBadge.textContent = `${topMatch.category} Breed`;
      
      if (detectedWeightRange) {
        detectedWeightRange.textContent = `Adult: ${topMatch.avgWeightLbs[0]}–${topMatch.avgWeightLbs[1]} lbs`;
      }
      if (diagCranial) diagCranial.textContent = topMatch.cranial;
      if (diagEar) diagEar.textContent = topMatch.ear;
      if (diagCoat) diagCoat.textContent = topMatch.coat;
      if (detectedNutritionFocus) detectedNutritionFocus.textContent = topMatch.nutrition;
      if (detectedMacros) detectedMacros.textContent = `${topMatch.proteinPct}% Protein / ${topMatch.fatPct}% Fat`;
      if (detectedPredispositions) detectedPredispositions.textContent = `Predispositions: ${topMatch.predispositions.join(', ')}`;

      // Show only labels actually returned by the classifier. Never manufacture
      // alternative breeds or probabilities from the top score.
      if (candidatesContainer) {
        candidatesContainer.innerHTML = visualMatches.slice(0, 3).map((match, index) => `
          <div class="space-y-1 ${index ? 'pt-1' : ''}">
            <div class="flex justify-between text-[10px] ${index ? 'text-[#4d4d4d] dark:text-[#a1a1a1]' : 'font-medium text-[#171717] dark:text-[#ededed]'}">
              <span>${index === 0 ? '<strong class="text-[#10b981]">1.</strong> ' : `${index + 1}. `}${match.name}</span>
              <span class="font-mono ${index === 0 ? 'text-[#10b981] font-bold' : ''}">${match.confidence}%</span>
            </div>
            <div class="w-full bg-[#ebebeb] dark:bg-[#262626] h-1.5 rounded-full overflow-hidden">
              <div class="${index === 0 ? 'bg-[#10b981]' : 'bg-[#8f8f8f]'} h-full rounded-full" style="width: ${Math.min(100, match.confidence)}%"></div>
            </div>
          </div>`).join('');
      }
    }
  }

  applyDetectedBtn?.addEventListener('click', () => {
    const breedSelect = document.getElementById('dog-breed') as HTMLSelectElement;
    if (breedSelect) {
      // Find matching option
      for (let i = 0; i < breedSelect.options.length; i++) {
        if (breedSelect.options[i].value.toLowerCase().includes(activeSelectedBreedName.toLowerCase()) || 
            activeSelectedBreedName.toLowerCase().includes(breedSelect.options[i].value.toLowerCase())) {
          breedSelect.selectedIndex = i;
          breedSelect.dispatchEvent(new Event('change'));
          break;
        }
      }
    }

    if (weightInput) {
      if (currentWeightUnit === 'KG') {
        weightInput.value = Math.round(activeSelectedWeight * 0.453592).toString();
      } else {
        weightInput.value = activeSelectedWeight.toString();
      }
    }

    // Close modal
    aiModal?.classList.add('hidden');
    stopCamera();
    cancelLaserAnimation();

    // Show brief toast notification / success feedback on the trigger button
    if (aiTriggerBtn) {
      const originalHTML = aiTriggerBtn.innerHTML;
      aiTriggerBtn.innerHTML = `<span>✓ Scanned: ${activeSelectedBreedName}</span>`;
      aiTriggerBtn.classList.add('bg-emerald-500/20', 'text-emerald-600', 'dark:text-emerald-400', 'border-emerald-500/40');
      setTimeout(() => {
        aiTriggerBtn.innerHTML = originalHTML;
        aiTriggerBtn.classList.remove('bg-emerald-500/20', 'text-emerald-600', 'dark:text-emerald-400', 'border-emerald-500/40');
      }, 3500);
    }
  });

  // Generate Plan Handler
  generateBtn?.addEventListener('click', () => {
    const dogName = (document.getElementById('dog-name') as HTMLInputElement)?.value || 'Lucy';
    const ageStage = (document.querySelector('input[name="age-stage"]:checked') as HTMLInputElement)?.value || 'adult';
    const gender = (document.querySelector('input[name="gender"]:checked') as HTMLInputElement)?.value || 'female-spayed';
    const breed = (document.getElementById('dog-breed') as HTMLSelectElement)?.value || 'Unknown / Mixed (Medium: 25–55 lbs)';
    
    let rawWeight = parseFloat((document.getElementById('dog-weight') as HTMLInputElement)?.value) || 45;
    const weightLbs = currentWeightUnit === 'KG' ? rawWeight * 2.20462 : rawWeight;

    const targetGoal = (document.getElementById('target-goal') as HTMLSelectElement)?.value || 'maintain';
    const bcs = parseInt(bcsSlider?.value || '5');
    const treatBudgetPct = parseInt(treatSlider?.value || '10');
    const activityLevel = (document.querySelector('input[name="activity-level"]:checked') as HTMLInputElement)?.value || 'moderate';
    const healthFocus = (document.getElementById('health-focus') as HTMLSelectElement)?.value || 'General Health';
    const dietPreference = (document.querySelector('input[name="diet-preference"]:checked') as HTMLInputElement)?.value || 'fresh-cooked';
    const proteinChoice = (document.querySelector('input[name="protein-choice"]:checked') as HTMLInputElement)?.value || 'Balanced Rotation (No Pref)';

    const allergyInputs = document.querySelectorAll('.allergy-check:checked');
    const allergies: string[] = [];
    allergyInputs.forEach((el) => allergies.push((el as HTMLInputElement).value));

    // Dispatch global custom event for PlanResults to render
    window.dispatchEvent(new CustomEvent('generate-plan', {
      detail: {
        name: dogName,
        ageStage,
        gender,
        breed,
        weightLbs,
        targetGoal,
        bcs,
        treatBudgetPct,
        activityLevel,
        allergies,
        healthFocus,
        dietPreference,
        proteinChoice
      }
    }));

    // Reveal and smooth scroll to results
    const resultsElem = document.getElementById('results-section');
    if (resultsElem) {
      resultsElem.classList.remove('hidden');
      resultsElem.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>
