---
import { CANINE_BREEDS } from '../data/breeds';
import { getLangFromUrl } from '../i18n/utils';
import { plannerTranslations } from '../i18n/planner';
import { plannerExtraTranslations } from '../i18n/plannerExtra';

const lang = getLangFromUrl(Astro.url);
const p = plannerTranslations[lang] || plannerTranslations.en;
const px = plannerExtraTranslations[lang] || plannerExtraTranslations.en;
const TOTAL_STEPS = 2;

const breedSearchPlaceholders: Record<string, string> = {
  en: 'Type breed (e.g. Golden, Frenchie)...',
  es: 'Escribe la raza (ej. Golden, Bulldog)...',
  ja: '犬種を入力 (例: ゴールデン、柴犬)...',
  fr: 'Tapez la race (ex. Golden, Bouledogue)...',
  de: 'Rasse eingeben (z.B. Schäferhund, Pudel)...',
  pt: 'Digite a raça (ex: Golden, Buldogue)...',
  ko: '견종 입력 (예: 골든 리트리버, 말티즈)...',
  it: 'Digita la razza (es. Golden, Barboncino)...',
};
const breedSearchPlaceholder = breedSearchPlaceholders[lang] || breedSearchPlaceholders.en;
---

<section id="planner-section" class="py-6 sm:py-8 bg-[#fdf8f3] dark:bg-[#150d04] border-b border-[#f0d5a8] dark:border-[#3a2510]" data-lang={lang}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div class="text-center mb-4 sm:mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-[#1c0f00] dark:text-[#fde8c8] tracking-tight mb-1">
        {p.title}
      </h2>
      <p class="text-xs sm:text-sm text-[#92400e] dark:text-[#c4956a] max-w-sm mx-auto">
        {p.subtitle}
      </p>
    </div>

    <!-- Quiz Card -->
    <div class="bg-white dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-2xl shadow-sm overflow-hidden">

      <!-- Progress Header -->
      <div class="px-5 pt-4 pb-0 border-b border-[#f0d5a8]/40 dark:border-[#3a2510]/40">
        <div class="flex items-center justify-between mb-2">
          <span id="step-label" class="text-xs font-bold text-[#92400e] dark:text-[#f59e0b] font-mono uppercase tracking-wider">
            {p.stepPrefix} 1 {p.ofStep}
          </span>
          <span id="step-title-badge" class="text-xs font-semibold text-[#1c0f00] dark:text-[#fde8c8]">
            {p.step1Title}
          </span>
        </div>
        <div class="w-full bg-[#fdf3e7] dark:bg-[#2a1a08] h-1.5 rounded-full overflow-hidden">
          <div id="quiz-progress-bar" class="h-full rounded-full transition-all duration-300 ease-out" style="width: 50%; background: linear-gradient(90deg, #c47a2b, #e8a44a)"></div>
        </div>
      </div>

      <form id="dog-planner-form" onsubmit="return false;" novalidate class="p-5 sm:p-6 flex flex-col gap-4">

        <!-- STEP 1: Dog Profile & Target Weight -->
        <div class="quiz-step" data-step="1">
          <div class="space-y-4">

            <!-- Name & Breed -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div>
                <label for="dog-name" class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1 font-mono">{p.nameLabel}</label>
                <input type="text" id="dog-name" placeholder={p.namePlaceholder} value="Lucy" autocomplete="off"
                  class="w-full px-3.5 py-2 text-sm bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] focus:ring-2 focus:ring-[#c47a2b]/20 transition-all font-medium" />
              </div>

              <!-- Breed / Genetic Size Searchable Combobox -->
              <div class="relative" id="breed-combobox-wrapper">
                <label for="dog-breed-search" class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1 font-mono">{p.breedLabel}</label>
                
                <div class="relative">
                  <div class="relative flex items-center">
                    <input
                      type="text"
                      id="dog-breed-search"
                      role="combobox"
                      aria-autocomplete="list"
                      aria-expanded="false"
                      aria-controls="breed-dropdown-list"
                      autocomplete="off"
                      spellcheck="false"
                      placeholder={breedSearchPlaceholder}
                      value={CANINE_BREEDS[0]?.name || ''}
                      class="w-full pl-3.5 pr-14 py-2 text-sm bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] focus:ring-2 focus:ring-[#c47a2b]/20 transition-all font-medium truncate cursor-pointer focus:cursor-text"
                    />

                    <!-- Clear search button and chevron toggle -->
                    <div class="absolute right-2 flex items-center gap-0.5">
                      <button
                        type="button"
                        id="breed-clear-btn"
                        tabindex="-1"
                        aria-label="Clear breed search"
                        class="hidden p-1 text-[#92400e]/70 dark:text-[#c4956a]/70 hover:text-[#c47a2b] dark:hover:text-[#f59e0b] hover:bg-[#f0d5a8]/40 dark:hover:bg-[#3a2510]/60 rounded-full transition-colors cursor-pointer"
                      >
                        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                      </button>

                      <button
                        type="button"
                        id="breed-dropdown-toggle"
                        tabindex="-1"
                        aria-label="Toggle breed dropdown"
                        class="p-1 text-[#92400e] dark:text-[#c4956a] hover:text-[#c47a2b] transition-transform duration-200 rounded-full cursor-pointer"
                      >
                        <svg id="breed-dropdown-chevron" class="w-4 h-4 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                      </button>
                    </div>
                  </div>

                  <!-- Dropdown list -->
                  <div
                    id="breed-dropdown-list"
                    role="listbox"
                    class="hidden absolute z-50 left-0 right-0 top-full mt-1.5 max-h-60 overflow-y-auto overscroll-contain bg-white dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl shadow-xl backdrop-blur-md py-1 divide-y divide-[#f0d5a8]/20 dark:divide-[#3a2510]/30 focus:outline-none"
                  >
                  </div>
                </div>

                <!-- Hidden native select for backwards compatibility with existing code and listeners -->
                <select id="dog-breed" name="dog-breed" class="sr-only" tabindex="-1" aria-hidden="true">
                  {CANINE_BREEDS.map((b) => (
                    <option value={b.name}>{b.name}</option>
                  ))}
                </select>
              </div>
            </div>

            <!-- Life Stage & Weight Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <fieldset class="border-0 p-0 m-0 min-w-0">
                <legend class="block w-full text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1 font-mono">{p.ageLabel}</legend>
                <div class="grid grid-cols-3 gap-1.5">
                  <label class="cursor-pointer">
                    <input type="radio" name="age-stage" value="puppy" class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <div class="text-base">🍼</div>
                      <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">Puppy</div>
                      <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">Growth</div>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="age-stage" value="adult" checked class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <div class="text-base">🦮</div>
                      <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.adult}</div>
                      <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">1–7 yrs</div>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="age-stage" value="senior" class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <div class="text-base">🐾</div>
                      <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.senior}</div>
                      <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">7+ yrs</div>
                    </div>
                  </label>
                </div>
              </fieldset>

              <div>
                <div class="flex items-center justify-between mb-1">
                  <label for="dog-weight" class="text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider font-mono">{p.weightLabel}</label>
                  <div class="flex items-center text-xs font-mono border border-[#f0d5a8] dark:border-[#3a2510] rounded-lg overflow-hidden">
                    <button type="button" id="unit-lbs" class="px-2 py-0.5 bg-[#b45309] text-white font-semibold transition-colors cursor-pointer text-xs" aria-label="Weight in pounds">LBS</button>
                    <button type="button" id="unit-kg" class="px-2 py-0.5 bg-white dark:bg-[#1c1208] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer text-xs" aria-label="Weight in kilograms">KG</button>
                  </div>
                </div>
                <div class="relative">
                  <input type="number" id="dog-weight" value="12" min="1" max="300" step="any"
                    class="w-full px-3.5 pr-12 py-2 text-sm bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] focus:ring-2 focus:ring-[#c47a2b]/20 transition-all font-medium [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />
                  <span id="weight-unit-label" class="absolute right-3 top-2.5 text-xs text-[#92400e] dark:text-[#c4956a] font-mono font-semibold pointer-events-none">LBS</span>
                </div>
              </div>
            </div>

            <!-- Weight Management Goal -->
            <fieldset class="border-0 p-0 m-0 min-w-0">
              <legend class="block w-full text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.weightGoalLabel}</legend>
              <div class="grid grid-cols-3 gap-2">
                <label class="cursor-pointer">
                  <input type="radio" name="weight-goal" value="maintain" checked class="peer sr-only" />
                  <div class="p-2.5 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-base">⚖️</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.goalMaintain}</div>
                    <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">Stable</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="weight-goal" value="lose" class="peer sr-only" />
                  <div class="p-2.5 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-base">📉</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.goalLose}</div>
                    <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">-15% Calorie Deficit</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="weight-goal" value="gain" class="peer sr-only" />
                  <div class="p-2.5 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-base">💪</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{p.goalGain}</div>
                    <div class="text-[9px] text-[#92400e] dark:text-[#c4956a]">+10% Calorie Surplus</div>
                  </div>
                </label>
              </div>
            </fieldset>

          </div>
        </div>

        <!-- STEP 2: Food Preference, Protein & Allergies -->
        <div class="quiz-step hidden" data-step="2">
          <div class="space-y-4">

            <!-- Primary Food Type -->
            <fieldset class="border-0 p-0 m-0 min-w-0">
              <legend class="block w-full text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{px.currentDietLabel}</legend>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                {[
                  { value: 'fresh',  label: px.dietFresh,  sub: px.dietFreshSub,  emoji: '🍲', checked: true },
                  { value: 'kibble', label: px.dietKibble, sub: px.dietKibbleSub, emoji: '🟤', checked: false },
                  { value: 'canned', label: px.dietCanned, sub: px.dietCannedSub, emoji: '🥫', checked: false },
                  { value: 'raw',    label: px.dietRaw,    sub: px.dietRawSub,    emoji: '🥩', checked: false },
                ].map(d => (
                  <label class="cursor-pointer">
                    <input type="radio" name="current-diet" value={d.value} checked={d.checked} class="peer sr-only" />
                    <div class="p-2.5 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <div class="text-lg">{d.emoji}</div>
                      <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{d.label}</div>
                      <div class="text-[9px] text-[#92400e] dark:text-[#c4956a] truncate w-full">{d.sub}</div>
                    </div>
                  </label>
                ))}
              </div>
            </fieldset>

            <!-- Protein Preference -->
            <fieldset class="border-0 p-0 m-0 min-w-0">
              <legend class="block w-full text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.proteinLabel}</legend>
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-1.5">
                {[
                  { value: 'salmon',  label: p.proteinSalmon,   emoji: '🐟', checked: true },
                  { value: 'beef',    label: p.proteinBeef,     emoji: '🥩', checked: false },
                  { value: 'chicken', label: p.proteinChicken,  emoji: '🍗', checked: false },
                  { value: 'turkey',  label: p.proteinTurkey,   emoji: '🦃', checked: false },
                  { value: 'lamb',    label: p.proteinLamb,     emoji: '🐑', checked: false },
                  { value: 'auto',    label: p.proteinRotation, emoji: '🔄', checked: false },
                ].map((opt) => (
                  <label data-protein={opt.value} class="relative cursor-pointer flex flex-col items-center gap-1 p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl bg-white dark:bg-[#1c1208] has-[:checked]:border-[#c47a2b] has-[:checked]:bg-[#c47a2b]/8 transition-all text-center">
                    <input type="radio" name="protein" value={opt.value} class="sr-only" checked={opt.checked} />
                    <span class="text-lg">{opt.emoji}</span>
                    <span class="text-[10px] font-semibold text-[#1c0f00] dark:text-[#fde8c8] leading-tight truncate w-full">{opt.label}</span>
                    <span class="protein-blocked-badge hidden absolute -top-1 -right-1 text-[9px] bg-red-500 text-white rounded-full w-3.5 h-3.5 flex items-center justify-center font-bold leading-none">✕</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <!-- Allergies & Daily Meds -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
              <fieldset class="sm:col-span-2 border-0 p-0 m-0 min-w-0">
                <legend class="block w-full text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.allergiesLabel}</legend>
                <div class="grid grid-cols-4 gap-1.5">
                  <label id="allergy-none-label" class="cursor-pointer flex flex-col items-center gap-1 p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl bg-white dark:bg-[#1c1208] has-[:checked]:border-[#22c55e] has-[:checked]:bg-[#22c55e]/8 transition-all text-center relative">
                    <input type="checkbox" id="allergy-none" name="allergy" value="none / no allergies" class="sr-only" checked />
                    <span class="text-base">✅</span>
                    <span class="text-[10px] font-semibold text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.allergyNone}</span>
                    <svg id="allergy-none-check" class="hidden absolute top-1 right-1 w-3 h-3 text-[#22c55e]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  </label>
                  <div class="contents" id="allergy-chips">
                    {[
                      { value: 'chicken / poultry', label: p.allergyChicken, emoji: '🍗' },
                      { value: 'beef',               label: p.allergyBeef,    emoji: '🥩' },
                      { value: 'dairy',              label: p.allergyDairy,   emoji: '🥛' },
                      { value: 'grains / wheat',     label: p.allergyWheat,   emoji: '🌾' },
                      { value: 'soy',                label: p.allergySoy,     emoji: '🫘' },
                      { value: 'eggs',               label: p.allergyEggs,    emoji: '🥚' },
                    ].map(a => (
                      <label class="allergy-chip cursor-pointer flex flex-col items-center gap-1 p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl bg-white dark:bg-[#1c1208] has-[:checked]:border-[#ef4444] has-[:checked]:bg-[#ef4444]/8 transition-all text-center">
                        <input type="checkbox" name="allergy" value={a.value} class="sr-only" />
                        <span class="text-base">{a.emoji}</span>
                        <span class="text-[10px] font-semibold text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{a.label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </fieldset>

              <fieldset class="border-0 p-0 m-0 min-w-0">
                <legend class="block w-full text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{px.medsLabel}</legend>
                <div class="grid grid-cols-2 gap-1.5">
                  <label class="cursor-pointer">
                    <input type="radio" name="daily-meds" value="none" checked class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <span class="text-base">❌</span>
                      <span class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{px.medsNone}</span>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="daily-meds" value="yes" class="peer sr-only" />
                    <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                      <span class="text-base">💊</span>
                      <span class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8]">{px.medsYes}</span>
                    </div>
                  </label>
                </div>
              </fieldset>
            </div>

          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex items-center justify-between pt-3 border-t border-[#f0d5a8] dark:border-[#3a2510]">
          <button type="button" id="prev-btn"
            class="hidden px-5 py-2.5 text-xs sm:text-sm font-semibold text-[#92400e] dark:text-[#c4956a] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl hover:text-[#1c0f00] hover:border-[#c47a2b] transition-all cursor-pointer min-h-[42px]">
            {p.prevBtn}
          </button>
          <div id="prev-placeholder"></div>
          <button type="button" id="next-btn"
            class="px-7 py-2.5 text-xs sm:text-sm font-bold bg-[#b45309] hover:bg-[#92400e] text-white rounded-xl transition-all cursor-pointer shadow-sm min-h-[42px]">
            {p.nextBtn}
          </button>
          <button type="submit" id="submit-btn"
            class="hidden px-7 py-2.5 text-xs sm:text-sm font-bold bg-[#b45309] hover:bg-[#92400e] text-white rounded-xl transition-all cursor-pointer shadow-sm min-h-[42px]">
            {p.submitBtn}
          </button>
        </div>

      </form>
    </div>

  </div>
</section>

<script>
  import { CANINE_BREEDS } from '../data/breeds';
  import { plannerTranslations } from '../i18n/planner';
  import { plannerExtraTranslations } from '../i18n/plannerExtra';
  import type { Lang } from '../i18n/ui';

  const TOTAL_STEPS = 2;
  const PLANNER_STATE_KEY = 'dfp-planner-state';
  let currentStep = 1;
  let weightUnit: 'lbs' | 'kg' = 'lbs';
  let currentWeightKg = false;

  // ── Breed-based weight defaults & min/max enforcement ────────────
  interface BreedWeightRule {
    match: string;
    defaultKg: number;
    defaultLbs: number;
    minKg: number;
    maxKg: number;
    minLbs: number;
    maxLbs: number;
  }

  const BREED_WEIGHT_RULES: BreedWeightRule[] = [
    { match: 'Toy: under', defaultKg: 5, defaultLbs: 12, minKg: 1, maxKg: 5.4, minLbs: 2.2, maxLbs: 12 },
    { match: 'Small: 12', defaultKg: 8, defaultLbs: 18, minKg: 5.4, maxKg: 11.3, minLbs: 12, maxLbs: 25 },
    { match: 'Medium: 25', defaultKg: 18, defaultLbs: 40, minKg: 11.3, maxKg: 25, minLbs: 25, maxLbs: 55 },
    { match: 'Large: 55', defaultKg: 33, defaultLbs: 70, minKg: 25, maxKg: 41, minLbs: 55, maxLbs: 90 },
    { match: 'Giant: 90', defaultKg: 50, defaultLbs: 110, minKg: 41, maxKg: 115, minLbs: 90, maxLbs: 250 },
  ];

  function getBreedRule(breedName: string): BreedWeightRule | null {
    return BREED_WEIGHT_RULES.find(r => breedName.includes(r.match)) ?? null;
  }

  function applyBreedWeight(breedName: string) {
    const input = document.getElementById('dog-weight') as HTMLInputElement;
    if (!input) return;

    const rule = getBreedRule(breedName);
    if (rule) {
      input.value = String(currentWeightKg ? rule.defaultKg : rule.defaultLbs);
      return;
    }

    const breed = CANINE_BREEDS.find(b => b.name === breedName);
    if (breed && breed.avgWeightLbs) {
      const avgLbs = Math.round((breed.avgWeightLbs[0] + breed.avgWeightLbs[1]) / 2);
      input.value = String(currentWeightKg ? Math.round(avgLbs * 0.453592) : avgLbs);
    }
  }

  function handleWeightInput() {
    const input = document.getElementById('dog-weight') as HTMLInputElement;
    if (!input) return;
    const breedSelect = document.getElementById('dog-breed') as HTMLSelectElement;
    const rule = getBreedRule(breedSelect?.value ?? '');
    if (!rule) return;

    const maxVal = currentWeightKg ? rule.maxKg : rule.maxLbs;
    const raw = input.value.trim();
    const current = parseFloat(raw);

    // If user types a value exceeding the maximum (e.g. typing 6 when max is 5.4 kg), automatically write 5.4 kg
    if (!isNaN(current) && current > maxVal) {
      input.value = String(maxVal);
    }
  }

  function clampWeightOnBlur() {
    const input = document.getElementById('dog-weight') as HTMLInputElement;
    if (!input) return;
    const breedSelect = document.getElementById('dog-breed') as HTMLSelectElement;
    const rule = getBreedRule(breedSelect?.value ?? '');

    const raw = input.value.trim();
    const current = parseFloat(raw);

    if (rule) {
      const minVal = currentWeightKg ? rule.minKg : rule.minLbs;
      const maxVal = currentWeightKg ? rule.maxKg : rule.maxLbs;
      const defVal = currentWeightKg ? rule.defaultKg : rule.defaultLbs;

      // Blank or invalid -> restore default
      if (!raw || isNaN(current) || current <= 0) {
        input.value = String(defVal);
        return;
      }
      // Clamp to minimum (e.g. no minimum lower than 1 kg / 2.2 lb)
      if (current < minVal) {
        input.value = String(minVal);
        return;
      }
      // Clamp to maximum (e.g. max 5.4 kg / 12 lb)
      if (current > maxVal) {
        input.value = String(maxVal);
      }
    } else {
      const minVal = currentWeightKg ? 1 : 2.2;
      const maxVal = currentWeightKg ? 115 : 250;
      if (!raw || isNaN(current) || current <= 0) {
        const breed = CANINE_BREEDS.find(b => b.name === breedSelect?.value);
        if (breed && breed.avgWeightLbs) {
          const avgLbs = Math.round((breed.avgWeightLbs[0] + breed.avgWeightLbs[1]) / 2);
          input.value = String(currentWeightKg ? Math.round(avgLbs * 0.453592) : avgLbs);
        } else {
          input.value = String(currentWeightKg ? 20 : 45);
        }
        return;
      }
      if (current < minVal) input.value = String(minVal);
      if (current > maxVal) input.value = String(maxVal);
    }
  }

  function getTranslations() {
    const section = document.getElementById('planner-section') as HTMLElement;
    const lang = (section?.dataset.lang || 'en') as Lang;
    return plannerTranslations[lang] || plannerTranslations.en;
  }

  function getExtraTranslations() {
    const section = document.getElementById('planner-section') as HTMLElement;
    const lang = (section?.dataset.lang || 'en') as Lang;
    return plannerExtraTranslations[lang] || plannerExtraTranslations.en;
  }

  function updateProgress() {
    const pct = (currentStep / TOTAL_STEPS) * 100;
    const bar = document.getElementById('quiz-progress-bar') as HTMLElement;
    const label = document.getElementById('step-label') as HTMLElement;
    const badge = document.getElementById('step-title-badge') as HTMLElement;
    if (bar) bar.style.width = pct + '%';
    if (label) {
      const t = getTranslations();
      label.textContent = `${t.stepPrefix || 'STEP'} ${currentStep} ${t.ofStep || 'OF 2'}`;
    }
    if (badge) {
      const t = getTranslations();
      const tx = getExtraTranslations();
      const titles = [t.step1Title, tx.step4Title];
      badge.textContent = titles[currentStep - 1] || '';
    }
  }

  function showStep(step: number) {
    document.querySelectorAll('.quiz-step').forEach((el) => {
      (el as HTMLElement).classList.add('hidden');
    });
    const target = document.querySelector(`.quiz-step[data-step="${step}"]`) as HTMLElement;
    if (target) target.classList.remove('hidden');

    const prevBtn = document.getElementById('prev-btn') as HTMLElement;
    const prevPlaceholder = document.getElementById('prev-placeholder') as HTMLElement;
    const nextBtn = document.getElementById('next-btn') as HTMLElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLElement;

    if (step === 1) {
      prevBtn.classList.add('hidden');
      prevPlaceholder.classList.remove('hidden');
      nextBtn.classList.remove('hidden');
      submitBtn.classList.add('hidden');
    } else {
      prevBtn.classList.remove('hidden');
      prevPlaceholder.classList.add('hidden');
      nextBtn.classList.add('hidden');
      submitBtn.classList.remove('hidden');
    }

    updateProgress();
  }

  // Next & Prev button listeners
  document.getElementById('next-btn')?.addEventListener('click', () => {
    clampWeightOnBlur();
    if (currentStep < TOTAL_STEPS) {
      currentStep++;
      showStep(currentStep);
      document.getElementById('planner-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  document.getElementById('prev-btn')?.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      showStep(currentStep);
      document.getElementById('planner-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  // Allergy blocking
  const ALLERGEN_PROTEIN_MAP: Record<string, string[]> = {
    'chicken / poultry': ['chicken'],
    'beef':              ['beef'],
    'dairy':             [],
    'grains / wheat':    [],
    'soy':               [],
    'eggs':              [],
  };

  const noneBox = document.getElementById('allergy-none') as HTMLInputElement;
  const noneCheck = document.getElementById('allergy-none-check') as HTMLElement;
  const allergyChips = document.querySelectorAll<HTMLInputElement>('#allergy-chips input[type="checkbox"]');
  const proteinCards = document.querySelectorAll<HTMLInputElement>('input[name="protein"]');

  function syncNoneVisual() {
    noneCheck?.classList.toggle('hidden', !noneBox?.checked);
  }

  function syncProteinBlocking() {
    const blocked = new Set<string>();
    allergyChips.forEach(cb => {
      if (cb.checked) {
        (ALLERGEN_PROTEIN_MAP[cb.value] || []).forEach(p => blocked.add(p));
      }
    });

    proteinCards.forEach(radio => {
      const card = radio.closest('label') as HTMLElement;
      if (!card) return;
      const badge = card.querySelector('.protein-blocked-badge') as HTMLElement;

      if (blocked.has(radio.value)) {
        radio.disabled = true;
        if (radio.checked) {
          radio.checked = false;
          const safeRadio = document.querySelector<HTMLInputElement>('input[name="protein"][value="salmon"]');
          if (safeRadio && !safeRadio.disabled) {
            safeRadio.checked = true;
          } else {
            const autoRadio = document.querySelector<HTMLInputElement>('input[name="protein"][value="auto"]');
            if (autoRadio) autoRadio.checked = true;
          }
        }
        card.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        badge?.classList.remove('hidden');
      } else {
        radio.disabled = false;
        card.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        badge?.classList.add('hidden');
      }
    });
  }

  noneBox?.addEventListener('change', () => {
    if (noneBox.checked) {
      allergyChips.forEach(cb => { cb.checked = false; });
    }
    syncNoneVisual();
    syncProteinBlocking();
  });

  allergyChips.forEach(cb => {
    cb.addEventListener('change', () => {
      if (cb.checked && noneBox?.checked) {
        noneBox.checked = false;
      }
      const anyChecked = Array.from(allergyChips).some(c => c.checked);
      if (!anyChecked) {
        noneBox.checked = true;
      }
      syncNoneVisual();
      syncProteinBlocking();
    });
  });

  // Breed selection and weight listeners
  const breedSelect = document.getElementById('dog-breed') as HTMLSelectElement | null;
  breedSelect?.addEventListener('change', () => {
    if (breedSelect) applyBreedWeight(breedSelect.value);
  });

  // ── Searchable Breed Combobox Logic ──────────────────────────────
  const noMatchesLabels: Record<string, string> = {
    en: 'No matching breeds found.',
    es: 'No se encontraron razas coincidentes.',
    ja: '該当する犬種が見つかりません。',
    fr: 'Aucune race correspondante trouvée.',
    de: 'Keine passenden Rassen gefunden.',
    pt: 'Nenhuma raça correspondente encontrada.',
    ko: '일치하는 견종이 없습니다.',
    it: 'Nessuna razza trovata.',
  };

  const breedComboboxWrapper = document.getElementById('breed-combobox-wrapper');
  const breedSearchInput = document.getElementById('dog-breed-search') as HTMLInputElement | null;
  const breedClearBtn = document.getElementById('breed-clear-btn') as HTMLButtonElement | null;
  const breedToggleBtn = document.getElementById('breed-dropdown-toggle') as HTMLButtonElement | null;
  const breedChevron = document.getElementById('breed-dropdown-chevron') as HTMLElement | null;
  const breedDropdownList = document.getElementById('breed-dropdown-list') as HTMLElement | null;

  let isBreedDropdownOpen = false;
  let activeHighlightedIndex = -1;
  let currentFilteredBreeds: typeof CANINE_BREEDS = [...CANINE_BREEDS];

  function escapeHtml(text: string): string {
    return text.replace(/[&<>"']/g, m => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    }[m] || m));
  }

  function highlightMatches(text: string, query: string): string {
    if (!query) return escapeHtml(text);
    const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (!tokens.length) return escapeHtml(text);

    const escapedTokens = tokens.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    const regex = new RegExp(`(${escapedTokens.join('|')})`, 'gi');

    const parts = text.split(regex);
    return parts.map(part => {
      if (tokens.some(t => part.toLowerCase() === t.toLowerCase())) {
        return `<strong class="font-bold text-[#c47a2b] dark:text-[#f59e0b]">${escapeHtml(part)}</strong>`;
      }
      return escapeHtml(part);
    }).join('');
  }

  function renderBreedList(query = '') {
    if (!breedDropdownList) return;
    const cleanQuery = query.trim().toLowerCase();

    if (!cleanQuery) {
      currentFilteredBreeds = CANINE_BREEDS;
    } else {
      const tokens = cleanQuery.split(/\s+/).filter(Boolean);
      currentFilteredBreeds = CANINE_BREEDS.filter(b => {
        const nameLower = b.name.toLowerCase();
        const catLower = b.category.toLowerCase();
        return tokens.every(token => nameLower.includes(token) || catLower.includes(token));
      });
    }

    activeHighlightedIndex = -1;
    const selectedBreedName = breedSelect?.value || CANINE_BREEDS[0]?.name;

    if (currentFilteredBreeds.length === 0) {
      const section = document.getElementById('planner-section');
      const curLang = section?.dataset.lang || 'en';
      const noMatchesMsg = noMatchesLabels[curLang] || noMatchesLabels.en;

      breedDropdownList.innerHTML = `
        <div class="px-4 py-4 text-center">
          <p class="text-xs text-[#92400e] dark:text-[#c4956a] font-medium">${escapeHtml(noMatchesMsg)}</p>
          <p class="text-[11px] text-[#92400e]/70 dark:text-[#c4956a]/70 mt-1">Try a different search term or select an Unknown / Mixed size tier.</p>
        </div>
      `;
      return;
    }

    breedDropdownList.innerHTML = currentFilteredBreeds.map((b, idx) => {
      const isSelected = b.name === selectedBreedName;
      return `
        <div
          role="option"
          tabindex="-1"
          data-index="${idx}"
          data-breed="${escapeHtml(b.name)}"
          aria-selected="${isSelected ? 'true' : 'false'}"
          class="breed-option px-3.5 py-2.5 text-xs sm:text-sm text-[#1c0f00] dark:text-[#fde8c8] hover:bg-[#c47a2b]/15 dark:hover:bg-[#c47a2b]/25 cursor-pointer flex items-center transition-colors select-none ${isSelected ? 'bg-[#c47a2b]/10 dark:bg-[#c47a2b]/20 font-semibold text-[#c47a2b] dark:text-[#f59e0b]' : ''}"
        >
          <span class="truncate">${highlightMatches(b.name, cleanQuery)}</span>
        </div>
      `;
    }).join('');

    const optionElements = breedDropdownList.querySelectorAll<HTMLElement>('.breed-option');
    optionElements.forEach(el => {
      el.addEventListener('mousedown', (e) => {
        e.preventDefault();
      });
      el.addEventListener('click', () => {
        const breedName = el.dataset.breed;
        if (breedName) {
          selectBreed(breedName);
        }
      });
    });
  }

  function selectBreed(breedName: string) {
    if (breedSelect) {
      breedSelect.value = breedName;
      breedSelect.dispatchEvent(new Event('change'));
    }
    if (breedSearchInput) {
      breedSearchInput.value = breedName;
    }
    closeBreedDropdown();
    updateClearBtnVisibility();
  }

  function openBreedDropdown(forceShowAll = false) {
    if (isBreedDropdownOpen) return;
    isBreedDropdownOpen = true;
    breedDropdownList?.classList.remove('hidden');
    breedSearchInput?.setAttribute('aria-expanded', 'true');
    breedChevron?.classList.add('rotate-180');

    const isSelectedBreedExact = breedSelect && breedSearchInput && breedSearchInput.value === breedSelect.value;
    const initialQuery = (forceShowAll || isSelectedBreedExact) ? '' : (breedSearchInput?.value || '');
    renderBreedList(initialQuery);

    if (isSelectedBreedExact && breedDropdownList) {
      const activeEl = breedDropdownList.querySelector('[aria-selected="true"]') as HTMLElement | null;
      if (activeEl) {
        requestAnimationFrame(() => activeEl.scrollIntoView({ block: 'nearest' }));
      }
    }
  }

  function closeBreedDropdown() {
    if (!isBreedDropdownOpen) return;
    isBreedDropdownOpen = false;
    activeHighlightedIndex = -1;
    breedDropdownList?.classList.add('hidden');
    breedSearchInput?.setAttribute('aria-expanded', 'false');
    breedChevron?.classList.remove('rotate-180');
  }

  function updateClearBtnVisibility() {
    if (!breedClearBtn || !breedSearchInput) return;
    if (breedSearchInput.value.trim().length > 0) {
      breedClearBtn.classList.remove('hidden');
    } else {
      breedClearBtn.classList.add('hidden');
    }
  }

  function updateHighlightedOption() {
    const options = breedDropdownList?.querySelectorAll<HTMLElement>('.breed-option');
    if (!options || !options.length) return;
    options.forEach((opt, idx) => {
      if (idx === activeHighlightedIndex) {
        opt.classList.add('bg-[#c47a2b]/20', 'dark:bg-[#c47a2b]/30', 'ring-1', 'ring-[#c47a2b]/50');
        opt.scrollIntoView({ block: 'nearest' });
      } else {
        opt.classList.remove('bg-[#c47a2b]/20', 'dark:bg-[#c47a2b]/30', 'ring-1', 'ring-[#c47a2b]/50');
      }
    });
  }

  function moveHighlight(direction: number) {
    if (!currentFilteredBreeds.length) return;
    activeHighlightedIndex += direction;
    if (activeHighlightedIndex < 0) activeHighlightedIndex = currentFilteredBreeds.length - 1;
    if (activeHighlightedIndex >= currentFilteredBreeds.length) activeHighlightedIndex = 0;
    updateHighlightedOption();
  }

  // Input listeners
  breedSearchInput?.addEventListener('click', () => {
    if (!isBreedDropdownOpen) {
      openBreedDropdown();
      breedSearchInput.select();
    }
  });

  breedSearchInput?.addEventListener('focus', () => {
    if (!isBreedDropdownOpen) {
      openBreedDropdown();
      breedSearchInput.select();
    }
  });

  breedSearchInput?.addEventListener('input', () => {
    const query = breedSearchInput.value;
    updateClearBtnVisibility();
    if (!isBreedDropdownOpen) {
      openBreedDropdown();
    }
    renderBreedList(query);
  });

  breedSearchInput?.addEventListener('keydown', (e) => {
    if (!isBreedDropdownOpen) {
      if (e.key === 'ArrowDown' || e.key === 'Enter') {
        e.preventDefault();
        openBreedDropdown();
        breedSearchInput.select();
        return;
      }
    }

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      moveHighlight(1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      moveHighlight(-1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (isBreedDropdownOpen) {
        if (activeHighlightedIndex >= 0 && activeHighlightedIndex < currentFilteredBreeds.length) {
          selectBreed(currentFilteredBreeds[activeHighlightedIndex].name);
        } else if (currentFilteredBreeds.length > 0) {
          selectBreed(currentFilteredBreeds[0].name);
        }
      }
    } else if (e.key === 'Escape') {
      e.preventDefault();
      if (breedSelect && breedSearchInput) {
        breedSearchInput.value = breedSelect.value;
      }
      closeBreedDropdown();
      updateClearBtnVisibility();
    } else if (e.key === 'Tab') {
      if (isBreedDropdownOpen) {
        if (activeHighlightedIndex >= 0 && activeHighlightedIndex < currentFilteredBreeds.length) {
          selectBreed(currentFilteredBreeds[activeHighlightedIndex].name);
        } else {
          const exact = CANINE_BREEDS.find(b => b.name.toLowerCase() === (breedSearchInput?.value || '').trim().toLowerCase());
          if (exact) {
            selectBreed(exact.name);
          } else if (breedSelect && breedSearchInput) {
            breedSearchInput.value = breedSelect.value;
            closeBreedDropdown();
            updateClearBtnVisibility();
          }
        }
      }
    }
  });

  // Clear button
  breedClearBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (breedSearchInput) {
      breedSearchInput.value = '';
      breedSearchInput.focus();
      updateClearBtnVisibility();
      renderBreedList('');
      if (!isBreedDropdownOpen) openBreedDropdown(true);
    }
  });

  // Toggle button
  breedToggleBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (isBreedDropdownOpen) {
      closeBreedDropdown();
    } else {
      openBreedDropdown(true);
      breedSearchInput?.focus();
      breedSearchInput?.select();
    }
  });

  // Click outside listener
  document.addEventListener('click', (e) => {
    if (!breedComboboxWrapper?.contains(e.target as Node)) {
      if (isBreedDropdownOpen) {
        const currentText = (breedSearchInput?.value || '').trim();
        const matchedBreed = CANINE_BREEDS.find(b => b.name.toLowerCase() === currentText.toLowerCase());
        if (matchedBreed) {
          selectBreed(matchedBreed.name);
        } else if (breedSelect && breedSearchInput) {
          breedSearchInput.value = breedSelect.value;
        }
        closeBreedDropdown();
        updateClearBtnVisibility();
      }
    }
  });

  const weightInput = document.getElementById('dog-weight') as HTMLInputElement | null;
  weightInput?.addEventListener('input', handleWeightInput);
  weightInput?.addEventListener('blur', clampWeightOnBlur);

  // Weight unit toggle
  document.getElementById('unit-lbs')?.addEventListener('click', () => {
    if (currentWeightKg) {
      const input = document.getElementById('dog-weight') as HTMLInputElement;
      const val = parseFloat(input?.value || '0') || 0;
      const rule = getBreedRule(breedSelect?.value ?? '');

      currentWeightKg = false;
      weightUnit = 'lbs';

      if (rule && Math.abs(val - rule.defaultKg) < 0.05) {
        input.value = String(rule.defaultLbs);
      } else {
        input.value = Math.round(val * 2.20462).toString();
      }
      clampWeightOnBlur();
    }
    (document.getElementById('unit-lbs') as HTMLElement).className = 'px-2 py-0.5 bg-[#b45309] text-white font-semibold transition-colors cursor-pointer text-xs';
    (document.getElementById('unit-kg') as HTMLElement).className = 'px-2 py-0.5 bg-white dark:bg-[#1c1208] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer text-xs';
    (document.getElementById('weight-unit-label') as HTMLElement).textContent = 'LBS';
  });

  document.getElementById('unit-kg')?.addEventListener('click', () => {
    if (!currentWeightKg) {
      const input = document.getElementById('dog-weight') as HTMLInputElement;
      const val = parseFloat(input?.value || '0') || 0;
      const rule = getBreedRule(breedSelect?.value ?? '');

      currentWeightKg = true;
      weightUnit = 'kg';

      if (rule && Math.abs(val - rule.defaultLbs) < 0.05) {
        input.value = String(rule.defaultKg);
      } else {
        input.value = Math.round(val / 2.20462).toString();
      }
      clampWeightOnBlur();
    }
    (document.getElementById('unit-kg') as HTMLElement).className = 'px-2 py-0.5 bg-[#b45309] text-white font-semibold transition-colors cursor-pointer text-xs';
    (document.getElementById('unit-lbs') as HTMLElement).className = 'px-2 py-0.5 bg-white dark:bg-[#1c1208] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer text-xs';
    (document.getElementById('weight-unit-label') as HTMLElement).textContent = 'KG';
  });

  // Reset handler
  document.addEventListener('dogPlannerReset', () => {
    sessionStorage.removeItem(PLANNER_STATE_KEY);
    currentStep = 1;
    const form = document.getElementById('dog-planner-form') as HTMLFormElement | null;
    if (form) form.reset();
    if (breedSelect && breedSearchInput) {
      breedSearchInput.value = breedSelect.value;
      closeBreedDropdown();
      updateClearBtnVisibility();
    }
    if (breedSelect) applyBreedWeight(breedSelect.value);
    syncNoneVisual();
    syncProteinBlocking();
    showStep(1);
  });

  // Submit handler
  function submitForm() {
    clampWeightOnBlur();
    const name = (document.getElementById('dog-name') as HTMLInputElement).value.trim() || 'Lucy';
    const breed = (document.getElementById('dog-breed') as HTMLSelectElement).value;
    const ageStage = (document.querySelector('input[name="age-stage"]:checked') as HTMLInputElement)?.value || 'adult';
    const weightGoal = (document.querySelector('input[name="weight-goal"]:checked') as HTMLInputElement)?.value || 'maintain';
    const currentDiet = (document.querySelector('input[name="current-diet"]:checked') as HTMLInputElement)?.value || 'fresh';
    const proteinChoice = (document.querySelector('input[name="protein"]:checked') as HTMLInputElement)?.value || 'salmon';
    const hasMeds = (document.querySelector('input[name="daily-meds"]:checked') as HTMLInputElement)?.value === 'yes';

    const rawWeight = parseFloat((document.getElementById('dog-weight') as HTMLInputElement).value) || 12;
    const weightLbs = currentWeightKg ? rawWeight * 2.20462 : rawWeight;

    const allergies = Array.from(document.querySelectorAll('input[name="allergy"]:checked'))
      .map(el => (el as HTMLInputElement).value);

    const profile = {
      name,
      breed,
      ageStage,
      gender: 'female-spayed',
      weightLbs,
      targetGoal: weightGoal,
      bcs: weightGoal === 'lose' ? 7 : (weightGoal === 'gain' ? 3 : 5),
      activityLevel: 'moderate',
      allergies: allergies.length ? allergies : ['none / no allergies'],
      healthFocus: ageStage === 'senior' ? 'Joints & Mobility Support' : 'General Longevity & Health',
      dietPreference: currentDiet,
      proteinChoice,
      currentDiet,
      mealsCount: 2,
      treatHabit: 'moderate',
      hasMeds,
    };

    document.dispatchEvent(new CustomEvent('dogPlannerSubmit', { detail: profile }));
  }

  document.getElementById('dog-planner-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    submitForm();
  });
  document.getElementById('submit-btn')?.addEventListener('click', submitForm);

  // Initialize breed combobox & weight
  if (breedSelect) {
    if (breedSearchInput) {
      breedSearchInput.value = breedSelect.value;
      updateClearBtnVisibility();
    }
    applyBreedWeight(breedSelect.value);
  }

  syncNoneVisual();
  syncProteinBlocking();
  showStep(1);
</script>
