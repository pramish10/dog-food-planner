                  <div class="font-semibold text-xs sm:text-sm mb-0.5">🛋️ {p.activityLow}</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.activityLowSub}</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/60 dark:peer-checked:!text-[#171717]/60">0.85x</div>
              </div>
            </label>

            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="moderate" checked class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">🐕 {p.activityMod}</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.activityModSub}</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/60 dark:peer-checked:!text-[#171717]/60">1.0x</div>
              </div>
            </label>

            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="active" class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">⚡ {p.activityHigh}</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.activityHighSub}</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/60 dark:peer-checked:!text-[#171717]/60">1.25x</div>
              </div>
            </label>

            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="working" class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">🏔️ {p.activityWorking}</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.activityWorkingSub}</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/60 dark:peer-checked:!text-[#171717]/60">1.55x</div>
              </div>
            </label>
          </div>
        </div>

        <!-- STEP 4: Allergies & Primary Health Focus -->
        <div class="quiz-step hidden" data-step="4">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">{p.step5Title}</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">{p.step5Subtitle}</p>

          <div class="space-y-5">
            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-2 font-mono">
                {p.allergiesLabel}
              </label>
              <div class="flex flex-wrap gap-1.5 sm:gap-2" id="allergy-pills">
                {[
                  { label: p.allergyNone, val: 'none / no allergies' },
                  { label: p.allergyChicken, val: 'chicken / poultry' },
                  { label: p.allergyBeef, val: 'beef' },
                  { label: p.allergyDairy, val: 'dairy' },
                  { label: p.allergyWheat, val: 'grains / wheat' },
                  { label: p.allergySoy, val: 'soy' },
                  { label: p.allergyEggs, val: 'eggs' },
                  { label: 'Corn', val: 'corn' }
                ].map((item, idx) => (
                  <label class="cursor-pointer touch-manipulation">
                    <input 
                      type="checkbox" 
                      value={item.val} 
                      checked={idx === 0} 
                      class="allergy-check peer sr-only" 
                    />
                    <span class="inline-block px-2.5 sm:px-3 py-1.5 text-[11px] sm:text-xs font-medium border border-[#ebebeb] dark:border-[#2e2e2e] rounded-full peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all">
                      {item.label}
                    </span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                {p.healthFocusLabel}
              </label>
              <select 
                id="health-focus" 
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
              >
                <option value="General Health" selected>⭐ {p.focusGeneral}</option>
                <option value="Sensitive Digestion">🌱 {p.focusDigestion}</option>
                <option value="Hip & Joint">🦴 {p.focusJoints}</option>
                <option value="Skin & Anti-Itch">✨ {p.focusCoat}</option>
                <option value="Weight Management">⚖️ {p.focusWeight}</option>
              </select>
            </div>
          </div>
        </div>

        <!-- STEP 5: Feeding Philosophy & Protein Rotation -->
        <div class="quiz-step hidden" data-step="5">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">{p.step4Title}</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">{p.step4Subtitle}</p>

          <div class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3.5">
              <label class="cursor-pointer touch-manipulation">
                <input type="radio" name="diet-preference" value="fresh-cooked" checked class="peer sr-only" />
                <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-xs sm:text-sm mb-0.5">🍲 {p.dietFresh}</div>
                    <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.dietFreshSub}</p>
                  </div>
                </div>
              </label>

              <label class="cursor-pointer touch-manipulation">
                <input type="radio" name="diet-preference" value="raw-barf" class="peer sr-only" />
                <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-xs sm:text-sm mb-0.5">🥩 {p.dietRaw}</div>
                    <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.dietRawSub}</p>
                  </div>
                </div>
              </label>

              <label class="cursor-pointer touch-manipulation">
                <input type="radio" name="diet-preference" value="superfood-topper" class="peer sr-only" />
                <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-xs sm:text-sm mb-0.5">🥣 {p.dietTopper}</div>
                    <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.dietTopperSub}</p>
                  </div>
                </div>
              </label>
            </div>

            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                {p.proteinLabel}
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-6 gap-2">
                {[
                  { label: p.proteinRotation, val: 'Balanced Rotation (No Pref)' },
                  { label: p.proteinChicken, val: 'Chicken' },
                  { label: p.proteinTurkey, val: 'Turkey' },
                  { label: p.proteinBeef, val: 'Beef' },
                  { label: p.proteinSalmon, val: 'Salmon' },
                  { label: p.proteinLamb, val: 'Lamb' }
                ].map((item, idx) => (
                  <label class="cursor-pointer touch-manipulation" data-protein-option={item.val.toLowerCase()}>
                    <input 
                      type="radio" 
                      name="protein-choice" 
                      value={item.val} 
                      checked={idx === 0} 
                      class="peer sr-only" 
                    />
                    <div class="p-2 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all">
                      {item.label}
                    </div>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex items-center justify-between mt-8 sm:mt-10 pt-4 sm:pt-6 border-t border-[#ebebeb] dark:border-[#262626] gap-2">
          <button 
            type="button" 
            id="prev-btn" 
            class="hidden px-4 sm:px-5 py-2.5 text-xs font-medium text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-full hover:bg-[#f2f2f2] dark:hover:bg-[#262626] active:scale-[0.98] transition-colors"
          >
            {p.prevBtn}
          </button>
          
          <div class="ml-auto flex items-center gap-2">
            <button 
              type="button" 
              id="next-btn" 
              class="px-5 sm:px-6 py-2.5 text-xs font-semibold text-white bg-[#171717] dark:bg-white dark:text-[#171717] hover:bg-[#333333] dark:hover:bg-[#e5e5e5] active:scale-[0.98] transition-all rounded-full shadow-sm"
            >
              {p.nextBtn}
            </button>
            
            <button 
              type="button" 
              id="generate-plan-btn" 
              class="hidden px-6 sm:px-8 py-2.5 text-xs font-semibold text-white bg-[#171717] dark:bg-white dark:text-[#171717] hover:bg-[#0070f3] dark:hover:bg-[#3291ff] dark:hover:text-white active:scale-[0.98] transition-all rounded-full shadow-md cursor-pointer"
            >
              {p.submitBtn}
            </button>
          </div>
        </div>

      </form>
    </div>

  </div>
</section>

<!-- AI Camera & Photo Breed Scanner Modal (BETA) -->
<div id="ai-scanner-modal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-md hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
  <div class="bg-white dark:bg-[#121212] rounded-2xl border border-[#ebebeb] dark:border-[#262626] max-w-lg w-full p-4 sm:p-5 shadow-2xl relative overflow-hidden my-auto animate-in fade-in zoom-in-95 duration-200">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-[#10b981]/15 text-[#10b981] flex items-center justify-center font-bold text-base">
          📸
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h4 class="font-semibold text-sm sm:text-base text-[#171717] dark:text-[#ededed]">AI Dog Breed Scanner</h4>
            <span class="font-mono text-[9px] uppercase px-1.5 py-0.5 rounded-full bg-[#0070f3] text-white font-bold tracking-wider">BETA</span>
          </div>
          <p class="text-[11px] text-[#8f8f8f] dark:text-[#737373]">Live camera or photo scan to detect breed</p>
        </div>
      </div>
      <button type="button" id="close-ai-modal" class="p-2 rounded-lg text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white hover:bg-[#f2f2f2] dark:hover:bg-[#262626] cursor-pointer transition-colors" aria-label="Close Scanner">
        ✕
      </button>
    </div>

    <!-- Scanner Viewfinder -->
    <div class="relative bg-[#0a0a0a] rounded-xl overflow-hidden aspect-4/3 flex items-center justify-center mb-3 border border-[#262626] shadow-inner">
      <video id="scanner-video" autoplay playsinline muted class="w-full h-full object-cover hidden"></video>
      <img id="scanner-img-preview" class="w-full h-full object-cover hidden" alt="Scanned Dog" />
      <canvas id="scanner-canvas" class="hidden"></canvas>

      <!-- Viewfinder Overlay Elements -->
      <div class="absolute inset-3 pointer-events-none flex flex-col justify-between z-20">
        <!-- Top status -->
        <div class="flex items-center pointer-events-auto">
          <div class="px-2 py-0.5 rounded-full bg-black/70 backdrop-blur-xs font-mono text-[9px] text-[#ededed] flex items-center gap-1.5 border border-white/10">
            <span id="camera-status-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="camera-status-text">Camera Active</span>
          </div>
        </div>

        <!-- Center Target Reticle -->
        <div class="self-center flex flex-col items-center pointer-events-none">
          <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-2xl border-2 border-dashed border-white/40 flex items-center justify-center relative">
            <span class="text-xs text-white/70 font-medium px-2 py-0.5 bg-black/50 rounded-md">Point at Dog</span>
          </div>
        </div>

        <!-- Live Auto-Scan Status HUD -->
        <div id="auto-scan-hud" class="self-center pointer-events-none text-center px-3 py-1 rounded-full bg-black/75 backdrop-blur-md border border-emerald-500/40 text-[10px] sm:text-[11px] font-mono text-emerald-300 flex items-center gap-1.5 shadow-lg transition-all">
          <span id="auto-scan-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="auto-scan-hud-text">⚡ Auto-Scan: Point at dog to scan</span>
        </div>

        <div class="text-center text-[10px] text-white/60 font-mono pointer-events-none">
          Automatically identifies a dog in frame
        </div>
      </div>

      <!-- Initial Loading / Placeholder State -->
      <div id="scanner-placeholder" class="text-center p-4 text-white z-10">
        <div class="w-12 h-12 rounded-full border-2 border-dashed border-[#10b981] mx-auto mb-2.5 flex items-center justify-center text-xl bg-[#10b981]/10 animate-pulse">
          🐾
        </div>
        <p class="text-xs font-semibold text-white">Starting Live Camera...</p>
        <p class="text-[10px] text-[#8f8f8f] mt-0.5">Please allow camera permissions if prompted</p>
      </div>

      <!-- Scanner Animation Line -->
      <div id="scanner-laser" class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-transparent via-[#10b981] to-transparent shadow-[0_0_12px_#10b981] hidden z-20 transition-all duration-75"></div>
      
      <!-- Processing Toast -->
      <div id="scanner-processing-tag" class="absolute bottom-2.5 inset-x-2.5 bg-black/85 backdrop-blur-md text-[#10b981] text-[10px] font-mono font-bold px-3 py-1.5 rounded-lg border border-[#10b981]/40 hidden z-30 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#10b981] animate-ping"></span>
          <span id="scan-step-text">IDENTIFYING DOG BREED...</span>
        </div>
      </div>
    </div>

    <div class="space-y-2.5">
      <!-- Camera switching is available only on phones and tablets. -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        <button 
          type="button" 
          id="flip-camera-btn-alt"
          class="py-2 bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] text-[#171717] dark:text-[#ededed] hover:bg-[#f2f2f2] dark:hover:bg-[#262626] text-xs font-semibold rounded-lg transition-all flex lg:hidden items-center justify-center gap-1.5 cursor-pointer touch-manipulation"
        >
          <span>🔄 Switch Camera</span>
        </button>
        
        <label class="py-2 bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] text-[#171717] dark:text-[#ededed] hover:bg-[#f2f2f2] dark:hover:bg-[#262626] text-xs font-semibold rounded-lg transition-all flex items-center justify-center gap-1.5 cursor-pointer text-center touch-manipulation">
          <span>📁 Upload Photo</span>
          <input type="file" id="dog-photo-upload" accept="image/*" class="sr-only" />
        </label>
      </div>

      <!-- Hidden elements for script compatibility -->
      <div id="lighting-badge" class="hidden">
        <span id="lighting-dot"></span>
        <span id="lighting-text"></span>
      </div>
      <div id="telemetry-badge" class="hidden">
        <span id="cranial-ratio-val"></span>
      </div>
      <div id="low-light-warning-box" class="hidden p-2.5 bg-amber-500/10 border border-amber-500/30 rounded-lg text-[11px] text-amber-700 dark:text-amber-300">
        💡 Lighting is low (<span id="lux-pct-text"></span>). A well-lit photo gives the most accurate breed identification.
      </div>
      <button type="button" id="start-camera-btn" class="hidden"></button>

      <!-- Non-Dog Warning Banner -->
      <div id="human-warning-box" class="hidden p-3 bg-rose-500/10 border border-rose-500/30 rounded-xl space-y-2">
        <div class="flex items-start gap-2.5">
