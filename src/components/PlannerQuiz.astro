  function updateAutoScanHud(text: string, mode: 'active' | 'detecting' | 'warning' | 'loading' = 'active') {
    const hud = document.getElementById('auto-scan-hud');
    const hudText = document.getElementById('auto-scan-hud-text');
    const hudDot = document.getElementById('auto-scan-dot');
    if (!hud || !hudText) return;

    hudText.textContent = text;
    if (mode === 'detecting') {
      hud.className = 'self-center pointer-events-none text-center px-3 py-1 rounded-full bg-emerald-900/90 backdrop-blur-md border border-emerald-400 text-[10px] sm:text-[11px] font-mono text-emerald-200 flex items-center gap-1.5 shadow-lg ring-2 ring-emerald-500/50 animate-pulse';
      if (hudDot) hudDot.className = 'w-2 h-2 rounded-full bg-emerald-300 animate-ping';
    } else if (mode === 'warning') {
      hud.className = 'self-center pointer-events-none text-center px-3 py-1 rounded-full bg-amber-950/85 backdrop-blur-md border border-amber-400 text-[10px] sm:text-[11px] font-mono text-amber-200 flex items-center gap-1.5 shadow-lg';
      if (hudDot) hudDot.className = 'w-2 h-2 rounded-full bg-amber-400';
    } else if (mode === 'loading') {
      hud.className = 'self-center pointer-events-none text-center px-3 py-1 rounded-full bg-black/75 backdrop-blur-md border border-blue-500/40 text-[10px] sm:text-[11px] font-mono text-blue-300 flex items-center gap-1.5 shadow-lg';
      if (hudDot) hudDot.className = 'w-2 h-2 rounded-full bg-blue-400 animate-pulse';
    } else {
      hud.className = 'self-center pointer-events-none text-center px-3 py-1 rounded-full bg-black/75 backdrop-blur-md border border-emerald-500/40 text-[10px] sm:text-[11px] font-mono text-emerald-300 flex items-center gap-1.5 shadow-lg';
      if (hudDot) hudDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
    }
  }

  function startAutoScanner() {
    stopAutoScanner();
    isAutoScanning = true;
    autoScanDogHits = 0;
    updateAutoScanHud('⚡ Auto-Scan: Point at dog to scan', 'active');

    autoScanIntervalId = setInterval(async () => {
      if (!isAutoScanning || isInferring) return;
      if (!scannerVideo || scannerVideo.paused || scannerVideo.videoWidth === 0) return;

      if (!cocoSsdModel) {
        updateAutoScanHud('⏳ Loading Neural Vision Engine...', 'loading');
        await loadEdgeModel();
        return;
      }

      try {
        const detections = await cocoSsdModel.detect(scannerVideo);
        if (!isAutoScanning || isInferring) return;

        const dogMatch = detections.find((d: any) => d.class === 'dog' && d.score >= 0.55);
        const personMatch = detections.find((d: any) => d.class === 'person' && d.score >= 0.60);
        const animalMatch = detections.find((d: any) => 
          ['cat', 'bird', 'horse', 'sheep', 'cow', 'elephant', 'bear', 'zebra', 'giraffe'].includes(d.class) && d.score >= 0.55
        );

        if (dogMatch) {
          autoScanDogHits++;
          updateAutoScanHud(`🐕 Dog In Frame (${Math.round(dogMatch.score * 100)}%)! Identifying...`, 'detecting');
          stopAutoScanner();
          await executeDeepVisionInference(scannerVideo, '');
        } else if (animalMatch) {
          autoScanDogHits = 0;
          updateAutoScanHud(`🐾 ${animalMatch.class.toUpperCase()} in frame — point at dog`, 'warning');
        } else if (personMatch) {
          autoScanDogHits = 0;
          updateAutoScanHud('👤 Person in frame — point at dog', 'warning');
        } else {
          autoScanDogHits = 0;
          updateAutoScanHud('⚡ Auto-Scan: Point at dog to scan', 'active');
        }
      } catch (e) {
        console.warn('Auto-scan frame error:', e);
      }
    }, 600);
  }

  function stopAutoScanner() {
    isAutoScanning = false;
    if (autoScanIntervalId) {
      clearInterval(autoScanIntervalId);
      autoScanIntervalId = null;
    }
  }

  async function startCamera(facing: 'environment' | 'user' = currentFacingMode) {
    resetScannerUI();
    scannerPlaceholder?.classList.remove('hidden');
    if (scannerVideo) scannerVideo.classList.add('hidden');
    if (cameraStatusText) cameraStatusText.textContent = 'Starting Camera...';

    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ 
          video: { facingMode: facing, width: { ideal: 640 }, height: { ideal: 480 } } 
        });
        if (scannerVideo) {
          scannerVideo.srcObject = stream;
          scannerVideo.classList.remove('hidden');
          await scannerVideo.play();
        }
        scannerPlaceholder?.classList.add('hidden');
        if (cameraStatusText) cameraStatusText.textContent = facing === 'environment' ? 'Rear Camera' : 'Front Camera';
        if (cameraStatusDot) cameraStatusDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse';
        startAutoScanner();
      } catch (err) {
        console.warn('Camera error:', err);
        scannerPlaceholder?.classList.add('hidden');
        if (cameraStatusText) cameraStatusText.textContent = 'Camera Blocked';
        if (cameraStatusDot) cameraStatusDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-400';
        showSubjectWarning('Camera unavailable', 'Camera access is required for a live scan. You can grant camera permissions or upload a dog photo.');
      }
    } else {
      scannerPlaceholder?.classList.add('hidden');
      showSubjectWarning('Camera unavailable', 'This device/browser does not support direct camera capture. Please upload a dog photo instead.');
    }
  }

