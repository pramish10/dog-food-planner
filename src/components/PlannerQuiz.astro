  // Load the detector and ImageNet classifier only in the browser. Both are trained neural
  // models, cached by the browser after first use, so no app or user download is required.
  async function loadEdgeModel() {
    if (cocoSsdModel && mobileNetModel) return;
    if (modelLoadPromise) return modelLoadPromise;
    modelLoadPromise = (async () => {
      if (typeof (window as any).cocoSsd === 'undefined' || typeof (window as any).mobilenet === 'undefined') return;
      try {
        const [detector, classifier] = await Promise.all([
          (window as any).cocoSsd.load({ base: 'mobilenet_v2' }),
          (window as any).mobilenet.load({ version: 2, alpha: 1.0 })
        ]);
        cocoSsdModel = detector;
        mobileNetModel = classifier;
      } catch (e) {
        console.warn('Could not load browser vision models:', e);
      } finally {
        modelLoadPromise = null;
      }
    })();
    return modelLoadPromise;
  }
  loadEdgeModel();

