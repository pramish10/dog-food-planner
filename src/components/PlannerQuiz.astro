---
import { CANINE_BREEDS } from '../data/breeds';
import { RECIPES } from '../data/recipes';
import { getLangFromUrl } from '../i18n/utils';
import { plannerTranslations } from '../i18n/planner';

const lang = getLangFromUrl(Astro.url);
const p = plannerTranslations[lang] || plannerTranslations.en;
---

<section id="planner-section" class="py-12 sm:py-20 bg-[#fafafa] dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]" data-lang={lang}>
  <div class="max-w-4xl mx-auto px-3.5 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-1.5 font-mono text-[10px] sm:text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#ffffff] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-2.5 shadow-2xs">
        <span class="text-[#0070f3]">01</span> // {p.badge}
      </div>
      <h2 class="text-2xl sm:text-4xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-2 sm:mb-3">
        {p.title}
      </h2>
      <p class="text-xs sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-lg mx-auto leading-relaxed">
        {p.subtitle}
      </p>
    </div>

    <!-- General Purpose & Educational Disclaimer Banner -->
    <div class="mb-6 sm:mb-8 p-3.5 sm:p-4 rounded-xl bg-amber-500/10 border border-amber-500/25 flex items-start gap-3 text-xs text-[#4d4d4d] dark:text-[#cccccc] leading-relaxed max-w-4xl mx-auto shadow-2xs">
      <span class="text-base shrink-0 mt-0.5">🐾</span>
      <div>
        <strong class="font-semibold text-amber-900 dark:text-amber-300">{p.disclaimerTitle}</strong>
        <span> {p.disclaimerText}</span>
      </div>
    </div>

    <!-- Quiz Card Container -->
    <div class="hairline-card p-4 sm:p-8 md:p-10 bg-white dark:bg-[#141414] relative overflow-hidden">
      
      <!-- Progress Bar -->
      <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-1.5 rounded-full mb-6 sm:mb-8 overflow-hidden">
        <div id="quiz-progress-bar" class="bg-[#171717] dark:bg-[#ededed] h-full transition-all duration-300 w-1/5"></div>
      </div>

      <!-- Step Indicator Badge -->
      <div class="flex items-center justify-between mb-5 sm:mb-6 pb-3 sm:pb-4 border-b border-[#ebebeb] dark:border-[#262626]">
        <span id="step-badge" class="font-mono text-[10px] sm:text-xs font-semibold text-[#8f8f8f] dark:text-[#737373] uppercase tracking-wider" data-prefix={p.stepPrefix} data-of={p.ofStep}>
          {p.stepPrefix} 1 {p.ofStep} {p.step1Title.toUpperCase()}
        </span>
        <span class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono hidden xs:inline">{p.nrcStandard}</span>
      </div>

      <form id="dog-planner-form" onsubmit="return false;">
        
        <!-- STEP 1: Basic Profile -->
        <div class="quiz-step active-step" data-step="1">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">{p.step1Title}</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">{p.step1Subtitle}</p>

          <div class="space-y-4 sm:space-y-5">
            <div>
              <label for="dog-name" class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                {p.nameLabel}
              </label>
              <input 
                type="text" 
                id="dog-name" 
                placeholder={p.namePlaceholder} 
                value="Lucy"
                required
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717] transition-all"
              />
            </div>

            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                {p.ageLabel}
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5">
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="puppy-early" class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] peer-checked:!text-white dark:peer-checked:!text-[#171717] group">
                    <div class="font-semibold text-xs text-inherit">{p.puppyEarly}</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.puppyEarlySub}</div>
                  </div>
                </label>

                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="puppy-late" class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] peer-checked:!text-white dark:peer-checked:!text-[#171717] group">
                    <div class="font-semibold text-xs text-inherit">{p.puppyLate}</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.puppyLateSub}</div>
                  </div>
                </label>

                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="adult" checked class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] peer-checked:!text-white dark:peer-checked:!text-[#171717] group">
                    <div class="font-semibold text-xs text-inherit">{p.adult}</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.adultSub}</div>
                  </div>
                </label>

                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="senior" class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] peer-checked:!text-white dark:peer-checked:!text-[#171717] group">
                    <div class="font-semibold text-xs text-inherit">{p.senior}</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.seniorSub}</div>
                  </div>
                </label>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                  {p.genderLabel}
                </label>
                <button 
                  type="button" 
                  id="gender-info-toggle-btn"
                  class="text-[10px] font-mono text-[#0070f3] dark:text-[#3291ff] hover:underline inline-flex items-center gap-1 cursor-pointer touch-manipulation"
                  aria-expanded="false"
                >
                  <span>ℹ️ {p.statusMeaningsBtn}</span>
                </button>
              </div>
              <p class="text-[11px] text-[#8f8f8f] dark:text-[#737373] mb-2 leading-relaxed">
                {p.genderDesc}
              </p>

              <!-- Expandable Status Meanings Guide -->
              <div id="gender-info-panel" class="hidden mb-3 p-3 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-xl text-[11px] space-y-2">
                <div class="font-semibold text-xs text-[#171717] dark:text-[#ededed] flex items-center justify-between">
                  <span>{p.statusGuideTitle}</span>
                  <a href="/faq/what-does-spayed-neutered-intact-gender-mean-for-dogs" target="_blank" class="text-[10px] text-[#0070f3] dark:text-[#3291ff] hover:underline font-mono">{p.fullFaqLink}</a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
                  <div class="p-2 bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] rounded-lg">
                    <div class="font-semibold text-[#171717] dark:text-[#ededed]">{p.femaleSpayedTitle}</div>
                    <div class="text-[#737373] dark:text-[#a1a1a1] mt-0.5">{p.femaleSpayedDesc}</div>
                  </div>
                  <div class="p-2 bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] rounded-lg">
                    <div class="font-semibold text-[#171717] dark:text-[#ededed]">{p.femaleIntactTitle}</div>
                    <div class="text-[#737373] dark:text-[#a1a1a1] mt-0.5">{p.femaleIntactDesc}</div>
                  </div>
                  <div class="p-2 bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] rounded-lg">
                    <div class="font-semibold text-[#171717] dark:text-[#ededed]">{p.maleNeuteredTitle}</div>
                    <div class="text-[#737373] dark:text-[#a1a1a1] mt-0.5">{p.maleNeuteredDesc}</div>
                  </div>
                  <div class="p-2 bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] rounded-lg">
                    <div class="font-semibold text-[#171717] dark:text-[#ededed]">{p.maleIntactTitle}</div>
                    <div class="text-[#737373] dark:text-[#a1a1a1] mt-0.5">{p.maleIntactDesc}</div>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5">
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="female-spayed" checked class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    <div class="font-semibold text-xs text-inherit">{p.femaleSpayed}</div>
                    <div class="text-[10px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.femaleSpayedSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="female-intact" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    <div class="font-semibold text-xs text-inherit">{p.femaleIntact}</div>
                    <div class="text-[10px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.femaleIntactSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="male-neutered" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    <div class="font-semibold text-xs text-inherit">{p.maleNeutered}</div>
                    <div class="text-[10px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.maleNeuteredSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="male-intact" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    <div class="font-semibold text-xs text-inherit">{p.maleIntact}</div>
                    <div class="text-[10px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">{p.maleIntactSub}</div>
                  </div>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: Breed & Physical Metrics with AI Breed Scanner -->
        <div class="quiz-step hidden" data-step="2">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
            <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed]">{p.step2Title}</h3>
            
            <!-- AI Camera Breed Scanner Trigger -->
            <button 
              type="button" 
              id="ai-scan-trigger-btn" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[11px] font-mono font-semibold text-[#0070f3] dark:text-[#3291ff] bg-[#d3e5ff]/50 dark:bg-[#0070f3]/20 hover:bg-[#d3e5ff] dark:hover:bg-[#0070f3]/30 border border-[#0070f3]/30 rounded-full transition-all touch-manipulation cursor-pointer shadow-2xs"
            >
              <span>📸 {p.aiScanBtn}</span>
              <span class="text-[9px] uppercase px-1.5 py-0.2 rounded-full bg-[#0070f3] text-white font-bold">BETA</span>
            </button>
          </div>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">{p.step2Subtitle}</p>

          <div class="space-y-4 sm:space-y-5">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="dog-breed" class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                  {p.breedLabel}
                </label>
              </div>
              <select 
                id="dog-breed" 
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
              >
                {CANINE_BREEDS.map((b) => (
                  <option value={b.name}>{b.name}</option>
                ))}
              </select>
            </div>

            <!-- Weight and Unit Selector -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="dog-weight" class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                    {p.weightLabel}
                  </label>
                  <div class="flex items-center text-[10px] font-mono border border-[#ebebeb] dark:border-[#2e2e2e] rounded overflow-hidden">
                    <button type="button" id="unit-lbs" class="px-2 py-0.5 bg-[#171717] dark:bg-white text-white dark:text-[#171717] transition-colors cursor-pointer">LBS</button>
                    <button type="button" id="unit-kg" class="px-2 py-0.5 bg-[#fafafa] dark:bg-[#1a1a1a] text-[#8f8f8f] dark:text-[#737373] transition-colors cursor-pointer">KG</button>
                  </div>
                </div>
                <div class="relative">
                  <input 
                    type="number" 
                    id="dog-weight" 
                    min="1" 
                    max="250" 
                    value="45" 
                    required 
                    class="w-full px-3.5 pr-16 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
                  />
                  <span id="weight-unit-label" class="absolute right-4 top-2.5 text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono">LBS</span>
                </div>
              </div>

              <div>
                <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                  {p.weightGoalLabel}
                </label>
                <select 
                  id="target-goal" 
                  class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
                >
                  <option value="maintain" selected>{p.goalMaintain}</option>
                  <option value="lose">{p.goalLose}</option>
                  <option value="gain">{p.goalGain}</option>
                </select>
              </div>
            </div>

            <!-- Body Condition Score 1-9 & Body Shape Selector -->
            <div class="space-y-2 p-3 sm:p-3.5 bg-[#fafafa] dark:bg-[#161616] rounded-xl border border-[#ebebeb] dark:border-[#262626]">
              <div class="flex items-center justify-between">
                <div>
                  <label class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                    {p.bcsLabel}
                  </label>
                </div>
                <span id="bcs-label" class="shrink-0 font-mono text-[10px] sm:text-xs font-bold text-[#10b981] bg-[#10b981]/15 px-2 py-0.5 rounded" data-underweight={p.bcsUnderweight} data-ideal={p.bcsIdeal} data-overweight={p.bcsOverweight} data-obese={p.bcsObese}>
                  {p.bcsIdeal} (BCS 5/9)
                </span>
              </div>

              <!-- Quick Presets -->
              <div class="grid grid-cols-3 gap-1.5 pt-1">
                <button type="button" class="bcs-preset-btn px-2 py-1.5 rounded-lg text-center border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1f1f1f] hover:border-[#171717] dark:hover:border-white transition-all text-left cursor-pointer" data-bcs="3">
                  <div class="text-[11px] font-semibold text-[#171717] dark:text-white flex items-center gap-1">🏃 {p.bcsUnderweight}</div>
                  <div class="text-[9px] text-[#8f8f8f] dark:text-[#737373] mt-0.5">{p.bcsUnderweightDesc}</div>
                </button>
                <button type="button" class="bcs-preset-btn px-2 py-1.5 rounded-lg text-center border-2 border-[#10b981] bg-[#10b981]/10 text-left cursor-pointer" data-bcs="5">
                  <div class="text-[11px] font-semibold text-[#171717] dark:text-white flex items-center gap-1">🐕 {p.bcsIdeal}</div>
                  <div class="text-[9px] text-[#10b981] font-medium mt-0.5">{p.bcsIdealDesc}</div>
                </button>
                <button type="button" class="bcs-preset-btn px-2 py-1.5 rounded-lg text-center border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1f1f1f] hover:border-[#171717] dark:hover:border-white transition-all text-left cursor-pointer" data-bcs="7">
                  <div class="text-[11px] font-semibold text-[#171717] dark:text-white flex items-center gap-1">🛋️ {p.bcsOverweight}</div>
                  <div class="text-[9px] text-[#8f8f8f] dark:text-[#737373] mt-0.5">{p.bcsOverweightDesc}</div>
                </button>
              </div>

              <!-- Fine-tuning Slider -->
              <div class="pt-1">
                <input 
                  type="range" 
                  id="bcs-slider" 
                  min="1" 
                  max="9" 
                  value="5" 
                  class="w-full h-2 bg-[#e5e5e5] dark:bg-[#2a2a2a] rounded-lg appearance-none cursor-pointer accent-[#171717] dark:accent-white touch-manipulation"
                />
                <div class="flex justify-between text-[9px] text-[#8f8f8f] dark:text-[#737373] font-mono mt-0.5">
                  <span>1 ({p.bcsUnderweight})</span>
                  <span class="text-[#10b981] font-semibold">4–5 ({p.bcsIdeal})</span>
                  <span>9 ({p.bcsOverweight})</span>
                </div>
              </div>
            </div>

            <!-- Treat & Snack Allowance Percentage -->
            <div class="space-y-2 p-3 sm:p-3.5 bg-[#fafafa] dark:bg-[#161616] rounded-xl border border-[#ebebeb] dark:border-[#262626]">
              <div class="flex items-center justify-between">
                <div>
                  <label class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                    {p.cardTreatTitle}
                  </label>
                </div>
                <span id="treat-budget-label" class="shrink-0 font-mono text-[10px] sm:text-xs font-bold text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#262626] border border-[#ebebeb] dark:border-[#333] px-2 py-0.5 rounded">
                  10%
                </span>
              </div>

              <!-- Quick treat budget buttons -->
              <div class="grid grid-cols-4 gap-1 pt-1">
                <button type="button" class="treat-preset-btn px-2 py-1 rounded-md text-[10px] font-mono border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1f1f1f] text-center hover:border-[#171717] dark:hover:border-white transition-all cursor-pointer" data-treat="0">0%</button>
                <button type="button" class="treat-preset-btn px-2 py-1 rounded-md text-[10px] font-mono border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1f1f1f] text-center hover:border-[#171717] dark:hover:border-white transition-all cursor-pointer" data-treat="5">5%</button>
                <button type="button" class="treat-preset-btn px-2 py-1 rounded-md text-[10px] font-mono border-2 border-[#171717] dark:border-white bg-[#171717] text-white dark:bg-white dark:text-[#171717] font-semibold text-center cursor-pointer" data-treat="10">10%</button>
                <button type="button" class="treat-preset-btn px-2 py-1 rounded-md text-[10px] font-mono border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1f1f1f] text-center hover:border-[#171717] dark:hover:border-white transition-all cursor-pointer" data-treat="15">15%</button>
              </div>

              <input 
                type="range" 
                id="treat-budget-slider" 
                min="0" 
                max="15" 
                step="5" 
                value="10" 
                class="w-full h-2 bg-[#e5e5e5] dark:bg-[#2a2a2a] rounded-lg appearance-none cursor-pointer accent-[#171717] dark:accent-white touch-manipulation"
              />
            </div>
          </div>
        </div>

        <!-- STEP 3: Activity Level & Lifestyle -->
        <div class="quiz-step hidden" data-step="3">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">{p.step3Title}</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">{p.step3Subtitle}</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3.5">
            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="sedentary" class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
