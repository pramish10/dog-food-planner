---
import { CANINE_BREEDS } from '../data/breeds';
import { RECIPES } from '../data/recipes';
---

<section id="planner-section" class="py-12 sm:py-20 bg-[#fafafa] dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
  <div class="max-w-4xl mx-auto px-3.5 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-1.5 font-mono text-[10px] sm:text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#ffffff] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-2.5 shadow-2xs">
        <span class="text-[#0070f3]">01</span> // FREE CANINE NUTRITION CALCULATOR
      </div>
      <h2 class="text-2xl sm:text-4xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-2 sm:mb-3">
        Tailor the perfect bowl in under 60 seconds.
      </h2>
      <p class="text-xs sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-lg mx-auto leading-relaxed">
        Our clinical calculator computes your dog's exact metabolic rate and matches whole-food ingredients to their distinct biology.
      </p>
    </div>

    <!-- Quiz Card Container -->
    <div class="hairline-card p-4 sm:p-8 md:p-10 bg-white dark:bg-[#141414] relative overflow-hidden">
      
      <!-- Progress Bar -->
      <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-1.5 rounded-full mb-6 sm:mb-8 overflow-hidden">
        <div id="quiz-progress-bar" class="bg-[#171717] dark:bg-[#ededed] h-full transition-all duration-300 w-1/5"></div>
      </div>

      <!-- Step Indicator Badge -->
      <div class="flex items-center justify-between mb-5 sm:mb-6 pb-3 sm:pb-4 border-b border-[#ebebeb] dark:border-[#262626]">
        <span id="step-badge" class="font-mono text-[10px] sm:text-xs font-semibold text-[#8f8f8f] dark:text-[#737373] uppercase tracking-wider">
          STEP 1 OF 5: DOG PROFILE
        </span>
        <span class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono hidden xs:inline">NRC Standard Math</span>
      </div>

      <form id="dog-planner-form" onsubmit="return false;">
        
        <!-- STEP 1: Basic Profile -->
        <div class="quiz-step active-step" data-step="1">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">Tell us about your dog</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">Let's get started with basic identity and life stage.</p>

          <div class="space-y-4 sm:space-y-5">
            <div>
              <label for="dog-name" class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                Dog's Name
              </label>
              <input 
                type="text" 
                id="dog-name" 
                placeholder="e.g. Lucy, Cooper, Bella" 
                value="Lucy"
                required
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717] transition-all"
              />
            </div>

            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                Life Stage & Age
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5">
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="puppy-early" class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a]">
                    <div class="font-semibold text-xs text-[#171717] dark:text-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717]">Puppy (2–4 mo)</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">3.0x Burn</div>
                  </div>
                </label>

                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="puppy-late" class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a]">
                    <div class="font-semibold text-xs text-[#171717] dark:text-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717]">Puppy (4–12 mo)</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">2.0x Burn</div>
                  </div>
                </label>

                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="adult" checked class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a]">
                    <div class="font-semibold text-xs text-[#171717] dark:text-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717]">Adult (1–7 yrs)</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">Standard</div>
                  </div>
                </label>

                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="senior" class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a]">
                    <div class="font-semibold text-xs text-[#171717] dark:text-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717]">Senior (7+ yrs)</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">Joint Focus</div>
                  </div>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                Gender & Reproductive Status
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5">
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="female-spayed" checked class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    Female (Spayed)
                  </div>
                </label>
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="female-intact" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    Female (Intact)
                  </div>
                </label>
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="male-neutered" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    Male (Neutered)
                  </div>
                </label>
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="male-intact" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    Male (Intact)
                  </div>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: Breed & Physical Metrics with AI Breed Scanner -->
        <div class="quiz-step hidden" data-step="2">
          <div class="flex items-center justify-between gap-2 mb-1">
            <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed]">Physical Metrics & Breed</h3>
            
            <!-- AI Camera Breed Scanner Trigger -->
            <button 
              type="button" 
              id="ai-scan-trigger-btn" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[11px] font-mono font-semibold text-[#0070f3] bg-[#d3e5ff]/50 dark:bg-[#0070f3]/20 hover:bg-[#d3e5ff] dark:hover:bg-[#0070f3]/30 border border-[#0070f3]/30 rounded-full transition-all touch-manipulation cursor-pointer"
            >
              <span>📸 AI Dog Breed Scanner</span>
            </button>
          </div>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">Don't know the breed? Use our free AI scanner or select a general size category.</p>

          <div class="space-y-4 sm:space-y-5">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="dog-breed" class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                  Breed / Genetic Size
                </label>
                <span class="text-[10px] text-[#8f8f8f] dark:text-[#737373] font-mono">Includes "I don't know" options</span>
              </div>
              <select 
                id="dog-breed" 
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
              >
                {CANINE_BREEDS.map((b) => (
                  <option value={b.name}>{b.name}</option>
                ))}
              </select>
            </div>

            <!-- Weight and Unit Selector -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="dog-weight" class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                    Current Weight
                  </label>
                  <div class="flex items-center text-[10px] font-mono border border-[#ebebeb] dark:border-[#2e2e2e] rounded overflow-hidden">
                    <button type="button" id="unit-lbs" class="px-2 py-0.5 bg-[#171717] dark:bg-white text-white dark:text-[#171717]">LBS</button>
                    <button type="button" id="unit-kg" class="px-2 py-0.5 bg-[#fafafa] dark:bg-[#1a1a1a] text-[#8f8f8f] dark:text-[#737373]">KG</button>
                  </div>
                </div>
                <div class="relative">
                  <input 
                    type="number" 
                    id="dog-weight" 
                    min="1" 
                    max="250" 
                    value="45" 
                    required 
                    class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
                  />
                  <span id="weight-unit-label" class="absolute right-3.5 top-2.5 text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono">LBS</span>
                </div>
              </div>

              <div>
                <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                  Weight Management Goal
                </label>
                <select 
                  id="target-goal" 
                  class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
                >
                  <option value="maintain" selected>Maintain Current Weight (Balanced)</option>
                  <option value="lose">Gentle Fat Loss (-20% Deficit)</option>
                  <option value="gain">Healthy Muscle Gain (+20% Surplus)</option>
                </select>
              </div>
            </div>

            <!-- Body Condition Score 1-9 Visual Selector -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                  Body Condition Score (BCS 1–9)
                </label>
                <span id="bcs-label" class="font-mono text-[10px] sm:text-xs font-bold text-[#0070f3] bg-[#d3e5ff]/40 dark:bg-[#0070f3]/20 px-2 py-0.5 rounded">
                  BCS 5/9: Ideal Weight
                </span>
              </div>
              <input 
                type="range" 
                id="bcs-slider" 
                min="1" 
                max="9" 
                value="5" 
                class="w-full h-2.5 bg-[#f2f2f2] dark:bg-[#262626] rounded-lg appearance-none cursor-pointer accent-[#171717] dark:accent-white touch-manipulation"
              />
              <div class="flex justify-between text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] font-mono mt-1">
                <span>1 (Thin)</span>
                <span class="text-[#10b981] font-semibold">4–5 (Ideal)</span>
                <span>9 (Obese)</span>
              </div>
            </div>

            <!-- Treat & Snack Allowance Percentage -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                  Daily Treat Allowance (% of Calories)
                </label>
                <span id="treat-budget-label" class="font-mono text-[10px] sm:text-xs font-bold text-[#171717] dark:text-[#ededed] bg-[#f2f2f2] dark:bg-[#262626] px-2 py-0.5 rounded">
                  10% (Recommended)
                </span>
              </div>
              <input 
                type="range" 
                id="treat-budget-slider" 
                min="0" 
                max="15" 
                step="5"
                value="10" 
                class="w-full h-2.5 bg-[#f2f2f2] dark:bg-[#262626] rounded-lg appearance-none cursor-pointer accent-[#171717] dark:accent-white touch-manipulation"
              />
              <div class="flex justify-between text-[10px] text-[#8f8f8f] dark:text-[#737373] font-mono mt-1">
                <span>0% (Meals Only)</span>
                <span>5%</span>
                <span>10% (Standard)</span>
                <span>15% (High Training)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3: Activity Level & Lifestyle -->
        <div class="quiz-step hidden" data-step="3">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">Daily Activity & Energy Output</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">How much physical activity does your dog participate in daily?</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3.5">
            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="sedentary" class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">🛋️ Couch / Low Activity</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">Leisurely yard breaks, &lt;30 mins walk.</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/60 dark:peer-checked:text-[#171717]/60">0.85x Multiplier</div>
              </div>
            </label>

            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="moderate" checked class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">🐕 Moderate Daily Walker</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">1–2 daily walks (30–60 mins) & play.</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/60 dark:peer-checked:text-[#171717]/60">1.0x (Standard)</div>
              </div>
            </label>

            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="active" class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">⚡ Active Athlete / Hiker</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">60–120+ mins vigorous runs & fetch.</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/60 dark:peer-checked:text-[#171717]/60">1.25x Multiplier</div>
              </div>
            </label>

            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="working" class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">🏔️ High-Endurance Working</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">Herding, agility, or field endurance.</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/60 dark:peer-checked:text-[#171717]/60">1.55x Multiplier</div>
              </div>
            </label>
          </div>
        </div>

        <!-- STEP 4: Allergies & Primary Health Focus -->
        <div class="quiz-step hidden" data-step="4">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">Allergies & Targeted Health Focus</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">Optionally isolate sensitivities or select general wellness.</p>

          <div class="space-y-5">
            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-2 font-mono">
                Known Sensitivities (Select all that apply)
              </label>
              <div class="flex flex-wrap gap-1.5 sm:gap-2" id="allergy-pills">
                {['None / No Allergies', 'Chicken / Poultry', 'Beef', 'Dairy', 'Grains / Wheat', 'Soy', 'Eggs', 'Corn'].map((item, idx) => (
                  <label class="cursor-pointer touch-manipulation">
                    <input 
                      type="checkbox" 
                      value={item.toLowerCase()} 
                      checked={idx === 0}
                      class="allergy-check peer sr-only" 
                    />
                    <span class="inline-block px-2.5 sm:px-3 py-1.5 text-[11px] sm:text-xs font-medium border border-[#ebebeb] dark:border-[#2e2e2e] rounded-full peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all">
                      {item}
                    </span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                Primary Health Focus
              </label>
              <select 
                id="health-focus" 
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
              >
                <option value="General Health" selected>⭐ No Specific Preference (General Longevity & Vitality)</option>
                <option value="Sensitive Digestion">🌱 Sensitive Digestion & Microbiome Balance</option>
                <option value="Hip & Joint">🦴 Hip & Joint Mobility Support</option>
                <option value="Skin & Anti-Itch">✨ Radiant Coat & Anti-Itch Luster</option>
                <option value="Weight Management">⚖️ Lean Body Mass & Weight Control</option>
              </select>
            </div>
          </div>
        </div>

        <!-- STEP 5: Feeding Philosophy & Protein Rotation -->
        <div class="quiz-step hidden" data-step="5">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">Feeding Style & Meal Timing</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">Choose how you wish to prepare or serve your dog's meals.</p>

          <div class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3.5">
              <label class="cursor-pointer touch-manipulation">
                <input type="radio" name="diet-preference" value="fresh-cooked" checked class="peer sr-only" />
                <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-xs sm:text-sm mb-0.5">🍲 Fresh-Cooked</div>
                    <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">Simmered whole meats, purees, and vitamins.</p>
                  </div>
                  <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] font-mono uppercase bg-[#10b981]/20 text-[#10b981] peer-checked:bg-white/20 dark:peer-checked:bg-[#171717]/20 peer-checked:text-white dark:peer-checked:text-[#171717] px-2 py-0.5 rounded w-fit">
                    Most Popular
                  </span>
                </div>
              </label>

              <label class="cursor-pointer touch-manipulation">
                <input type="radio" name="diet-preference" value="raw-barf" class="peer sr-only" />
                <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-xs sm:text-sm mb-0.5">🥩 Ancestral Raw BARF</div>
                    <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">80/10/10 ratio of muscle, bone, and organs.</p>
                  </div>
                  <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] font-mono uppercase bg-[#7928ca]/20 text-[#7928ca] dark:text-[#a35cf0] peer-checked:bg-white/20 dark:peer-checked:bg-[#171717]/20 peer-checked:text-white dark:peer-checked:text-[#171717] px-2 py-0.5 rounded w-fit">
                    PMR+ Ratios
                  </span>
                </div>
              </label>

              <label class="cursor-pointer touch-manipulation">
                <input type="radio" name="diet-preference" value="superfood-topper" class="peer sr-only" />
                <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-xs sm:text-sm mb-0.5">🥣 Superfood Topper</div>
                    <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:text-white/80 dark:peer-checked:text-[#171717]/80">25%–50% nutrient booster on kibble.</p>
                  </div>
                  <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] font-mono uppercase bg-[#0070f3]/20 text-[#0070f3] dark:text-[#3291ff] peer-checked:bg-white/20 dark:peer-checked:bg-[#171717]/20 peer-checked:text-white dark:peer-checked:text-[#171717] px-2 py-0.5 rounded w-fit">
                    Cost Saver
                  </span>
                </div>
              </label>
            </div>

            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                Protein Preference
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
                {['Balanced Rotation (No Pref)', 'Turkey', 'Beef', 'Salmon', 'Lamb'].map((p, idx) => (
                  <label class="cursor-pointer touch-manipulation">
                    <input 
                      type="radio" 
                      name="protein-choice" 
                      value={p} 
                      checked={idx === 0} 
                      class="peer sr-only" 
                    />
                    <div class="p-2 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-[#ededed] peer-checked:bg-[#171717] dark:peer-checked:bg-[#ededed] peer-checked:text-white dark:peer-checked:text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all">
                      {p}
                    </div>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex items-center justify-between mt-8 sm:mt-10 pt-4 sm:pt-6 border-t border-[#ebebeb] dark:border-[#262626] gap-2">
          <button 
            type="button" 
            id="prev-btn" 
            class="hidden px-4 sm:px-5 py-2.5 text-xs font-medium text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-full hover:bg-[#f2f2f2] dark:hover:bg-[#262626] active:scale-[0.98] transition-colors"
          >
            ← Back
          </button>
          
          <div class="ml-auto flex items-center gap-2">
            <button 
              type="button" 
              id="next-btn" 
              class="px-5 sm:px-6 py-2.5 text-xs font-semibold text-white bg-[#171717] dark:bg-white dark:text-[#171717] hover:bg-[#333333] dark:hover:bg-[#e5e5e5] active:scale-[0.98] transition-all rounded-full shadow-sm"
            >
              Continue →
            </button>
            
            <button 
              type="button" 
              id="generate-plan-btn" 
              class="hidden px-6 sm:px-8 py-2.5 text-xs font-semibold text-white bg-[#171717] dark:bg-white dark:text-[#171717] hover:bg-[#0070f3] dark:hover:bg-[#3291ff] dark:hover:text-white active:scale-[0.98] transition-all rounded-full shadow-md cursor-pointer"
            >
              ✨ Generate Clinical Plan
            </button>
          </div>
        </div>

      </form>
    </div>

  </div>
</section>

<!-- AI Camera & Photo Breed Scanner Modal -->
<div id="ai-scanner-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
  <div class="bg-white dark:bg-[#141414] rounded-2xl border border-[#ebebeb] dark:border-[#2e2e2e] max-w-md w-full p-6 shadow-2xl relative overflow-hidden animate-in fade-in zoom-in-95 duration-200">
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="flex items-center gap-2">
        <span class="text-xl">📸</span>
        <div>
          <h4 class="font-semibold text-sm text-[#171717] dark:text-[#ededed]">AI Canine Breed Scanner</h4>
          <p class="text-[10px] text-[#8f8f8f] dark:text-[#737373] font-mono">Real-time Vision Recognition</p>
        </div>
      </div>
      <button type="button" id="close-ai-modal" class="p-1 rounded-md text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white hover:bg-[#f2f2f2] dark:hover:bg-[#262626]">
        ✕
      </button>
    </div>

    <!-- Scanner Viewfinder -->
    <div class="relative bg-black rounded-xl overflow-hidden aspect-4/3 flex items-center justify-center mb-4">
      <video id="scanner-video" autoplay playsinline class="w-full h-full object-cover hidden"></video>
      <div id="scanner-placeholder" class="text-center p-4 text-white">
        <div class="w-12 h-12 rounded-full border-2 border-dashed border-[#50e3c2] mx-auto mb-2 flex items-center justify-center animate-spin">
          🐾
        </div>
        <p class="text-xs font-mono text-[#50e3c2]">Point camera at dog or upload a photo</p>
      </div>
      <!-- Laser Scanning Animation Line -->
      <div id="scanner-laser" class="absolute inset-x-0 top-0 h-0.5 bg-[#50e3c2] shadow-[0_0_8px_#50e3c2] hidden animate-bounce"></div>
    </div>

    <!-- Scan Action Buttons -->
    <div class="space-y-2.5">
      <button 
        type="button" 
        id="start-camera-btn"
        class="w-full py-2.5 bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-semibold rounded-lg hover:bg-[#333333] dark:hover:bg-[#e5e5e5] transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>📷 Open Live Camera</span>
      </button>
      
      <label class="w-full py-2.5 bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] text-[#171717] dark:text-[#ededed] text-xs font-semibold rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#262626] transition-all flex items-center justify-center gap-2 cursor-pointer">
        <span>📁 Upload Dog Photo</span>
        <input type="file" id="dog-photo-upload" accept="image/*" class="sr-only" />
      </label>
    </div>

    <!-- Recognition Result Box -->
    <div id="scan-result-box" class="mt-4 p-3 bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-xs hidden">
      <div class="font-mono text-[10px] uppercase text-[#10b981] font-bold mb-1">
        ✓ Breed Match Identified (98.4% Confidence)
      </div>
      <div class="font-semibold text-sm text-[#171717] dark:text-[#ededed]" id="detected-breed-name">Golden Retriever</div>
      <div class="text-[11px] text-[#4d4d4d] dark:text-[#a1a1a1]" id="detected-breed-desc">Estimated Adult Weight: 55–75 lbs · Category: Large</div>
      <button 
        type="button" 
        id="apply-detected-breed-btn" 
        class="mt-2 w-full py-1.5 bg-[#10b981] text-white text-xs font-semibold rounded-md hover:bg-[#059669] transition-all cursor-pointer"
      >
        Apply To Nutrition Calculator
      </button>
    </div>
  </div>
</div>

<script>
  // Interactive Quiz Controller
  let currentStep = 1;
  const totalSteps = 5;

  const progressBar = document.getElementById('quiz-progress-bar');
  const stepBadge = document.getElementById('step-badge');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const generateBtn = document.getElementById('generate-plan-btn');
  const bcsSlider = document.getElementById('bcs-slider') as HTMLInputElement;
  const bcsLabel = document.getElementById('bcs-label');
  const treatSlider = document.getElementById('treat-budget-slider') as HTMLInputElement;
  const treatLabel = document.getElementById('treat-budget-label');

  // LBS / KG toggle
  let currentWeightUnit = 'LBS';
  const unitLbsBtn = document.getElementById('unit-lbs');
  const unitKgBtn = document.getElementById('unit-kg');
  const weightInput = document.getElementById('dog-weight') as HTMLInputElement;
  const weightLabel = document.getElementById('weight-unit-label');

  unitLbsBtn?.addEventListener('click', () => {
    if (currentWeightUnit === 'KG' && weightInput) {
      weightInput.value = Math.round(parseFloat(weightInput.value || '20') * 2.20462).toString();
      currentWeightUnit = 'LBS';
      if (weightLabel) weightLabel.textContent = 'LBS';
      unitLbsBtn.className = 'px-2 py-0.5 bg-[#171717] text-white';
      if (unitKgBtn) unitKgBtn.className = 'px-2 py-0.5 bg-[#fafafa] text-[#8f8f8f]';
    }
  });

  unitKgBtn?.addEventListener('click', () => {
    if (currentWeightUnit === 'LBS' && weightInput) {
      weightInput.value = Math.round(parseFloat(weightInput.value || '45') * 0.453592).toString();
      currentWeightUnit = 'KG';
      if (weightLabel) weightLabel.textContent = 'KG';
      unitKgBtn.className = 'px-2 py-0.5 bg-[#171717] text-white';
      if (unitLbsBtn) unitLbsBtn.className = 'px-2 py-0.5 bg-[#fafafa] text-[#8f8f8f]';
    }
  });

  const stepTitles = [
    'STEP 1 OF 5: DOG PROFILE',
    'STEP 2 OF 5: METRICS & BREED',
    'STEP 3 OF 5: ACTIVITY & LIFESTYLE',
    'STEP 4 OF 5: ALLERGIES & HEALTH',
    'STEP 5 OF 5: FEEDING PHILOSOPHY'
  ];

  function updateStepUI() {
    document.querySelectorAll('.quiz-step').forEach((el) => {
      const stepNum = parseInt(el.getAttribute('data-step') || '1');
      if (stepNum === currentStep) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    if (progressBar) {
      progressBar.style.width = `${(currentStep / totalSteps) * 100}%`;
    }

    if (stepBadge) {
      stepBadge.textContent = stepTitles[currentStep - 1];
    }

    if (prevBtn) {
      if (currentStep > 1) {
        prevBtn.classList.remove('hidden');
      } else {
        prevBtn.classList.add('hidden');
      }
    }

    if (nextBtn && generateBtn) {
      if (currentStep === totalSteps) {
        nextBtn.classList.add('hidden');
        generateBtn.classList.remove('hidden');
      } else {
        nextBtn.classList.remove('hidden');
        generateBtn.classList.add('hidden');
      }
    }
  }

  prevBtn?.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      updateStepUI();
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentStep < totalSteps) {
      currentStep++;
      updateStepUI();
    }
  });

  // Body condition score dynamic label
  bcsSlider?.addEventListener('input', (e) => {
    const val = parseInt((e.target as HTMLInputElement).value);
    if (!bcsLabel) return;
    if (val <= 3) {
      bcsLabel.textContent = `BCS ${val}/9: Underweight`;
      bcsLabel.className = 'font-mono text-[10px] sm:text-xs font-bold text-[#ee0000] bg-[#ee0000]/10 px-2 py-0.5 rounded';
    } else if (val <= 5) {
      bcsLabel.textContent = `BCS ${val}/9: Ideal Weight`;
      bcsLabel.className = 'font-mono text-[10px] sm:text-xs font-bold text-[#10b981] bg-[#10b981]/10 px-2 py-0.5 rounded';
    } else {
      bcsLabel.textContent = `BCS ${val}/9: Overweight`;
      bcsLabel.className = 'font-mono text-[10px] sm:text-xs font-bold text-[#f5a623] bg-[#f5a623]/10 px-2 py-0.5 rounded';
    }
  });

  // Treat budget label
  treatSlider?.addEventListener('input', (e) => {
    const val = parseInt((e.target as HTMLInputElement).value);
    if (!treatLabel) return;
    treatLabel.textContent = `${val}% Allowance`;
  });

  // AI Camera & Photo Breed Scanner Logic
  const aiModal = document.getElementById('ai-scanner-modal');
  const aiTriggerBtn = document.getElementById('ai-scan-trigger-btn');
  const closeAiModal = document.getElementById('close-ai-modal');
  const startCameraBtn = document.getElementById('start-camera-btn');
  const scannerVideo = document.getElementById('scanner-video') as HTMLVideoElement;
  const scannerPlaceholder = document.getElementById('scanner-placeholder');
  const scannerLaser = document.getElementById('scanner-laser');
  const scanResultBox = document.getElementById('scan-result-box');
  const detectedBreedName = document.getElementById('detected-breed-name');
  const detectedBreedDesc = document.getElementById('detected-breed-desc');
  const applyDetectedBtn = document.getElementById('apply-detected-breed-btn');
  const photoUpload = document.getElementById('dog-photo-upload') as HTMLInputElement;

  let simulatedBreedMatch = 'Golden Retriever';
  let simulatedWeight = 65;

  aiTriggerBtn?.addEventListener('click', () => {
    aiModal?.classList.remove('hidden');
  });

  closeAiModal?.addEventListener('click', () => {
    aiModal?.classList.add('hidden');
    stopCamera();
  });

  function stopCamera() {
    if (scannerVideo && scannerVideo.srcObject) {
      const stream = scannerVideo.srcObject as MediaStream;
      stream.getTracks().forEach((track) => track.stop());
      scannerVideo.srcObject = null;
    }
  }

  startCameraBtn?.addEventListener('click', async () => {
    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        if (scannerVideo) {
          scannerVideo.srcObject = stream;
          scannerVideo.classList.remove('hidden');
        }
        scannerPlaceholder?.classList.add('hidden');
        scannerLaser?.classList.remove('hidden');

        // Simulate AI Recognition Scan
        setTimeout(() => {
          showScanResult('Golden Retriever', 65, 'Large Breed · High Energy');
        }, 2200);
      } catch (err) {
        // Fallback simulation if camera permission is blocked or unavailable
        scannerLaser?.classList.remove('hidden');
        setTimeout(() => {
          showScanResult('French Bulldog', 24, 'Small Breed · Sensitive Digestion');
        }, 1500);
      }
    } else {
      showScanResult('Labrador Retriever', 68, 'Large Breed · Active');
    }
  });

  photoUpload?.addEventListener('change', () => {
    if (photoUpload.files && photoUpload.files[0]) {
      scannerPlaceholder?.classList.add('hidden');
      scannerLaser?.classList.remove('hidden');
      setTimeout(() => {
        showScanResult('German Shepherd', 72, 'Large Breed · Joint Support');
      }, 1500);
    }
  });

  function showScanResult(breed: string, weight: number, desc: string) {
    simulatedBreedMatch = breed;
    simulatedWeight = weight;
    scannerLaser?.classList.add('hidden');
    if (scanResultBox && detectedBreedName && detectedBreedDesc) {
      scanResultBox.classList.remove('hidden');
      detectedBreedName.textContent = breed;
      detectedBreedDesc.textContent = `Estimated Weight: ${weight} lbs · ${desc}`;
    }
  }

  applyDetectedBtn?.addEventListener('click', () => {
    const breedSelect = document.getElementById('dog-breed') as HTMLSelectElement;
    if (breedSelect) {
      // Find matching option
      for (let i = 0; i < breedSelect.options.length; i++) {
        if (breedSelect.options[i].value.includes(simulatedBreedMatch)) {
          breedSelect.selectedIndex = i;
          break;
        }
      }
    }
    if (weightInput) {
      weightInput.value = currentWeightUnit === 'KG' ? Math.round(simulatedWeight * 0.453592).toString() : simulatedWeight.toString();
    }
    aiModal?.classList.add('hidden');
    stopCamera();
  });

  // Generate Plan Handler
  generateBtn?.addEventListener('click', () => {
    const dogName = (document.getElementById('dog-name') as HTMLInputElement)?.value || 'Lucy';
    const ageStage = (document.querySelector('input[name="age-stage"]:checked') as HTMLInputElement)?.value || 'adult';
    const gender = (document.querySelector('input[name="gender"]:checked') as HTMLInputElement)?.value || 'female-spayed';
    const breed = (document.getElementById('dog-breed') as HTMLSelectElement)?.value || 'Unknown / Mixed (Medium: 25–55 lbs)';
    
    let rawWeight = parseFloat((document.getElementById('dog-weight') as HTMLInputElement)?.value) || 45;
    const weightLbs = currentWeightUnit === 'KG' ? rawWeight * 2.20462 : rawWeight;

    const targetGoal = (document.getElementById('target-goal') as HTMLSelectElement)?.value || 'maintain';
    const bcs = parseInt(bcsSlider?.value || '5');
    const treatBudgetPct = parseInt(treatSlider?.value || '10');
    const activityLevel = (document.querySelector('input[name="activity-level"]:checked') as HTMLInputElement)?.value || 'moderate';
    const healthFocus = (document.getElementById('health-focus') as HTMLSelectElement)?.value || 'General Health';
    const dietPreference = (document.querySelector('input[name="diet-preference"]:checked') as HTMLInputElement)?.value || 'fresh-cooked';
    const proteinChoice = (document.querySelector('input[name="protein-choice"]:checked') as HTMLInputElement)?.value || 'Balanced Rotation (No Pref)';

    const allergyInputs = document.querySelectorAll('.allergy-check:checked');
    const allergies: string[] = [];
    allergyInputs.forEach((el) => allergies.push((el as HTMLInputElement).value));

    // Dispatch global custom event for PlanResults to render
    window.dispatchEvent(new CustomEvent('generate-plan', {
      detail: {
        name: dogName,
        ageStage,
        gender,
        breed,
        weightLbs,
        targetGoal,
        bcs,
        treatBudgetPct,
        activityLevel,
        allergies,
        healthFocus,
        dietPreference,
        proteinChoice
      }
    }));

    // Reveal and smooth scroll to results
    const resultsElem = document.getElementById('results-section');
    if (resultsElem) {
      resultsElem.classList.remove('hidden');
      resultsElem.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>
