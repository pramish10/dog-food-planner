                  >
                    <svg class="dropdown-chevron w-4 h-4 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                  </button>
                </div>

                <!-- Direct Options on PC, Dropdown Grid on Mobile -->
                <div
                  id="meds-options-list"
                  role="listbox"
                  class="quiz-options-flyout hidden sm:flex items-center gap-2 flex-wrap z-20 bg-white/95 dark:bg-[#1c1208]/95 sm:bg-transparent sm:dark:bg-transparent p-2 sm:p-0 rounded-xl sm:rounded-none border border-[#f0d5a8] dark:border-[#3a2510] sm:border-0 shadow-lg sm:shadow-none"
                >
