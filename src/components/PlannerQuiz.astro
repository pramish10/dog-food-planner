---
import { CANINE_BREEDS } from '../data/breeds';
import { RECIPES } from '../data/recipes';
---

<section id="planner-section" class="py-16 sm:py-24 bg-[#fafafa] border-b border-[#ebebeb]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] bg-[#ffffff] border border-[#ebebeb] px-3 py-1 rounded-full mb-3 shadow-2xs">
        <span class="text-[#0070f3]">01</span> // INTERACTIVE CANINE NUTRITION QUIZ
      </div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-[#171717] tracking-tight mb-3">
        Tailor the perfect bowl in under 60 seconds.
      </h2>
      <p class="text-sm sm:text-base text-[#4d4d4d] max-w-lg mx-auto">
        Our clinical calculator computes your dog's exact metabolic rate and matches whole-food ingredients to their distinct life stage.
      </p>
    </div>

    <!-- Quiz Card Container -->
    <div class="hairline-card p-6 sm:p-10 bg-white relative overflow-hidden">
      
      <!-- Progress Bar -->
      <div class="w-full bg-[#f2f2f2] h-1.5 rounded-full mb-8 overflow-hidden">
        <div id="quiz-progress-bar" class="bg-[#171717] h-full transition-all duration-300 w-1/5"></div>
      </div>

      <!-- Step Indicator Badge -->
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-[#ebebeb]">
        <span id="step-badge" class="font-mono text-xs font-semibold text-[#8f8f8f] uppercase tracking-wider">
          STEP 1 OF 5: DOG PROFILE
        </span>
        <span class="text-xs text-[#8f8f8f] font-mono">Veterinary Standard AAFCO/NRC</span>
      </div>

      <form id="dog-planner-form" onsubmit="return false;">
        
        <!-- STEP 1: Basic Profile -->
        <div class="quiz-step active-step" data-step="1">
          <h3 class="text-xl font-semibold text-[#171717] mb-2">Tell us about your dog</h3>
          <p class="text-sm text-[#8f8f8f] mb-6">Let's get started with basic identity and life stage.</p>

          <div class="space-y-5">
            <div>
              <label for="dog-name" class="block text-xs font-semibold text-[#171717] uppercase tracking-wider mb-2 font-mono">
                Dog's Name
              </label>
              <input 
                type="text" 
                id="dog-name" 
                placeholder="e.g. Luna, Cooper, Bella" 
                value="Luna"
                required
                class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-md text-[#171717] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] transition-all"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-[#171717] uppercase tracking-wider mb-2 font-mono">
                Life Stage & Age
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <label class="cursor-pointer">
                  <input type="radio" name="age-stage" value="puppy-early" class="peer sr-only" />
                  <div class="p-3 border border-[#ebebeb] rounded-md text-center peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all">
                    <div class="font-semibold text-xs">Puppy (2–4 mo)</div>
                    <div class="text-[11px] text-[#8f8f8f] peer-checked:text-white/80">3.0x Metabolic Burn</div>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="age-stage" value="puppy-late" class="peer sr-only" />
                  <div class="p-3 border border-[#ebebeb] rounded-md text-center peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all">
                    <div class="font-semibold text-xs">Puppy (4–12 mo)</div>
                    <div class="text-[11px] text-[#8f8f8f] peer-checked:text-white/80">2.0x Metabolic Burn</div>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="age-stage" value="adult" checked class="peer sr-only" />
                  <div class="p-3 border border-[#ebebeb] rounded-md text-center peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all">
                    <div class="font-semibold text-xs">Adult (1–7 yrs)</div>
                    <div class="text-[11px] text-[#8f8f8f] peer-checked:text-white/80">Standard Maintenance</div>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="age-stage" value="senior" class="peer sr-only" />
                  <div class="p-3 border border-[#ebebeb] rounded-md text-center peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all">
                    <div class="font-semibold text-xs">Senior (7+ yrs)</div>
                    <div class="text-[11px] text-[#8f8f8f] peer-checked:text-white/80">Joint & Organ Focus</div>
                  </div>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-[#171717] uppercase tracking-wider mb-2 font-mono">
                Gender & Reproductive Status
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <label class="cursor-pointer">
                  <input type="radio" name="gender" value="female-spayed" checked class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] rounded-md text-center text-xs font-medium peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all">
                    Female (Spayed)
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="gender" value="female-intact" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] rounded-md text-center text-xs font-medium peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all">
                    Female (Intact)
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="gender" value="male-neutered" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] rounded-md text-center text-xs font-medium peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all">
                    Male (Neutered)
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="gender" value="male-intact" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] rounded-md text-center text-xs font-medium peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all">
                    Male (Intact)
                  </div>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: Breed & Physical Metrics -->
        <div class="quiz-step hidden" data-step="2">
          <h3 class="text-xl font-semibold text-[#171717] mb-2">Physical Metrics & Body Score</h3>
          <p class="text-sm text-[#8f8f8f] mb-6">Weight and body condition score determine precise caloric density.</p>

          <div class="space-y-5">
            <div>
              <label for="dog-breed" class="block text-xs font-semibold text-[#171717] uppercase tracking-wider mb-2 font-mono">
                Breed / Genetic Size
              </label>
              <select 
                id="dog-breed" 
                class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-md text-[#171717] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717]"
              >
                {CANINE_BREEDS.map((b) => (
                  <option value={b.name}>{b.name} ({b.category})</option>
                ))}
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="dog-weight" class="block text-xs font-semibold text-[#171717] uppercase tracking-wider mb-2 font-mono">
                  Current Weight (lbs)
                </label>
                <div class="relative">
                  <input 
                    type="number" 
                    id="dog-weight" 
                    min="2" 
                    max="220" 
                    value="45" 
                    required 
                    class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-md text-[#171717] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717]"
                  />
                  <span class="absolute right-3.5 top-2.5 text-xs text-[#8f8f8f] font-mono">LBS</span>
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-[#171717] uppercase tracking-wider mb-2 font-mono">
                  Weight Management Goal
                </label>
                <select 
                  id="target-goal" 
                  class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-md text-[#171717] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717]"
                >
                  <option value="maintain" selected>Maintain Current Weight (Balanced)</option>
                  <option value="lose">Gentle Fat Loss (-20% Calorie Deficit)</option>
                  <option value="gain">Healthy Muscle / Weight Gain (+20% Surplus)</option>
                </select>
              </div>
            </div>

            <!-- Body Condition Score 1-9 Visual Selector -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-semibold text-[#171717] uppercase tracking-wider font-mono">
                  Body Condition Score (BCS 1–9)
                </label>
                <span id="bcs-label" class="font-mono text-xs font-bold text-[#0070f3] bg-[#d3e5ff]/40 px-2 py-0.5 rounded">
                  BCS 5/9: Ideal Lean Weight
                </span>
              </div>
              <input 
                type="range" 
                id="bcs-slider" 
                min="1" 
                max="9" 
                value="5" 
                class="w-full h-2 bg-[#f2f2f2] rounded-lg appearance-none cursor-pointer accent-[#171717]"
              />
              <div class="flex justify-between text-[11px] text-[#8f8f8f] font-mono mt-1">
                <span>1 (Emaciated)</span>
                <span class="text-[#10b981] font-semibold">4–5 (Ideal Ribbon)</span>
                <span>9 (Severely Obese)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3: Activity Level & Lifestyle -->
        <div class="quiz-step hidden" data-step="3">
          <h3 class="text-xl font-semibold text-[#171717] mb-2">Daily Activity & Energy Output</h3>
          <p class="text-sm text-[#8f8f8f] mb-6">How much physical activity does your dog participate in each day?</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <label class="cursor-pointer">
              <input type="radio" name="activity-level" value="sedentary" class="peer sr-only" />
              <div class="p-4 border border-[#ebebeb] rounded-lg peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-sm mb-1">🛋️ Couch Companion / Low Activity</div>
                  <p class="text-xs text-[#8f8f8f] peer-checked:text-white/80">Leisurely backyard potty breaks and under 30 minutes of walking daily.</p>
                </div>
                <div class="font-mono text-[10px] mt-3 uppercase text-[#8f8f8f] peer-checked:text-white/60">Multiplier: 0.85x</div>
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="activity-level" value="moderate" checked class="peer sr-only" />
              <div class="p-4 border border-[#ebebeb] rounded-lg peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-sm mb-1">🐕 Moderate Daily Walker</div>
                  <p class="text-xs text-[#8f8f8f] peer-checked:text-white/80">1–2 daily neighborhood walks (30–60 mins) plus regular indoor play.</p>
                </div>
                <div class="font-mono text-[10px] mt-3 uppercase text-[#8f8f8f] peer-checked:text-white/60">Multiplier: 1.0x (Standard)</div>
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="activity-level" value="active" class="peer sr-only" />
              <div class="p-4 border border-[#ebebeb] rounded-lg peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-sm mb-1">⚡ Active Athlete / Hiker</div>
                  <p class="text-xs text-[#8f8f8f] peer-checked:text-white/80">60–120+ minutes of daily vigorous exercise, running, swimming, or off-leash fetch.</p>
                </div>
                <div class="font-mono text-[10px] mt-3 uppercase text-[#8f8f8f] peer-checked:text-white/60">Multiplier: 1.25x</div>
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="activity-level" value="working" class="peer sr-only" />
              <div class="p-4 border border-[#ebebeb] rounded-lg peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-sm mb-1">🏔️ High-Endurance Working Dog</div>
                  <p class="text-xs text-[#8f8f8f] peer-checked:text-white/80">Herding, agility champions, field hunting, or endurance sledding.</p>
                </div>
                <div class="font-mono text-[10px] mt-3 uppercase text-[#8f8f8f] peer-checked:text-white/60">Multiplier: 1.55x</div>
              </div>
            </label>
          </div>
        </div>

        <!-- STEP 4: Allergies & Primary Health Focus -->
        <div class="quiz-step hidden" data-step="4">
          <h3 class="text-xl font-semibold text-[#171717] mb-2">Allergies & Targeted Health Support</h3>
          <p class="text-sm text-[#8f8f8f] mb-6">Exclude triggers and supercharge organs that need therapeutic nutrition.</p>

          <div class="space-y-6">
            <div>
              <label class="block text-xs font-semibold text-[#171717] uppercase tracking-wider mb-2 font-mono">
                Known Sensitivities or Exclusions (Select all that apply)
              </label>
              <div class="flex flex-wrap gap-2" id="allergy-pills">
                {['Chicken / Poultry', 'Beef', 'Dairy', 'Grains / Wheat', 'Soy', 'Eggs', 'Corn', 'None'].map((item) => (
                  <label class="cursor-pointer">
                    <input 
                      type="checkbox" 
                      value={item.toLowerCase()} 
                      class="allergy-check peer sr-only" 
                    />
                    <span class="inline-block px-3 py-1.5 text-xs font-medium border border-[#ebebeb] rounded-full peer-checked:border-[#ee0000] peer-checked:bg-[#ee0000] peer-checked:text-white transition-all">
                      {item}
                    </span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-[#171717] uppercase tracking-wider mb-2 font-mono">
                Primary Health Focus
              </label>
              <select 
                id="health-focus" 
                class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#ebebeb] rounded-md text-[#171717] focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717]"
              >
                <option value="Sensitive Digestion">🌱 Sensitive Digestion & Microbiome Balance</option>
                <option value="Hip & Joint">🦴 Hip & Joint Mobility Support</option>
                <option value="Skin & Anti-Itch">✨ Radiant Coat & Anti-Itch Luster</option>
                <option value="Longevity & Vitality" selected>🧬 Cellular Longevity & Immune Vitality</option>
                <option value="Weight Management">⚖️ Lean Body Mass & Weight Control</option>
              </select>
            </div>
          </div>
        </div>

        <!-- STEP 5: Feeding Philosophy & Protein Choice -->
        <div class="quiz-step hidden" data-step="5">
          <h3 class="text-xl font-semibold text-[#171717] mb-2">Select Your Feeding Philosophy</h3>
          <p class="text-sm text-[#8f8f8f] mb-6">Choose how you wish to prepare or serve your dog's meals.</p>

          <div class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
              <label class="cursor-pointer">
                <input type="radio" name="diet-preference" value="fresh-cooked" checked class="peer sr-only" />
                <div class="p-4 border border-[#ebebeb] rounded-lg peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-sm mb-1">🍲 Fresh-Cooked Meal</div>
                    <p class="text-xs text-[#8f8f8f] peer-checked:text-white/80">Gently simmered whole meats, fresh purees, and bioavailable supplements.</p>
                  </div>
                  <span class="inline-block mt-3 text-[10px] font-mono uppercase bg-[#10b981]/20 text-[#10b981] peer-checked:bg-white/20 peer-checked:text-white px-2 py-0.5 rounded w-fit">
                    Most Popular
                  </span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="diet-preference" value="raw-barf" class="peer sr-only" />
                <div class="p-4 border border-[#ebebeb] rounded-lg peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-sm mb-1">🥩 Ancestral Raw BARF</div>
                    <p class="text-xs text-[#8f8f8f] peer-checked:text-white/80">80/10/10 biological balance of raw muscle, edible bone, and secreting organs.</p>
                  </div>
                  <span class="inline-block mt-3 text-[10px] font-mono uppercase bg-[#7928ca]/20 text-[#7928ca] peer-checked:bg-white/20 peer-checked:text-white px-2 py-0.5 rounded w-fit">
                    PMR+ Ratios
                  </span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="diet-preference" value="superfood-topper" class="peer sr-only" />
                <div class="p-4 border border-[#ebebeb] rounded-lg peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-sm mb-1">🥣 Superfood Topper</div>
                    <p class="text-xs text-[#8f8f8f] peer-checked:text-white/80">25%–50% nutrient booster added to existing kibble. 100% budget friendly.</p>
                  </div>
                  <span class="inline-block mt-3 text-[10px] font-mono uppercase bg-[#0070f3]/20 text-[#0070f3] peer-checked:bg-white/20 peer-checked:text-white px-2 py-0.5 rounded w-fit">
                    Cost Saver
                  </span>
                </div>
              </label>
            </div>

            <div>
              <label class="block text-xs font-semibold text-[#171717] uppercase tracking-wider mb-2 font-mono">
                Primary Protein Base
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                {['Turkey', 'Beef', 'Salmon', 'Lamb'].map((p, idx) => (
                  <label class="cursor-pointer">
                    <input 
                      type="radio" 
                      name="protein-choice" 
                      value={p} 
                      checked={idx === 0} 
                      class="peer sr-only" 
                    />
                    <div class="p-2.5 border border-[#ebebeb] rounded-md text-center text-xs font-medium peer-checked:border-[#171717] peer-checked:bg-[#171717] peer-checked:text-white transition-all">
                      {p}
                    </div>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex items-center justify-between mt-10 pt-6 border-t border-[#ebebeb]">
          <button 
            type="button" 
            id="prev-btn" 
            class="hidden px-5 py-2 text-xs font-medium text-[#171717] bg-white border border-[#ebebeb] rounded-full hover:bg-[#f2f2f2] transition-colors"
          >
            ← Back
          </button>
          
          <div class="ml-auto flex items-center gap-3">
            <button 
              type="button" 
              id="next-btn" 
              class="px-6 py-2.5 text-xs font-semibold text-white bg-[#171717] hover:bg-[#333333] active:scale-[0.98] transition-all rounded-full shadow-sm"
            >
              Continue →
            </button>
            
            <button 
              type="button" 
              id="generate-plan-btn" 
              class="hidden px-8 py-2.5 text-xs font-semibold text-white bg-[#171717] hover:bg-[#0070f3] active:scale-[0.98] transition-all rounded-full shadow-md"
            >
              ✨ Generate Clinical Plan
            </button>
          </div>
        </div>

      </form>
    </div>

  </div>
</section>

<script>
  // Interactive Quiz Controller
  let currentStep = 1;
  const totalSteps = 5;

  const progressBar = document.getElementById('quiz-progress-bar');
  const stepBadge = document.getElementById('step-badge');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const generateBtn = document.getElementById('generate-plan-btn');
  const bcsSlider = document.getElementById('bcs-slider') as HTMLInputElement;
  const bcsLabel = document.getElementById('bcs-label');

  const stepTitles = [
    'STEP 1 OF 5: DOG PROFILE',
    'STEP 2 OF 5: PHYSICAL METRICS & BCS',
    'STEP 3 OF 5: ACTIVITY & LIFESTYLE',
    'STEP 4 OF 5: ALLERGIES & HEALTH FOCUS',
    'STEP 5 OF 5: FEEDING PHILOSOPHY'
  ];

  function updateStepUI() {
    document.querySelectorAll('.quiz-step').forEach((el) => {
      const stepNum = parseInt(el.getAttribute('data-step') || '1');
      if (stepNum === currentStep) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    if (progressBar) {
      progressBar.style.width = `${(currentStep / totalSteps) * 100}%`;
    }

    if (stepBadge) {
      stepBadge.textContent = stepTitles[currentStep - 1];
    }

    if (prevBtn) {
      if (currentStep > 1) {
        prevBtn.classList.remove('hidden');
      } else {
        prevBtn.classList.add('hidden');
      }
    }

    if (nextBtn && generateBtn) {
      if (currentStep === totalSteps) {
        nextBtn.classList.add('hidden');
        generateBtn.classList.remove('hidden');
      } else {
        nextBtn.classList.remove('hidden');
        generateBtn.classList.add('hidden');
      }
    }
  }

  prevBtn?.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      updateStepUI();
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentStep < totalSteps) {
      currentStep++;
      updateStepUI();
    }
  });

  // Body condition score dynamic label
  bcsSlider?.addEventListener('input', (e) => {
    const val = parseInt((e.target as HTMLInputElement).value);
    if (!bcsLabel) return;
    if (val <= 3) {
      bcsLabel.textContent = `BCS ${val}/9: Underweight (Ribs visibly prominent)`;
      bcsLabel.className = 'font-mono text-xs font-bold text-[#ee0000] bg-[#ee0000]/10 px-2 py-0.5 rounded';
    } else if (val <= 5) {
      bcsLabel.textContent = `BCS ${val}/9: Ideal Weight (Tuck and waist evident)`;
      bcsLabel.className = 'font-mono text-xs font-bold text-[#10b981] bg-[#10b981]/10 px-2 py-0.5 rounded';
    } else {
      bcsLabel.textContent = `BCS ${val}/9: Overweight (Heavy fat covering ribs)`;
      bcsLabel.className = 'font-mono text-xs font-bold text-[#f5a623] bg-[#f5a623]/10 px-2 py-0.5 rounded';
    }
  });

  // Generate Plan Handler
  generateBtn?.addEventListener('click', () => {
    const dogName = (document.getElementById('dog-name') as HTMLInputElement)?.value || 'Luna';
    const ageStage = (document.querySelector('input[name="age-stage"]:checked') as HTMLInputElement)?.value || 'adult';
    const gender = (document.querySelector('input[name="gender"]:checked') as HTMLInputElement)?.value || 'female-spayed';
    const breed = (document.getElementById('dog-breed') as HTMLSelectElement)?.value || 'Mixed Breed / Mutts';
    const weightLbs = parseFloat((document.getElementById('dog-weight') as HTMLInputElement)?.value) || 45;
    const targetGoal = (document.getElementById('target-goal') as HTMLSelectElement)?.value || 'maintain';
    const bcs = parseInt(bcsSlider?.value || '5');
    const activityLevel = (document.querySelector('input[name="activity-level"]:checked') as HTMLInputElement)?.value || 'moderate';
    const healthFocus = (document.getElementById('health-focus') as HTMLSelectElement)?.value || 'Longevity & Vitality';
    const dietPreference = (document.querySelector('input[name="diet-preference"]:checked') as HTMLInputElement)?.value || 'fresh-cooked';
    const proteinChoice = (document.querySelector('input[name="protein-choice"]:checked') as HTMLInputElement)?.value || 'Turkey';

    const allergyInputs = document.querySelectorAll('.allergy-check:checked');
    const allergies: string[] = [];
    allergyInputs.forEach((el) => allergies.push((el as HTMLInputElement).value));

    // Dispatch global custom event for PlanResults to render
    window.dispatchEvent(new CustomEvent('generate-plan', {
      detail: {
        name: dogName,
        ageStage,
        gender,
        breed,
        weightLbs,
        targetGoal,
        bcs,
        activityLevel,
        allergies,
        healthFocus,
        dietPreference,
        proteinChoice
      }
    }));

    // Smooth scroll to results
    const resultsElem = document.getElementById('results-section');
    if (resultsElem) {
      resultsElem.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>
