                  <div>
                    <div class="font-semibold text-xs sm:text-sm mb-0.5">🍲 Fresh-Cooked</div>
                    <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">Simmered whole meats, purees, and vitamins.</p>
                  </div>
                  <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] font-mono uppercase bg-[#10b981]/20 text-[#10b981] peer-checked:bg-white/20 dark:peer-checked:bg-[#171717]/20 peer-checked:!text-white dark:peer-checked:!text-[#171717] px-2 py-0.5 rounded w-fit">
                    Most Popular
                  </span>
                </div>
              </label>

              <label class="cursor-pointer touch-manipulation">
                <input type="radio" name="diet-preference" value="raw-barf" class="peer sr-only" />
                <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                  <div>
                    <div class="font-semibold text-xs sm:text-sm mb-0.5">🥩 Ancestral Raw BARF</div>
                    <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">80/10/10 ratio of muscle, bone, and organs.</p>
                  </div>
                  <span class="inline-block mt-2 sm:mt-3 text-[9px] sm:text-[10px] font-mono uppercase bg-[#7928ca]/20 text-[#7928ca] dark:text-[#a35cf0] peer-checked:bg-white/20 dark:peer-checked:bg-[#171717]/20 peer-checked:!text-white dark:peer-checked:!text-[#171717] px-2 py-0.5 rounded w-fit">
                    PMR+ Ratios
