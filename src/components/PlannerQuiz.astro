---
import { CANINE_BREEDS } from '../data/breeds';
import { RECIPES } from '../data/recipes';
---

<section id="planner-section" class="py-12 sm:py-20 bg-[#fafafa] dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
  <div class="max-w-4xl mx-auto px-3.5 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-1.5 font-mono text-[10px] sm:text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#ffffff] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-2.5 shadow-2xs">
        <span class="text-[#0070f3]">01</span> // FREE CANINE NUTRITION CALCULATOR
      </div>
      <h2 class="text-2xl sm:text-4xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-2 sm:mb-3">
        Tailor the perfect bowl in under 60 seconds.
      </h2>
      <p class="text-xs sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-lg mx-auto leading-relaxed">
        Our clinical calculator computes your dog's exact metabolic rate and matches whole-food ingredients to their distinct biology.
      </p>
    </div>

    <!-- Quiz Card Container -->
    <div class="hairline-card p-4 sm:p-8 md:p-10 bg-white dark:bg-[#141414] relative overflow-hidden">
      
      <!-- Progress Bar -->
      <div class="w-full bg-[#f2f2f2] dark:bg-[#262626] h-1.5 rounded-full mb-6 sm:mb-8 overflow-hidden">
        <div id="quiz-progress-bar" class="bg-[#171717] dark:bg-[#ededed] h-full transition-all duration-300 w-1/5"></div>
      </div>

      <!-- Step Indicator Badge -->
      <div class="flex items-center justify-between mb-5 sm:mb-6 pb-3 sm:pb-4 border-b border-[#ebebeb] dark:border-[#262626]">
        <span id="step-badge" class="font-mono text-[10px] sm:text-xs font-semibold text-[#8f8f8f] dark:text-[#737373] uppercase tracking-wider">
          STEP 1 OF 5: DOG PROFILE
        </span>
        <span class="text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono hidden xs:inline">NRC Standard Math</span>
      </div>

      <form id="dog-planner-form" onsubmit="return false;">
        
        <!-- STEP 1: Basic Profile -->
        <div class="quiz-step active-step" data-step="1">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">Tell us about your dog</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">Let's get started with basic identity and life stage.</p>

          <div class="space-y-4 sm:space-y-5">
            <div>
              <label for="dog-name" class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                Dog's Name
              </label>
              <input 
                type="text" 
                id="dog-name" 
                placeholder="e.g. Lucy, Cooper, Bella" 
                value="Lucy"
                required
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717] transition-all"
              />
            </div>

            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                Life Stage & Age
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5">
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="puppy-early" class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] peer-checked:!text-white dark:peer-checked:!text-[#171717] group">
                    <div class="font-semibold text-xs text-inherit">Puppy (2–4 mo)</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">3.0x Burn</div>
                  </div>
                </label>

                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="puppy-late" class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] peer-checked:!text-white dark:peer-checked:!text-[#171717] group">
                    <div class="font-semibold text-xs text-inherit">Puppy (4–12 mo)</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">2.0x Burn</div>
                  </div>
                </label>

                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="adult" checked class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] peer-checked:!text-white dark:peer-checked:!text-[#171717] group">
                    <div class="font-semibold text-xs text-inherit">Adult (1–7 yrs)</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">Standard</div>
                  </div>
                </label>

                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="age-stage" value="senior" class="peer sr-only" />
                  <div class="p-2.5 sm:p-3 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white transition-all h-full flex flex-col justify-center bg-white dark:bg-[#1a1a1a] text-[#171717] dark:text-[#ededed] peer-checked:!text-white dark:peer-checked:!text-[#171717] group">
                    <div class="font-semibold text-xs text-inherit">Senior (7+ yrs)</div>
                    <div class="text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">Joint Focus</div>
                  </div>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                Gender & Reproductive Status
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5">
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="female-spayed" checked class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    Female (Spayed)
                  </div>
                </label>
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="female-intact" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    Female (Intact)
                  </div>
                </label>
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="male-neutered" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    Male (Neutered)
                  </div>
                </label>
                <label class="cursor-pointer touch-manipulation">
                  <input type="radio" name="gender" value="male-intact" class="peer sr-only" />
                  <div class="p-2.5 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-center text-xs font-medium peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] transition-all bg-white dark:bg-[#1a1a1a]">
                    Male (Intact)
                  </div>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: Breed & Physical Metrics with AI Breed Scanner -->
        <div class="quiz-step hidden" data-step="2">
          <div class="flex items-center justify-between gap-2 mb-1">
            <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed]">Physical Metrics & Breed</h3>
            
            <!-- AI Camera Breed Scanner Trigger -->
            <button 
              type="button" 
              id="ai-scan-trigger-btn" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[11px] font-mono font-semibold text-[#0070f3] bg-[#d3e5ff]/50 dark:bg-[#0070f3]/20 hover:bg-[#d3e5ff] dark:hover:bg-[#0070f3]/30 border border-[#0070f3]/30 rounded-full transition-all touch-manipulation cursor-pointer"
            >
              <span>📸 AI Dog Breed Scanner</span>
            </button>
          </div>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">Don't know the breed? Use our free AI scanner or select a general size category.</p>

          <div class="space-y-4 sm:space-y-5">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="dog-breed" class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                  Breed / Genetic Size
                </label>
                <span class="text-[10px] text-[#8f8f8f] dark:text-[#737373] font-mono">Includes "I don't know" options</span>
              </div>
              <select 
                id="dog-breed" 
                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
              >
                {CANINE_BREEDS.map((b) => (
                  <option value={b.name}>{b.name}</option>
                ))}
              </select>
            </div>

            <!-- Weight and Unit Selector -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="dog-weight" class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                    Current Weight
                  </label>
                  <div class="flex items-center text-[10px] font-mono border border-[#ebebeb] dark:border-[#2e2e2e] rounded overflow-hidden">
                    <button type="button" id="unit-lbs" class="px-2 py-0.5 bg-[#171717] dark:bg-white text-white dark:text-[#171717] transition-colors cursor-pointer">LBS</button>
                    <button type="button" id="unit-kg" class="px-2 py-0.5 bg-[#fafafa] dark:bg-[#1a1a1a] text-[#8f8f8f] dark:text-[#737373] transition-colors cursor-pointer">KG</button>
                  </div>
                </div>
                <div class="relative">
                  <input 
                    type="number" 
                    id="dog-weight" 
                    min="1" 
                    max="250" 
                    value="45" 
                    required 
                    class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
                  />
                  <span id="weight-unit-label" class="absolute right-3.5 top-2.5 text-[10px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] font-mono">LBS</span>
                </div>
              </div>

              <div>
                <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-1.5 font-mono">
                  Weight Management Goal
                </label>
                <select 
                  id="target-goal" 
                  class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
                >
                  <option value="maintain" selected>Maintain Current Weight (Balanced)</option>
                  <option value="lose">Gentle Fat Loss (-20% Deficit)</option>
                  <option value="gain">Healthy Muscle Gain (+20% Surplus)</option>
                </select>
              </div>
            </div>

            <!-- Body Condition Score 1-9 Visual Selector -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                  Body Condition Score (BCS 1–9)
                </label>
                <span id="bcs-label" class="font-mono text-[10px] sm:text-xs font-bold text-[#0070f3] bg-[#d3e5ff]/40 dark:bg-[#0070f3]/20 px-2 py-0.5 rounded">
                  BCS 5/9: Ideal Weight
                </span>
              </div>
              <input 
                type="range" 
                id="bcs-slider" 
                min="1" 
                max="9" 
                value="5" 
                class="w-full h-2.5 bg-[#f2f2f2] dark:bg-[#262626] rounded-lg appearance-none cursor-pointer accent-[#171717] dark:accent-white touch-manipulation"
              />
              <div class="flex justify-between text-[10px] sm:text-[11px] text-[#8f8f8f] dark:text-[#737373] font-mono mt-1">
                <span>1 (Thin)</span>
                <span class="text-[#10b981] font-semibold">4–5 (Ideal)</span>
                <span>9 (Obese)</span>
              </div>
            </div>

            <!-- Treat & Snack Allowance Percentage -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono">
                  Daily Treat Allowance (% of Calories)
                </label>
                <span id="treat-budget-label" class="font-mono text-[10px] sm:text-xs font-bold text-[#171717] dark:text-[#ededed] bg-[#f2f2f2] dark:bg-[#262626] px-2 py-0.5 rounded">
                  10% (Recommended)
                </span>
              </div>
              <input 
                type="range" 
                id="treat-budget-slider" 
                min="0" 
                max="15" 
                step="5" 
                value="10" 
                class="w-full h-2.5 bg-[#f2f2f2] dark:bg-[#262626] rounded-lg appearance-none cursor-pointer accent-[#171717] dark:accent-white touch-manipulation"
              />
              <div class="flex justify-between text-[10px] text-[#8f8f8f] dark:text-[#737373] font-mono mt-1">
                <span>0% (Meals Only)</span>
                <span>5%</span>
                <span>10% (Standard)</span>
                <span>15% (High Training)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3: Activity Level & Lifestyle -->
        <div class="quiz-step hidden" data-step="3">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">Daily Activity & Energy Output</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">How much physical activity does your dog participate in daily?</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3.5">
            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="sedentary" class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">🛋️ Couch / Low Activity</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">Leisurely yard breaks, &lt;30 mins walk.</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/60 dark:peer-checked:!text-[#171717]/60">0.85x Multiplier</div>
              </div>
            </label>

            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="moderate" checked class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">🐕 Moderate Daily Walker</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">1–2 daily walks (30–60 mins) & play.</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/60 dark:peer-checked:!text-[#171717]/60">1.0x (Standard)</div>
              </div>
            </label>

            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="active" class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">⚡ Active Athlete / Hiker</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">60–120+ mins vigorous runs & fetch.</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/60 dark:peer-checked:!text-[#171717]/60">1.25x Multiplier</div>
              </div>
            </label>

            <label class="cursor-pointer touch-manipulation">
              <input type="radio" name="activity-level" value="working" class="peer sr-only" />
              <div class="p-3.5 sm:p-4 border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg peer-checked:border-[#171717] dark:peer-checked:border-white peer-checked:bg-[#171717] dark:peer-checked:bg-white peer-checked:!text-white dark:peer-checked:!text-[#171717] text-[#171717] dark:text-[#ededed] bg-white dark:bg-[#1a1a1a] transition-all h-full flex flex-col justify-between">
                <div>
                  <div class="font-semibold text-xs sm:text-sm mb-0.5">🏔️ High-Endurance Working</div>
                  <p class="text-[11px] sm:text-xs text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/80 dark:peer-checked:!text-[#171717]/80">Herding, agility, or field endurance.</p>
                </div>
                <div class="font-mono text-[9px] sm:text-[10px] mt-2 sm:mt-3 uppercase text-[#8f8f8f] dark:text-[#737373] peer-checked:!text-white/60 dark:peer-checked:!text-[#171717]/60">1.55x Multiplier</div>
              </div>
            </label>
          </div>
        </div>

        <!-- STEP 4: Allergies & Primary Health Focus -->
        <div class="quiz-step hidden" data-step="4">
          <h3 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-[#ededed] mb-1">Allergies & Targeted Health Focus</h3>
          <p class="text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] mb-5 sm:mb-6">Optionally isolate sensitivities or select general wellness.</p>

          <div class="space-y-5">
            <div>
              <label class="block text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider mb-2 font-mono">
                Known Sensitivities (Select all that apply)
              </label>
              <div class="flex flex-wrap gap-1.5 sm:gap-2" id="allergy-pills">
                {['None / No Allergies', 'Chicken / Poultry', 'Beef', 'Dairy', 'Grains / Wheat', 'Soy', 'Eggs', 'Corn'].map((item, idx) => (
                  <label class="cursor-pointer touch-manipulation">
                    <input 
                      type="checkbox" 
                      value={item.toLowerCase()} 
