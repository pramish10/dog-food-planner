    if (bcsLabel) {
      if (val <= 3) {
        bcsLabel.textContent = `Slim Build (BCS ${val}/9)`;
        bcsLabel.className = 'shrink-0 font-mono text-[10px] sm:text-xs font-bold text-[#f5a623] bg-[#f5a623]/15 px-2 py-0.5 rounded';
      } else if (val <= 5) {
        bcsLabel.textContent = `Ideal Build (BCS ${val}/9)`;
        bcsLabel.className = 'shrink-0 font-mono text-[10px] sm:text-xs font-bold text-[#10b981] bg-[#10b981]/15 px-2 py-0.5 rounded';
      } else {
        bcsLabel.textContent = `Heavy Build (BCS ${val}/9)`;
        bcsLabel.className = 'shrink-0 font-mono text-[10px] sm:text-xs font-bold text-[#ee0000] bg-[#ee0000]/15 px-2 py-0.5 rounded';
      }
    }
    bcsPresetBtns.forEach((btn) => {
      const bcs = parseInt(btn.getAttribute('data-bcs') || '0');
      const isMatch = (bcs === 3 && val <= 3) || (bcs === 5 && (val === 4 || val === 5)) || (bcs === 7 && val >= 6);
      if (isMatch) {
        btn.className = 'bcs-preset-btn px-2 py-1.5 rounded-lg text-center border-2 border-[#10b981] bg-[#10b981]/10 text-left cursor-pointer';
