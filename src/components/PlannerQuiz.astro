          <button type="button" id="next-btn"
            class="px-7 py-2.5 text-xs sm:text-sm font-bold bg-[#b45309] hover:bg-[#92400e] text-white rounded-xl transition-all cursor-pointer shadow-sm min-h-[42px]">
            {p.nextBtn}
          </button>
          <button type="submit" id="submit-btn"
            class="hidden px-7 py-2.5 text-xs sm:text-sm font-bold bg-[#b45309] hover:bg-[#92400e] text-white rounded-xl transition-all cursor-pointer shadow-sm min-h-[42px]">
            {p.submitBtn}
          </button>
