---
import { CANINE_BREEDS } from '../data/breeds';
import { getLangFromUrl } from '../i18n/utils';
import { plannerTranslations } from '../i18n/planner';

const lang = getLangFromUrl(Astro.url);
const p = plannerTranslations[lang] || plannerTranslations.en;
const TOTAL_STEPS = 4;
---

<section id="planner-section" class="py-6 sm:py-10 bg-[#fdf8f3] dark:bg-[#150d04] border-b border-[#f0d5a8] dark:border-[#3a2510]" data-lang={lang}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div class="text-center mb-4 sm:mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-[#1c0f00] dark:text-[#fde8c8] tracking-tight mb-1">
        {p.title}
      </h2>
      <p class="text-xs sm:text-sm text-[#92400e] dark:text-[#c4956a] max-w-sm mx-auto">
        {p.subtitle}
      </p>
    </div>

    <!-- Quiz Card — horizontal on lg+, vertical on mobile -->
    <div class="bg-white dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-2xl shadow-sm overflow-hidden lg:flex lg:min-h-[520px]">

      <!-- LEFT SIDEBAR: Step navigator (desktop only) -->
      <div class="hidden lg:flex lg:flex-col lg:w-56 xl:w-64 shrink-0 bg-[#fdf3e7] dark:bg-[#1a0e04] border-r border-[#f0d5a8] dark:border-[#3a2510] p-5">
        <div class="text-[10px] font-mono font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-widest mb-4">{p.stepPrefix}</div>
        <nav class="flex flex-col gap-2 flex-1" id="step-nav-sidebar">
          {[
            { n: 1, title: p.step1Title, icon: '🐾' },
            { n: 2, title: p.step2Title, icon: '⚖️' },
            { n: 3, title: p.step3Title, icon: '🏃' },
            { n: 4, title: p.step4Title, icon: '🌿' },
          ].map(s => (
            <button
              type="button"
              data-nav-step={s.n}
              class={`step-nav-btn w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all cursor-pointer ${s.n === 1 ? 'bg-white dark:bg-[#2a1a08] shadow-sm border border-[#f0d5a8] dark:border-[#3a2510]' : 'hover:bg-white/60 dark:hover:bg-[#2a1a08]/60'}`}
            >
              <span class="text-base shrink-0">{s.icon}</span>
              <div class="min-w-0">
                <div class={`text-[10px] font-mono font-semibold uppercase tracking-wider ${s.n === 1 ? 'text-[#c47a2b]' : 'text-[#92400e] dark:text-[#c4956a]'}`} data-nav-step-label={s.n}>STEP {s.n}</div>
                <div class={`text-xs font-semibold truncate ${s.n === 1 ? 'text-[#1c0f00] dark:text-[#fde8c8]' : 'text-[#92400e] dark:text-[#c4956a]'}`} data-nav-step-title={s.n}>{s.title}</div>
              </div>
              <svg data-nav-check={s.n} class="hidden ml-auto w-4 h-4 text-[#22c55e] shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </button>
          ))}
        </nav>
        <!-- Sidebar progress bar -->
        <div class="mt-4 pt-4 border-t border-[#f0d5a8] dark:border-[#3a2510]">
          <div class="flex items-center justify-between mb-1.5">
            <span id="sidebar-step-label" class="text-[10px] font-mono font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider">{p.stepPrefix} 1 {p.ofStep}</span>
          </div>
          <div class="w-full bg-[#fdf3e7] dark:bg-[#2a1a08] h-1.5 rounded-full overflow-hidden border border-[#f0d5a8] dark:border-[#3a2510]">
            <div id="quiz-progress-bar-sidebar" class="h-full rounded-full transition-all duration-500 ease-out" style="width: 25%; background: linear-gradient(90deg, #c47a2b, #e8a44a)"></div>
          </div>
        </div>
      </div>

      <!-- RIGHT CONTENT AREA -->
      <div class="flex-1 flex flex-col min-w-0">

        <!-- Mobile Progress Bar (hidden on lg+) -->
        <div class="lg:hidden px-4 sm:px-6 pt-4 pb-0">
          <div class="flex items-center justify-between mb-2">
            <span id="step-label" class="text-[11px] font-semibold text-[#92400e] dark:text-[#c4956a] font-mono uppercase tracking-wider">
              {p.stepPrefix} 1 {p.ofStep}
            </span>
            <span id="step-title-badge" class="text-[11px] font-semibold text-[#1c0f00] dark:text-[#fde8c8]">{p.step1Title}</span>
          </div>
          <div class="w-full bg-[#fdf3e7] dark:bg-[#2a1a08] h-1 rounded-full overflow-hidden">
            <div id="quiz-progress-bar" class="h-full rounded-full transition-all duration-500 ease-out" style="width: 25%; background: linear-gradient(90deg, #c47a2b, #e8a44a)"></div>
          </div>
        </div>
        <!-- Desktop: hidden elements kept for JS compat (IDs used by updateProgress) -->
        <!-- These are intentionally hidden on desktop; mobile versions above are shown -->

      <form id="dog-planner-form" onsubmit="return false;" novalidate class="p-4 sm:p-5 lg:p-6 flex-1 flex flex-col">

        <!-- STEP 1: Dog Basics -->
        <div class="quiz-step" data-step="1">
          <h3 class="text-sm font-bold text-[#1c0f00] dark:text-[#fde8c8] mb-3">{p.step1Title}</h3>

          <div class="space-y-3">
            <!-- Name — half width, no need to stretch full -->
            <div class="flex items-center gap-3">
              <label for="dog-name" class="text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider font-mono shrink-0">{p.nameLabel}</label>
              <input type="text" id="dog-name" placeholder={p.namePlaceholder} value="Lucy" autocomplete="off"
                class="w-48 sm:w-56 px-3 py-2 text-sm bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] focus:ring-2 focus:ring-[#c47a2b]/20 transition-all" />
            </div>

            <!-- Life Stage — 4 cols on sm+, 2 on mobile -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.ageLabel}</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                <label class="cursor-pointer">
                  <input type="radio" name="age-stage" value="puppy-early" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🍼</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.puppyEarly}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.puppyEarlySub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="age-stage" value="puppy-late" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🐕</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.puppyLate}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.puppyLateSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="age-stage" value="adult" checked class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🦮</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.adult}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.adultSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="age-stage" value="senior" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🐾</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.senior}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.seniorSub}</div>
                  </div>
                </label>
              </div>
            </div>

            <!-- Gender — 4 cols on sm+, 2 on mobile -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.genderLabel}</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                <label class="cursor-pointer">
                  <input type="radio" name="gender" value="female-spayed" checked class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">♀️</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.femaleSpayed}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.femaleSpayedSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="gender" value="female-intact" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🌸</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.femaleIntact}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.femaleIntactSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="gender" value="male-neutered" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">♂️</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.maleNeutered}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.maleNeuteredSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="gender" value="male-intact" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">💪</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.maleIntact}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.maleIntactSub}</div>
                  </div>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: Physical Metrics & Weight Goal -->
        <div class="quiz-step hidden" data-step="2">
          <h3 class="text-sm font-bold text-[#1c0f00] dark:text-[#fde8c8] mb-3">{p.step2Title}</h3>

          <div class="space-y-3">
            <!-- Breed + Weight side by side on sm+ -->
            <div class="flex flex-col sm:flex-row sm:items-end gap-3">
              <div class="flex-1 min-w-0">
                <label for="dog-breed" class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.breedLabel}</label>
                <select id="dog-breed"
                  class="w-full px-3 py-2 text-sm bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] focus:ring-2 focus:ring-[#c47a2b]/20">
                  {CANINE_BREEDS.map((b) => (
                    <option value={b.name}>{b.name}</option>
                  ))}
                </select>
              </div>
              <div class="sm:w-44 shrink-0">
                <div class="flex items-center justify-between mb-1.5">
                  <label for="dog-weight" class="text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider font-mono">{p.weightLabel}</label>
                  <div class="flex items-center text-xs font-mono border border-[#f0d5a8] dark:border-[#3a2510] rounded-lg overflow-hidden">
                    <button type="button" id="unit-lbs" class="px-2.5 py-1 bg-[#c47a2b] text-white font-semibold transition-colors cursor-pointer">LBS</button>
                    <button type="button" id="unit-kg" class="px-2.5 py-1 bg-white dark:bg-[#1c1208] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer">KG</button>
                  </div>
                </div>
                <div class="relative">
                  <input type="number" id="dog-weight" min="1" max="250" value="45"
                    class="w-full px-3 pr-12 py-2 text-sm bg-[#fdf8f3] dark:bg-[#1c1208] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-[#1c0f00] dark:text-[#fde8c8] focus:outline-none focus:border-[#c47a2b] focus:ring-2 focus:ring-[#c47a2b]/20" />
                  <span id="weight-unit-label" class="absolute right-3 top-2.5 text-xs text-[#92400e] dark:text-[#c4956a] font-mono font-semibold">LBS</span>
                </div>
              </div>
            </div>

            <!-- Body Condition Score — full width 4 cols -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.bcsLabel}</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                <label class="cursor-pointer">
                  <input type="radio" name="bcs" value="2" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🦴</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.bcsUnderweight}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">BCS 1–3</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="bcs" value="5" checked class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">✅</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.bcsIdeal}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">BCS 4–5</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="bcs" value="7" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🍩</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.bcsOverweight}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">BCS 6–7</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="bcs" value="9" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">⚠️</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.bcsObese}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">BCS 8–9</div>
                  </div>
                </label>
              </div>
            </div>

            <!-- Weight Management Goal — full width 3 cols, spacious -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.weightGoalLabel}</label>
              <div class="grid grid-cols-3 gap-2">
                <label class="cursor-pointer">
                  <input type="radio" name="weight-goal" value="maintain" checked class="peer sr-only" />
                  <div class="p-3 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-1">
                    <div class="text-xl">⚖️</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.goalMaintain}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.goalMaintainSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="weight-goal" value="lose" class="peer sr-only" />
                  <div class="p-3 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-1">
                    <div class="text-xl">📉</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.goalLose}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.goalLoseSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="weight-goal" value="gain" class="peer sr-only" />
                  <div class="p-3 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-1">
                    <div class="text-xl">💪</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.goalGain}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.goalGainSub}</div>
                  </div>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 3: Activity & Lifestyle -->
        <div class="quiz-step hidden" data-step="3">
          <h3 class="text-sm font-bold text-[#1c0f00] dark:text-[#fde8c8] mb-3">{p.step3Title}</h3>

          <div class="space-y-3">
            <!-- Activity Level — 4 cols on sm+, 2 on mobile -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.activityLabel}</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                <label class="cursor-pointer">
                  <input type="radio" name="activity" value="sedentary" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🛋️</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.activityLow}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.activityLowSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="activity" value="moderate" checked class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🚶</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.activityMod}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.activityModSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="activity" value="active" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🏃</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.activityHigh}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.activityHighSub}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="activity" value="working" class="peer sr-only" />
                  <div class="p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl text-center peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex flex-col items-center justify-center gap-0.5">
                    <div class="text-lg">🐕‍🦺</div>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.activityWorking}</div>
                    <div class="text-[10px] text-[#92400e] dark:text-[#c4956a] leading-tight">{p.activityWorkingSub}</div>
                  </div>
                </label>
              </div>
            </div>

            <!-- Allergies — None is first chip in unified 4-col grid -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.allergiesLabel}</label>
              <div class="grid grid-cols-4 gap-1.5">
                <!-- None chip — green when checked, same size as allergen chips -->
                <label id="allergy-none-label" class="cursor-pointer flex flex-col items-center gap-1 p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl bg-white dark:bg-[#1c1208] has-[:checked]:border-[#22c55e] has-[:checked]:bg-[#22c55e]/8 transition-all text-center relative">
                  <input type="checkbox" id="allergy-none" name="allergy" value="none / no allergies" class="sr-only" checked />
                  <span class="text-lg">✅</span>
                  <span class="text-[10px] font-semibold text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.allergyNone}</span>
                  <svg id="allergy-none-check" class="hidden absolute top-1 right-1 w-3 h-3 text-[#22c55e]" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </label>
                <!-- Allergen chips -->
                <div class="contents" id="allergy-chips">
                  {[
                    { value: 'chicken / poultry', label: p.allergyChicken, emoji: '🍗' },
                    { value: 'beef',               label: p.allergyBeef,    emoji: '🥩' },
                    { value: 'dairy',              label: p.allergyDairy,   emoji: '🥛' },
                    { value: 'grains / wheat',     label: p.allergyWheat,   emoji: '🌾' },
                    { value: 'soy',                label: p.allergySoy,     emoji: '🫘' },
                    { value: 'eggs',               label: p.allergyEggs,    emoji: '🥚' },
                  ].map(a => (
                    <label class="allergy-chip cursor-pointer flex flex-col items-center gap-1 p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl bg-white dark:bg-[#1c1208] has-[:checked]:border-[#ef4444] has-[:checked]:bg-[#ef4444]/8 transition-all text-center">
                      <input type="checkbox" name="allergy" value={a.value} class="sr-only" />
                      <span class="text-lg">{a.emoji}</span>
                      <span class="text-[10px] font-semibold text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{a.label}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 4: Health & Protein -->
        <div class="quiz-step hidden" data-step="4">
          <h3 class="text-sm font-bold text-[#1c0f00] dark:text-[#fde8c8] mb-3">{p.step4Title}</h3>

          <div class="space-y-3">
            <!-- Health Focus — 2-col compact grid, 5 items (last spans full on odd) -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.healthFocusLabel}</label>
              <div class="grid grid-cols-2 gap-1.5">
                <label class="cursor-pointer">
                  <input type="radio" name="health-focus" value="General Longevity & Health" checked class="peer sr-only" />
                  <div class="px-3 py-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex items-center gap-2">
                    <span class="text-base shrink-0">⭐</span>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.focusGeneral}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="health-focus" value="Joints & Mobility Support" class="peer sr-only" />
                  <div class="px-3 py-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex items-center gap-2">
                    <span class="text-base shrink-0">🦴</span>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.focusJoints}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="health-focus" value="Skin & Shiny Coat Vitality" class="peer sr-only" />
                  <div class="px-3 py-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex items-center gap-2">
                    <span class="text-base shrink-0">✨</span>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.focusCoat}</div>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="health-focus" value="Sensitive Digestion & Gut Health" class="peer sr-only" />
                  <div class="px-3 py-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex items-center gap-2">
                    <span class="text-base shrink-0">🌿</span>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.focusDigestion}</div>
                  </div>
                </label>
                <label class="cursor-pointer col-span-2 sm:col-span-1">
                  <input type="radio" name="health-focus" value="Metabolic Weight Management" class="peer sr-only" />
                  <div class="px-3 py-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl peer-checked:border-[#c47a2b] peer-checked:bg-[#c47a2b]/8 transition-all bg-white dark:bg-[#1c1208] flex items-center gap-2">
                    <span class="text-base shrink-0">⚖️</span>
                    <div class="font-semibold text-xs text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{p.focusWeight}</div>
                  </div>
                </label>
              </div>
            </div>

            <!-- Protein Preference — 6 chips, 3-col, compact -->
            <div>
              <label class="block text-xs font-semibold text-[#92400e] dark:text-[#c4956a] uppercase tracking-wider mb-1.5 font-mono">{p.proteinLabel}</label>
              <div class="grid grid-cols-3 gap-1.5">
                {[
                  { value: 'auto',    label: p.proteinRotation, emoji: '🔄' },
                  { value: 'chicken', label: p.proteinChicken,  emoji: '🍗' },
                  { value: 'beef',    label: p.proteinBeef,     emoji: '🥩' },
                  { value: 'turkey',  label: p.proteinTurkey,   emoji: '🦃' },
                  { value: 'lamb',    label: p.proteinLamb,     emoji: '🐑' },
                  { value: 'salmon',  label: p.proteinSalmon,   emoji: '🐟' },
                ].map((opt, i) => (
                  <label data-protein={opt.value} class="relative cursor-pointer flex flex-col items-center gap-1 p-2 border-2 border-[#f0d5a8] dark:border-[#3a2510] rounded-xl bg-white dark:bg-[#1c1208] has-[:checked]:border-[#c47a2b] has-[:checked]:bg-[#c47a2b]/8 transition-all text-center">
                    <input type="radio" name="protein" value={opt.value} class="sr-only" checked={i === 0} />
                    <span class="text-lg">{opt.emoji}</span>
                    <span class="text-[10px] font-semibold text-[#1c0f00] dark:text-[#fde8c8] leading-tight">{opt.label}</span>
                    <span class="protein-blocked-badge hidden absolute -top-1 -right-1 text-[9px] bg-red-500 text-white rounded-full w-3.5 h-3.5 flex items-center justify-center font-bold leading-none">✕</span>
                  </label>
                ))}
              </div>
            </div>

          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex items-center justify-between mt-4 pt-4 border-t border-[#f0d5a8] dark:border-[#3a2510] lg:mt-auto">
          <button type="button" id="prev-btn"
            class="hidden px-5 py-3 text-sm font-semibold text-[#92400e] dark:text-[#c4956a] border border-[#f0d5a8] dark:border-[#3a2510] rounded-xl hover:text-[#1c0f00] hover:border-[#c47a2b] transition-all cursor-pointer touch-manipulation min-h-[44px]">
            {p.prevBtn}
          </button>
          <div id="prev-placeholder"></div>
          <button type="button" id="next-btn"
            class="px-7 py-3 text-sm font-semibold bg-[#c47a2b] hover:bg-[#b8691f] text-white rounded-xl transition-all cursor-pointer touch-manipulation min-h-[44px]">
            {p.nextBtn}
          </button>
          <button type="submit" id="submit-btn"
            class="hidden px-7 py-3 text-sm font-semibold bg-[#c47a2b] hover:bg-[#b8691f] text-white rounded-xl transition-all cursor-pointer touch-manipulation min-h-[44px]">
            {p.submitBtn}
          </button>
        </div>

      </form>
      </div><!-- end RIGHT CONTENT AREA -->
    </div>

  </div>
</section>

<script>
  const TOTAL_STEPS = 4;
  const PLANNER_STATE_KEY = 'dfp-planner-state';
  let currentStep = 1;
  let weightUnit: 'lbs' | 'kg' = 'lbs';

  const stepTitles = ['step1Title', 'step2Title', 'step3Title', 'step4Title'];

  function getTranslations() {
    const section = document.getElementById('planner-section') as HTMLElement;
    const lang = section?.dataset.lang || 'en';
    return (window as any).__plannerTranslations?.[lang] || {};
  }

  function savePlannerState() {
    const form = document.getElementById('dog-planner-form') as HTMLFormElement | null;
    if (!form) return;

    const formData = new FormData(form);
    const values: Record<string, string | string[]> = {};

    for (const [key, value] of formData.entries()) {
      if (key in values) {
        const existing = values[key];
        values[key] = Array.isArray(existing)
          ? [...existing, String(value)]
          : [String(existing), String(value)];
      } else {
        values[key] = String(value);
      }
    }

    const dogName = document.getElementById('dog-name') as HTMLInputElement | null;
    const dogBreed = document.getElementById('dog-breed') as HTMLSelectElement | null;
    const dogWeight = document.getElementById('dog-weight') as HTMLInputElement | null;

    sessionStorage.setItem(
      PLANNER_STATE_KEY,
      JSON.stringify({
        currentStep,
        weightUnit,
        currentWeightKg,
        values,
        fields: {
          dogName: dogName?.value ?? '',
          dogBreed: dogBreed?.value ?? '',
          dogWeight: dogWeight?.value ?? '',
        },
      })
    );
  }

  function restorePlannerState() {
    const raw = sessionStorage.getItem(PLANNER_STATE_KEY);
    if (!raw) return;

    try {
      const state = JSON.parse(raw);
      const values = state?.values || {};

      Object.entries(values).forEach(([name, value]) => {
        const inputs = document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`);
        if (!inputs.length) return;

        if (inputs[0].type === 'radio') {
          inputs.forEach((input) => {
            input.checked = input.value === value;
          });
          return;
        }

        if (inputs[0].type === 'checkbox') {
          const selected = Array.isArray(value) ? value : [value];
          inputs.forEach((input) => {
            input.checked = selected.includes(input.value);
          });
        }
      });

      const dogName = document.getElementById('dog-name') as HTMLInputElement | null;
      const dogBreed = document.getElementById('dog-breed') as HTMLSelectElement | null;
      const dogWeight = document.getElementById('dog-weight') as HTMLInputElement | null;

      if (dogName && state?.fields?.dogName !== undefined) dogName.value = state.fields.dogName;
      if (dogBreed && state?.fields?.dogBreed !== undefined) dogBreed.value = state.fields.dogBreed;
      if (dogWeight && state?.fields?.dogWeight !== undefined) dogWeight.value = state.fields.dogWeight;

      currentWeightKg = Boolean(state?.currentWeightKg);
      weightUnit = state?.weightUnit === 'kg' ? 'kg' : 'lbs';
      currentStep = Math.min(Math.max(Number(state?.currentStep) || 1, 1), TOTAL_STEPS);
    } catch {
      sessionStorage.removeItem(PLANNER_STATE_KEY);
    }
  }

  function updateProgress() {
    const pct = (currentStep / TOTAL_STEPS) * 100;
    // Mobile progress bar
    const bar = document.getElementById('quiz-progress-bar') as HTMLElement;
    const label = document.getElementById('step-label') as HTMLElement;
    const badge = document.getElementById('step-title-badge') as HTMLElement;
    if (bar) bar.style.width = pct + '%';
    if (label) {
      const t = getTranslations();
      label.textContent = `${t.stepPrefix || 'STEP'} ${currentStep} ${t.ofStep || 'OF 4'}`;
    }
    if (badge) {
      const t = getTranslations();
      const key = stepTitles[currentStep - 1] as keyof typeof t;
      badge.textContent = t[key] || '';
    }
    // Sidebar progress bar (desktop)
    const sidebarBar = document.getElementById('quiz-progress-bar-sidebar') as HTMLElement;
    const sidebarLabel = document.getElementById('sidebar-step-label') as HTMLElement;
    if (sidebarBar) sidebarBar.style.width = pct + '%';
    if (sidebarLabel) {
      const t = getTranslations();
      sidebarLabel.textContent = `${t.stepPrefix || 'STEP'} ${currentStep} ${t.ofStep || 'OF 4'}`;
    }
    // Update sidebar nav buttons
    document.querySelectorAll('.step-nav-btn').forEach((btn) => {
      const btnStep = Number((btn as HTMLElement).dataset.navStep);
      const isActive = btnStep === currentStep;
      const isCompleted = btnStep < currentStep;
      btn.classList.toggle('bg-white', isActive);
      btn.classList.toggle('dark:bg-[#2a1a08]', isActive);
      btn.classList.toggle('shadow-sm', isActive);
      btn.classList.toggle('border', isActive);
      btn.classList.toggle('border-[#f0d5a8]', isActive);
      btn.classList.toggle('dark:border-[#3a2510]', isActive);
      // label color
      const stepLabel = btn.querySelector(`[data-nav-step-label="${btnStep}"]`) as HTMLElement;
      const stepTitle = btn.querySelector(`[data-nav-step-title="${btnStep}"]`) as HTMLElement;
      const checkIcon = btn.querySelector(`[data-nav-check="${btnStep}"]`) as HTMLElement;
      if (stepLabel) {
        stepLabel.classList.toggle('text-[#c47a2b]', isActive || isCompleted);
        stepLabel.classList.toggle('text-[#92400e]', !isActive && !isCompleted);
        stepLabel.classList.toggle('dark:text-[#c4956a]', !isActive && !isCompleted);
      }
      if (stepTitle) {
        stepTitle.classList.toggle('text-[#1c0f00]', isActive);
        stepTitle.classList.toggle('dark:text-[#fde8c8]', isActive);
        stepTitle.classList.toggle('text-[#92400e]', !isActive);
        stepTitle.classList.toggle('dark:text-[#c4956a]', !isActive);
      }
      if (checkIcon) {
        checkIcon.classList.toggle('hidden', !isCompleted);
      }
    });
  }

  function showStep(step: number) {
    document.querySelectorAll('.quiz-step').forEach((el) => {
      (el as HTMLElement).classList.add('hidden');
    });
    const target = document.querySelector(`.quiz-step[data-step="${step}"]`) as HTMLElement;
    if (target) target.classList.remove('hidden');

    const prevBtn = document.getElementById('prev-btn') as HTMLElement;
    const prevPlaceholder = document.getElementById('prev-placeholder') as HTMLElement;
    const nextBtn = document.getElementById('next-btn') as HTMLElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLElement;

    if (step === 1) {
      prevBtn.classList.add('hidden');
      prevPlaceholder.classList.remove('hidden');
    } else {
      prevBtn.classList.remove('hidden');
      prevPlaceholder.classList.add('hidden');
    }

    if (step === TOTAL_STEPS) {
      nextBtn.classList.add('hidden');
      submitBtn.classList.remove('hidden');
    } else {
      nextBtn.classList.remove('hidden');
      submitBtn.classList.add('hidden');
    }

    updateProgress();
  }

  // Next button
  document.getElementById('next-btn')?.addEventListener('click', () => {
    if (currentStep < TOTAL_STEPS) {
      currentStep++;
      showStep(currentStep);
      savePlannerState();
      document.getElementById('planner-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  // Prev button
  document.getElementById('prev-btn')?.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      showStep(currentStep);
      savePlannerState();
      document.getElementById('planner-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  // ── Allergy ↔ Protein cross-link logic ───────────────────────────

  // Maps allergen checkbox value → protein radio value(s) to block
  const ALLERGEN_PROTEIN_MAP: Record<string, string[]> = {
    'chicken / poultry': ['chicken'],
    'beef':              ['beef'],
    'dairy':             [],          // no direct protein match
    'grains / wheat':    [],
    'soy':               [],
    'eggs':              [],
  };

  const noneBox      = document.getElementById('allergy-none') as HTMLInputElement;
  const noneCheck    = document.getElementById('allergy-none-check') as HTMLElement;
  const allergyChips = document.querySelectorAll<HTMLInputElement>('#allergy-chips input[type="checkbox"]');
  const proteinCards = document.querySelectorAll<HTMLInputElement>('input[name="protein"]');

  function syncNoneVisual() {
    noneCheck?.classList.toggle('hidden', !noneBox?.checked);
  }

  // Run on page load so the checkmark reflects the default checked state
  syncNoneVisual();

  function syncProteinBlocking() {
    // Collect all currently checked allergen values
    const blocked = new Set<string>();
    allergyChips.forEach(cb => {
      if (cb.checked) {
        (ALLERGEN_PROTEIN_MAP[cb.value] || []).forEach(p => blocked.add(p));
      }
    });

    proteinCards.forEach(radio => {
      const card = radio.closest('label') as HTMLElement;
      if (!card) return;
      const badge = card.querySelector('.protein-blocked-badge') as HTMLElement;

      if (blocked.has(radio.value)) {
        // Disable & grey out
        radio.disabled = true;
        if (radio.checked) {
          // Move selection to 'auto' (Balanced Rotation)
          radio.checked = false;
          const autoRadio = document.querySelector<HTMLInputElement>('input[name="protein"][value="auto"]');
          if (autoRadio) autoRadio.checked = true;
        }
        card.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        card.setAttribute('title', 'Blocked — allergen selected');
        badge?.classList.remove('hidden');
      } else {
        // Re-enable
        radio.disabled = false;
        card.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        card.removeAttribute('title');
        badge?.classList.add('hidden');
      }
    });
  }

  // "None" pill — clears all allergens and re-enables all proteins
  noneBox?.addEventListener('change', () => {
    if (noneBox.checked) {
      allergyChips.forEach(cb => { cb.checked = false; });
    }
    syncNoneVisual();
    syncProteinBlocking();
    savePlannerState();
  });

  // Each allergen chip — blocks matching proteins, clears "None"
  // If all chips are unchecked again, auto-restore "None"
  allergyChips.forEach(cb => {
    cb.addEventListener('change', () => {
      if (cb.checked && noneBox?.checked) {
        noneBox.checked = false;
      }
      // If no allergen chip is checked, restore "None"
      const anyChecked = Array.from(allergyChips).some(c => c.checked);
      if (!anyChecked) {
        noneBox.checked = true;
      }
      syncNoneVisual();
      syncProteinBlocking();
      savePlannerState();
    });
  });

  // ── Weight unit toggle ────────────────────────────────────────────
  let currentWeightKg = false;
  document.getElementById('unit-lbs')?.addEventListener('click', () => {
    if (currentWeightKg) {
      const input = document.getElementById('dog-weight') as HTMLInputElement;
      const val = parseFloat(input.value) || 0;
      input.value = Math.round(val * 2.20462).toString();
      input.max = '250';
    }
    currentWeightKg = false;
    weightUnit = 'lbs';
    (document.getElementById('unit-lbs') as HTMLElement).className = 'px-3 py-1.5 bg-[#c47a2b] dark:bg-white text-white dark:text-[#1c0f00] font-semibold transition-colors cursor-pointer font-mono text-xs';
    (document.getElementById('unit-kg') as HTMLElement).className = 'px-3 py-1.5 bg-white dark:bg-[#2a1a08] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer font-mono text-xs';
    (document.getElementById('weight-unit-label') as HTMLElement).textContent = 'LBS';
    savePlannerState();

  });

  document.getElementById('unit-kg')?.addEventListener('click', () => {
    if (!currentWeightKg) {
      const input = document.getElementById('dog-weight') as HTMLInputElement;
      const val = parseFloat(input.value) || 0;
      input.value = Math.round(val / 2.20462).toString();
      input.max = '115';
    }
    currentWeightKg = true;
    weightUnit = 'kg';
    (document.getElementById('unit-kg') as HTMLElement).className = 'px-3 py-1.5 bg-[#c47a2b] dark:bg-white text-white dark:text-[#1c0f00] font-semibold transition-colors cursor-pointer font-mono text-xs';
    (document.getElementById('unit-lbs') as HTMLElement).className = 'px-3 py-1.5 bg-white dark:bg-[#2a1a08] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer font-mono text-xs';
    (document.getElementById('weight-unit-label') as HTMLElement).textContent = 'KG';
    savePlannerState();

  });

  document.getElementById('dog-planner-form')?.addEventListener('input', () => {
    savePlannerState();
  });

  document.getElementById('dog-planner-form')?.addEventListener('change', () => {
    savePlannerState();
  });

  // ── Reset handler (fired by Start Over button in PlanResults) ────
  document.addEventListener('dogPlannerReset', () => {
    // Clear saved planner state
    sessionStorage.removeItem(PLANNER_STATE_KEY);
    currentStep = 1;
    // Reset the form to its default values
    const form = document.getElementById('dog-planner-form') as HTMLFormElement | null;
    if (form) form.reset();
    // Re-sync allergy/protein UI after form reset
    syncNoneVisual();
    syncProteinBlocking();
    // Go back to step 1 — this correctly shows next-btn and hides submit-btn
    showStep(1);
  });

  restorePlannerState();
  syncNoneVisual();
  syncProteinBlocking();
  showStep(currentStep);

  if (currentWeightKg) {
    (document.getElementById('unit-kg') as HTMLElement).className = 'px-3 py-1.5 bg-[#c47a2b] dark:bg-white text-white dark:text-[#1c0f00] font-semibold transition-colors cursor-pointer font-mono text-xs';
    (document.getElementById('unit-lbs') as HTMLElement).className = 'px-3 py-1.5 bg-white dark:bg-[#2a1a08] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer font-mono text-xs';
    (document.getElementById('weight-unit-label') as HTMLElement).textContent = 'KG';
  } else {
    (document.getElementById('unit-lbs') as HTMLElement).className = 'px-3 py-1.5 bg-[#c47a2b] dark:bg-white text-white dark:text-[#1c0f00] font-semibold transition-colors cursor-pointer font-mono text-xs';
    (document.getElementById('unit-kg') as HTMLElement).className = 'px-3 py-1.5 bg-white dark:bg-[#2a1a08] text-[#92400e] dark:text-[#c4956a] transition-colors cursor-pointer font-mono text-xs';
    (document.getElementById('weight-unit-label') as HTMLElement).textContent = 'LBS';
  }

  savePlannerState();

  // Form submit
  document.getElementById('dog-planner-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    submitForm();
  });
  document.getElementById('submit-btn')?.addEventListener('click', () => {
    submitForm();
  });

  function submitForm() {
    const name = (document.getElementById('dog-name') as HTMLInputElement).value.trim() || 'Lucy';
    const breed = (document.getElementById('dog-breed') as HTMLSelectElement).value;
    const ageStage = (document.querySelector('input[name="age-stage"]:checked') as HTMLInputElement)?.value || 'adult';
    const gender = (document.querySelector('input[name="gender"]:checked') as HTMLInputElement)?.value || 'male-neutered';
    const bcs = parseInt((document.querySelector('input[name="bcs"]:checked') as HTMLInputElement)?.value || '5');
    const weightGoal = (document.querySelector('input[name="weight-goal"]:checked') as HTMLInputElement)?.value || 'maintain';
    const activity = (document.querySelector('input[name="activity"]:checked') as HTMLInputElement)?.value || 'moderate';
    const diet = 'fresh-cooked'; // Default to first tab; user can switch tabs in results
    const healthFocus = (document.querySelector('input[name="health-focus"]:checked') as HTMLInputElement)?.value || 'General Longevity & Health';
    const proteinChoice = (document.querySelector('input[name="protein"]:checked') as HTMLInputElement)?.value || 'auto';

    const rawWeight = parseFloat((document.getElementById('dog-weight') as HTMLInputElement).value) || 45;
    const weightLbs = currentWeightKg ? rawWeight * 2.20462 : rawWeight;

    const allergies = Array.from(document.querySelectorAll('input[name="allergy"]:checked'))
      .map(el => (el as HTMLInputElement).value);

    const profile = {
      name,
      breed,
      ageStage,
      gender,
      weightLbs,
      targetGoal: weightGoal,
      bcs,
      activityLevel: activity,
      allergies: allergies.length ? allergies : ['none / no allergies'],
      healthFocus,
      dietPreference: diet,
      proteinChoice,
    };

    document.dispatchEvent(new CustomEvent('dogPlannerSubmit', { detail: profile }));
  }
</script>
