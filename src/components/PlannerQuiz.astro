  const ALL_BREED_PROFILES: ExtendedBreedProfile[] = [
    ...COMPREHENSIVE_BREED_INTEL,
    ...CANINE_BREEDS
      .filter((breed) => !breed.name.startsWith('Unknown / Mixed') && !COMPREHENSIVE_BREED_INTEL.some((profile) => profile.name === breed.name))
      .map((breed) => ({
        name: breed.name,
