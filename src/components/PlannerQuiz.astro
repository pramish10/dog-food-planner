                class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] focus:ring-1 focus:ring-[#171717]"
              >
                <option value="General Health" selected>⭐ No Specific Preference (General Longevity & Vitality)</option>
                <option value="Sensitive Digestion">🌱 Sensitive Digestion & Microbiome Balance</option>
                <option value="Hip & Joint">🦴 Hip & Joint Mobility Support</option>
                <option value="Skin & Anti-Itch">✨ Radiant Coat & Anti-Itch Luster</option>
                <option value="Weight Management">⚖️ Lean Body Mass & Weight Control</option>
