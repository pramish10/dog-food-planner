---
const TRANSITION_DAYS = [
  { day: 1, freshPct: 15, oldPct: 85, desc: 'Start slowly and watch how your dog feels.' },
  { day: 2, freshPct: 25, oldPct: 75, desc: 'Keep meals small and familiar.' },
  { day: 3, freshPct: 40, oldPct: 60, desc: 'Your dog is getting used to the new food.' },
  { day: 4, freshPct: 50, oldPct: 50, desc: 'Halfway there. Keep the routine steady.' },
  { day: 5, freshPct: 65, oldPct: 35, desc: 'Continue if your dog is comfortable.' },
  { day: 6, freshPct: 80, oldPct: 20, desc: 'Almost fully switched.' },
  { day: 7, freshPct: 100, oldPct: 0, desc: 'The new food is now the full meal.' }
];
---

<section id="transition-section" class="py-12 sm:py-20 bg-[#fafafa] dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
  <div class="max-w-5xl mx-auto px-3.5 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-14">
      <div class="inline-flex items-center gap-1.5 font-mono text-[10px] sm:text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#ffffff] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-2.5 shadow-2xs">
        <span class="text-[#10b981]">02</span> // SWITCHING FOOD
      </div>
      <h2 class="text-2xl sm:text-4xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-2 sm:mb-3">
        The 7-Day Gentle Transition Roadmap
      </h2>
      <p class="text-xs sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
        Change food slowly over a week so your dog has time to adjust. If they seem unwell, pause and ask your vet.
      </p>
    </div>

    <!-- 7-Day Timeline Cards (Responsive Grid: 2 cols on mobile, 4 on tablet, 7 on desktop) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-2.5 sm:gap-3 mb-8 sm:mb-10">
      {TRANSITION_DAYS.map((item) => (
        <div class="p-3.5 sm:p-4 bg-white dark:bg-[#141414] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex flex-col justify-between hover:border-[#171717] dark:hover:border-[#ededed] transition-all group">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="font-mono text-[10px] sm:text-xs font-bold text-[#171717] dark:text-[#ededed] bg-[#f2f2f2] dark:bg-[#262626] group-hover:bg-[#171717] dark:group-hover:bg-white group-hover:text-white dark:group-hover:text-[#171717] px-2 py-0.5 rounded transition-colors">
                DAY {item.day}
              </span>
            </div>

            <!-- Ratio Stacked Bar -->
            <div class="w-full bg-[#ebebeb] dark:bg-[#262626] h-2 sm:h-2.5 rounded-full overflow-hidden flex my-2 sm:my-3">
              <div class="bg-[#10b981] h-full" style={`width: ${item.freshPct}%`}></div>
              <div class="bg-[#d1d1d1] dark:bg-[#404040] h-full" style={`width: ${item.oldPct}%`}></div>
            </div>

            <div class="text-[10px] sm:text-[11px] font-mono mb-2">
              <span class="text-[#10b981] font-bold">{item.freshPct}% Fresh</span>
              <span class="text-[#8f8f8f] dark:text-[#737373] block text-[9px] sm:text-[10px]">{item.oldPct}% Old Diet</span>
            </div>
          </div>

          <p class="text-[10px] sm:text-[11px] text-[#4d4d4d] dark:text-[#a1a1a1] leading-snug pt-2 border-t border-[#ebebeb] dark:border-[#262626]">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Transition Pro-Tips Banner -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 p-4 sm:p-6 bg-white dark:bg-[#141414] rounded-xl border border-[#ebebeb] dark:border-[#262626]">
      <div class="flex items-start gap-2.5 sm:gap-3">
        <span class="text-lg sm:text-xl">🥣</span>
        <div>
          <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono mb-0.5 sm:mb-1">Add Pure Pumpkin</h4>
          <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">1 tbsp of pure organic pumpkin puree calms loose stool during the first 72 hours.</p>
        </div>
      </div>

      <div class="flex items-start gap-2.5 sm:gap-3">
        <span class="text-lg sm:text-xl">🌡️</span>
        <div>
          <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono mb-0.5 sm:mb-1">Room Temperature</h4>
          <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">Serve at room temp or warm with a splash of bone broth to release enticing aromas.</p>
        </div>
      </div>

      <div class="flex items-start gap-2.5 sm:gap-3">
        <span class="text-lg sm:text-xl">💧</span>
        <div>
          <h4 class="text-[11px] sm:text-xs font-semibold text-[#171717] dark:text-[#ededed] uppercase tracking-wider font-mono mb-0.5 sm:mb-1">Natural Hydration</h4>
          <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">Keep fresh water available at every meal.</p>
        </div>
      </div>
    </div>

  </div>
</section>
