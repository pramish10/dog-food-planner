---
import '../styles/global.css';
import { getLangFromUrl, cleanPathname, getAbsoluteLocalizedUrl } from '../i18n/utils';
import { localesMap, ui, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
  lang?: Lang;
}

const lang: Lang = Astro.props.lang || getLangFromUrl(Astro.url);
const cleanPath = cleanPathname(Astro.url.pathname);

const currentLocaleData = localesMap[lang] || localesMap[defaultLang];
const defaultStrings = ui[lang] || ui[defaultLang];

const {
  title = defaultStrings['meta.title'],
  description = defaultStrings['meta.description'],
  keywords = defaultStrings['meta.keywords'],
  canonicalUrl = getAbsoluteLocalizedUrl(cleanPath, lang),
  ogImage = "https://dogfoodplanner.com/og-image.jpg"
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir={currentLocaleData.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="DogFoodPlanner" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Multilingual Hreflang SEO Markup -->
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocalizedUrl(cleanPath, 'en')} />
    <link rel="alternate" hreflang="en" href={getAbsoluteLocalizedUrl(cleanPath, 'en')} />
    <link rel="alternate" hreflang="es" href={getAbsoluteLocalizedUrl(cleanPath, 'es')} />
    <link rel="alternate" hreflang="ja" href={getAbsoluteLocalizedUrl(cleanPath, 'ja')} />
    <link rel="alternate" hreflang="fr" href={getAbsoluteLocalizedUrl(cleanPath, 'fr')} />
    <link rel="alternate" hreflang="de" href={getAbsoluteLocalizedUrl(cleanPath, 'de')} />
    <link rel="alternate" hreflang="pt" href={getAbsoluteLocalizedUrl(cleanPath, 'pt')} />
    <link rel="alternate" hreflang="ko" href={getAbsoluteLocalizedUrl(cleanPath, 'ko')} />
    <link rel="alternate" hreflang="it" href={getAbsoluteLocalizedUrl(cleanPath, 'it')} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="DogFoodPlanner.com Nutrition Research Team" />
    
    <!-- Browser-based deep-learning models. They are fetched on demand by the scanner; visitors never install anything. -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0/dist/tf.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3/dist/coco-ssd.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@tensorflow-models/mobilenet@2.1.1/dist/mobilenet.min.js"></script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Dog Food Planner - Free Custom Dog Meal & Nutrition Calculator" />
    <meta property="og:site_name" content="Dog Food Planner" />
    <meta property="og:locale" content={currentLocaleData.ogLocale} />
    {Object.values(localesMap).filter(l => l.code !== lang).map(l => (
      <meta property="og:locale:alternate" content={l.ogLocale} />
    ))}

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@dogfoodplanner" />

    <!-- Performance & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Theme initialization -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Structured Data Schema.org (SoftwareApplication + Organization + FAQPage) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebApplication",
            "@id": "https://dogfoodplanner.com/#app",
            "name": "Dog Food Planner",
            "url": "https://dogfoodplanner.com",
            "applicationCategory": "HealthApplication",
            "operatingSystem": "All Devices (Mobile, Tablet, Desktop)",
            "description": "Free veterinary dog food calculator and custom canine recipe planner. Generates personalized fresh dog food, raw dog food, and puppy food meal recommendations without paid subscriptions.",
            "offers": {
              "@type": "Offer",
              "price": "0.00",
              "priceCurrency": "USD"
            }
          },
          {
            "@type": "Organization",
            "@id": "https://dogfoodplanner.com/#organization",
            "name": "Dog Food Planner",
            "url": "https://dogfoodplanner.com",
            "logo": "https://dogfoodplanner.com/logo.png",
            "sameAs": [
              "https://twitter.com/dogfoodplanner"
            ]
          },
          {
            "@type": "FAQPage",
            "@id": "https://dogfoodplanner.com/#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "What is the best dog food for dogs with sensitive stomachs?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "The best dog foods for sensitive stomach feature single novel protein sources (like lean turkey, salmon, or pasture-raised lamb) combined with soothing soluble fiber (such as organic pure pumpkin puree) and zero artificial binders, corn, wheat, or soy."
                }
              },
              {
                "@type": "Question",
                "name": "How does fresh dog food compare to commercial dry kibble brands?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Fresh dog food contains 70-75% natural biological moisture and less than 4% carbohydrates, compared to commercial dry kibble which is extruded at high temperatures (300°F-400°F) and contains 45-60% starch and grain fillers."
                }
              },
              {
                "@type": "Question",
                "name": "Is this dog food planner really 100% free with no paid subscription?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes! DogFoodPlanner.com provides completely free veterinary calculation tools, macro breakdowns, printable feeding cards, and custom dog food recipes with zero subscription fees, paywalls, or forced delivery sign-ups."
                }
              }
            ]
          }
        ]
      }
    </script>
  </head>
  <body class="bg-[#fafafa] dark:bg-[#0d0d0d] text-[#4d4d4d] dark:text-[#a1a1a1] antialiased selection:bg-[#0070f3] selection:text-white min-h-screen flex flex-col justify-between">
    <slot />
  </body>
</html>
