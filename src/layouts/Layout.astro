---
import '../styles/global.css';
import { getLangFromUrl, cleanPathname, getAbsoluteLocalizedUrl, formatMetaDescription } from '../i18n/utils';
import { localesMap, ui, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  lang?: Lang;
  noindex?: boolean;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const lang: Lang = Astro.props.lang || getLangFromUrl(Astro.url);
const cleanPath = cleanPathname(Astro.url.pathname);

const currentLocaleData = localesMap[lang] || localesMap[defaultLang];
const defaultStrings = ui[lang] || ui[defaultLang];

const {
  title = defaultStrings['meta.title'],
  description = defaultStrings['meta.description'],
  canonicalUrl = getAbsoluteLocalizedUrl(cleanPath, lang),
  ogImage = "https://dogfoodplanner.com/og-image.jpg",
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes = "(max-width: 640px) calc(100vw - 32px), (max-width: 1024px) 90vw, 750px"
} = Astro.props;

const isNoindex = Boolean(Astro.props.noindex || ['/404', '/500', '/print'].includes(cleanPath));

const robotsContent = !isNoindex
  ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  : "noindex, follow";

const finalDescription = formatMetaDescription(description, 160);
---

<!doctype html>
<html lang={lang} dir={currentLocaleData.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    
    <!-- Analytics Stub & Deferred Loader: Queue events immediately with zero render-blocking -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      (function() {
        var loaded = false;
        function loadAnalytics() {
          if (loaded) return;
          loaded = true;

          // Load Google Tag Manager
          var gtm = document.createElement('script');
          gtm.async = true;
          gtm.src = 'https://www.googletagmanager.com/gtag/js?id=G-JVHN8EX00F';
          document.head.appendChild(gtm);
          gtag('config', 'G-JVHN8EX00F');

          // Load Microsoft Clarity
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "yzqnbdqsfu");
        }

        var events = ['scroll', 'touchstart', 'pointerdown', 'keydown'];
        var onInteract = function() {
          loadAnalytics();
          events.forEach(function(e) { window.removeEventListener(e, onInteract); });
        };
        events.forEach(function(e) { window.addEventListener(e, onInteract, { once: true, passive: true }); });

        // Defer idle fallback to prevent competing with LCP and initial user tasks
        window.addEventListener('load', function() {
          var timer = setTimeout(function() {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadAnalytics);
            } else {
              loadAnalytics();
            }
          }, 8500);
          var cancelTimer = function() { clearTimeout(timer); };
          events.forEach(function(e) { window.addEventListener(e, cancelTimer, { once: true, passive: true }); });
        });
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Dog Food Planner" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    
    <!-- Multilingual Hreflang SEO Markup -->
    {!isNoindex && (
      <>
        <link rel="alternate" hreflang="x-default" href={getAbsoluteLocalizedUrl(cleanPath, 'en')} />
        <link rel="alternate" hreflang="en" href={getAbsoluteLocalizedUrl(cleanPath, 'en')} />
        <link rel="alternate" hreflang="es" href={getAbsoluteLocalizedUrl(cleanPath, 'es')} />
        <link rel="alternate" hreflang="ja" href={getAbsoluteLocalizedUrl(cleanPath, 'ja')} />
        <link rel="alternate" hreflang="fr" href={getAbsoluteLocalizedUrl(cleanPath, 'fr')} />
        <link rel="alternate" hreflang="de" href={getAbsoluteLocalizedUrl(cleanPath, 'de')} />
        <link rel="alternate" hreflang="pt" href={getAbsoluteLocalizedUrl(cleanPath, 'pt')} />
        <link rel="alternate" hreflang="ko" href={getAbsoluteLocalizedUrl(cleanPath, 'ko')} />
        <link rel="alternate" hreflang="it" href={getAbsoluteLocalizedUrl(cleanPath, 'it')} />
      </>
    )}

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={finalDescription} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="bingbot" content={robotsContent} />
    <meta name="author" content="Dog Food Planner Editorial Team" />
    
    <!-- Pinterest Verification -->
    <meta name="p:domain_verify" content="37c7f4ff6cbde75ea0963ff781f83070" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Dog Food Planner - Free Custom Dog Meal & Nutrition Calculator" />
    <meta property="og:site_name" content="Dog Food Planner" />
    <meta property="og:locale" content={currentLocaleData.ogLocale} />
    {Object.values(localesMap).filter(l => l.code !== lang).map(l => (
      <meta property="og:locale:alternate" content={l.ogLocale} />
    ))}

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={finalDescription} />
    <meta property="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@dogfoodplanner" />

    <!-- Performance & Fonts: Preconnect & Non-render-blocking Font Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500;600&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500;600&display=swap" />
    </noscript>
    {preloadImage && (
      <link 
        rel="preload" 
        as="image" 
        href={preloadImage} 
        imagesrcset={preloadImageSrcset} 
        imagesizes={preloadImageSrcset ? preloadImageSizes : undefined} 
        fetchpriority="high" 
      />
    )}

    <!-- Theme initialization: Defaults to light mode unless explicitly set to dark -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Structured Data Schema.org (WebSite + WebApplication + Organization) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://dogfoodplanner.com/#website",
            "url": "https://dogfoodplanner.com",
            "name": "Dog Food Planner",
            "alternateName": [
              "Dog Food Planner",
              "DogFoodPlanner",
              "DogFoodPlanner.com"
            ],
            "inLanguage": ["en", "es", "ja", "fr", "de", "pt", "ko", "it"]
          },
          {
            "@type": "WebApplication",
            "@id": "https://dogfoodplanner.com/#app",
            "name": "Dog Food Planner",
            "url": "https://dogfoodplanner.com",
            "applicationCategory": "HealthApplication",
            "operatingSystem": "All Devices (Mobile, Tablet, Desktop)",
            "description": "Free dog feeding calculator and custom canine recipe planner. Generates personalized fresh dog food, raw dog food, and puppy food meal recommendations without paid subscriptions.",
            "offers": {
              "@type": "Offer",
              "price": "0.00",
              "priceCurrency": "USD"
            }
          },
          {
            "@type": "Organization",
            "@id": "https://dogfoodplanner.com/#organization",
            "name": "Dog Food Planner",
            "url": "https://dogfoodplanner.com",
            "logo": "https://dogfoodplanner.com/logo.png",
            "sameAs": [
              "https://twitter.com/dogfoodplanner"
            ]
          }
        ]
      }
    </script>
  </head>
  <body class="bg-[#fafafa] dark:bg-[#0d0d0d] text-[#4d4d4d] dark:text-[#a1a1a1] antialiased selection:bg-[#0070f3] selection:text-white min-h-screen flex flex-col justify-between pb-[env(safe-area-inset-bottom)] overflow-x-clip">
    <slot />
    <script is:inline>
      // ── Site-wide: "Plan Bowl" / #planner-section link handler ──────────────
      // Works from ANY page on the site.
      (function () {
        var NAV_FLAG = 'dfp-navigate-to-planner';

        document.addEventListener('click', function (e) {
          var link = e.target && e.target.closest('a[href*="#planner-section"]');
          if (!link) return;

          var href = link.getAttribute('href') || '';
          var plannerSection  = document.getElementById('planner-section');
          var resultsSection  = document.getElementById('results-section');

          // ── Case 1: We're already on the home page (planner exists in DOM) ──
          if (plannerSection) {
            // Results are showing — scroll to them instead of resetting
            if (resultsSection && !resultsSection.classList.contains('hidden')) {
              e.preventDefault();
              resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            // Planner already visible — let the default anchor scroll happen
            return;
          }

          // ── Case 2: We're on a different page ──
          // If the user already has results saved, navigate home and let the
          // results restore automatically (don't set the reset flag).
          // Only set the reset flag when there are no saved results, so the
          // planner starts fresh at step 1.
          var hasResults = false;
          try { hasResults = !!sessionStorage.getItem('dfp-results-state'); } catch (_) {}

          if (!hasResults) {
            try { sessionStorage.setItem(NAV_FLAG, '1'); } catch (_) {}
          }
          // Let the browser navigate normally (href="/#planner-section")
        });
      })();
    </script>

    <script is:inline>
      (function () {
        const KEY = 'dfp-language-switch-scroll';
        const raw = sessionStorage.getItem(KEY);
        if (!raw) return;

        try {
          const state = JSON.parse(raw);
          if (typeof state?.scrollY !== 'number') return;

          const root = document.documentElement;
          const body = document.body;
          const previousHtmlScrollBehavior = root.style.scrollBehavior;
          const previousBodyScrollBehavior = body.style.scrollBehavior;

          root.style.scrollBehavior = 'auto';
          body.style.scrollBehavior = 'auto';
          window.history.scrollRestoration = 'manual';
          const targetY = state.scrollY;
          window.scrollTo(0, targetY);

          let userInteracted = false;
          const markInteracted = () => { userInteracted = true; };
          window.addEventListener('wheel', markInteracted, { once: true, passive: true });
          window.addEventListener('touchmove', markInteracted, { once: true, passive: true });
          window.addEventListener('keydown', markInteracted, { once: true, passive: true });

          requestAnimationFrame(() => {
            window.scrollTo(0, targetY);
            requestAnimationFrame(() => {
              window.scrollTo(0, targetY);
              root.style.scrollBehavior = previousHtmlScrollBehavior;
              body.style.scrollBehavior = previousBodyScrollBehavior;
              sessionStorage.removeItem(KEY);
            });
          });

          if (document.readyState !== 'complete') {
            window.addEventListener('load', () => {
              if (!userInteracted && Math.abs(window.scrollY - targetY) > 5) {
                window.scrollTo(0, targetY);
              }
            }, { once: true });
          }
        } catch {
          sessionStorage.removeItem(KEY);
        }
      })();
    </script>
  </body>
</html>
