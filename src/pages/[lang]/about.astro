---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import { getLangStaticPaths, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';
import { getPageTranslations } from '../../i18n/pages';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params as { lang: Lang };
const currentStrings = ui[lang] || ui.en;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const p = getPageTranslations(lang).about;
---

<Layout 
  lang={lang}
  title={currentStrings['about.title']}
  description={currentStrings['about.desc']}
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs 
      items={[
        { name: t('nav.brand'), url: translatePath('/') },
        { name: currentStrings['about.title'].split(':')[0] || 'About Us' }
      ]}
    />

    <!-- Header -->
    <section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
          {p.missionBadge}
        </div>
        <h1 class="text-[1.65rem] sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4 text-balance leading-tight">
          {currentStrings['about.title']}
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
          {currentStrings['about.desc']}
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-8 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
      
      <!-- Mission Pillars Card -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
          {p.whyTitle}
        </h2>
        <p>
          {p.whyP1}
        </p>
        <p>
          {p.whyP2}
        </p>
      </section>

      <!-- Methodology Card -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-6">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
          {p.methodTitle}
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {p.pillars.map((pillar, index) => (
            <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] space-y-1.5">
              <div class="font-mono text-xs font-bold text-[#0070f3] dark:text-[#3291ff]">{pillar.tag}</div>
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">{pillar.title}</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">{pillar.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Clinical Disclaimer & Commitment -->
      <div class="p-6 sm:p-8 bg-[#171717] dark:bg-[#1a1a1a] text-white rounded-2xl text-center space-y-4">
        <h3 class="text-xl font-bold text-white dark:text-[#ededed]">
          {p.ctaTitle}
        </h3>
        <p class="text-xs sm:text-sm text-white/80 dark:text-[#a1a1a1] max-w-xl mx-auto">
          {p.ctaDesc}
        </p>
        <div>
          <a href={translatePath('/#planner-section')} class="inline-flex items-center gap-2 px-6 py-2.5 bg-white dark:bg-[#ededed] text-[#171717] hover:bg-[#f2f2f2] text-xs font-bold rounded-full transition-all shadow-sm">
            {p.ctaBtn}
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
