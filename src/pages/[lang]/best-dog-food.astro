---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import Footer from '../../components/Footer.astro';
import { getLangStaticPaths, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params as { lang: Lang };
const currentStrings = ui[lang] || ui.en;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout 
  lang={lang}
  title={currentStrings['bestFood.title']}
  description={currentStrings['bestFood.desc']}
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs 
      items={[
        { name: t('nav.brand'), url: translatePath('/') },
        { name: t('nav.bestDogFood') }
      ]}
    />

    <!-- Header Section -->
    <section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
          <span class="text-[#0070f3]">PILLAR GUIDE</span> // CLINICAL CANINE RANKING 2026
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4">
          {currentStrings['bestFood.title']}
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
          {currentStrings['bestFood.desc']}
        </p>
      </div>
    </section>

    <!-- Main Content Section -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
      
      <!-- Top 5 Rankings Card -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
          What Are the Top 5 Healthiest Dog Foods in 2026?
        </h2>
        <p>
          Canine nutritional longevity research confirms that minimal heat processing and high biological moisture are the two strongest predictors of canine vitality, kidney health, and disease resistance.
        </p>
        
        <div class="space-y-3 mt-4">
          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">1</span>
            <div>
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">Gently Cooked Fresh Dog Food (Homemade or Human-Grade Kitchens)</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                Cooked at 160°F to retain heat-sensitive taurine, vitamins, and natural hydration (70%+). Delivers 90%+ nutrient absorption with zero chemical BHA/BHT preservatives.
              </p>
            </div>
          </div>

          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">2</span>
            <div>
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">Raw BARF Diet (80-10-10 Ancestral Formula)</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                80% muscle meat, 10% edible bone, 10% organ meat (5% liver + 5% secreting organ). Rich in live digestive enzymes, natural chondroitin for joints, and clean teeth maintenance.
              </p>
            </div>
          </div>

          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">3</span>
            <div>
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">Freeze-Dried Raw Dog Food</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                Moisture removed through cold sublimation under vacuum without heat damage. Shelf-stable convenience with raw bio-availability once rehydrated with bone broth or warm water.
              </p>
            </div>
          </div>

          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">4</span>
            <div>
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">Air-Dried / Dehydrated Meat Food</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                Gently dried at low temperatures (140°F) to eliminate pathogens while avoiding extrusion starch binders. Extremely nutrient-dense jerky texture with 40%+ crude protein.
              </p>
            </div>
          </div>

          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">5</span>
            <div>
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">High-Protein, Grain-Free or Ancient Grain Dry Kibble</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                Named animal protein as first 2 ingredients (e.g., deboned salmon, turkey meal). Supplemented with omega-3 EPA/DHA and guaranteed live probiotics. Best when served with warm moisture topper.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Comparison Section -->
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
          Side-by-Side Comparison: Fresh vs Raw vs Dry Kibble
        </h2>
        <ComparisonTable />
      </section>

      <!-- Feeding Calculator CTA Box -->
      <section class="p-6 sm:p-8 rounded-2xl bg-linear-to-r from-blue-600 to-indigo-700 text-white shadow-lg flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center sm:text-left">
          <h3 class="text-lg sm:text-xl font-bold">Ready to calculate exact portions for your dog?</h3>
          <p class="text-xs sm:text-sm text-blue-100 max-w-xl">
            Use our 100% free veterinary calculator to compute precise daily grams, calories (RER/MER), and macro ratios tailored to your dog's breed and life stage.
          </p>
        </div>
        <a 
          href={translatePath('/#planner-section')}
          class="shrink-0 px-6 py-3 rounded-full bg-white text-[#171717] font-semibold text-xs sm:text-sm hover:bg-neutral-100 active:scale-95 transition-all shadow-md"
        >
          {t('nav.planBowl')} →
        </a>
      </section>

      <!-- FAQs -->
      <FaqSection 
        title="Frequently Asked Questions: Dog Food" 
        subtitle="Common questions dog parents ask regarding food selection and transition."
        category="nutrition"
        limit={6}
      />
    </div>
  </main>
  
  <Footer />
</Layout>
