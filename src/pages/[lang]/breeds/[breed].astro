---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FaqSection from '../../../components/FaqSection.astro';
import Footer from '../../../components/Footer.astro';
import { CANINE_BREEDS, type BreedInfo } from '../../../data/breeds';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { ui, type Lang } from '../../../i18n/ui';
import { getPageTranslations } from '../../../i18n/pages';

export function getStaticPaths() {
  const targetLangs: Lang[] = ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'];
  const validBreeds = CANINE_BREEDS.filter(b => !b.name.startsWith('Unknown'));
  return targetLangs.flatMap(lang => 
    validBreeds.map(breed => {
      const slug = breed.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      return {
        params: { lang, breed: slug },
        props: { breed, slug, lang }
      };
    })
  );
}

interface Props {
  breed: BreedInfo;
  slug: string;
  lang: Lang;
}

const { breed, slug, lang } = Astro.props;

if (!breed) {
  return Astro.redirect(`/${lang}/`);
}

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const p = getPageTranslations(lang).breeds;
const interpolate = (value: string, variables: Record<string, string | number>) =>
  value.replace(/\{(\w+)\}/g, (_, key) => String(variables[key] ?? `{${key}}`));

// Calorie & Portion Math for this breed
const avgWeight = (breed.avgWeightLbs[0] + breed.avgWeightLbs[1]) / 2;
const weightKg = avgWeight / 2.20462;
const baseRer = Math.round(70 * Math.pow(weightKg, 0.75));
const dailyCalories = Math.round(baseRer * 1.6 * breed.metabolicFactor);
const freshFoodGramsDaily = Math.round(avgWeight * 453.592 * 0.025);
const freshFoodCups = (freshFoodGramsDaily / 225).toFixed(1);
const kibbleCups = (dailyCalories / 380).toFixed(1);

const titleMap: Record<Lang, (n: string) => string> = {
  en: (n) => `Best Dog Food for ${n}s 2026: Calorie & Feeding Guide | DogFoodPlanner.com`,
  es: (n) => `Mejor Comida para ${n} 2026: Guía de Alimentación y Calorías | DogFoodPlanner.com`,
  ja: (n) => `【2026年】${n}におすすめのドッグフード＆適切な給餌量計算 | DogFoodPlanner.com`,
  fr: (n) => `Meilleure Nourriture pour ${n} 2026 : Ration & Calories | DogFoodPlanner.com`,
  de: (n) => `Bestes Hundefutter für ${n} 2026: Futtermenge & Kalorien | DogFoodPlanner.com`,
  pt: (n) => `Melhor Ração para ${n} 2026: Quantidade Diária e Calorias | DogFoodPlanner.com`,
  ko: (n) => `2026 ${n} 맞춤 추천 사료 및 일일 급여량 가이드 | DogFoodPlanner.com`,
  it: (n) => `Miglior Cibo per ${n} 2026: Guida Alimentare e Fabbisogno | DogFoodPlanner.com`,
};

const descMap: Record<Lang, (n: string, c: number, w0: number, w1: number) => string> = {
  en: (n, c, w0, w1) => `Veterinary nutrition guide for ${n}s. Average weight (${w0}-${w1} lbs), daily calories (~${c} kcal), portion cups, and health predispositions.`,
  es: (n, c, w0, w1) => `Guía veterinaria de alimentación para ${n}. Peso medio (${w0}-${w1} lbs), calorías diarias (~${c} kcal) y porciones de comida recomendadas.`,
  ja: (n, c, w0, w1) => `${n}の獣医師監修フードガイド。平均体重（${w0}〜${w1}ポンド）、推定カロリー（約${c} kcal）、適正な給餌量。`,
  fr: (n, c, w0, w1) => `Guide nutritionnel vétérinaire pour ${n}. Poids moyen (${w0}-${w1} lbs), calories quotidiennes (~${c} kcal) et portions recommandées.`,
  de: (n, c, w0, w1) => `Veterinärmedizinischer Futter-Ratgeber für ${n}. Durchschnittsgewicht (${w0}-${w1} lbs), Tageskalorien (~${c} kcal) und Futterbedarf.`,
  pt: (n, c, w0, w1) => `Guia nutricional para ${n}. Peso médio (${w0}-${w1} lbs), calorias diárias (~${c} kcal) e porções recomendadas.`,
  ko: (n, c, w0, w1) => `${n} 수의 영양 가이드. 평균 체중 (${w0}-${w1} lbs), 일일 권장 칼로리 (~${c} kcal) 및 사료 급여량.`,
  it: (n, c, w0, w1) => `Guida nutrizionale veterinaria per ${n}. Peso medio (${w0}-${w1} lbs), calorie giornaliere (~${c} kcal) e dosi consigliate.`,
};

const pageTitle = (titleMap[lang] || titleMap.en)(breed.name);
const pageDesc = (descMap[lang] || descMap.en)(breed.name, dailyCalories, breed.avgWeightLbs[0], breed.avgWeightLbs[1]);
---

<Layout 
  lang={lang}
  title={pageTitle}
  description={pageDesc}
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs 
      items={[
        { name: t('nav.brand'), url: translatePath('/') },
        { name: p.eyebrow, url: translatePath('/#planner-section') },
        { name: breed.name }
      ]}
    />

    <!-- Hero Section -->
    <section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
          <span class="text-[#0070f3] dark:text-[#3291ff]">🐾</span> {p.eyebrow}
        </div>
        <h1 class="text-[1.65rem] sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4 text-balance leading-tight">
          {pageTitle}
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
          {pageDesc}
        </p>
      </div>
    </section>

    <!-- Breed Nutritional Dashboard -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
      
      <!-- Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="hairline-card p-4 bg-white dark:bg-[#141414] text-center">
          <span class="text-[10px] font-mono text-[#8f8f8f] dark:text-[#737373] uppercase block mb-1">{p.targetWeight}</span>
          <span class="text-lg sm:text-xl font-bold font-mono text-[#171717] dark:text-[#ededed]">{breed.avgWeightLbs[0]} - {breed.avgWeightLbs[1]} lbs</span>
        </div>

        <div class="hairline-card p-4 bg-white dark:bg-[#141414] text-center">
          <span class="text-[10px] font-mono text-[#8f8f8f] dark:text-[#737373] uppercase block mb-1">{p.dailyCalories}</span>
          <span class="text-lg sm:text-xl font-bold font-mono text-[#0070f3] dark:text-[#3291ff]">~{dailyCalories} kcal</span>
        </div>

        <div class="hairline-card p-4 bg-white dark:bg-[#141414] text-center">
          <span class="text-[10px] font-mono text-[#8f8f8f] dark:text-[#737373] uppercase block mb-1">{p.freshDaily}</span>
          <span class="text-lg sm:text-xl font-bold font-mono text-[#10b981]">{freshFoodCups} {p.cups} <span class="text-xs text-[#8f8f8f] dark:text-[#737373]">({freshFoodGramsDaily}g)</span></span>
        </div>

        <div class="hairline-card p-4 bg-white dark:bg-[#141414] text-center">
          <span class="text-[10px] font-mono text-[#8f8f8f] dark:text-[#737373] uppercase block mb-1">{p.kibbleDaily}</span>
          <span class="text-lg sm:text-xl font-bold font-mono text-[#7928ca] dark:text-[#a855f7]">{kibbleCups} {p.cups}</span>
        </div>
      </div>

      <!-- Specific Breed Nutrition Tips -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
          {interpolate(p.reqsTitle, { name: breed.name })}
        </h2>
        <p>
          {interpolate(p.reqsIntro, { category: breed.category, w0: breed.avgWeightLbs[0], w1: breed.avgWeightLbs[1], name: breed.name })}
        </p>

        {breed.predispositions && breed.predispositions.length > 0 && (
          <div class="pt-2">
            <h3 class="text-xs font-mono uppercase font-bold text-[#171717] dark:text-[#ededed] mb-2">{p.predispositionsTitle}</h3>
            <div class="flex flex-wrap gap-2">
              {breed.predispositions.map(p => (
                <span class="px-3 py-1 bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg font-mono text-xs font-semibold text-[#171717] dark:text-[#ededed]">
                  ✓ {p}
                </span>
              ))}
            </div>
          </div>
        )}

        <div class="space-y-3 pt-4 border-t border-[#ebebeb] dark:border-[#262626]">
          <h3 class="font-bold text-sm text-[#171717] dark:text-[#ededed]">{p.feedingRoutineTitle}</h3>
          <p class="text-xs">
            {interpolate(p.feedingRoutineDesc, { name: breed.name })}
          </p>
        </div>
      </section>

      <!-- Interactive Calculator Embed CTA -->
      <div class="p-6 sm:p-8 bg-[#171717] dark:bg-[#141414] border border-[#2e2e2e] text-white rounded-2xl text-center space-y-3 shadow-sm">
        <h3 class="text-xl font-bold text-white dark:text-[#ededed]">
          {interpolate(p.ctaTitle, { name: breed.name })}
        </h3>
        <p class="text-xs sm:text-sm text-white/80 dark:text-[#a1a1a1] max-w-xl mx-auto">
          {p.ctaSubtitle}
        </p>
        <div class="pt-2">
          <a href={translatePath('/feeding-calculator')} class="inline-flex items-center gap-2 px-6 py-2.5 bg-white text-[#171717] text-xs font-bold rounded-full hover:bg-[#f2f2f2] transition-colors shadow-sm">
            {interpolate(p.ctaBtn, { name: breed.name })}
          </a>
        </div>
      </div>

    </div>

    <!-- Related FAQs -->
    <FaqSection 
      title={interpolate(p.faqTitle, { name: breed.name })}
      subtitle={p.faqSubtitle}
      limit={5}
      viewAllLink={true}
    />

  </main>

  <Footer />
</Layout>
