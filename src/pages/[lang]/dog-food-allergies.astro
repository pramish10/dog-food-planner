---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import { getLangStaticPaths, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params as { lang: Lang };
const currentStrings = ui[lang] || ui.en;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout 
  lang={lang}
  title={currentStrings['allergies.title']}
  description={currentStrings['allergies.desc']}
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs 
      items={[
        { name: t('nav.brand'), url: translatePath('/') },
        { name: t('nav.allergies') }
      ]}
    />

    <!-- Header Section -->
    <section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
          <span class="text-[#0070f3]">CLINICAL DERMATOLOGY</span> // CANINE ALLERGIES & DIGESTION
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4">
          {currentStrings['allergies.title']}
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
          {currentStrings['allergies.desc']}
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
      
      <!-- Top Allergens List -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
          The Top 5 Most Common Canine Food Allergens
        </h2>
        <p>
          Canine food allergies are immune-mediated hypersensitivity reactions to specific proteins. In order of prevalence:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-2">
          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626]">
            <span class="text-xl mb-1 block">🍗</span>
            <h3 class="font-bold text-xs text-[#171717] dark:text-[#ededed]">1. Factory Chicken (60% of cases)</h3>
            <p class="text-xs text-[#8f8f8f] dark:text-[#737373] mt-1">Due to heavy overexposure across commercial pet food, chicken is the #1 canine allergen.</p>
          </div>
          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626]">
            <span class="text-xl mb-1 block">🥩</span>
            <h3 class="font-bold text-xs text-[#171717] dark:text-[#ededed]">2. Commercial Beef (30% of cases)</h3>
            <p class="text-xs text-[#8f8f8f] dark:text-[#737373] mt-1">High-antigen meat proteins frequently cause recurrent otitis (ear infections).</p>
          </div>
          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626]">
            <span class="text-xl mb-1 block">🌾</span>
            <h3 class="font-bold text-xs text-[#171717] dark:text-[#ededed]">3. Wheat Gluten & Corn Fillers</h3>
            <p class="text-xs text-[#8f8f8f] dark:text-[#737373] mt-1">Inflammatory grain starches can disrupt the intestinal mucosal lining in sensitive dogs.</p>
          </div>
        </div>
      </section>

      <!-- Solution Section -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
          How Novel Single Proteins Heal Sensitive Stomachs
        </h2>
        <p>
          If your dog exhibits chronic paw licking, red ear flaps, or loose stools, switching to a single novel protein source (such as venison, rabbit, duck, or wild kangaroo) prevents immune recognition, immediately halting histamine cascades.
        </p>
      </section>

      <!-- FAQs -->
      <FaqSection 
        title="Canine Allergies & Digestive FAQs" 
        subtitle="Clinical questions on elimination trials, itchy paws, and sensitive stomach management."
        category="health"
        limit={6}
      />
    </div>
  </main>
  
  <Footer />
</Layout>
