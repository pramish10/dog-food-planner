---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import { getLangStaticPaths, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params as { lang: Lang };
const currentStrings = ui[lang] || ui.en;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout 
  lang={lang}
  title={currentStrings['brands.title']}
  description={currentStrings['brands.desc']}
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs 
      items={[
        { name: t('nav.brand'), url: translatePath('/') },
        { name: t('nav.brands') }
      ]}
    />

    <!-- Header Section -->
    <section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
          <span class="text-[#0070f3]">INDEPENDENT ANALYSIS</span> // BRAND REVIEWS & RECALL LOG
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4">
          {currentStrings['brands.title']}
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
          {currentStrings['brands.desc']}
        </p>
      </div>
    </section>

    <!-- Main Brand Breakdown -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
      
      <!-- Brand 1: Blue Buffalo -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">1. Blue Buffalo Dog Food Review</h2>
          <span class="text-xs font-mono font-bold px-2.5 py-1 bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-800/60 rounded-full">
            Grade: B+
          </span>
        </div>
        <p>
          <strong>Overview:</strong> Meat-first formulas avoiding corn, wheat, and soy. Features cold-formed "LifeSource Bits" containing antioxidants and vitamins.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
          <div class="p-3 bg-green-50/50 dark:bg-green-950/30 border border-green-100 dark:border-green-900/40 rounded-lg">
            <strong class="text-green-800 dark:text-green-300 block mb-1">Pros:</strong>
            <p class="text-xs text-green-900 dark:text-green-200">Real meat is ingredient #1; wide variety of life-stage and limited-ingredient formulas; widely available on Chewy and pet stores.</p>
          </div>
          <div class="p-3 bg-amber-50/50 dark:bg-amber-950/30 border border-amber-100 dark:border-amber-900/40 rounded-lg">
            <strong class="text-amber-800 dark:text-amber-300 block mb-1">Cons & Recalls:</strong>
            <p class="text-xs text-amber-900 dark:text-amber-200">High carbohydrate proportion (45-50%); past recalls regarding elevated moisture/mold and Vitamin D levels.</p>
          </div>
        </div>
      </section>

      <!-- Brand 2: Ollie Fresh Food -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed]">2. Ollie Fresh Dog Food Review</h2>
          <span class="text-xs font-mono font-bold px-2.5 py-1 bg-green-50 dark:bg-green-950/60 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-800/60 rounded-full">
            Grade: A
          </span>
        </div>
        <p>
          <strong>Overview:</strong> Human-grade gently cooked subscription dog food formulated by veterinary nutritionists with visible whole ingredients.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
          <div class="p-3 bg-green-50/50 dark:bg-green-950/30 border border-green-100 dark:border-green-900/40 rounded-lg">
            <strong class="text-green-800 dark:text-green-300 block mb-1">Pros:</strong>
            <p class="text-xs text-green-900 dark:text-green-200">70%+ moisture, zero synthetic food dyes or meat meals; clean single novel proteins like baked lamb or turkey.</p>
          </div>
          <div class="p-3 bg-amber-50/50 dark:bg-amber-950/30 border border-amber-100 dark:border-amber-900/40 rounded-lg">
            <strong class="text-amber-800 dark:text-amber-300 block mb-1">Cons:</strong>
            <p class="text-xs text-amber-900 dark:text-amber-200">Requires freezer storage space; significantly higher monthly cost compared to dry kibble.</p>
          </div>
        </div>
      </section>

      <!-- Comparison Callout -->
      <div class="p-6 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-2xl border border-[#ebebeb] dark:border-[#262626] text-center space-y-3">
        <h3 class="text-base font-bold text-[#171717] dark:text-[#ededed]">
          Want to formulate your own recipes instead of commercial subscription markups?
        </h3>
        <p class="text-xs text-[#8f8f8f] dark:text-[#737373] max-w-lg mx-auto">
          Our free veterinary feeding calculator provides exact NRC macro splits and home recipe blueprints with zero fees.
        </p>
        <a href={translatePath('/#planner-section')} class="inline-block px-5 py-2.5 bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-bold rounded-full hover:bg-[#333333] transition-colors">
          {t('nav.planBowl')} →
        </a>
      </div>

      <!-- FAQs -->
      <FaqSection 
        title="Commercial Dog Food Brand FAQs" 
        subtitle="Common questions regarding recalls, AAFCO label claims, and kibble manufacturing."
        category="nutrition"
        limit={6}
      />
    </div>
  </main>
  
  <Footer />
</Layout>
