---
import LocalizedGuidePage from '../../components/LocalizedGuidePage.astro';
import { getLangStaticPaths } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
export function getStaticPaths() { return getLangStaticPaths(); }
const { lang } = Astro.params as { lang: Lang };
---
<LocalizedGuidePage lang={lang} kind="recipes" titleKey="recipes.title" navKey="nav.recipes" />
