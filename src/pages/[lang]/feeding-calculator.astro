---
import { getLangStaticPaths, useTranslatedPath } from '../../i18n/utils';
import { type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params as { lang: Lang };
const translatePath = useTranslatedPath(lang);

// Redirect /[lang]/feeding-calculator → /[lang]/#planner-section
return Astro.redirect(translatePath('/') + '#planner-section', 301);
---
