---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import IngredientChecker from '../../components/IngredientChecker.astro';
import Footer from '../../components/Footer.astro';
import { getLangStaticPaths, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';

export function getStaticPaths() { return getLangStaticPaths(); }
const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const strings = ui[lang] || ui.en;
---
<Layout
  lang={lang}
  title={strings['toxic.title']}
  description={strings['toxic.desc']}
>
  <Navbar />
  <main class="min-h-screen page-warm-bg">
    <Breadcrumbs items={[{ name: t('nav.brand'), url: translatePath('/') }, { name: t('nav.toxicFoods') }]} />
    <IngredientChecker />
  </main>

<style>
  .page-warm-bg {
    background: linear-gradient(160deg, #fff8f0 0%, #fef3e2 60%, #fff0e6 100%);
  }
  html.dark .page-warm-bg {
    background: linear-gradient(160deg, #150d04 0%, #1c1005 60%, #1a0e04 100%);
  }
</style>
  <Footer />
</Layout>
