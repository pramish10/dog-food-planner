---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import IngredientChecker from '../../components/IngredientChecker.astro';
import Footer from '../../components/Footer.astro';
import { getLangStaticPaths, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { ui, type Lang } from '../../i18n/ui';

export function getStaticPaths() { return getLangStaticPaths(); }
const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const strings = ui[lang] || ui.en;
---
<Layout
  lang={lang}
  title={strings['toxic.title']}
  description={strings['toxic.desc']}
>
  <Navbar />
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs items={[{ name: t('nav.brand'), url: translatePath('/') }, { name: t('nav.toxicFoods') }]} />
    <section class="py-10 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-[10px] sm:text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
          <span class="text-[#ee0000]">☠</span> Ingredient Safety Database
        </div>
        <h1 class="text-[1.65rem] sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4 text-balance leading-tight">
          {strings['toxic.title']}
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
          {strings['toxic.desc']}
        </p>
      </div>
    </section>
    <IngredientChecker />
  </main>
  <Footer />
</Layout>
