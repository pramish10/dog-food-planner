---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSection from '../components/FaqSection.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Footer from '../components/Footer.astro';
import AffiliateButton from '../components/AffiliateButton.astro';


// Top 5 ranking cards — each label matches the exact Amazon product title
const top5BuyLinks = [
  // #1 Fresh Cooked → JustFoodForDogs Pantry Fresh Chicken & White Rice (human-grade, gently cooked)
  { label: 'JustFoodForDogs Pantry Fresh – Chicken & White Rice', url: 'https://amzn.to/4x9327I' },
  // #2 Raw BARF → Stella & Chewy's Freeze-Dried Variety Pack (5 proteins, 80/10/10 patties)
  { label: "Stella & Chewy's Freeze-Dried Raw Variety Pack (5 Proteins)", url: 'https://amzn.to/4gCgdJp' },
  // #3 Premium Kibble → ORIJEN Original Grain-Free WHOLEPREY (85%+ animal, traceable meats)
  { label: 'ORIJEN Grain-Free WHOLEPREY Original Recipe, 23.5lb', url: 'https://amzn.to/4xF5aFr' },
  // #4 Limited Ingredient → Royal Canin Vet Hydrolyzed Protein (single hydrolyzed protein, vet-grade)
  { label: 'Royal Canin Veterinary Hydrolyzed Protein Adult, 25.3lb', url: 'https://amzn.to/4ykV9Nk' },
  // #5 Hybrid Bowl Topper → Brutus Broth Chicken Bone Broth (glucosamine, pour-over topper)
  { label: 'Brutus Broth Chicken Bone Broth – Hip & Joint Topper', url: 'https://amzn.to/4zSd7Zb' },
];

// Life Stage cards — exact product matched to each life stage's nutritional need
const lifeStageLinks = [
  // Puppy: needs DHA + controlled Ca:P → ORIJEN Small Breed (28% protein, DHA, small kibble)
  { label: 'ORIJEN Small Breed Grain-Free, 4lb', url: 'https://amzn.to/3VdZ4gE' },
  // Small Dogs: concentrated calories, small bites → Blue Buffalo Wilderness Chicken 4.5lb (small bag, small kibble)
  { label: 'Blue Buffalo Wilderness Chicken Grain-Free, 4.5lb', url: 'https://amzn.to/4zYiXs0' },
  // Sensitive Stomachs: single hydrolyzed protein, zero corn/wheat/soy → Purina Pro Plan HA
  { label: 'Purina Pro Plan Vet HA Hydrolyzed, 16.5lb', url: 'https://amzn.to/4iOBEIw' },
  // Senior Dogs: glucosamine + lower fat + high moisture → Hill's Science Diet Large Breed 35lb
  { label: "Hill's Science Diet Large Breed Adult, 35lb", url: 'https://amzn.to/3SOmfNW' },
];
---

<Layout 
  title="Best Dog Food 2026: Top Dry, Fresh, Raw & Sensitive Stomach Food | DogFoodPlanner.com"
  description="Comprehensive guide to the best dog food in 2026. Compare human-grade fresh dog food, 80-10-10 raw BARF diets, high-protein dry kibble, and specialized puppy foods."
  canonicalUrl="https://dogfoodplanner.com/best-dog-food"
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs 
      items={[
        { name: 'Home', url: '/' },
        { name: 'Best Dog Food Guide' }
      ]}
    />

    <!-- Header Section -->
    <section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
          <span class="text-[#0070f3]">PILLAR GUIDE</span> // CLINICAL CANINE RANKING 2026
        </div>
        <h1 class="text-[1.65rem] sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4 text-balance leading-tight">
          The Best Dog Food: Veterinary Ranking & Nutritional Analysis
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
          How to select the healthiest, most bioavailable diet for your dog across fresh cooked meals, raw ancestral formulas, and premium dry kibble.
        </p>
      </div>
    </section>

    <!-- Main Content Section -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
      
      <!-- Top 5 Rankings Card -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
          What Are the Top 5 Healthiest Dog Foods in 2026?
        </h2>
        <p>
          Canine nutritional longevity research confirms that minimal heat processing and high biological moisture are the two strongest predictors of canine vitality, kidney health, and disease resistance.
        </p>
        
        <div class="space-y-3 mt-4">
          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">1</span>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">Gently Cooked Fresh Dog Food (Homemade or Human-Grade Kitchens)</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                Cooked at 160°F to retain heat-sensitive taurine, vitamins, and natural hydration (70%+). Delivers 90%+ nutrient absorption with zero chemical BHA/BHT preservatives.
              </p>
              <AffiliateButton url={top5BuyLinks[0].url} label="Buy Now" size="sm" class="mt-2.5" />
            </div>
          </div>

          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">2</span>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">Freeze-Dried / Pathogen-Controlled Raw BARF (80/10/10)</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                80% muscle meat, 10% raw bone, and 10% organ meats. Retains active digestive enzymes for optimal dental plaque scraping and compact stools.
              </p>
              <AffiliateButton url={top5BuyLinks[1].url} label="Buy Now" size="sm" class="mt-2.5" />
            </div>
          </div>

          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">3</span>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">Traceable, Low-Glycemic Dry Kibble with Whole Meats (e.g. Open Farm, Orijen)</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                Utilizes Certified Humane meats, non-GMO produce, and avoids rendered animal by-products and heavy legume fractioning.
              </p>
              <AffiliateButton url={top5BuyLinks[2].url} label="Buy Now" size="sm" class="mt-2.5" />
            </div>
          </div>

          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">4</span>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">Limited Ingredient Diets for Allergies (Novel Single Protein)</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                Utilizes novel proteins (venison, rabbit, duck, wild salmon) with soluble pumpkin fiber to calm gastrointestinal inflammation.
              </p>
              <AffiliateButton url={top5BuyLinks[3].url} label="Buy Now" size="sm" class="mt-2.5" />
            </div>
          </div>

          <div class="p-4 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs shrink-0 mt-0.5">5</span>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-[#171717] dark:text-[#ededed] text-sm">Superfood Hybrid Bowl (Kibble + 20% Fresh Toppers)</h3>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1">
                Adding warm bone broth, pasture-raised egg yolks, and steamed greens to high-tier kibble reduces inflammatory markers by up to 90% cost-effectively.
              </p>
              <AffiliateButton url={top5BuyLinks[4].url} label="Buy Now" size="sm" class="mt-2.5" />
            </div>
          </div>
        </div>
      </section>

      <!-- Kibble vs Fresh Comparison -->
      <ComparisonTable />

      <!-- Best Dog Food by Category -->
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-6">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed]">
          Choosing the Best Food for Your Dog's Specific Life Stage & Needs
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-5 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] space-y-2">
            <h3 class="font-bold text-sm text-[#171717] dark:text-[#ededed] flex items-center gap-1.5">
              <span>🐶</span> Best Puppy Food
            </h3>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Requires 28-32% protein, controlled 1.2:1 to 1.4:1 Calcium-to-Phosphorus ratio (especially for large breeds to prevent hip dysplasia), and DHA for neural cognitive growth.
            </p>
            <AffiliateButton url={lifeStageLinks[0].url} label="Buy Now" size="sm" class="mt-1" />
          </div>

          <div class="p-5 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] space-y-2">
            <h3 class="font-bold text-sm text-[#171717] dark:text-[#ededed] flex items-center gap-1.5">
              <span>🐕</span> Best Food for Small Dogs
            </h3>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              High metabolic burn per pound demands concentrated calories, miniature bite sizes for compact jaws, and steady complex carbs to prevent hypoglycemia.
            </p>
            <AffiliateButton url={lifeStageLinks[1].url} label="Buy Now" size="sm" class="mt-1" />
          </div>

          <div class="p-5 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] space-y-2">
            <h3 class="font-bold text-sm text-[#171717] dark:text-[#ededed] flex items-center gap-1.5">
              <span>🌾</span> Best Food for Sensitive Stomachs
            </h3>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Single novel protein (turkey or lamb), zero corn/wheat/soy, enriched with pure pumpkin puree and soothing wild fish oil for gut mucosal healing.
            </p>
            <AffiliateButton url={lifeStageLinks[2].url} label="Buy Now" size="sm" class="mt-1" />
          </div>

          <div class="p-5 bg-[#fafafa] dark:bg-[#1a1a1a] rounded-xl border border-[#ebebeb] dark:border-[#262626] space-y-2">
            <h3 class="font-bold text-sm text-[#171717] dark:text-[#ededed] flex items-center gap-1.5">
              <span>🦴</span> Best Food for Senior Dogs
            </h3>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
              Higher biological protein to prevent sarcopenia (muscle wasting), lower fat to prevent pancreatitis, glucosamine/chondroitin for joints, and elevated moisture for renal support.
            </p>
            <AffiliateButton url={lifeStageLinks[3].url} label="Buy Now" size="sm" class="mt-1" />
          </div>
        </div>
      </section>

      <!-- Interactive Calculator Embed CTA -->
      <div class="p-6 sm:p-8 bg-[#171717] dark:bg-[#141414] border border-[#2e2e2e] text-white rounded-2xl text-center space-y-3 shadow-sm">
        <h3 class="text-xl font-bold text-white dark:text-[#ededed]">
          Calculate Your Dog's Personalized Bowl Now
        </h3>
        <p class="text-xs sm:text-sm text-white/80 dark:text-[#a1a1a1] max-w-xl mx-auto">
          Get exact daily calories, grams, cups, and macro ratios formulated specifically for your dog's breed and weight.
        </p>
        <div class="pt-2">
          <a href="/feeding-calculator" class="inline-flex items-center gap-2 px-6 py-3 bg-white dark:bg-[#ededed] text-[#171717] hover:bg-[#f2f2f2] dark:hover:bg-white text-xs font-bold rounded-full transition-all shadow-sm">
            Launch Veterinary Calculator →
          </a>
        </div>
      </div>



    </div>

    <!-- Related FAQs for Best Dog Food -->
    <FaqSection 
      title="Best Dog Food FAQs"
      subtitle="Answers to common questions about dog food selection, brands, and feeding choices."
      category="Diet & Nutrition"
      limit={8}
      viewAllLink={true}
    />

  </main>

  <Footer />
</Layout>
