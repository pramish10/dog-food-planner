---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import { CANINE_BREEDS, type BreedInfo } from '../../data/breeds';

export function getStaticPaths() {
  return CANINE_BREEDS
    .filter(b => !b.name.startsWith('Unknown'))
    .map(breed => {
      const slug = breed.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      return {
        params: { breed: slug },
        props: { breed, slug }
      };
    });
}

interface Props {
  breed: BreedInfo;
  slug: string;
}

const { breed } = Astro.props;

if (!breed) {
  return Astro.redirect('/');
}

// Calorie & Portion Math for this breed
const avgWeight = (breed.avgWeightLbs[0] + breed.avgWeightLbs[1]) / 2;
const weightKg = avgWeight / 2.20462;
const baseRer = Math.round(70 * Math.pow(weightKg, 0.75));
const dailyCalories = Math.round(baseRer * 1.6 * breed.metabolicFactor);
const freshFoodGramsDaily = Math.round(avgWeight * 453.592 * 0.025);
const freshFoodCups = (freshFoodGramsDaily / 225).toFixed(1);
const kibbleCups = (dailyCalories / 380).toFixed(1);
---

<Layout 
  title={`Best Dog Food for ${breed.name}s 2026: Calorie & Feeding Guide | DogFoodPlanner.com`}
  description={`Veterinary nutrition guide for ${breed.name}s. Average weight (${breed.avgWeightLbs[0]}-${breed.avgWeightLbs[1]} lbs), daily calories (~${dailyCalories} kcal), portion cups, and health predispositions.`}
  canonicalUrl={`https://dogfoodplanner.com/breeds/${Astro.params.breed}`}
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa]">
    <Breadcrumbs 
      items={[
        { name: 'Home', url: '/' },
        { name: 'Breeds Guide', url: '/#planner-section' },
        { name: `${breed.name} Food Guide` }
      ]}
    />

    <!-- Hero Section -->
    <section class="py-12 sm:py-16 bg-white border-b border-[#ebebeb]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] bg-[#fafafa] border border-[#ebebeb] px-3 py-1 rounded-full mb-3 shadow-2xs">
          <span class="text-[#0070f3]">🐾</span> BREED NUTRITION // {breed.category.toUpperCase()} CANINE
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#171717] tracking-tight mb-4">
          Best Dog Food & Feeding Guide for {breed.name}s
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] max-w-2xl mx-auto leading-relaxed">
          Veterinary metabolic guidelines, exact daily calories, portion sizes, and key dietary predispositions for {breed.name}s.
        </p>
      </div>
    </section>

    <!-- Breed Nutritional Dashboard -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10 text-xs sm:text-sm text-[#4d4d4d] leading-relaxed">
      
      <!-- Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="hairline-card p-4 bg-white text-center">
          <span class="text-[10px] font-mono text-[#8f8f8f] uppercase block mb-1">Target Weight</span>
          <span class="text-lg sm:text-xl font-bold font-mono text-[#171717]">{breed.avgWeightLbs[0]} - {breed.avgWeightLbs[1]} lbs</span>
        </div>

        <div class="hairline-card p-4 bg-white text-center">
          <span class="text-[10px] font-mono text-[#8f8f8f] uppercase block mb-1">Daily Calories</span>
          <span class="text-lg sm:text-xl font-bold font-mono text-[#0070f3]">~{dailyCalories} kcal</span>
        </div>

        <div class="hairline-card p-4 bg-white text-center">
          <span class="text-[10px] font-mono text-[#8f8f8f] uppercase block mb-1">Fresh Food Daily</span>
          <span class="text-lg sm:text-xl font-bold font-mono text-[#10b981]">{freshFoodCups} cups <span class="text-xs text-[#8f8f8f]">({freshFoodGramsDaily}g)</span></span>
        </div>

        <div class="hairline-card p-4 bg-white text-center">
          <span class="text-[10px] font-mono text-[#8f8f8f] uppercase block mb-1">Kibble Daily</span>
          <span class="text-lg sm:text-xl font-bold font-mono text-[#7928ca]">{kibbleCups} cups</span>
        </div>
      </div>

      <!-- Specific Breed Nutrition Tips -->
      <section class="hairline-card p-6 sm:p-8 bg-white space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717]">
          Nutritional Requirements for {breed.name}s
        </h2>
        <p>
          As a <strong>{breed.category}</strong> dog with an average weight of {breed.avgWeightLbs[0]}–{breed.avgWeightLbs[1]} lbs, the {breed.name} requires a tailored nutrient ratio:
        </p>

        {breed.predispositions && breed.predispositions.length > 0 && (
          <div class="pt-2">
            <h3 class="text-xs font-mono uppercase font-bold text-[#171717] mb-2">Key Health & Dietary Predispositions:</h3>
            <div class="flex flex-wrap gap-2">
              {breed.predispositions.map(p => (
                <span class="px-3 py-1 bg-[#fafafa] border border-[#ebebeb] rounded-lg font-mono text-xs font-semibold text-[#171717]">
                  ✓ {p}
                </span>
              ))}
            </div>
          </div>
        )}

        <div class="space-y-3 pt-4 border-t border-[#ebebeb]">
          <h3 class="font-bold text-sm text-[#171717]">Feeding Routine Recommendation:</h3>
          <p class="text-xs">
            Feed your adult {breed.name} <strong>twice daily</strong> (50% in the morning and 50% in the evening). Always ensure clean filtered water is available. If feeding dry kibble, rehydrate with warm bone broth or water to support kidney longevity.
          </p>
        </div>
      </section>

      <!-- Interactive Calculator Embed CTA -->
      <div class="hairline-card p-6 sm:p-8 bg-[#171717] text-white rounded-2xl text-center space-y-3">
        <h3 class="text-xl font-bold text-white">
          Customize Your {breed.name}'s Exact Meal Plan
        </h3>
        <p class="text-xs text-white/80 max-w-xl mx-auto">
          Adjust for your dog's exact age (puppy, adult, senior), exact weight, activity level, and body condition score with our free calculator.
        </p>
        <div class="pt-2">
          <a href="/feeding-calculator" class="inline-flex items-center gap-2 px-6 py-2.5 bg-white text-[#171717] text-xs font-bold rounded-full hover:bg-[#f2f2f2] transition-colors shadow-sm">
            Launch {breed.name} Calculator →
          </a>
        </div>
      </div>

    </div>

    <!-- Related FAQs -->
    <FaqSection 
      title={`Common Feeding FAQs for ${breed.name}s`}
      subtitle={`Answers to portion questions, feeding frequency, and best foods.`}
      limit={5}
      viewAllLink={true}
    />

  </main>

  <Footer />
</Layout>
