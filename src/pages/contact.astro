---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Contact Us | DogFoodPlanner.com"
  description="Get in touch with the DogFoodPlanner canine nutrition team. Send feedback, suggest recipes, report bugs, or ask nutrition methodology questions."
  canonicalUrl="https://dogfoodplanner.com/contact"
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs 
      items={[
        { name: 'Home', url: '/' },
        { name: 'Contact Us' }
      ]}
    />

    <!-- Header -->
    <section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
          <span class="text-[#0070f3]">SUPPORT & FEEDBACK</span> // DIRECT INQUIRIES
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4">
          Get in Touch With Our Team
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
          Have a canine nutrition inquiry, recipe suggestion, or breed scanner feedback? We'd love to hear from you.
        </p>
      </div>
    </section>

    <!-- Main Contact Area -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Contact Information Cards (1 Col) -->
        <div class="space-y-4">
          <div class="hairline-card p-5 bg-white dark:bg-[#141414] space-y-2">
            <div class="text-lg">📧</div>
            <h3 class="font-bold text-sm text-[#171717] dark:text-[#ededed]">Email Inquiries</h3>
            <p class="text-xs text-[#8f8f8f] dark:text-[#737373]">General questions & feedback:</p>
            <p class="font-mono text-xs text-[#0070f3] dark:text-[#3291ff]">hello@dogfoodplanner.com</p>
          </div>

          <div class="hairline-card p-5 bg-white dark:bg-[#141414] space-y-2">
            <div class="text-lg">🐾</div>
            <h3 class="font-bold text-sm text-[#171717] dark:text-[#ededed]">Nutrition Research</h3>
            <p class="text-xs text-[#8f8f8f] dark:text-[#737373]">Veterinary formula inquiries:</p>
            <p class="font-mono text-xs text-[#10b981]">clinical@dogfoodplanner.com</p>
          </div>

          <div class="hairline-card p-5 bg-white dark:bg-[#141414] space-y-2">
            <div class="text-lg">🛡️</div>
            <h3 class="font-bold text-sm text-[#171717] dark:text-[#ededed]">Privacy & Terms</h3>
            <p class="text-xs text-[#8f8f8f] dark:text-[#737373]">Data protection questions:</p>
            <p class="font-mono text-xs text-[#7928ca] dark:text-[#a35cf0]">privacy@dogfoodplanner.com</p>
          </div>
        </div>

        <!-- Contact Form (2 Cols) -->
        <div class="md:col-span-2">
          <div class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414]">
            <h2 class="text-xl font-bold text-[#171717] dark:text-[#ededed] mb-1">
              Send a Message
            </h2>
            <p class="text-xs text-[#8f8f8f] dark:text-[#737373] mb-6">
              Our nutrition team typically reviews and replies to all messages within 24–48 business hours.
            </p>

            <form id="contact-form" onsubmit="return false;" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-name" class="block text-xs font-mono uppercase font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">
                    Your Name
                  </label>
                  <input 
                    type="text" 
                    id="contact-name" 
                    required 
                    placeholder="e.g. Sarah Jenkins"
                    class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] transition-all"
                  />
                </div>
                <div>
                  <label for="contact-email" class="block text-xs font-mono uppercase font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">
                    Your Email
                  </label>
                  <input 
                    type="email" 
                    id="contact-email" 
                    required 
                    placeholder="sarah@example.com"
                    class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] transition-all"
                  />
                </div>
              </div>

              <div>
                <label for="contact-subject" class="block text-xs font-mono uppercase font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">
                  Subject / Topic
                </label>
                <select 
                  id="contact-subject"
                  class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed]"
                >
                  <option value="calculator">Canine Nutrition Calculator Feedback</option>
                  <option value="breed-scanner">AI Dog Breed Scanner Question / Accuracy</option>
                  <option value="recipe">Homemade Recipe & Macro Suggestion</option>
                  <option value="brand">Pet Food Brand Review / Recall Update</option>
                  <option value="other">General Inquiries & Other</option>
                </select>
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-mono uppercase font-semibold text-[#171717] dark:text-[#ededed] mb-1.5">
                  Your Message
                </label>
                <textarea 
                  id="contact-message" 
                  rows="5" 
                  required 
                  placeholder="Tell us how we can help you and your dog..."
                  class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-lg text-[#171717] dark:text-[#ededed] focus:outline-none focus:border-[#171717] dark:focus:border-[#ededed] transition-all resize-none"
                ></textarea>
              </div>

              <div id="contact-success-msg" class="hidden p-3 bg-[#10b981]/10 border border-[#10b981]/30 text-[#10b981] text-xs rounded-lg font-mono">
                ✓ Thank you! Your message has been received. Our team will get back to you shortly.
              </div>

              <button 
                type="submit" 
                id="submit-contact-btn"
                class="w-full sm:w-auto px-6 py-2.5 bg-[#171717] dark:bg-white text-white dark:text-[#171717] hover:bg-[#333333] dark:hover:bg-[#e5e5e5] text-xs font-semibold rounded-full transition-all cursor-pointer shadow-sm"
              >
                Send Message →
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('contact-success-msg');
  const submitBtn = document.getElementById('submit-contact-btn');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.textContent = 'Sending...';
      setTimeout(() => {
        if (successMsg) successMsg.classList.remove('hidden');
        if (submitBtn) submitBtn.textContent = 'Message Sent ✓';
        form.reset();
      }, 700);
    }
  });
</script>
