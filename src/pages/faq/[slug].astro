---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import { FAQS_DATA, getFaqBySlug } from '../../data/faqs';
import { findBrandMatchInText } from '../../data/affiliates';
import AffiliateButton from '../../components/AffiliateButton.astro';

export function getStaticPaths() {
  return FAQS_DATA.map(faq => ({
    params: { slug: faq.slug },
    props: { faq }
  }));
}

const { faq } = Astro.props;

if (!faq) {
  return Astro.redirect('/faq');
}

