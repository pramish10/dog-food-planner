---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import { FAQS_DATA, getFaqBySlug } from '../../data/faqs';
import { findBrandMatchInText } from '../../data/affiliates';
import AffiliateButton from '../../components/AffiliateButton.astro';

export function getStaticPaths() {
  return FAQS_DATA.map(faq => ({
    params: { slug: faq.slug },
    props: { faq }
  }));
}

const { faq } = Astro.props;

if (!faq) {
  return Astro.redirect('/faq');
}

// ─── Curated product placements ───────────────────────────────────────────────
// Only shown on FAQs where a product directly solves the question being asked.
// Knowledge is the priority — products appear only when they are the natural
// next step after reading the answer (e.g. "how to make homemade food" → calcium).
// Most FAQs (digestion time, definitions, safety info) show NO product at all.

type FaqProduct = { label: string; note: string; url: string };

const FAQ_PRODUCTS: Record<string, FaqProduct> = {

  // ── ACTIONABLE: product is the direct next step after reading the answer ──

  // "What is the #1 best dog food?" → answer says fresh cooked is #1 → JustFoodForDogs is that product
  'what-is-the-1-best-dog-food': {
    label: 'JustFoodForDogs Pantry Fresh – Chicken & White Rice (Pack of 24)',
    note: 'Human-grade, gently cooked in a USDA-inspected kitchen — the category ranked #1 in the longevity research above.',
    url: 'https://amzn.to/4x9327I',
  },

  // "How to make homemade dog food?" → calcium is the #1 missing nutrient in any boneless recipe
  'how-to-make-homemade-dog-food': {
    label: 'U.S.A. Eggshell Powder, 8oz — Calcium Supplement',
    note: 'Add ½ tsp per pound of boneless meat to hit the 1.2:1 Ca:P ratio — the most critical step described above.',
    url: 'https://amzn.to/4haNVWy',
  },

  // "Is homemade dog food healthy?" → answer warns calcium deficiency is the main risk → eggshell powder is the fix
  'is-homemade-dog-food-healthy': {
    label: 'U.S.A. Eggshell Powder, 8oz — Calcium Supplement',
    note: 'The calcium supplement referenced above — prevents the bone demineralization risk of unsupplemented homemade diets.',
    url: 'https://amzn.to/4haNVWy',
  },

  // "What is a raw food diet (BARF)?" → freeze-dried is the safest, most accessible entry point
  'raw-food-diet-for-dogs': {
    label: "Stella & Chewy's Freeze-Dried Raw Dinner Patties – Variety Pack (5 Proteins)",
    note: 'HPP pathogen-controlled freeze-dried raw — the safest way to start BARF without sourcing and handling raw meat yourself.',
    url: 'https://amzn.to/4gCgdJp',
  },

  // "What is the 80-10-10 rule?" → answer explains organs are 10% → organ meat product is exactly what's needed
  'what-is-the-80-10-10-rule-for-dog-food': {
    label: "Stella & Chewy's Freeze-Dried Raw Beef Meal Mixers – 95% Grass-Fed Beef, Organs & Bone, 1oz",
    note: 'Contains the muscle meat, organ, and raw bone ratio the 80/10/10 rule describes — use as a complete meal or topper.',
    url: 'https://amzn.to/4gyO85G',
  },

  // "Best dog food for allergies?" → vet hydrolyzed diet is the clinical gold standard named in the answer
  'what-is-the-best-dog-food-for-allergies': {
    label: 'Royal Canin Veterinary Diet Hydrolyzed Protein Adult, 25.3lb',
    note: 'Vet-grade hydrolyzed protein — the elimination diet option described in step 2 of the protocol above.',
    url: 'https://amzn.to/4ykV9Nk',
  },

  // "Dog not eating food but eats treats?" → bone broth topper is the exact fix the answer recommends
  'why-is-my-dog-not-eating-his-food-but-will-eat-treats': {
    label: 'Brutus Broth Chicken Bone Broth – Hip & Joint Meal Topper, 16.9 fl oz',
    note: 'Warm bone broth over kibble is the first step the answer recommends — adds aroma and moisture without rewarding refusal.',
    url: 'https://amzn.to/4zSd7Zb',
  },

  // "Best dry dog food?" → Orijen is the top brand explicitly named in the answer
  'what-is-the-best-dry-dog-food': {
    label: 'ORIJEN Grain-Free WHOLEPREY Dry Dog Food Original Recipe, 23.5lb',
    note: 'The top-rated traceable kibble named in the answer — 85%+ animal inclusions, baked not extruded, no rendered by-products.',
    url: 'https://amzn.to/4xF5aFr',
  },

  // "Best dog food to feed daily?" → salmon oil is the omega-3 topper named in the Hybrid Bowl answer
  'what-is-the-best-dog-food-to-feed-your-dog': {
    label: 'Zesty Paws Wild Alaskan Salmon Oil for Dogs & Cats, 16oz',
    note: 'The EPA/DHA omega-3 oil referenced in the Hybrid Bowl formula above — add 1 tsp per 20 lbs of body weight daily.',
    url: 'https://amzn.to/46HCJdW',
  },

  // "Can dogs live on dry food only?" → answer says add bone broth for hydration — that's the actionable step
  'can-dogs-live-on-dry-food-only': {
    label: 'Brutus Broth Chicken Bone Broth – Hip & Joint Meal Topper, 16.9 fl oz',
    note: 'The answer recommends rehydrating kibble with warm bone broth to protect kidney function — this is that product.',
    url: 'https://amzn.to/4zSd7Zb',
  },

  // "What is the best natural dog food?" → answer recommends air-dried as the closest to natural → ZIWI Peak
  'what-is-the-best-natural-dog-food': {
    label: 'ZIWI Peak Air-Dried Dog Food – Beef (16oz) + Chicken (16oz) Bundle',
    note: 'Air-dried at low temperature to preserve natural enzymes — the minimally processed format the answer describes.',
    url: 'https://amzn.to/4gRp8FA',
  },

  // "What are the top 5 healthiest dog foods?" → answer ranks fresh cooked #1 → JustFoodForDogs
  'what-are-the-top-5-healthiest-dog-food': {
    label: 'JustFoodForDogs Pantry Fresh – Chicken & White Rice (Pack of 24)',
    note: 'Human-grade gently cooked — the #1 ranked category in the list above, made in a USDA-inspected kitchen.',
    url: 'https://amzn.to/4x9327I',
  },

  // "What is the best diet for dogs?" → answer recommends salmon oil as the essential omega-3 supplement
  'what-is-the-best-diet-for-dogs': {
    label: 'Zesty Paws Wild Alaskan Salmon Oil for Dogs & Cats, 16oz',
    note: 'The omega-3 supplement the answer recommends adding to any diet — EPA/DHA for coat, joints, and inflammation.',
    url: 'https://amzn.to/46HCJdW',
  },

  // "Should I feed wet or dry food?" → answer recommends bone broth to rehydrate dry kibble
  'should-i-feed-my-dog-wet-or-dry-food': {
    label: 'The Honest Kitchen Bone Broth Pour Overs – Variety Pack of 3, 5.5oz',
    note: 'The answer recommends adding moisture to dry kibble — these pour-over broths are the easiest way to do that.',
    url: 'https://amzn.to/4zZ68xK',
  },
};

// Brand-review FAQs: show the brand's own product (existing logic)
const faqBlob = `${faq.question} ${faq.shortAnswer} ${faq.tags.join(' ')}`;
const brandCtx = faq.category === 'Brand Reviews & Safety'
  ? findBrandMatchInText(faqBlob)
  : null;

// Curated product for this specific FAQ (null for most FAQs)
const curatedProduct: FaqProduct | null = FAQ_PRODUCTS[faq.slug] ?? null;

// Resolved product — single source used in the template (curated takes priority over brand)
const resolvedProduct: FaqProduct | null = curatedProduct
  ?? (brandCtx ? { label: brandCtx.product.name, note: `${brandCtx.brand} — the product reviewed and referenced above.`, url: brandCtx.product.url } : null);

// Find related FAQs
const relatedFaqs = (faq.relatedSlugs || [])
  .map(slug => getFaqBySlug(slug))
  .filter((f): f is NonNullable<typeof f> => f !== undefined)
  .slice(0, 3);

// Fallback related if none explicitly defined
const fallbackRelated = FAQS_DATA
  .filter(f => f.category === faq.category && f.id !== faq.id)
  .slice(0, 3);

const finalRelated = relatedFaqs.length > 0 ? relatedFaqs : fallbackRelated;

// Single FAQ Schema.org JSON-LD
const singleFaqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${faq.shortAnswer} ${faq.fullAnswerHtml.replace(/<[^>]*>?/gm, ' ').replace(/\s+/g, ' ').trim()}`
      }
    }
  ]
};

// Article Schema for rich results
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": faq.question,
  "description": faq.shortAnswer,
  "author": {
    "@type": "Organization",
    "name": "Dog Food Planner Nutrition Team",
    "url": "https://dogfoodplanner.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dog Food Planner",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dogfoodplanner.com/logo.png"
    }
  },
  "mainEntityOfPage": `https://dogfoodplanner.com/faq/${faq.slug}`
};
---

<Layout 
  title={`${faq.question} | Veterinary Canine Answer`}
  description={faq.shortAnswer}
  canonicalUrl={`https://dogfoodplanner.com/faq/${faq.slug}`}
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs 
      items={[
        { name: 'Home', url: '/' },
        { name: 'Dog Food FAQs', url: '/faq' },
        { name: faq.question }
      ]}
    />

    <!-- Article & Q&A Container -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
      
      <!-- Article Header -->
      <header class="mb-8">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-[#0070f3] dark:text-[#3291ff] bg-blue-50 dark:bg-blue-950/60 border border-blue-100 dark:border-blue-900/60 px-3 py-1 rounded-full mb-3">
          <span>{faq.category}</span>
        </div>
        <h1 class="text-[1.35rem] sm:text-3xl lg:text-4xl font-bold text-[#171717] dark:text-[#ededed] tracking-tight mb-4 leading-tight text-balance">
          {faq.question}
        </h1>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[#8f8f8f] dark:text-[#737373] font-mono border-b border-[#ebebeb] dark:border-[#262626] pb-4">
          <span>Reviewed by: <strong>Veterinary Canine Nutritionist</strong></span>
          <span>•</span>
          <span>Updated: {new Date().getFullYear()}</span>
        </div>
      </header>

      <!-- Highlighted Direct Answer Callout -->
      <div class="p-5 sm:p-6 bg-white dark:bg-[#141414] rounded-2xl border-2 border-[#171717] dark:border-[#ededed] shadow-sm mb-8">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
            ✓
          </div>
          <div>
            <h2 class="text-xs font-mono uppercase font-bold text-[#171717] dark:text-[#ededed] mb-1">
              Direct Quick Answer
            </h2>
            <p class="text-sm sm:text-base text-[#171717] dark:text-[#ededed] leading-relaxed font-medium">
              {faq.shortAnswer}
            </p>
          </div>
        </div>
      </div>

      <!-- In-Depth Clinical Explanation -->
      <article class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] mb-10 prose prose-neutral dark:prose-invert max-w-none text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed space-y-4">
        <h2 class="text-lg sm:text-xl font-bold text-[#171717] dark:text-[#ededed] border-b border-[#ebebeb] dark:border-[#262626] pb-3 mb-4">
          Detailed Nutritional & Clinical Analysis
        </h2>
        <div class="space-y-4" set:html={faq.fullAnswerHtml} />

        {/* Product — lives inside the article card, flush with the answer above it */}
        {resolvedProduct && (
          <div class="not-prose mt-6 pt-5 border-t border-[#ebebeb] dark:border-[#262626] flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <p class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373] mb-1">Referenced in this answer</p>
              <p class="text-sm font-semibold text-[#171717] dark:text-[#ededed] leading-snug mb-1">{resolvedProduct.label}</p>
              <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">{resolvedProduct.note}</p>
            </div>
            <AffiliateButton url={resolvedProduct.url} label="Buy Now" size="sm" class="shrink-0 mt-1" />
          </div>
        )}

        <!-- Tags / Topics -->
        <div class="pt-6 border-t border-[#ebebeb] dark:border-[#262626] flex flex-wrap items-center gap-1.5 not-prose">
          <span class="text-xs font-mono text-[#8f8f8f] dark:text-[#737373] mr-1">Topics:</span>
          {faq.tags.map(tag => (
            <span class="px-2 py-0.5 text-[11px] font-mono bg-[#fafafa] dark:bg-[#1a1a1a] text-[#4d4d4d] dark:text-[#a1a1a1] border border-[#ebebeb] dark:border-[#2e2e2e] rounded-md">
              #{tag}
            </span>
          ))}
        </div>
      </article>

      <!-- Interactive Calculator Call-to-Action -->
      <div class="p-6 sm:p-8 bg-gradient-to-br from-[#171717] to-[#333333] border border-[#2e2e2e] text-white rounded-2xl mb-12 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="space-y-2 text-center sm:text-left">
          <div class="inline-flex items-center gap-1 text-[11px] font-mono text-[#10b981] uppercase tracking-wider font-semibold">
            <span>🐾</span> Free Canine Nutrition Engine
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-white">
            Calculate Exact Daily Calories & Meal Portions For Your Dog
          </h3>
          <p class="text-xs text-white/80 max-w-lg">
            Use our free veterinary calculator to determine your dog's exact metabolic burn (RER/MER) and get custom fresh or raw food recipe grams.
          </p>
        </div>
        <a 
          href="/feeding-calculator" 
          class="shrink-0 px-6 py-3 bg-white text-[#171717] hover:bg-[#f2f2f2] text-xs font-bold rounded-full transition-all shadow-md active:scale-95"
        >
          Calculate Portions Now →
        </a>
      </div>

      <!-- Related Questions Section -->
      {finalRelated.length > 0 && (
        <section class="border-t border-[#ebebeb] dark:border-[#262626] pt-10">
          <h3 class="text-base sm:text-lg font-bold text-[#171717] dark:text-[#ededed] tracking-tight mb-4">
            Related Canine Nutrition Questions
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {finalRelated.map(related => (
              <a 
                href={`/faq/${related.slug}`} 
                class="hairline-card p-4 bg-white dark:bg-[#141414] hover:border-[#171717] dark:hover:border-[#ededed] transition-all flex flex-col justify-between group"
              >
                <div>
                  <span class="text-[10px] font-mono text-[#0070f3] dark:text-[#3291ff] uppercase font-semibold mb-1 block">
                    {related.category}
                  </span>
                  <h4 class="font-medium text-xs text-[#171717] dark:text-[#ededed] group-hover:text-[#0070f3] dark:group-hover:text-[#3291ff] transition-colors leading-snug line-clamp-3 mb-2">
                    {related.question}
                  </h4>
                </div>
                <span class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] group-hover:text-[#171717] dark:group-hover:text-white transition-colors mt-2">
                  Read Answer →
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Back to FAQ Directory -->
      <div class="mt-10 text-center">
        <a 
          href="/faq" 
          class="inline-flex items-center gap-1.5 text-xs font-mono text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white transition-colors underline"
        >
          ← Back to All 40+ Dog Food FAQs
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<!-- JSON-LD FAQPage & Article Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(singleFaqJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
