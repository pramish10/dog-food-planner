---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PlannerQuiz from '../components/PlannerQuiz.astro';
import PlanResults from '../components/PlanResults.astro';
import IngredientChecker from '../components/IngredientChecker.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Best Dog Food & Free Custom Meal Planner 2026 | DogFoodPlanner.com"
  description="Calculate the best dog food, fresh dog food recipes, and raw BARF formulas tailored for your puppy, adult, or sensitive stomach dog. 100% free veterinary canine nutrition tool."
>
  <Navbar />
  <main>
    <Hero />
    <PlannerQuiz />
    <PlanResults />
    <IngredientChecker />
    <FaqSection 
      title="Frequently Asked Questions" 
      subtitle="Quick veterinary answers to top questions on portion sizing, canine diets, and toxic foods."
      limit={8}
      showCategories={true}
      showSearch={true}
      viewAllLink={true}
    />
  </main>
  <Footer />
</Layout>
