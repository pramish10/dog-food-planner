---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PlannerQuiz from '../components/PlannerQuiz.astro';
import PlanResults from '../components/PlanResults.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';

const currentStrings = ui['en'];
---

<Layout 
  title={currentStrings['meta.title']}
  description={currentStrings['meta.description']}
  keywords={currentStrings['meta.keywords']}
>
  <Navbar />
  <main>
    <Hero />
    <PlannerQuiz />
    <PlanResults />
  </main>
  <Footer />
</Layout>

