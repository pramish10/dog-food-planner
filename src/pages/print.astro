---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Print Canine Nutrition Card — Dog Food Planner">
  <div class="max-w-3xl mx-auto p-6 sm:p-8 bg-white border-2 border-black my-6 rounded-2xl font-sans text-black shadow-lg print:shadow-none print:border-2 print:my-0 print:p-6 print:max-w-full">
    <div class="flex items-center justify-between pb-4 border-b-2 border-black">
      <div>
        <h1 class="text-2xl font-black font-mono tracking-tight">DOG FOOD PLANNER // MEAL CARD</h1>
        <p class="text-xs sm:text-sm font-medium text-gray-700 mt-0.5">Standard NRC / AAFCO Canine Macronutrient Formulation</p>
      </div>
      <div class="text-right font-mono text-sm shrink-0">
        <div class="font-bold text-[#c47a2b]">dogfoodplanner.com</div>
        <div class="text-gray-600 text-xs mt-0.5">Date: {new Date().toLocaleDateString()}</div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-5 p-5 bg-amber-50/40 border border-amber-200 rounded-xl text-sm print:bg-gray-50 print:border-black">
      <div class="space-y-2">
        <div><strong class="font-bold">Dog:</strong> Lucy (Mixed Breed)</div>
        <div><strong class="font-bold">Life Stage:</strong> Adult (Spayed Female)</div>
        <div><strong class="font-bold">Weight:</strong> 45 lbs (20.4 kg)</div>
      </div>
      <div class="space-y-2">
        <div><strong class="font-bold">Daily Calories:</strong> 984 kcal/day (MER)</div>
        <div><strong class="font-bold">Daily Fresh Portion:</strong> 728 grams (≈ 3.2 cups)</div>
        <div><strong class="font-bold">Split:</strong> 364g per bowl (2x Daily)</div>
      </div>
    </div>

    <div class="mb-5">
      <h2 class="text-sm font-bold uppercase font-mono mb-2.5 tracking-wide flex items-center justify-between">
        <span>Recipe: Gently Cooked Lean Turkey & Pumpkin Feast</span>
        <span class="text-xs text-gray-600 font-normal">Batch Target: 1,000g</span>
      </h2>
      <ul id="print-recipe-items" class="text-sm divide-y divide-gray-200 border-2 border-black rounded-xl overflow-hidden">
        <li class="p-3 sm:p-3.5 flex justify-between bg-white items-center">
          <a href="https://link.amazon/B0fpxfvVg" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-black underline decoration-black decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
            USDA Lean Ground Turkey (93/7)
          </a>
          <span class="font-mono font-bold">473g</span>
        </li>
        <li class="p-3 sm:p-3.5 flex justify-between bg-gray-50 items-center">
          <a href="https://link.amazon/B0fpxfvVg" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-black underline decoration-black decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
            Organic Turkey Hearts & Gizzards
          </a>
          <span class="font-mono font-bold">73g</span>
        </li>
        <li class="p-3 sm:p-3.5 flex justify-between bg-white items-center">
          <a href="https://link.amazon/B06zoxxSD" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-black underline decoration-black decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
            Pure Organic Pumpkin Puree
          </a>
          <span class="font-mono font-bold">73g</span>
        </li>
        <li class="p-3 sm:p-3.5 flex justify-between bg-gray-50 items-center">
          <a href="https://www.amazon.com/s?k=healthy+veggie+mix+for+dogs&tag=dogfoodplanner-20" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-black underline decoration-black decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
            Baby Spinach & Steamed Zucchini
          </a>
          <span class="font-mono font-bold">58g</span>
        </li>
        <li class="p-3 sm:p-3.5 flex justify-between bg-white items-center">
          <a href="https://link.amazon/B02zrZWPG" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-black underline decoration-black decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
            Wild Alaskan Salmon Oil
          </a>
          <span class="font-mono font-bold">22g</span>
        </li>
        <li class="p-3 sm:p-3.5 flex justify-between bg-gray-50 items-center">
          <a href="https://www.amazon.com/s?k=organic+dog+eggshell+calcium+powder&tag=dogfoodplanner-20" target="_blank" rel="noopener noreferrer sponsored" class="amazon-food-link amazon-inline-link inline font-semibold text-black underline decoration-black decoration-1.5 underline-offset-2 hover:opacity-80 transition-opacity cursor-pointer">
            Eggshell Calcium & Organic Kelp Blend
          </a>
          <span class="font-mono font-bold">29g</span>
        </li>
      </ul>
    </div>

    <div class="text-sm bg-gray-50 p-5 border border-gray-300 rounded-xl mb-5">
      <strong class="font-bold text-black block mb-2">Feeding & Storage Instructions:</strong>
      <ol class="list-decimal list-inside space-y-2 text-gray-800 leading-relaxed">
        <li>Feed half in the morning and half in the evening at room temperature.</li>
        <li>Refrigerate fresh batch for up to 4 days or freeze in pre-portioned silicone bags for up to 3 months.</li>
        <li>Always ensure clean filtered water is available at all times.</li>
      </ol>
    </div>

    <div class="flex items-center justify-end pt-4 border-t border-gray-200 text-xs text-gray-500 mb-6">
      <span class="font-mono">Page 1 of 1</span>
    </div>

    <div class="text-center no-print pt-2">
      <button id="download-print-pdf-btn" type="button" class="inline-flex items-center gap-2 px-8 py-3 bg-[#c47a2b] hover:bg-[#a8621f] text-white text-sm font-bold rounded-full cursor-pointer transition-all shadow-md active:scale-95">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
        </svg>
        Download / Print PDF
      </button>
    </div>
  </div>

  <script>
    // Ensure body.printing-plan is active during print so print CSS applies uniformly
    function triggerPrintPdf() {
      document.body.classList.add('printing-plan');
      window.print();
    }

    document.getElementById('download-print-pdf-btn')?.addEventListener('click', triggerPrintPdf);

    window.addEventListener('beforeprint', () => {
      document.body.classList.add('printing-plan');
    });

    window.addEventListener('afterprint', () => {
      document.body.classList.remove('printing-plan');
    });

    // Hydrate personalized dog meal plan from sessionStorage if available
    try {
      const raw = sessionStorage.getItem('dfp-results-state');
      if (raw) {
        const state = JSON.parse(raw);
        if (state?.profile) {
          const profile = state.profile;
          const dogName = profile.dogName || 'Lucy';
          const breed = profile.breed || 'Dog';
          const weight = profile.weightLbs ? `${Math.round(profile.weightLbs)} lbs` : '45 lbs';
          
          const dogInfoEl = document.querySelector('.grid.grid-cols-1.sm\\:grid-cols-2');
          if (dogInfoEl) {
            // Updated personalized labels
            const strongs = dogInfoEl.querySelectorAll('strong');
            if (strongs[0]?.parentElement) strongs[0].parentElement.innerHTML = `<strong class="font-bold">Dog:</strong> ${dogName} (${breed})`;
            if (strongs[2]?.parentElement) strongs[2].parentElement.innerHTML = `<strong class="font-bold">Weight:</strong> ${weight}`;
          }
        }
      }
    } catch (e) {
      // Graceful fallback to static defaults
    }

    // Explicitly guarantee all affiliate links open in a new tab on any device
    document.querySelectorAll('a.amazon-food-link, a.amazon-inline-link').forEach((link) => {
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener noreferrer sponsored');
    });
  </script>
</Layout>
