---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IngredientChecker from '../components/IngredientChecker.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<Layout
  lang={lang}
  title="Toxic Foods for Dogs: Canine Ingredient Safety Lookup | DogFoodPlanner"
  description="Search 60+ ingredients to instantly see what's safe, toxic, or needs caution for dogs. Check which foods are safe or unsafe for dogs."
>
  <Navbar />
  <main class="min-h-screen page-warm-bg">
    <Breadcrumbs items={[{ name: t('nav.brand'), url: translatePath('/') }, { name: t('nav.toxicFoods') }]} />
    <section class="relative py-10 sm:py-16 border-b border-[#f0d5a8] dark:border-[#3a2510] overflow-hidden">
      <div class="absolute inset-0 pointer-events-none z-0">
        <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-[500px] h-48 rounded-full opacity-50" style="background: radial-gradient(ellipse at 50% 0%, rgba(196,122,43,0.15) 0%, transparent 70%); filter: blur(35px);"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h1 class="text-[1.65rem] sm:text-4xl lg:text-5xl font-extrabold text-[#1c0f00] dark:text-[#fde8c8] tracking-tight mb-4 text-balance leading-tight">
          Canine Ingredient Safety & Toxicity Lookup
        </h1>
        <p class="text-sm sm:text-base text-[#6b4226] dark:text-[#c4956a] max-w-2xl mx-auto leading-relaxed">
          Search 60+ ingredients — instantly see what's safe, what's toxic, and what to feed with caution. Check which foods are safe or unsafe for dogs.
        </p>
        <p class="mt-3 text-xs sm:text-sm font-semibold text-red-700 dark:text-red-400">
          If your dog ate something toxic, call your vet or the <a href="https://www.aspca.org/pet-care/animal-poison-control" target="_blank" rel="noopener noreferrer" class="underline hover:text-red-900 dark:hover:text-red-200">ASPCA Poison Control Center</a> right away.
        </p>
        <p class="mt-2 text-xs font-mono text-[#8f5e35] dark:text-[#c4956a]">
          Last updated: October 14, 2026
        </p>
      </div>
    </section>
    <IngredientChecker />
  </main>

<style>
  .page-warm-bg {
    background: linear-gradient(160deg, #fff8f0 0%, #fef3e2 60%, #fff0e6 100%);
  }
  html.dark .page-warm-bg {
    background: linear-gradient(160deg, #150d04 0%, #1c1005 60%, #1a0e04 100%);
  }
</style>
  <Footer />
</Layout>
