---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IngredientChecker from '../components/IngredientChecker.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
---

<Layout 
  title="Toxic Foods & Dangerous Ingredients for Dogs 2026 | DogFoodPlanner.com"
  description="Complete canine toxicity checker and ingredient safety guide. Can dogs eat cat food, eggs, bananas, or chicken meal? Check foods instantly."
  canonicalUrl="https://dogfoodplanner.com/toxic-foods"
>
  <Navbar />
  
  <main class="min-h-screen bg-[#fafafa] dark:bg-[#0d0d0d]">
    <Breadcrumbs 
      items={[
        { name: 'Home', url: '/' },
        { name: 'Toxic Foods & Ingredient Checker' }
      ]}
    />

    <!-- Header Section -->
    <section class="py-12 sm:py-16 bg-white dark:bg-[#0d0d0d] border-b border-[#ebebeb] dark:border-[#262626]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase font-medium text-[#171717] dark:text-[#ededed] bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#2e2e2e] px-3 py-1 rounded-full mb-3 shadow-2xs">
          <span class="text-[#e11d48] dark:text-[#f43f5e]">CRITICAL SAFETY</span> // CANINE INGREDIENT TOXICITY
        </div>
        <h1 class="text-[1.65rem] sm:text-4xl lg:text-5xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight mb-4 text-balance leading-tight">
          Canine Ingredient Safety & Toxic Foods Directory
        </h1>
        <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
          Search over 60+ ingredients to verify if they are safe, beneficial superfoods, or potentially life-threatening toxins for dogs.
        </p>
      </div>
    </section>

    <!-- Interactive Ingredient Checker Component -->
    <div class="py-8">
      <IngredientChecker />
    </div>

    <!-- Lethal Foods Guide Section -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 space-y-8 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#e11d48] dark:text-[#f43f5e] flex items-center gap-2">
          <span>☠️</span> The Most Dangerous Household Foods for Dogs
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-4 bg-red-50/50 dark:bg-red-950/30 rounded-xl border border-red-100 dark:border-red-900/40">
            <h3 class="font-bold text-xs text-red-900 dark:text-red-200">1. Xylitol / Birch Sugar</h3>
            <p class="text-xs text-red-800 dark:text-red-300 mt-1">Causes severe, rapid insulin surge resulting in hypoglycemia and acute liver failure within 30 minutes.</p>
          </div>

          <div class="p-4 bg-red-50/50 dark:bg-red-950/30 rounded-xl border border-red-100 dark:border-red-900/40">
            <h3 class="font-bold text-xs text-red-900 dark:text-red-200">2. Grapes, Raisins & Currants</h3>
            <p class="text-xs text-red-800 dark:text-red-300 mt-1">Contain tartaric acid compounds that cause acute, irreversible canine renal (kidney) failure.</p>
          </div>

          <div class="p-4 bg-red-50/50 dark:bg-red-950/30 rounded-xl border border-red-100 dark:border-red-900/40">
            <h3 class="font-bold text-xs text-red-900 dark:text-red-200">3. Dark Chocolate & Cocoa</h3>
            <p class="text-xs text-red-800 dark:text-red-300 mt-1">Theobromine and caffeine cause cardiac arrhythmias, central nervous system seizures, and death.</p>
          </div>

          <div class="p-4 bg-red-50/50 dark:bg-red-950/30 rounded-xl border border-red-100 dark:border-red-900/40">
            <h3 class="font-bold text-xs text-red-900 dark:text-red-200">4. Onions, Garlic, Leeks & Chives</h3>
            <p class="text-xs text-red-800 dark:text-red-300 mt-1">Alliums contain thiosulfates that rupture canine red blood cells causing hemolytic anemia.</p>
          </div>

          <div class="p-4 bg-red-50/50 dark:bg-red-950/30 rounded-xl border border-red-100 dark:border-red-900/40">
            <h3 class="font-bold text-xs text-red-900 dark:text-red-200">5. Macadamia Nuts</h3>
            <p class="text-xs text-red-800 dark:text-red-300 mt-1">Unknown toxin causes severe hind-limb weakness, tremors, hyperthermia, and inability to walk.</p>
          </div>

          <div class="p-4 bg-red-50/50 dark:bg-red-950/30 rounded-xl border border-red-100 dark:border-red-900/40">
            <h3 class="font-bold text-xs text-red-900 dark:text-red-200">6. Cooked Bones</h3>
            <p class="text-xs text-red-800 dark:text-red-300 mt-1">Cooking makes bones brittle and sharp, causing esophageal, stomach, and intestinal punctures.</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Safe Superfood Alternatives — directly contrasting the toxic list above -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pb-10">
      <section class="hairline-card p-6 sm:p-8 bg-white dark:bg-[#141414] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-[#ededed] flex items-center gap-2">
          <span>✅</span> Safe Superfoods to Use Instead
        </h2>
        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1]">
          These are the dog-safe whole foods referenced throughout our guides — each one a healthy alternative to the toxic items above.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="flex items-start gap-3 p-3 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#1a1a1a]">
            <span class="text-lg shrink-0">🎃</span>
            <div class="flex-1 min-w-0">
              <div class="text-[11px] font-semibold text-[#171717] dark:text-[#ededed]">Libby's 100% Pure Canned Pumpkin, 15oz</div>
              <div class="text-[10px] text-[#8f8f8f] dark:text-[#737373] mt-0.5">Safe fiber source — soothes diarrhea & constipation. Use instead of onion-based table scraps.</div>
              <AffiliateButton url="https://amzn.to/3UFE0PZ" label="Buy Now" size="sm" class="mt-2" />
            </div>
          </div>
          <div class="flex items-start gap-3 p-3 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#1a1a1a]">
            <span class="text-lg shrink-0">🐟</span>
            <div class="flex-1 min-w-0">
              <div class="text-[11px] font-semibold text-[#171717] dark:text-[#ededed]">Wild Planet Wild Sardines in Water, No Salt (12-pack)</div>
              <div class="text-[10px] text-[#8f8f8f] dark:text-[#737373] mt-0.5">Safe omega-3 whole food — use instead of chocolate or macadamia nut treats.</div>
              <AffiliateButton url="https://amzn.to/4xg3W2h" label="Buy Now" size="sm" class="mt-2" />
            </div>
          </div>
          <div class="flex items-start gap-3 p-3 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#1a1a1a]">
            <span class="text-lg shrink-0">🫙</span>
            <div class="flex-1 min-w-0">
              <div class="text-[11px] font-semibold text-[#171717] dark:text-[#ededed]">Zesty Paws Wild Alaskan Salmon Oil, 16oz</div>
              <div class="text-[10px] text-[#8f8f8f] dark:text-[#737373] mt-0.5">Safe anti-inflammatory oil — replaces grapes/raisins as a coat & joint health topper.</div>
              <AffiliateButton url="https://amzn.to/46HCJdW" label="Buy Now" size="sm" class="mt-2" />
            </div>
          </div>
          <div class="flex items-start gap-3 p-3 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#1a1a1a]">
            <span class="text-lg shrink-0">🍲</span>
            <div class="flex-1 min-w-0">
              <div class="text-[11px] font-semibold text-[#171717] dark:text-[#ededed]">Brutus Broth Chicken Bone Broth – Hip & Joint Topper</div>
              <div class="text-[10px] text-[#8f8f8f] dark:text-[#737373] mt-0.5">Safe hydrating topper — use instead of xylitol-containing peanut butters or flavored treats.</div>
              <AffiliateButton url="https://amzn.to/4zSd7Zb" label="Buy Now" size="sm" class="mt-2" />
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Related FAQs for Ingredients & Safety -->
    <FaqSection 
      title="Ingredients & Safety FAQs"
      subtitle="Frequently asked questions on cat food, human foods, eggs, fruits, and chicken meal."
      category="Ingredients & Safety"
      limit={8}
      viewAllLink={true}
    />

  </main>

  <Footer />
</Layout>
